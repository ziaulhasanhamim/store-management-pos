@inject NavigationManager Navigation

<label for="items-location" class="field-label">Stock location</label>
<select id="items-location" class="field" value="@SelectedLocationId"
        @onchange="ChangeLocation">
    @foreach (var location in Locations)
    {
        <option value="@location.Id" selected="@(location.Id == SelectedLocationId)">
            @location.Name
        </option>
    }
</select>

@code {
    [Parameter]
    public Lookup[] Locations { get; set; } = [];

    [Parameter]
    public int? SelectedLocationId { get; set; }

    private void ChangeLocation(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var locationId) ||
            locationId == SelectedLocationId ||
            !Locations.Any(location => location.Id == locationId))
        {
            return;
        }

        var uri = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["locationId"] = locationId,
            ["page"] = 1
        });

        Navigation.NavigateTo(uri);
    }
}
