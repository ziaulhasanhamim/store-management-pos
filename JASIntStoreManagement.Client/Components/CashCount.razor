@using System.Globalization

<label class="field-label" for="counted-cash">Counted cash (@Currency)</label>
<input id="counted-cash" name="@FieldName" class="field" type="text" inputmode="decimal"
       data-select-on-focus="true" required="@Required" pattern="[0-9]+([.][0-9]{1,2})?"
       @bind="Count" @bind:event="oninput" />
@if (decimal.TryParse(Count, NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out var actual) && actual >= 0)
{
    var difference = actual - Expected;
    <p class="mt-3 text-sm font-semibold @(difference == 0 ? "text-emerald-700" : "text-amber-700")" role="status">
        @(difference == 0 ? "Balanced" : difference < 0 ? "Shortage" : "Overage")
        · @Currency @Math.Abs(difference).ToString("N2")
    </p>
}

@code {
    [Parameter]
    public decimal Expected { get; set; }

    [Parameter]
    public string Currency { get; set; } = "BDT";

    [Parameter]
    public string FieldName { get; set; } = "Close.ActualCash";

    [Parameter]
    public bool Required { get; set; } = true;

    [Parameter]
    public decimal? Value { get; set; }

    private string Count = "";

    protected override void OnInitialized()
    {
        Count = Value?.ToString("0.00", CultureInfo.InvariantCulture) ?? "";
    }
}
