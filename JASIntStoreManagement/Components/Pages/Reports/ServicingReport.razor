@page "/reports/servicing"
@attribute [Authorize(Policy = AppPolicies.MakeSales)]
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using JASIntStoreManagement.Client.DTOs
@using JASIntStoreManagement.Client.Security
@using JASIntStoreManagement.Services
@inject ServicingService Servicing
@inject IConfiguration Configuration
@inject NavigationManager Navigation

<PageTitle>Mobile Servicing Report · @(Configuration["StoreName"] ?? "JAS International")</PageTitle>

<div class="page-heading">
    <div>
        <nav class="breadcrumb">
            <a href="/">Dashboard</a>
            <span>/</span>
            <a href="/reports">Reports</a>
            <span>/</span>
            <span>Mobile servicing</span>
        </nav>
        <h1 class="mt-1">Mobile Servicing Report</h1>
        <p class="text-sm text-slate-500">Period summary, technician profit splits, material costs, and daily collections</p>
    </div>
    <div class="flex flex-wrap gap-2 no-print">
        <a href="@ExportCsvUrl" class="btn-secondary" download>
            <Icon Name="history" Class="size-4 mr-1.5" />
            Export CSV
        </a>
        <a href="/servicing" class="btn-secondary">
            <Icon Name="service" Class="size-4 mr-1.5" />
            Daily servicing hub
        </a>
        <a href="/servicing/technicians" class="btn-secondary">
            <Icon Name="users" Class="size-4 mr-1.5" />
            Technicians & rates
        </a>
    </div>
</div>

@if (Error is not null)
{
    <p class="error-panel mb-4" role="alert">@Error</p>
}

@if (Data is null)
{
    <LoadingPanel Message="Loading servicing report…" />
}
else
{
    <!-- Filter Presets & Controls -->
    <div class="report-filters no-print mb-6">
        <div class="mb-4 flex flex-wrap items-center gap-2">
            @foreach (var preset in Presets)
            {
                <a href="@PresetLink(preset.Key)" class="@(Period == preset.Key ? "filter-chip active" : "filter-chip")">@preset.Value</a>
            }
        </div>

        <form method="get" action="/reports/servicing" class="grid items-end gap-3 sm:grid-cols-2 xl:grid-cols-5" data-enhance data-auto-search="false">
            <input type="hidden" name="period" value="custom" />
            <div class="sm:col-span-2">
                <label class="field-label">Date range</label>
                <DateRangePicker Id="report-date-range" Start="@EffectiveStart" End="@EffectiveEnd" AutoSubmit="false" />
            </div>

            <div>
                <label class="field-label" for="filter-location">Store Location</label>
                <select id="filter-location" name="locationId" class="field">
                    <option value="">All store locations</option>
                    @foreach (var loc in Data.Locations)
                    {
                        <option value="@loc.Id" selected="@(LocationId == loc.Id)">@loc.Name</option>
                    }
                </select>
            </div>

            <div>
                <label class="field-label" for="filter-tech">Technician</label>
                <select id="filter-tech" name="technicianId" class="field">
                    <option value="">All technicians</option>
                    @foreach (var tech in Data.Technicians)
                    {
                        <option value="@tech.Id" selected="@(TechnicianId == tech.Id)">@tech.Name (@tech.LocationName)</option>
                    }
                </select>
            </div>

            <div class="flex items-center gap-2">
                <div class="flex-1">
                    <label class="field-label" for="filter-search">Search notes</label>
                    <input id="filter-search" name="search" class="field" value="@Search" placeholder="Technician or notes" maxlength="100" />
                </div>
                <button type="submit" class="btn-primary self-end py-2 px-4">
                    <Icon Name="search" Class="size-4 mr-1" />
                    Filter
                </button>
            </div>
        </form>
    </div>

    <!-- Summary KPI Cards -->
    <div class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
        <div class="flex flex-col justify-between rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs">
            <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Total Servicing</span>
                <div class="mt-2 text-2xl font-bold tracking-tight text-blue-700 tabular-nums">
                    @Money(Data.Summary.TotalServicingAmount)
                </div>
                <p class="mt-0.5 text-[11px] text-slate-400">Total collections from customers</p>
            </div>
            <div class="mt-4 border-t border-slate-100 pt-3 text-xs text-slate-600">
                <span>Active technicians: <strong class="text-slate-900">@Data.Summary.TechnicianCount</strong></span>
            </div>
        </div>

        <div class="flex flex-col justify-between rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs">
            <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Parts / Material Cost</span>
                <div class="mt-2 text-2xl font-bold tracking-tight text-slate-700 tabular-nums">
                    @Money(Data.Summary.TotalCost)
                </div>
                <p class="mt-0.5 text-[11px] text-slate-400">Total spare parts cost</p>
            </div>
            <div class="mt-4 border-t border-slate-100 pt-3 text-xs text-slate-600">
                <span>Gross profit: <strong class="text-emerald-700">@Money(Data.Summary.TotalProfit)</strong></span>
            </div>
        </div>

        <div class="flex flex-col justify-between rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs">
            <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Technician Payouts</span>
                <div class="mt-2 text-2xl font-bold tracking-tight text-indigo-700 tabular-nums">
                    @Money(Data.Summary.TotalTechnicianCut)
                </div>
                <p class="mt-0.5 text-[11px] text-slate-400">Taken upfront by technicians</p>
            </div>
            <div class="mt-4 border-t border-slate-100 pt-3 text-xs text-slate-600">
                <span>Average share: <strong class="text-slate-900">@(Data.Summary.TotalProfit > 0 ? $"{Data.Summary.TotalTechnicianCut / Data.Summary.TotalProfit * 100:0.#}%" : "0%")</strong></span>
            </div>
        </div>

        <div class="flex flex-col justify-between rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs">
            <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Shop Servicing Profit</span>
                <div class="mt-2 text-2xl font-bold tracking-tight text-emerald-700 tabular-nums">
                    @Money(Data.Summary.TotalShopProfit)
                </div>
                <p class="mt-0.5 text-[11px] text-slate-400">Store retained profit</p>
            </div>
            <div class="mt-4 border-t border-slate-100 pt-3 flex items-center justify-between text-xs">
                <span class="text-emerald-700">Deposited: <strong>@Money(Data.Summary.DepositedShopProfit)</strong></span>
                @if (Data.Summary.UndepositedShopProfit > 0)
                {
                    <span class="text-amber-700 font-semibold">Pending: @Money(Data.Summary.UndepositedShopProfit)</span>
                }
            </div>
        </div>

        <div class="flex flex-col justify-between rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs">
            <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Report Scope</span>
                <div class="mt-2 text-lg font-bold tracking-tight text-slate-900">
                    @Data.StartDate.ToString("dd MMM") – @Data.EndDate.ToString("dd MMM yyyy")
                </div>
                <p class="mt-0.5 text-[11px] text-slate-400">@((Data.EndDate.DayNumber - Data.StartDate.DayNumber + 1)) days in period</p>
            </div>
            <div class="mt-4 border-t border-slate-100 pt-3 text-xs text-slate-600">
                <span>Entries recorded: <strong class="text-slate-900">@Data.Entries.Count</strong></span>
            </div>
        </div>
    </div>

    <!-- Period Technician Performance Summary Table -->
    <section class="panel mb-6 table-scroll">
        <div class="panel-heading">
            <div>
                <h2 class="font-semibold text-slate-900">Technicians · Period Performance Summary</h2>
                <p class="mt-0.5 text-xs text-slate-500">Collections, material costs, technician cuts, and shop earnings per technician in this period.</p>
            </div>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Technician</th>
                    <th>Assigned Store Location</th>
                    <th class="text-right">Default Rate %</th>
                    <th class="text-right">Days Active</th>
                    <th class="text-right">Total Servicing</th>
                    <th class="text-right">Total Material Cost</th>
                    <th class="text-right">Period Profit</th>
                    <th class="text-right">Technician Cut (Upfront)</th>
                    <th class="text-right">Shop Profit</th>
                </tr>
            </thead>
            <tbody>
                @if (Data.TechnicianSummaries.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="p-6 text-center text-xs text-slate-400">No mobile servicing entries recorded for this period.</td>
                    </tr>
                }
                else
                {
                    @foreach (var tech in Data.TechnicianSummaries)
                    {
                        <tr>
                            <td class="font-medium text-slate-900">@tech.TechnicianName</td>
                            <td class="text-slate-600">@tech.LocationName</td>
                            <td class="text-right tabular-nums">@tech.CommissionRate.ToString("0.##")%</td>
                            <td class="text-right tabular-nums">@tech.DaysWorked</td>
                            <td class="text-right tabular-nums font-semibold text-blue-700">@Money(tech.TotalServicing)</td>
                            <td class="text-right tabular-nums text-slate-700">@Money(tech.TotalCost)</td>
                            <td class="text-right tabular-nums font-medium text-slate-900">@Money(tech.TotalProfit)</td>
                            <td class="text-right tabular-nums text-indigo-700">@Money(tech.TechnicianCut)</td>
                            <td class="text-right tabular-nums font-bold text-emerald-700">@Money(tech.ShopProfit)</td>
                        </tr>
                    }
                }
            </tbody>
            @if (Data.TechnicianSummaries.Count > 0)
            {
                <tfoot>
                    <tr>
                        <th colspan="3">Total (@Data.TechnicianSummaries.Count @(Data.TechnicianSummaries.Count == 1 ? "technician" : "technicians"))</th>
                        <td class="text-right font-bold tabular-nums">@Data.TechnicianSummaries.Sum(t => t.DaysWorked)</td>
                        <td class="text-right font-bold tabular-nums text-blue-700">@Money(Data.Summary.TotalServicingAmount)</td>
                        <td class="text-right font-bold tabular-nums text-slate-700">@Money(Data.Summary.TotalCost)</td>
                        <td class="text-right font-bold tabular-nums text-slate-900">@Money(Data.Summary.TotalProfit)</td>
                        <td class="text-right font-bold tabular-nums text-indigo-700">@Money(Data.Summary.TotalTechnicianCut)</td>
                        <td class="text-right font-bold tabular-nums text-emerald-700">@Money(Data.Summary.TotalShopProfit)</td>
                    </tr>
                </tfoot>
            }
        </table>
    </section>

    <!-- Detailed Daily Servicing Entries Table -->
    <section class="panel mb-6 table-scroll">
        <div class="panel-heading">
            <div>
                <h2 class="font-semibold text-slate-900">Daily Servicing Entries (@Data.Entries.Count)</h2>
                <p class="mt-0.5 text-xs text-slate-500">Every daily entry submitted by technicians across all shop locations.</p>
            </div>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Technician</th>
                    <th>Store Location</th>
                    <th class="text-right">Servicing Total</th>
                    <th class="text-right">Parts Cost</th>
                    <th class="text-right">Day Profit</th>
                    <th class="text-right">Rate %</th>
                    <th class="text-right">Tech Cut (Upfront)</th>
                    <th class="text-right">Shop Profit</th>
                    <th class="text-center">Drawer Deposit</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @if (Data.Entries.Count == 0)
                {
                    <tr>
                        <td colspan="11" class="p-6 text-center text-xs text-slate-400">No matching daily servicing records found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var entry in Data.Entries)
                    {
                        <tr>
                            <td>
                                <a href="@($"/servicing?date={entry.Date:yyyy-MM-dd}&locationId={entry.LocationId}")" class="font-medium text-blue-700 hover:underline">
                                    @entry.Date.ToString("dd MMM yyyy")
                                </a>
                            </td>
                            <td class="font-medium text-slate-900">@entry.TechnicianName</td>
                            <td class="text-slate-600">@entry.LocationName</td>
                            <td class="text-right tabular-nums font-semibold text-blue-700">@Money(entry.TotalAmount)</td>
                            <td class="text-right tabular-nums text-slate-700">@Money(entry.TotalCost)</td>
                            <td class="text-right tabular-nums text-slate-900">@Money(entry.Profit)</td>
                            <td class="text-right tabular-nums">@entry.CommissionRate.ToString("0.##")%</td>
                            <td class="text-right tabular-nums text-indigo-700 font-medium">@Money(entry.TechnicianCut)</td>
                            <td class="text-right tabular-nums font-bold text-emerald-700">@Money(entry.ShopProfit)</td>
                            <td class="text-center">
                                @if (entry.IsDeposited)
                                {
                                    <span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-[11px] font-semibold text-emerald-700">
                                        Deposited
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-[11px] font-semibold text-amber-700">
                                        Pending
                                    </span>
                                }
                            </td>
                            <td class="text-xs text-slate-500 max-w-xs truncate" title="@entry.Notes">
                                @(string.IsNullOrWhiteSpace(entry.Notes) ? "—" : entry.Notes)
                            </td>
                        </tr>
                    }
                }
            </tbody>
            @if (Data.Entries.Count > 0)
            {
                <tfoot>
                    <tr>
                        <th colspan="3">Total (@Data.Entries.Count entries)</th>
                        <td class="text-right font-bold tabular-nums text-blue-700">@Money(Data.Summary.TotalServicingAmount)</td>
                        <td class="text-right font-bold tabular-nums text-slate-700">@Money(Data.Summary.TotalCost)</td>
                        <td class="text-right font-bold tabular-nums text-slate-900">@Money(Data.Summary.TotalProfit)</td>
                        <td></td>
                        <td class="text-right font-bold tabular-nums text-indigo-700">@Money(Data.Summary.TotalTechnicianCut)</td>
                        <td class="text-right font-bold tabular-nums text-emerald-700">@Money(Data.Summary.TotalShopProfit)</td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            }
        </table>
    </section>
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    public string Period { get; set; } = "month";

    [SupplyParameterFromQuery]
    public DateOnly? Start { get; set; }

    [SupplyParameterFromQuery]
    public DateOnly? End { get; set; }

    [SupplyParameterFromQuery]
    public int? LocationId { get; set; }

    [SupplyParameterFromQuery]
    public int? TechnicianId { get; set; }

    [SupplyParameterFromQuery]
    public string? Search { get; set; }

    private ServicingReportData? Data;
    private string? Error;

    private static readonly KeyValuePair<string, string>[] Presets =
    [
        new("today", "Today"),
        new("yesterday", "Yesterday"),
        new("week", "This week"),
        new("month", "This month"),
        new("lastmonth", "Last month"),
        new("year", "This year"),
        new("custom", "Custom")
    ];

    private DateOnly EffectiveStart => Data?.StartDate ?? DateOnly.FromDateTime(DateTime.UtcNow);
    private DateOnly EffectiveEnd => Data?.EndDate ?? DateOnly.FromDateTime(DateTime.UtcNow);

    private string ExportCsvUrl =>
        $"/api/reports/export/servicing?period={Period}&start={EffectiveStart:yyyy-MM-dd}&end={EffectiveEnd:yyyy-MM-dd}&locationId={LocationId}&search={Uri.EscapeDataString(Search ?? "")}";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var zone = AccountingCalendar.Zone(Configuration);
            var range = ReportService.ResolveRange(Period, Start, End, zone, DateTimeOffset.UtcNow);

            Data = await Servicing.GetServicingReportAsync(
                HttpContext.User,
                range.Start,
                range.End,
                LocationId,
                TechnicianId,
                Search,
                HttpContext.RequestAborted);
        }
        catch (ValidationException ex)
        {
            Error = ex.Message;
        }
        catch (Exception ex)
        {
            Error = "Failed to load servicing report: " + ex.Message;
        }
    }

    private string PresetLink(string preset)
    {
        var query = new List<string> { $"period={preset}" };
        if (LocationId.HasValue) query.Add($"locationId={LocationId.Value}");
        if (TechnicianId.HasValue) query.Add($"technicianId={TechnicianId.Value}");
        if (!string.IsNullOrWhiteSpace(Search)) query.Add($"search={Uri.EscapeDataString(Search)}");
        return $"/reports/servicing?{string.Join("&", query)}";
    }

    private string Money(decimal amount) => $"{amount:N2} {Configuration["CurrencyCode"] ?? "BDT"}";
}
