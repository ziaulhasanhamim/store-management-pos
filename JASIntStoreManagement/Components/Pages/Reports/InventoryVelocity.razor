@page "/reports/inventory-velocity"
@attribute [Authorize(Policy = AppPolicies.ManageInventory)]
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using JASIntStoreManagement.Client.DTOs
@using JASIntStoreManagement.Client.Security
@using JASIntStoreManagement.Services
@inject AnalyticsService Analytics
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Dead Stock & Inventory Velocity · @(Configuration["StoreName"] ?? "JAS International")</PageTitle>

<div class="page-heading">
    <div>
        <nav class="breadcrumb">
            <a href="/">Dashboard</a>
            <span>/</span>
            <a href="/reports">Reports</a>
            <span>/</span>
            <span>Dead stock & inventory velocity</span>
        </nav>
        <h1 class="mt-1">Dead Stock & Inventory Velocity</h1>
        <p class="text-sm text-slate-500">Uncover trapped capital in stagnant stock and track fast-moving bestsellers</p>
    </div>
    <div class="flex flex-wrap gap-2 no-print">
        <a href="@ExportCsvUrl" class="btn-secondary" download>
            <Icon Name="history" Class="size-4 mr-1.5" />
            Export CSV
        </a>
        <a href="/reports/inventory" class="btn-secondary">
            <Icon Name="box" Class="size-4 mr-1.5" />
            Stock valuation
        </a>
    </div>
</div>

@if (Error is not null)
{
    <p class="error-panel mb-4" role="alert">@Error</p>
}

@if (Data is null)
{
    <LoadingPanel Message="Auditing inventory velocity and stagnant stock…" />
}
else
{
    <!-- Filter Controls & Threshold Chips -->
    <div class="report-filters no-print mb-6">
        <div class="mb-4 flex flex-wrap items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500 mr-2">Inactivity Threshold:</span>
            @foreach (var threshold in Thresholds)
            {
                <a href="@ThresholdLink(threshold.Key)" class="@(DaysThreshold == threshold.Key ? "filter-chip active" : "filter-chip")">
                    @threshold.Value
                </a>
            }
        </div>

        <form method="get" action="/reports/inventory-velocity" class="grid items-end gap-3 sm:grid-cols-2 xl:grid-cols-4" data-enhance data-auto-search="false">
            <input type="hidden" name="daysThreshold" value="@DaysThreshold" />

            <div>
                <label class="field-label" for="filter-location">Store Location</label>
                <select id="filter-location" name="locationId" class="field">
                    <option value="">All store locations</option>
                    @foreach (var loc in Data.Locations)
                    {
                        <option value="@loc.Id" selected="@(LocationId == loc.Id)">@loc.Name</option>
                    }
                </select>
            </div>

            <div>
                <label class="field-label" for="filter-category">Product Category</label>
                <select id="filter-category" name="categoryId" class="field">
                    <option value="">All product categories</option>
                    @foreach (var cat in Data.Categories)
                    {
                        <option value="@cat.Id" selected="@(CategoryId == cat.Id)">@cat.Name</option>
                    }
                </select>
            </div>

            <div class="flex items-end sm:col-span-2 xl:col-span-2">
                <button type="submit" class="btn-primary w-full py-2 px-4">
                    <Icon Name="search" Class="size-4 mr-1" />
                    Apply filters
                </button>
            </div>
        </form>
    </div>

    <!-- Summary KPI Cards -->
    <div class="mb-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="metric bg-white border border-rose-200/80 shadow-xs">
            <div class="flex items-center justify-between">
                <p class="text-xs font-semibold uppercase tracking-wider text-rose-600">Trapped Dead Capital</p>
                <span class="inline-flex size-7 items-center justify-center rounded-lg bg-rose-50 text-rose-600">
                    <Icon Name="trash" Class="size-4" />
                </span>
            </div>
            <strong class="text-2xl mt-1 text-rose-600">@Money(Data.TotalDeadStockCapital)</strong>
            <span class="text-xs text-rose-600/80 mt-0.5 font-medium">Stagnant for &ge; @DaysThreshold days</span>
        </div>

        <div class="metric bg-white border border-slate-200/80 shadow-xs">
            <div class="flex items-center justify-between">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Dead Stock Items</p>
                <span class="inline-flex size-7 items-center justify-center rounded-lg bg-amber-50 text-amber-600">
                    <Icon Name="box" Class="size-4" />
                </span>
            </div>
            <strong class="text-2xl mt-1 text-amber-700">@Data.DeadStockItemsCount</strong>
            <span class="text-xs text-slate-400 mt-0.5">Products needing clearance</span>
        </div>

        <div class="metric bg-white border border-slate-200/80 shadow-xs">
            <div class="flex items-center justify-between">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Fast Velocity Movers</p>
                <span class="inline-flex size-7 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600">
                    <Icon Name="dashboard" Class="size-4" />
                </span>
            </div>
            <strong class="text-2xl mt-1 text-emerald-600">@Data.FastMoversCount</strong>
            <span class="text-xs text-slate-400 mt-0.5">High turnover bestsellers</span>
        </div>

        <div class="metric bg-white border border-slate-200/80 shadow-xs">
            <div class="flex items-center justify-between">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Audited Inventory Value</p>
                <span class="inline-flex size-7 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600">
                    <Icon Name="wallet" Class="size-4" />
                </span>
            </div>
            <strong class="text-2xl mt-1 text-indigo-700">@Money(Data.Items.Sum(i => i.TiedUpCapital))</strong>
            <span class="text-xs text-slate-400 mt-0.5">Across @Data.Items.Count total SKUs</span>
        </div>
    </div>

    <!-- Visual Charts -->
    <div class="mb-6 grid gap-6 lg:grid-cols-2">
        <!-- Capital by Velocity Tier Donut Chart -->
        <div class="chart-card bg-white rounded-xl border border-slate-200/80 p-5 shadow-xs">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <h2 class="text-base font-bold text-slate-800">Capital by Velocity Tier</h2>
                    <p class="text-xs text-slate-500">How your tied-up inventory value is distributed</p>
                </div>
                <span class="stat-pill bg-slate-100 text-slate-700 font-semibold text-xs px-2.5 py-1 rounded-full">Allocation</span>
            </div>
            <div class="relative h-72 w-full">
                @{
                    var deadCapital = Data.Items.Where(i => i.Tier == StockVelocityTier.Dead).Sum(i => i.TiedUpCapital);
                    var slowCapital = Data.Items.Where(i => i.Tier == StockVelocityTier.Slow).Sum(i => i.TiedUpCapital);
                    var normalCapital = Data.Items.Where(i => i.Tier == StockVelocityTier.Normal).Sum(i => i.TiedUpCapital);
                    var fastCapital = Data.Items.Where(i => i.Tier == StockVelocityTier.Fast).Sum(i => i.TiedUpCapital);

                    var tierLabels = new[] { $"Dead Stock (>{DaysThreshold}d)", "Slow Moving (>45d)", "Active Normal", "Fast Velocity" };
                    var tierValues = new[] { deadCapital, slowCapital, normalCapital, fastCapital };
                    var tierColors = new[] { "#ef4444", "#f59e0b", "#3b82f6", "#10b981" };
                }
                <canvas id="velocity-donut-chart"
                        data-chart="donut"
                        data-currency="@Currency"
                        data-labels="@JsonSerializer.Serialize(tierLabels)"
                        data-values="@JsonSerializer.Serialize(tierValues)"
                        data-colors="@JsonSerializer.Serialize(tierColors)">
                </canvas>
            </div>
        </div>

        <!-- Dead Capital by Category Bar Chart -->
        <div class="chart-card bg-white rounded-xl border border-slate-200/80 p-5 shadow-xs">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <h2 class="text-base font-bold text-slate-800">Dead Capital by Category</h2>
                    <p class="text-xs text-slate-500">Categories with highest trapped capital</p>
                </div>
                <span class="stat-pill bg-rose-50 text-rose-700 font-semibold text-xs px-2.5 py-1 rounded-full">Dead Capital</span>
            </div>
            <div class="relative h-72 w-full">
                @{
                    var deadByCategory = Data.Items
                        .Where(i => i.Tier == StockVelocityTier.Dead)
                        .GroupBy(i => i.CategoryName)
                        .Select(g => new { Category = g.Key, Capital = g.Sum(x => x.TiedUpCapital) })
                        .OrderByDescending(x => x.Capital)
                        .Take(6)
                        .ToList();

                    var catBarLabels = deadByCategory.Select(x => x.Category).ToList();
                    var catBarDatasets = new[]
                    {
                        new {
                            label = "Dead Capital",
                            data = deadByCategory.Select(x => x.Capital).ToList(),
                            color = "#f43f5e",
                            isPercent = false
                        }
                    };
                }
                @if (deadByCategory.Count > 0)
                {
                    <canvas id="category-dead-bar-chart"
                            data-chart="bar"
                            data-horizontal="true"
                            data-currency="@Currency"
                            data-labels="@JsonSerializer.Serialize(catBarLabels)"
                            data-datasets="@JsonSerializer.Serialize(catBarDatasets)">
                    </canvas>
                }
                else
                {
                    <div class="flex h-full items-center justify-center text-sm text-emerald-600 font-medium">
                        🎉 Excellent! No dead stock detected in this period.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Inventory Velocity Table -->
    <section class="panel bg-white border border-slate-200/80 shadow-xs rounded-xl overflow-hidden mb-8">
        <div class="border-b border-slate-200/80 px-5 py-4 flex flex-wrap items-center justify-between gap-3">
            <div>
                <h2 class="text-base font-bold text-slate-800">Inventory Velocity Audit</h2>
                <p class="text-xs text-slate-500">Sorted by stagnant dead stock first, then tied-up capital</p>
            </div>
            <div class="text-xs font-semibold text-slate-500">
                Showing @Data.Items.Count items
            </div>
        </div>

        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Product & Barcode</th>
                        <th>Category</th>
                        <th>Supplier</th>
                        <th class="text-right">Stock Qty</th>
                        <th class="text-right">Cost Price</th>
                        <th class="text-right">Tied-Up Capital</th>
                        <th>Last Sold Date</th>
                        <th class="text-right">Inactive Days</th>
                        <th class="text-right">Velocity Tier</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Data.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="p-8 text-center text-slate-400">
                                No stock items found matching your filters.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Data.Items)
                    {
                        <tr>
                            <td>
                                <a href="/inventory/@item.ProductId" class="font-semibold text-blue-700 hover:underline">
                                    @item.ProductName
                                </a>
                                @if (!string.IsNullOrWhiteSpace(item.Barcode))
                                {
                                    <span class="block text-xs font-mono text-slate-400">@item.Barcode</span>
                                }
                            </td>
                            <td class="text-slate-600">@item.CategoryName</td>
                            <td class="text-slate-600">@item.SupplierName</td>
                            <td class="text-right tabular-nums font-semibold text-slate-800">@item.QuantityOnHand.ToString("N0")</td>
                            <td class="text-right tabular-nums text-slate-500">@Money(item.CostPrice)</td>
                            <td class="text-right tabular-nums font-bold @(item.Tier == StockVelocityTier.Dead ? "text-rose-600" : "text-slate-900")">
                                @Money(item.TiedUpCapital)
                            </td>
                            <td class="text-slate-600 text-xs">
                                @(item.LastSoldDate?.ToString("dd MMM yyyy") ?? "Never sold")
                            </td>
                            <td class="text-right tabular-nums">
                                <span class="text-xs font-medium @(item.DaysSinceLastSale >= DaysThreshold ? "text-rose-600 font-bold" : "text-slate-600")">
                                    @item.DaysSinceLastSale days
                                </span>
                            </td>
                            <td class="text-right">
                                @switch (item.Tier)
                                {
                                    case StockVelocityTier.Dead:
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200">
                                            Dead Stock
                                        </span>
                                        break;
                                    case StockVelocityTier.Slow:
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                                            Slow Moving
                                        </span>
                                        break;
                                    case StockVelocityTier.Fast:
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            Fast Velocity
                                        </span>
                                        break;
                                    default:
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700">
                                            Active
                                        </span>
                                        break;
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                @if (Data.Items.Count > 0)
                {
                    <tfoot>
                        <tr class="font-bold bg-slate-50/80 border-t-2 border-slate-200">
                            <th colspan="3">Total (@Data.Items.Count products)</th>
                            <th class="text-right tabular-nums">@Data.Items.Sum(i => i.QuantityOnHand).ToString("N0")</th>
                            <th></th>
                            <th class="text-right tabular-nums text-indigo-700">@Money(Data.Items.Sum(i => i.TiedUpCapital))</th>
                            <th colspan="2"></th>
                            <th class="text-right text-rose-600">@Money(Data.TotalDeadStockCapital) dead</th>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </section>
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    public int DaysThreshold { get; set; } = 60;

    [SupplyParameterFromQuery]
    public int? LocationId { get; set; }

    [SupplyParameterFromQuery]
    public int? CategoryId { get; set; }

    private InventoryVelocityReportData? Data;
    private string? Error;

    private static readonly KeyValuePair<int, string>[] Thresholds =
    [
        new(30, "30+ Days"),
        new(60, "60+ Days (Default)"),
        new(90, "90+ Days (Severe)"),
        new(120, "120+ Days (Critical)")
    ];

    private string Currency => Configuration["CurrencyCode"] ?? "BDT";

    private string ExportCsvUrl =>
        $"/api/reports/export/inventory-velocity?daysThreshold={DaysThreshold}&locationId={LocationId}&categoryId={CategoryId}";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Data = await Analytics.GetInventoryVelocityAsync(
                HttpContext.User,
                DaysThreshold,
                LocationId,
                CategoryId,
                HttpContext.RequestAborted);
        }
        catch (ValidationException ex)
        {
            Error = ex.Message;
        }
        catch (Exception ex)
        {
            Error = "Failed to load inventory velocity: " + ex.Message;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await JS.InvokeVoidAsync("JASCharts.initDeclarativeCharts");
        }
        catch
        {
            // Ignore if JS interop is unavailable during SSR
        }
    }

    private string ThresholdLink(int days)
    {
        var query = new List<string> { $"daysThreshold={days}" };
        if (LocationId.HasValue) query.Add($"locationId={LocationId.Value}");
        if (CategoryId.HasValue) query.Add($"categoryId={CategoryId.Value}");
        return $"/reports/inventory-velocity?{string.Join("&", query)}";
    }

    private string Money(decimal amount) => $"{amount:N2} {Currency}";
}
