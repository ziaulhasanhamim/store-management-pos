@page "/servicing/technicians"
@attribute [Authorize(Policy = AppPolicies.ManageUsers)]
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@inject ServicingService Servicing
@inject NavigationManager Navigation

<PageTitle>Technicians · @(Configuration["StoreName"] ?? "JAS International")</PageTitle>

<div class="page-heading">
    <div>
        <div class="flex items-center gap-2 text-xs font-semibold tracking-wider text-slate-400 uppercase">
            <a href="/servicing" class="hover:text-blue-600">Servicing</a>
            <span>/</span>
            <span>Technicians</span>
        </div>
        <h1 class="mt-1">Technicians & Commissions</h1>
    </div>
    <div class="flex items-center gap-3">
        <a href="/servicing" class="btn-secondary">
            <Icon Name="back" />
            Back to servicing
        </a>
    </div>
</div>

@if (Error is not null)
{
    <p class="error-panel mb-6" role="alert">@Error</p>
}

@if (SuccessMessage is not null)
{
    <div class="mb-6 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm font-medium text-emerald-800">
        @SuccessMessage
    </div>
}

<div class="grid items-start gap-6 lg:grid-cols-3">
    <!-- Form: Add or Edit Technician -->
    <section class="panel p-6 lg:col-span-1">
        <h2 class="mb-1 font-semibold text-slate-900">@(Form?.Id is { } and > 0 ? "Edit technician" : "Add new technician")</h2>
        <p class="mb-5 text-xs text-slate-500">Configure technician profiles and default commission rates. Technicians collect their commission upfront on each job.</p>

        <form method="post" @formname="technician-form" @onsubmit="SaveTechnicianAsync" data-enhance data-submit-indication="true">
            <AntiforgeryToken />
            <input type="hidden" name="Form.Id" value="@Form?.Id" />

            <div class="space-y-4">
                <div>
                    <label class="field-label" for="tech-name">Technician name</label>
                    <input id="tech-name" name="Form.Name" class="field" value="@Form?.Name" maxlength="100" placeholder="e.g. Rahim Ahmed" required />
                </div>

                <div>
                    <label class="field-label" for="tech-location">Store location</label>
                    <select id="tech-location" name="Form.LocationId" class="field font-medium" value="@Form?.LocationId" required>
                        <option value="">Select store location</option>
                        @foreach (var loc in Locations)
                        {
                            <option value="@loc.Id">@loc.Name</option>
                        }
                    </select>
                    <p class="mt-1 text-[11px] text-slate-400">Servicing profits will count toward and deposit into this store location's cash drawer.</p>
                </div>

                <div>
                    <label class="field-label" for="tech-phone">Phone number</label>
                    <input id="tech-phone" name="Form.Phone" class="field" value="@Form?.Phone" maxlength="30" placeholder="e.g. 01711-000000" />
                </div>

                <div>
                    <label class="field-label" for="tech-commission">Default commission %</label>
                    <div class="relative">
                        <input id="tech-commission" name="Form.DefaultCommissionRate" class="field pr-10" inputmode="decimal" type="number" step="0.5" min="0" max="100" value="@((Form?.DefaultCommissionRate ?? 50m).ToString("0.##", CultureInfo.InvariantCulture))" required />
                        <span class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-sm text-slate-400">%</span>
                    </div>
                    <p class="mt-1 text-[11px] text-slate-400">Default rate is 50%. This can still be adjusted per servicing job.</p>
                </div>

                @if (Form?.Id is { } and > 0)
                {
                    <div class="pt-2">
                        <label class="flex items-center gap-2 cursor-pointer text-sm text-slate-700">
                            <input type="checkbox" name="Form.IsArchived" value="true" checked="@Form.IsArchived" class="rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
                            <span>Archive technician (hide from active selection)</span>
                        </label>
                    </div>
                }

                <div class="flex gap-3 pt-3">
                    <button class="btn-primary flex-1" data-pending-text="Saving…">
                        @(Form?.Id is { } and > 0 ? "Update technician" : "Save technician")
                    </button>
                    @if (Form?.Id is { } and > 0)
                    {
                        <a href="/servicing/technicians" class="btn-secondary">Cancel</a>
                    }
                </div>
            </div>
        </form>
    </section>

    <!-- List: Technicians & Stats -->
    <section class="panel lg:col-span-2">
        <div class="border-b border-slate-200 px-6 py-4 flex items-center justify-between">
            <h2 class="font-semibold text-slate-900">All Technicians (@(TechnicianList?.Count ?? 0))</h2>
            <span class="text-xs text-slate-400">Commission taken upfront on daily profits</span>
        </div>

        @if (TechnicianList is null)
        {
            <div class="p-6">
                <LoadingPanel Message="Loading technicians…" />
            </div>
        }
        else if (TechnicianList.Count == 0)
        {
            <div class="p-8 text-center">
                <p class="text-sm text-slate-500">No technicians configured yet. Add your first technician using the form on the left.</p>
            </div>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Technician</th>
                            <th>Phone</th>
                            <th class="text-center">Commission</th>
                            <th class="text-right">Days</th>
                            <th class="text-right">Total Profit</th>
                            <th class="text-right">Tech Cut (Paid)</th>
                            <th class="text-center">Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tech in TechnicianList)
                        {
                            <tr class="@(tech.IsArchived ? "opacity-60 bg-slate-50/50" : "")">
                                <td class="font-medium text-slate-900">
                                    @tech.Name
                                    <span class="block text-[11px] text-slate-500 font-normal">@tech.LocationName</span>
                                </td>
                                <td class="text-slate-500">@(tech.Phone ?? "—")</td>
                                <td class="text-center font-semibold text-blue-600">@tech.DefaultCommissionRate.ToString("0.##")%</td>
                                <td class="text-right">@tech.TotalDays</td>
                                <td class="text-right font-medium">@Money(tech.TotalProfit)</td>
                                <td class="text-right font-semibold text-emerald-600">@Money(tech.TotalTechnicianCut)</td>
                                <td class="text-center">
                                    @if (tech.IsArchived)
                                    {
                                        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-600">Archived</span>
                                    }
                                    else
                                    {
                                        <span class="rounded-full bg-emerald-50 px-2 py-0.5 text-[11px] font-medium text-emerald-700">Active</span>
                                    }
                                </td>
                                <td class="text-right">
                                    <button type="button" class="btn-secondary text-xs py-1 px-2.5" @onclick="() => EditTechnician(tech)">
                                        Edit
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "technician-form")]
    private TechnicianInput? Form { get; set; }

    [SupplyParameterFromQuery]
    public int? EditId { get; set; }

    private IReadOnlyList<TechnicianDto>? TechnicianList;
    private IReadOnlyList<StockLocationOption> Locations = [];
    private string? Error;
    private string? SuccessMessage;

    protected override void OnParametersSet()
    {
        Form ??= new();
    }

    protected override async Task OnInitializedAsync()
    {
        Locations = await Servicing.GetLocationsAsync(HttpContext.RequestAborted);
        await LoadTechniciansAsync();

        if (Form != null && Form.LocationId == 0 && Locations.Count > 0)
        {
            Form.LocationId = Locations[0].Id;
        }

        if (EditId is { } id and > 0 && TechnicianList != null)
        {
            var match = TechnicianList.FirstOrDefault(t => t.Id == id);
            if (match != null)
            {
                Form = new TechnicianInput
                {
                    Id = match.Id,
                    Name = match.Name,
                    Phone = match.Phone,
                    LocationId = match.LocationId,
                    DefaultCommissionRate = match.DefaultCommissionRate,
                    IsArchived = match.IsArchived
                };
            }
        }
    }

    private async Task LoadTechniciansAsync()
    {
        TechnicianList = await Servicing.GetTechniciansAsync(includeArchived: true, HttpContext.RequestAborted);
    }

    private void EditTechnician(TechnicianDto tech)
    {
        Form = new TechnicianInput
        {
            Id = tech.Id,
            Name = tech.Name,
            Phone = tech.Phone,
            LocationId = tech.LocationId,
            DefaultCommissionRate = tech.DefaultCommissionRate,
            IsArchived = tech.IsArchived
        };
        Error = null;
        SuccessMessage = null;
    }

    private async Task SaveTechnicianAsync()
    {
        Error = null;
        SuccessMessage = null;
        try
        {
            var id = await Servicing.SaveTechnicianAsync(HttpContext.User, Form!, HttpContext.RequestAborted);
            SuccessMessage = Form?.Id is { } and > 0 ? "Technician updated successfully." : "Technician added successfully.";
            Form = new TechnicianInput();
            await LoadTechniciansAsync();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
    }

    private string Money(decimal amount) => $"{amount:N2} {Configuration["CurrencyCode"] ?? "BDT"}";
}
