@page "/servicing"
@attribute [Authorize(Policy = AppPolicies.MakeSales)]
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using JASIntStoreManagement.Client.DTOs
@using JASIntStoreManagement.Client.Security
@using JASIntStoreManagement.Services
@inject ServicingService Servicing
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<PageTitle>Mobile servicing · @(Configuration["StoreName"] ?? "JAS International")</PageTitle>

<div class="page-heading">
    <div>
        <nav class="breadcrumb">
            <a href="/">Dashboard</a>
            <span>/</span>
            <span>Mobile servicing</span>
        </nav>
        <h1 class="mt-1">Mobile Servicing</h1>
        <p class="text-sm text-slate-500">Record daily servicing totals and technician profit distributions</p>
    </div>
    <div class="flex flex-wrap gap-2">
        <a href="/servicing/technicians" class="btn-secondary">
            <Icon Name="service" Class="size-4 mr-1.5" />
            Technicians & rates
        </a>
        <a href="/cash-drawer" class="btn-secondary">
            <Icon Name="wallet" Class="size-4 mr-1.5" />
            Cash drawer
        </a>
    </div>
</div>

@if (Error is not null)
{
    <p class="error-panel mb-4" role="alert">@Error</p>
}

@if (SuccessMessage is not null)
{
    <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-800 flex items-center justify-between" role="status">
        <div class="flex items-center gap-2">
            <svg class="size-5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>@SuccessMessage</span>
        </div>
        <button type="button" class="text-emerald-700 hover:text-emerald-900" @onclick="() => SuccessMessage = null">✕</button>
    </div>
}

@if (PageData is null)
{
    <LoadingPanel Message="Loading mobile servicing data…" />
}
else
{
    <!-- Filter bar: Date & Location -->
    <section class="panel mb-6 p-4">
        <form method="get" action="/servicing" class="flex flex-wrap items-center gap-4">
            <div class="flex items-center gap-2">
                <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider" for="filter-date">Date</label>
                <input id="filter-date" name="Date" type="date" class="field py-1.5 text-sm" value="@PageData.Date.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
            </div>

            @if (PageData.Locations.Count > 1)
            {
                <div class="flex items-center gap-2">
                    <label class="text-xs font-semibold text-slate-500 uppercase tracking-wider" for="filter-location">Location</label>
                    <select id="filter-location" name="LocationId" class="field py-1.5 text-sm" value="@PageData.LocationId" onchange="this.form.submit()">
                        @foreach (var loc in PageData.Locations)
                        {
                            <option value="@loc.Id">@loc.Name</option>
                        }
                    </select>
                </div>
            }
            else if (PageData.Locations.Count == 1)
            {
                <span class="text-sm text-slate-500">Location: <strong class="text-slate-800">@PageData.Locations[0].Name</strong></span>
            }

            <noscript>
                <button type="submit" class="btn-secondary text-xs">Filter</button>
            </noscript>
        </form>
    </section>

    <!-- Daily KPIs -->
    <div class="mb-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        <div class="metric">
            <p>Active Technicians</p>
            <strong>@PageData.Summary.TechnicianCount</strong>
        </div>
        <div class="metric">
            <p>Total Servicing</p>
            <strong class="text-blue-600">@Money(PageData.Summary.TotalServicingAmount)</strong>
        </div>
        <div class="metric">
            <p>Parts / Material Cost</p>
            <strong class="text-slate-600">@Money(PageData.Summary.TotalCost)</strong>
        </div>
        <div class="metric">
            <p>Technician Payouts (Upfront)</p>
            <strong class="text-indigo-600">@Money(PageData.Summary.TotalTechnicianCut)</strong>
        </div>
        <div class="metric">
            <p>Shop Servicing Profit</p>
            <strong class="text-emerald-600">@Money(PageData.Summary.TotalShopProfit)</strong>
        </div>
    </div>

    <!-- Undeposited Profit Banner & One-Click Drawer Deposit -->
    @if (PageData.Summary.UndepositedShopProfit > 0)
    {
        <div class="mb-6 rounded-xl border border-amber-200 bg-amber-50 p-5 text-amber-900 shadow-xs">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div class="flex items-start gap-3">
                    <div class="rounded-lg bg-amber-100 p-2.5 text-amber-700">
                        <Icon Name="wallet" Class="size-6" />
                    </div>
                    <div>
                        <h3 class="text-base font-semibold text-slate-900">
                            Undeposited Shop Profit: @Money(PageData.Summary.UndepositedShopProfit)
                        </h3>
                        <p class="text-xs text-slate-600 mt-1">
                            Technicians have already taken their share upfront. Before closing shift, deposit the shop's share into your physical cash drawer.
                        </p>
                    </div>
                </div>
                <form method="post" @formname="deposit-profit" @onsubmit="DepositToDrawerAsync" data-enhance data-submit-indication="true">
                    <AntiforgeryToken />
                    <button type="submit" class="btn-primary whitespace-nowrap shadow-xs py-2.5 px-4 font-semibold" data-pending-text="Depositing…">
                        Deposit @Money(PageData.Summary.UndepositedShopProfit) to Drawer
                    </button>
                </form>
            </div>
        </div>
    }

    <div class="grid gap-6 lg:grid-cols-12 items-start">
        <!-- Daily Technician Servicing Entry Form -->
        <section id="servicing-form-section" class="panel p-6 lg:col-span-5">
            <div class="mb-4">
                <h2 id="entry-form-title" class="font-semibold text-slate-900">
                    @(EntryForm?.Id is { } and > 0 ? "Edit daily servicing" : "Record technician daily totals")
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">
                    Enter the technician's total servicing collections and material costs for today.
                </p>
            </div>

            @if (PageData.Technicians.Count == 0)
            {
                <div class="rounded-xl border border-dashed border-slate-300 p-6 text-center">
                    <p class="text-sm text-slate-600 mb-3">No active technicians found.</p>
                    <a href="/servicing/technicians" class="btn-primary text-xs">Add your first technician</a>
                </div>
            }
            else
            {
                <form method="post" @formname="servicing-entry-form" @onsubmit="SaveEntryAsync" data-enhance data-submit-indication="true">
                    <AntiforgeryToken />
                    <input type="hidden" id="entry-id" name="EntryForm.Id" value="@EntryForm?.Id" />
                    <input type="hidden" name="EntryForm.Date" value="@PageData.Date.ToString("yyyy-MM-dd")" />
                    <input type="hidden" id="entry-location-id" name="EntryForm.LocationId" value="@(EntryForm?.LocationId > 0 ? EntryForm.LocationId : (PageData.LocationId ?? 0))" />

                    <div class="space-y-4">
                        <div>
                            <label class="field-label" for="entry-tech">Technician</label>
                            <select id="entry-tech" name="EntryForm.TechnicianId" class="field font-medium" value="@EntryForm?.TechnicianId" required>
                                <option value="">Select technician</option>
                                @foreach (var tech in PageData.Technicians)
                                {
                                    <option value="@tech.Id" 
                                            data-commission="@tech.DefaultCommissionRate.ToString("0.##", CultureInfo.InvariantCulture)"
                                            data-location-id="@tech.LocationId"
                                            data-location-name="@tech.LocationName">
                                        @tech.Name (@tech.LocationName, @tech.DefaultCommissionRate.ToString("0.##")% default)
                                    </option>
                                }
                            </select>
                            <p id="entry-tech-location-hint" class="text-xs text-slate-500 mt-1">
                                Assigned store: <strong class="text-slate-700" id="tech-assigned-loc">@(SelectedTechnician?.LocationName ?? (PageData.Technicians.FirstOrDefault(t => t.Id == EntryForm?.TechnicianId)?.LocationName ?? "Select technician"))</strong>
                            </p>
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="field-label" for="entry-total">Total Servicing Amount</label>
                                <input id="entry-total" name="EntryForm.TotalAmount" class="field font-semibold text-blue-700" inputmode="decimal" type="number" step="0.01" min="0" value="@((EntryForm?.TotalAmount ?? 0m) > 0 ? EntryForm!.TotalAmount.ToString("0.##", CultureInfo.InvariantCulture) : "")" placeholder="0.00" required />
                                <p class="text-[11px] text-slate-400 mt-1">Total collected from customers</p>
                            </div>
                            <div>
                                <label class="field-label" for="entry-cost">Total Material / Parts Cost</label>
                                <input id="entry-cost" name="EntryForm.TotalCost" class="field font-semibold text-slate-700" inputmode="decimal" type="number" step="0.01" min="0" value="@((EntryForm?.TotalCost ?? 0m).ToString("0.##", CultureInfo.InvariantCulture))" placeholder="0.00" />
                                <p class="text-[11px] text-slate-400 mt-1">Total spare parts cost</p>
                            </div>
                        </div>

                        <div>
                            <div class="flex items-center justify-between">
                                <label class="field-label" for="entry-commission">Commission %</label>
                                <span class="text-xs text-slate-400">Default: @(SelectedTechnician?.DefaultCommissionRate.ToString("0.##") ?? "50")%</span>
                            </div>
                            <div class="relative">
                                <input id="entry-commission" name="EntryForm.CommissionRate" class="field pr-10" inputmode="decimal" type="number" step="0.5" min="0" max="100" value="@((EntryForm?.CommissionRate ?? 50m).ToString("0.##", CultureInfo.InvariantCulture))" required />
                                <span class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-sm text-slate-400">%</span>
                            </div>
                        </div>

                        <div>
                            <label class="field-label" for="entry-notes">Notes (optional)</label>
                            <input id="entry-notes" name="EntryForm.Notes" class="field" value="@EntryForm?.Notes" maxlength="500" placeholder="Optional notes" />
                        </div>

                        <!-- Live Calculation Card (Updates on every keystroke) -->
                        <div class="rounded-xl border border-slate-200 bg-slate-50/80 p-4 text-xs space-y-2">
                            <div class="flex justify-between text-slate-600">
                                <span>Day's Profit (Servicing − Parts Cost):</span>
                                <strong id="calc-profit" class="text-slate-900 font-semibold text-sm">@Money(EntryForm?.Profit ?? 0m)</strong>
                            </div>
                            <div class="flex justify-between text-indigo-700">
                                <span id="calc-comm-label">Technician Cut (@((EntryForm?.CommissionRate ?? 50m).ToString("0.##"))% taken upfront):</span>
                                <strong id="calc-tech-cut" class="font-bold text-sm">@Money(EntryForm?.TechnicianCut ?? 0m)</strong>
                            </div>
                            <div class="flex justify-between border-t border-slate-200 pt-2 text-emerald-800 font-medium">
                                <span>Shop Profit (to Cash Drawer):</span>
                                <strong id="calc-shop-profit" class="font-black text-sm text-emerald-700">@Money(EntryForm?.ShopProfit ?? 0m)</strong>
                            </div>
                            <p id="calc-warning" class="hidden text-xs font-semibold text-amber-800 bg-amber-100 p-2 rounded-lg"></p>
                        </div>

                        <div class="flex items-center gap-2 pt-2">
                            <button id="entry-submit-btn" type="submit" class="btn-primary flex-1 py-2.5 font-semibold" data-pending-text="Saving…">
                                @(EntryForm?.Id is { } and > 0 ? "Update daily servicing" : "Save daily servicing")
                            </button>
                            <button id="entry-cancel-btn" type="button" class="btn-secondary py-2.5 @(EntryForm?.Id is { } and > 0 ? "" : "hidden")" onclick="window.cancelServicingEdit()">
                                Cancel
                            </button>
                        </div>
                    </div>
                </form>
            }
        </section>

        <!-- Today's Technician Daily Entries Table -->
        <section class="panel lg:col-span-7">
            <div class="border-b border-slate-200 px-6 py-4 flex items-center justify-between">
                <div>
                    <h2 class="font-semibold text-slate-900">Today's Technician Servicing (@PageData.Entries.Count)</h2>
                    <p class="text-xs text-slate-500 mt-0.5">Recorded for @PageData.Date.ToString("dd MMM yyyy")</p>
                </div>
            </div>

            @if (PageData.Entries.Count == 0)
            {
                <div class="p-10 text-center">
                    <div class="mx-auto mb-3 flex size-12 items-center justify-center rounded-full bg-slate-100 text-slate-400">
                        <Icon Name="service" Class="size-6" />
                    </div>
                    <p class="font-medium text-slate-800">No mobile servicing entries recorded for today</p>
                    <p class="text-xs text-slate-500 mt-1">Select a technician on the left and enter their day's total servicing amount and cost.</p>
                </div>
            }
            else
            {
                <div class="table-scroll">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Technician</th>
                                <th class="text-right">Servicing Total</th>
                                <th class="text-right">Parts Cost</th>
                                <th class="text-right">Day Profit</th>
                                <th class="text-right">Tech Cut (Upfront)</th>
                                <th class="text-right">Shop Profit</th>
                                <th class="text-center">Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in PageData.Entries)
                            {
                                <tr>
                                    <td class="font-medium text-slate-900">
                                        @entry.TechnicianName
                                        @if (!string.IsNullOrWhiteSpace(entry.Notes))
                                        {
                                            <span class="block text-[11px] text-slate-400">@entry.Notes</span>
                                        }
                                    </td>
                                    <td class="text-right font-medium text-blue-700">@Money(entry.TotalAmount)</td>
                                    <td class="text-right text-slate-600">@Money(entry.TotalCost)</td>
                                    <td class="text-right font-semibold text-slate-900">@Money(entry.Profit)</td>
                                    <td class="text-right font-semibold text-indigo-700">
                                        @Money(entry.TechnicianCut)
                                        <span class="block text-[10px] text-slate-400 font-normal">@entry.CommissionRate.ToString("0.##")%</span>
                                    </td>
                                    <td class="text-right font-black text-emerald-700">@Money(entry.ShopProfit)</td>
                                    <td class="text-center">
                                        @if (entry.IsDeposited)
                                        {
                                            <span class="badge badge-success text-[11px]">Deposited to Drawer</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-warning text-[11px]">Pending Deposit</span>
                                        }
                                    </td>
                                    <td class="text-right">
                                        @if (!entry.IsDeposited)
                                        {
                                            <div class="flex items-center justify-end gap-1.5">
                                                <button type="button" class="btn-secondary py-1 px-2 text-xs" onclick="window.editServicingEntry(@entry.Id, @entry.TechnicianId, @entry.TotalAmount.ToString(CultureInfo.InvariantCulture), @entry.TotalCost.ToString(CultureInfo.InvariantCulture), @entry.CommissionRate.ToString(CultureInfo.InvariantCulture), '@(entry.Notes?.Replace("'", "\\'"))', '@(entry.TechnicianName.Replace("'", "\\'"))')" title="Edit entry">
                                                    Edit
                                                </button>
                                                <form method="post" @formname="@($"delete-entry-{entry.Id}")" @onsubmit="() => DeleteEntryAsync(entry.Id)" class="inline" data-enhance>
                                                    <AntiforgeryToken />
                                                    <button type="submit" class="text-xs text-red-600 hover:text-red-800 p-1" title="Delete entry" onclick="return confirm('Delete servicing entry for @entry.TechnicianName?');">
                                                        ✕
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="font-semibold bg-slate-50 border-t-2 border-slate-200">
                                <td>Total (@PageData.Entries.Count technicians)</td>
                                <td class="text-right text-blue-700">@Money(PageData.Summary.TotalServicingAmount)</td>
                                <td class="text-right text-slate-700">@Money(PageData.Summary.TotalCost)</td>
                                <td class="text-right text-slate-900">@Money(PageData.Summary.TotalProfit)</td>
                                <td class="text-right text-indigo-700">@Money(PageData.Summary.TotalTechnicianCut)</td>
                                <td class="text-right text-emerald-700 font-bold">@Money(PageData.Summary.TotalShopProfit)</td>
                                <td colspan="2"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </section>
    </div>

    <!-- Currency & Daily entries state for real-time client-side calculation -->
    <script>
        window.__STORE_CURRENCY__ = '@(Configuration["CurrencyCode"] ?? "BDT")';
        window.__TODAY_SERVICING_ENTRIES__ = {
            @foreach (var entry in PageData.Entries)
            {
                @:@entry.TechnicianId: { id: @entry.Id, technicianId: @entry.TechnicianId, technicianName: '@(entry.TechnicianName.Replace("'", "\\'"))', totalAmount: @entry.TotalAmount.ToString(CultureInfo.InvariantCulture), totalCost: @entry.TotalCost.ToString(CultureInfo.InvariantCulture), commissionRate: @entry.CommissionRate.ToString(CultureInfo.InvariantCulture), isDeposited: @(entry.IsDeposited ? "true" : "false"), notes: '@(entry.Notes?.Replace("'", "\\'"))' },
            }
        };
        if (typeof window.updateServicingCalculations === 'function') {
            window.updateServicingCalculations();
        }
    </script>
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "servicing-entry-form")]
    private MobileServicingEntryInput? EntryForm { get; set; }

    [SupplyParameterFromQuery]
    public int? LocationId { get; set; }

    [SupplyParameterFromQuery]
    public string? Date { get; set; }

    private MobileServicingPageData? PageData;
    private TechnicianDto? SelectedTechnician;
    private string? Error;
    private string? SuccessMessage;

    protected override void OnParametersSet()
    {
        EntryForm ??= new();
    }

    protected override async Task OnInitializedAsync()
    {
        DateOnly? selectedDate = null;
        if (!string.IsNullOrWhiteSpace(Date) && DateOnly.TryParseExact(Date, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var d))
        {
            selectedDate = d;
        }

        await LoadDataAsync(selectedDate, LocationId);

        if (PageData != null && EntryForm != null && EntryForm.TechnicianId == 0 && PageData.Technicians.Count > 0)
        {
            var firstTech = PageData.Technicians.First();
            EntryForm.TechnicianId = firstTech.Id;
            EntryForm.CommissionRate = firstTech.DefaultCommissionRate;
            SelectedTechnician = firstTech;
        }
    }

    private async Task LoadDataAsync(DateOnly? date, int? locationId)
    {
        Error = null;
        PageData = await Servicing.GetMobileServicingPageDataAsync(HttpContext.User, date, locationId, HttpContext.RequestAborted);
        if (EntryForm != null)
        {
            if (EntryForm.LocationId == 0 && PageData.LocationId.HasValue)
            {
                EntryForm.LocationId = PageData.LocationId.Value;
            }
            EntryForm.Date = PageData.Date;
        }
    }

    private async Task SaveEntryAsync()
    {
        Error = null;
        SuccessMessage = null;
        try
        {
            if (EntryForm == null || PageData == null) return;
            EntryForm.Date = PageData.Date;
            var tech = PageData.Technicians.FirstOrDefault(t => t.Id == EntryForm.TechnicianId);
            if (tech != null)
            {
                EntryForm.LocationId = tech.LocationId;
            }
            else if (EntryForm.LocationId <= 0)
            {
                EntryForm.LocationId = PageData.LocationId ?? 0;
            }
            var isUpdate = EntryForm.Id is { } and > 0;
            var entryId = await Servicing.SaveMobileServicingEntryAsync(HttpContext.User, EntryForm, HttpContext.RequestAborted);

            var profit = EntryForm.Profit;
            var techCut = EntryForm.TechnicianCut;
            var shopProfit = EntryForm.ShopProfit;

            SuccessMessage = isUpdate
                ? $"Updated daily servicing for {tech?.Name ?? "Technician"}: Profit {Money(profit)} (Technician cut: {Money(techCut)}, Shop profit: {Money(shopProfit)})."
                : $"Recorded daily servicing for {tech?.Name ?? "Technician"}: Profit {Money(profit)} (Technician cut: {Money(techCut)}, Shop profit: {Money(shopProfit)}). Staged for drawer deposit.";

            EntryForm = new MobileServicingEntryInput
            {
                LocationId = PageData.LocationId ?? 0,
                Date = PageData.Date,
                CommissionRate = 50m
            };

            await LoadDataAsync(PageData.Date, PageData.LocationId);
        }
        catch (ValidationException ex)
        {
            Error = ex.Message;
        }
        catch (Exception ex)
        {
            Error = "Failed to save mobile servicing entry: " + ex.Message;
        }
    }

    private async Task DeleteEntryAsync(int entryId)
    {
        Error = null;
        SuccessMessage = null;
        try
        {
            await Servicing.DeleteMobileServicingEntryAsync(HttpContext.User, entryId, HttpContext.RequestAborted);
            SuccessMessage = "Servicing entry deleted.";
            await LoadDataAsync(PageData?.Date, PageData?.LocationId);
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
    }

    private async Task DepositToDrawerAsync()
    {
        Error = null;
        SuccessMessage = null;
        try
        {
            if (PageData?.LocationId == null)
            {
                throw new ValidationException("No location selected for drawer deposit.");
            }

            var result = await Servicing.DepositServicingProfitAsync(
                HttpContext.User,
                PageData.Date,
                PageData.LocationId.Value,
                HttpContext.RequestAborted);

            SuccessMessage = $"Successfully deposited {Money(result.DepositedAmount)} servicing profit ({result.EntriesCount} technicians) into active cash drawer.";
            await LoadDataAsync(PageData.Date, PageData.LocationId);
        }
        catch (ValidationException ex)
        {
            Error = ex.Message;
        }
        catch (Exception ex)
        {
            Error = "Deposit failed: " + ex.Message;
        }
    }

    private string Money(decimal amount) => $"{amount:N2} {Configuration["CurrencyCode"] ?? "BDT"}";
}
