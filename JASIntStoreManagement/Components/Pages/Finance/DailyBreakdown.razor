<section class="panel mt-6">
    <div class="panel-heading">
        <div>
            <h2>Day activity · @Date.ToString("dd MMM yyyy")</h2>
            <p class="mt-1 text-xs text-slate-500">Active payments only. Corrections replace the original posting; internal cash transfers are excluded.</p>
        </div>
    </div>
    @if (Data.TechnicianServicing.Count > 0)
    {
        <div class="border-b border-slate-200 p-5">
            <div class="flex items-center justify-between mb-3">
                <h3 class="font-semibold text-slate-900">Technicians · Servicing breakdown</h3>
                <a href="/servicing?date=@Date.ToString("yyyy-MM-dd")" class="text-xs font-semibold text-blue-700 hover:underline">Manage servicing</a>
            </div>
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Technician</th>
                            <th>Store Location</th>
                            <th class="text-right">Total Servicing</th>
                            <th class="text-right">Parts Cost</th>
                            <th class="text-right">Technician Cut (Upfront)</th>
                            <th class="text-right">Shop Profit (to Drawer)</th>
                            <th class="text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tech in Data.TechnicianServicing)
                        {
                            <tr>
                                <td class="font-medium text-slate-900">@tech.TechnicianName</td>
                                <td class="text-slate-600">@tech.LocationName</td>
                                <td class="text-right tabular-nums font-semibold text-blue-700">@Money(tech.TotalServicing)</td>
                                <td class="text-right tabular-nums text-slate-700">@Money(tech.TotalCost)</td>
                                <td class="text-right tabular-nums text-indigo-700">@Money(tech.TechnicianCut)</td>
                                <td class="text-right tabular-nums font-bold text-emerald-700">@Money(tech.ShopProfit)</td>
                                <td class="text-center">
                                    @if (tech.IsDeposited)
                                    {
                                        <span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-[11px] font-semibold text-emerald-700">
                                            Deposited in drawer
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-[11px] font-semibold text-amber-700">
                                            Pending deposit
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="2">Total (@Data.TechnicianServicing.Count @(Data.TechnicianServicing.Count == 1 ? "technician" : "technicians"))</th>
                            <td class="text-right font-bold tabular-nums text-blue-700">@Money(Data.TechnicianServicing.Sum(t => t.TotalServicing))</td>
                            <td class="text-right font-bold tabular-nums text-slate-700">@Money(Data.TechnicianServicing.Sum(t => t.TotalCost))</td>
                            <td class="text-right font-bold tabular-nums text-indigo-700">@Money(Data.TechnicianServicing.Sum(t => t.TechnicianCut))</td>
                            <td class="text-right font-bold tabular-nums text-emerald-700">@Money(Data.TechnicianServicing.Sum(t => t.ShopProfit))</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
    <div class="grid gap-6 p-5 lg:grid-cols-2">
        <div>
            <h3 class="mb-3 font-semibold">Expenses by category</h3>
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th class="text-right">Spent</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in Data.Categories)
                        {
                            <tr>
                                <td>@(category.Name ?? category.Category.ToString())</td>
                                <td class="text-right">@Money(category.Amount)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>Total expenses</th>
                            <td class="text-right">@Money(Data.Categories.Sum(category => category.Amount))</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
        <div>
            <h3 class="mb-3 font-semibold">Payments at a glance</h3>
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Activity</th>
                            <th class="text-right">In</th>
                            <th class="text-right">Out</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var group in Groups)
                        {
                            <tr>
                                <td>@group.Key</td>
                                <td class="text-right">@Money(group.Where(row => row.Amount > 0).Sum(row => row.Amount))</td>
                                <td class="text-right">@Money(-group.Where(row => row.Amount < 0).Sum(row => row.Amount))</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>Total cash & bank</th>
                            <td class="text-right">@Money(Data.Payments.Where(row => row.Amount > 0).Sum(row => row.Amount))</td>
                            <td class="text-right">@Money(-Data.Payments.Where(row => row.Amount < 0).Sum(row => row.Amount))</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
    @foreach (var group in Groups)
    {
        <details class="day-payment-group" open="@(group.Key == "Supplier payments")">
            <summary>
                <span>@group.Key <small>· @group.Count() payments</small></span>
                <strong>@Money(group.Sum(row => row.Amount))</strong>
            </summary>
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Recorded at</th>
                            <th>Account / person</th>
                            <th>Cash location / bank</th>
                            <th>Method</th>
                            <th>Notes</th>
                            <th class="text-right">Received</th>
                            <th class="text-right">Paid out</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in group)
                        {
                            <tr>
                                <td>@payment.At.ToBusinessTime(Configuration).ToString("dd MMM, HH:mm")</td>
                                <td>@(string.IsNullOrEmpty(payment.Party) ? "—" : payment.Party)</td>
                                <td>@payment.Account</td>
                                <td>@SplitPayments.MethodName(payment.Method)</td>
                                <td>@payment.Notes</td>
                                <td class="text-right text-emerald-700">@(payment.Amount > 0 ? Money(payment.Amount) : "—")</td>
                                <td class="text-right">@(payment.Amount < 0 ? Money(-payment.Amount) : "—")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="5">@group.Key total</th>
                            <td class="text-right">@Money(group.Where(row => row.Amount > 0).Sum(row => row.Amount))</td>
                            <td class="text-right">@Money(-group.Where(row => row.Amount < 0).Sum(row => row.Amount))</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </details>
    }
    @if (Data.Payments.Count == 0)
    {
        <p class="p-5 text-sm text-slate-500">No payments recorded for this day.</p>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public DailyFinanceDetails Data { get; set; } = default!;

    [Parameter]
    public DateOnly Date { get; set; }

    private IEnumerable<IGrouping<string, DayPayment>> Groups => Data.Payments.GroupBy(payment => payment.Type).OrderBy(group => group.Key);
    private string Money(decimal amount) => $"{Configuration["CurrencyCode"] ?? "BDT"} {amount:N2}";
}
