<section class="mt-6">
    @if (Data.SelectedLocationName != null)
    {
        <div class="mb-4 flex items-center justify-between rounded-xl border border-blue-200 bg-blue-50/70 p-3.5 text-blue-900">
            <div class="flex items-center gap-2 text-sm font-medium">
                <svg class="h-4 w-4 text-blue-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span>Filtered to: <strong>@Data.SelectedLocationName</strong> (Showing location sales & stock received)</span>
            </div>
            <a href="@($"/finance/month?month={MonthDate:yyyy-MM}")" class="btn-secondary text-xs">View all locations</a>
        </div>
    }
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-xl font-bold tracking-tight text-slate-900">Monthly Business Summary</h2>
        <details class="no-print relative">
            <summary class="btn-secondary cursor-pointer text-xs select-none">Adjust Opening Assets</summary>
            <div class="absolute right-0 z-30 mt-2 w-96 rounded-2xl border border-slate-200 bg-white p-5 shadow-xl text-left">
                <h4 class="mb-1 font-semibold text-slate-900">Month Opening Assets</h4>
                <p class="mb-4 text-xs text-slate-500">Configure or correct opening asset figures for this month. New months auto-inherit from previous month closing.</p>
                <form method="post" @formname="opening-assets" data-enhance data-submit-indication="true">
                    <AntiforgeryToken />
                    <input type="hidden" name="OpeningInput.Month" value="@MonthDate.ToString("yyyy-MM-01")" />
                    <input type="hidden" name="Action" value="save-opening-assets" />
                    <div class="space-y-2.5 text-xs">
                        <div>
                            <label class="block font-medium text-slate-700">Opening Stock Value</label>
                            <input type="number" step="0.01" name="OpeningInput.OpeningStock" class="field text-sm" value="@Data.OpeningAssets.Stock" required />
                        </div>
                        <div>
                            <label class="block font-medium text-slate-700">Opening Cash in Drawers</label>
                            <input type="number" step="0.01" name="OpeningInput.OpeningCash" class="field text-sm" value="@Data.OpeningAssets.Cash" required />
                        </div>
                        <div>
                            <label class="block font-medium text-slate-700">Opening Bank Balance</label>
                            <input type="number" step="0.01" name="OpeningInput.OpeningBank" class="field text-sm" value="@Data.OpeningAssets.Bank" required />
                        </div>
                        <div>
                            <label class="block font-medium text-slate-700">Opening Supplier Due (Payable)</label>
                            <input type="number" step="0.01" name="OpeningInput.OpeningSupplierDue" class="field text-sm" value="@Data.OpeningAssets.SupplierDue" required />
                        </div>
                        <div>
                            <label class="block font-medium text-slate-700">Opening Customer Due (Receivable)</label>
                            <input type="number" step="0.01" name="OpeningInput.OpeningCustomerDue" class="field text-sm" value="@Data.OpeningAssets.CustomerDue" required />
                        </div>
                        <div>
                            <label class="block font-medium text-slate-700">Opening Lender Debt</label>
                            <input type="number" step="0.01" name="OpeningInput.OpeningDebt" class="field text-sm" value="@Data.OpeningAssets.Debt" required />
                        </div>
                    </div>
                    <div class="mt-4 flex justify-end gap-2">
                        <button type="submit" class="btn-primary text-xs">Save Opening Assets</button>
                    </div>
                </form>
            </div>
        </details>
    </div>
    <div class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <!-- Card 1: Present Office Cash -->
        <div class="flex flex-col justify-between rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs transition hover:shadow-sm">
            <div>
                <div class="flex items-center justify-between">
                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Present office cash</span>
                    <span class="rounded-md bg-blue-50 px-2 py-0.5 text-[11px] font-semibold text-blue-700">Funds</span>
                </div>
                <div class="mt-2 text-2xl font-bold tracking-tight text-slate-900 tabular-nums">
                    @Money(Data.ClosingAssets.Cash + Data.ClosingAssets.Bank)
                </div>
                <p class="mt-0.5 text-[11px] text-slate-400">Total available closing funds</p>
            </div>
            <div class="mt-4 border-t border-slate-100 pt-3 space-y-1.5 text-xs">
                <div class="flex justify-between items-center text-slate-600">
                    <span>Physical cash in drawers:</span>
                    <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.ClosingAssets.Cash)</span>
                </div>
                <div class="flex justify-between items-center text-slate-600">
                    <span>Bank / digital balance:</span>
                    <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.ClosingAssets.Bank)</span>
                </div>
            </div>
        </div>

        <!-- Card 2: Due & Pay Status -->
        <div class="flex flex-col justify-between rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs transition hover:shadow-sm">
            <div>
                <div class="flex items-center justify-between">
                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Due & pay status</span>
                    <span class="rounded-md bg-amber-50 px-2 py-0.5 text-[11px] font-semibold text-amber-700">Suppliers</span>
                </div>
                <div class="mt-2 text-2xl font-bold tracking-tight text-slate-900 tabular-nums">
                    @Money(Data.TotalSupplierPaid)
                </div>
                <p class="mt-0.5 text-[11px] text-slate-400">Total supplier payments made</p>
            </div>
            <div class="mt-4 border-t border-slate-100 pt-3 space-y-1.5 text-xs">
                <div class="flex justify-between items-center text-slate-600">
                    <span>Suppliers due (payable):</span>
                    <span class="font-semibold text-rose-600 tabular-nums">@Money(Data.ClosingAssets.SupplierDue)</span>
                </div>
                <div class="flex justify-between items-center text-slate-600">
                    <span>Customer due (receivable):</span>
                    <span class="font-semibold text-emerald-700 tabular-nums">@Money(Data.ClosingAssets.CustomerDue)</span>
                </div>
                <div class="flex justify-between items-center text-slate-600">
                    <span>Stock received (tStok In):</span>
                    <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.TotalStockReceived)</span>
                </div>
            </div>
        </div>

        <!-- Card 3: Sales Status -->
        <div class="flex flex-col justify-between rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs transition hover:shadow-sm">
            <div>
                <div class="flex items-center justify-between">
                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Sales status</span>
                    <span class="rounded-md bg-emerald-50 px-2 py-0.5 text-[11px] font-semibold text-emerald-700">Trading</span>
                </div>
                <div class="mt-2 text-2xl font-bold tracking-tight text-slate-900 tabular-nums">
                    @Money(Data.TotalSales)
                </div>
                <p class="mt-0.5 text-[11px] text-slate-400">Net revenue after discounts</p>
            </div>
            <div class="mt-4 border-t border-slate-100 pt-3 space-y-1.5 text-xs">
                <div class="flex justify-between items-center text-slate-600">
                    <span>Sales profit (margin):</span>
                    <span class="font-semibold text-emerald-700 tabular-nums">@Money(Data.SalesProfit)</span>
                </div>
                <div class="flex justify-between items-center text-slate-600">
                    <span>Total spend (expenses + payroll):</span>
                    <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.TotalSpend)</span>
                </div>
                <div class="flex justify-between items-center text-slate-600">
                    <span>Net trading result:</span>
                    <span class="font-semibold tabular-nums @(Data.NetProfit >= 0 ? "text-emerald-700" : "text-rose-600")">@Money(Data.NetProfit)</span>
                </div>
            </div>
        </div>

        <!-- Card 4: Asset Built & Equity -->
        <div class="flex flex-col justify-between rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs transition hover:shadow-sm">
            <div>
                <div class="flex items-center justify-between">
                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Asset built & equity</span>
                    <span class="rounded-md bg-indigo-50 px-2 py-0.5 text-[11px] font-semibold text-indigo-700">Equity</span>
                </div>
                <div class="mt-2 text-2xl font-bold tracking-tight tabular-nums @(Data.AssetGrowth >= 0 ? "text-emerald-700" : "text-rose-600")">
                    @Money(Data.AssetGrowth)
                </div>
                <p class="mt-0.5 text-[11px] text-slate-400">Net asset growth this month</p>
            </div>
            <div class="mt-4 border-t border-slate-100 pt-3 space-y-1.5 text-xs">
                <div class="flex justify-between items-center text-slate-600">
                    <span>Opening net assets:</span>
                    <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.OpeningAssets.NetAssets)</span>
                </div>
                <div class="flex justify-between items-center text-slate-600">
                    <span>Closing net assets:</span>
                    <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.ClosingAssets.NetAssets)</span>
                </div>
            </div>
        </div>
    </div>

    @if (Data.SelectedLocationName == null && Data.LocationBreakdown.Count > 0)
    {
        <!-- Stock Locations Multi-Store Performance Section -->
        <section class="panel mb-6 table-scroll">
            <div class="panel-heading">
                <div>
                    <h3 class="font-semibold text-slate-900">Stock Locations · Multi-Store Performance</h3>
                    <p class="mt-0.5 text-xs text-slate-500">Sales, margins, stock deliveries, and on-hand inventory values across all shop branches and warehouses.</p>
                </div>
            </div>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Store Location</th>
                        <th class="text-right">Net Sales</th>
                        <th class="text-right">Cost of Goods</th>
                        <th class="text-right">Sales Profit</th>
                        <th class="text-right">Margin %</th>
                        <th class="text-right">Stock Received (tStok In)</th>
                        <th class="text-right">Stock Inventory Value</th>
                        <th class="text-right no-print">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var loc in Data.LocationBreakdown)
                    {
                        var margin = loc.Sales > 0 ? (loc.SalesProfit / loc.Sales * 100) : 0m;
                        <tr>
                            <td class="font-medium text-slate-900">@loc.LocationName</td>
                            <td class="text-right tabular-nums">@Money(loc.Sales)</td>
                            <td class="text-right tabular-nums">@Money(loc.Cogs)</td>
                            <td class="text-right tabular-nums font-semibold text-emerald-700">@Money(loc.SalesProfit)</td>
                            <td class="text-right tabular-nums">@margin.ToString("0.#")%</td>
                            <td class="text-right tabular-nums">@Money(loc.StockReceived)</td>
                            <td class="text-right tabular-nums font-medium text-slate-900">@Money(loc.StockValue)</td>
                            <td class="text-right no-print">
                                <a href="@($"/finance/month?month={MonthDate:yyyy-MM}&locationId={loc.LocationId}")" class="text-xs font-semibold text-blue-700 hover:underline">Filter store</a>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th>Total (@Data.LocationBreakdown.Count @(Data.LocationBreakdown.Count == 1 ? "location" : "locations"))</th>
                        <td class="text-right font-bold tabular-nums">@Money(Data.LocationBreakdown.Sum(l => l.Sales))</td>
                        <td class="text-right font-bold tabular-nums">@Money(Data.LocationBreakdown.Sum(l => l.Cogs))</td>
                        <td class="text-right font-bold tabular-nums text-emerald-700">@Money(Data.LocationBreakdown.Sum(l => l.SalesProfit))</td>
                        <td class="text-right font-bold tabular-nums">
                            @{
                                var totalSales = Data.LocationBreakdown.Sum(l => l.Sales);
                                var totalProfit = Data.LocationBreakdown.Sum(l => l.SalesProfit);
                                var avgMargin = totalSales > 0 ? totalProfit / totalSales * 100 : 0m;
                            }
                            @avgMargin.ToString("0.#")%
                        </td>
                        <td class="text-right font-bold tabular-nums">@Money(Data.LocationBreakdown.Sum(l => l.StockReceived))</td>
                        <td class="text-right font-bold tabular-nums">@Money(Data.LocationBreakdown.Sum(l => l.StockValue))</td>
                        <td class="no-print"></td>
                    </tr>
                </tfoot>
            </table>
        </section>
    }

    <!-- Working Days Table -->
    <section class="panel mb-6 table-scroll">
        <div class="panel-heading">
            <div>
                <h3 class="font-semibold text-slate-900">Working days of the month</h3>
                <p class="mt-0.5 text-xs text-slate-500">Only days with recorded business activity or opened cash drawers are shown. Expand any day's expenses to see its category breakdown.</p>
            </div>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th class="text-right">Sales</th>
                    <th class="text-right">Sales profit</th>
                    <th class="text-right">Supplier paid</th>
                    <th class="text-right">Stock received</th>
                    <th class="text-right">Expenses</th>
                    <th class="text-right">Payroll paid</th>
                    <th class="text-right">Total spend</th>
                    <th class="text-right">Stock variance</th>
                    <th class="text-right">Net result</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var day in Data.Days)
                {
                    <tr>
                        <td>
                            <a href="@($"/finance/day?date={day.Date:yyyy-MM-dd}")" class="font-medium text-blue-700 hover:underline">@day.Date.ToString("dd MMM, ddd")</a>
                        </td>
                        <td class="text-right tabular-nums">@Money(day.Sales)</td>
                        <td class="text-right tabular-nums text-emerald-700 font-medium">@Money(day.SalesProfit)</td>
                        <td class="text-right tabular-nums">@Money(day.SupplierPaid)</td>
                        <td class="text-right tabular-nums">@Money(day.StockReceived)</td>
                        <td class="text-right tabular-nums">
                            <span>@Money(day.Expenses)</span>
                            @if (day.ExpenseCategories.Count > 0)
                            {
                                <details class="text-left mt-1 text-xs">
                                    <summary class="cursor-pointer text-blue-600 hover:underline select-none">
                                        @day.ExpenseCategories.Count @(day.ExpenseCategories.Count == 1 ? "category" : "categories")
                                    </summary>
                                    <div class="mt-1 p-2 bg-slate-50 rounded border border-slate-200 shadow-sm space-y-1">
                                        @foreach (var cat in day.ExpenseCategories)
                                        {
                                            <div class="flex justify-between gap-3">
                                                <span class="text-slate-600">@(cat.Name ?? (cat.Category == ExpenseCategory.Refreshments ? "Snacks / refreshments" : cat.Category.ToString()))</span>
                                                <span class="font-semibold tabular-nums">@Money(cat.Amount)</span>
                                            </div>
                                        }
                                    </div>
                                </details>
                            }
                        </td>
                        <td class="text-right tabular-nums">@Money(day.Payroll)</td>
                        <td class="text-right tabular-nums">@Money(day.TotalSpend)</td>
                        <td class="text-right tabular-nums">@Money(day.StockVariance)</td>
                        <td class="text-right tabular-nums font-medium @(day.NetProfit >= 0 ? "text-emerald-700" : "text-rose-600")">@Money(day.NetProfit)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th>Total (@Data.Days.Count @(Data.Days.Count == 1 ? "day" : "days"))</th>
                    <td class="text-right font-bold tabular-nums">@Money(Data.TotalSales)</td>
                    <td class="text-right font-bold tabular-nums text-emerald-700">@Money(Data.SalesProfit)</td>
                    <td class="text-right font-bold tabular-nums">@Money(Data.TotalSupplierPaid)</td>
                    <td class="text-right font-bold tabular-nums">@Money(Data.TotalStockReceived)</td>
                    <td class="text-right font-bold tabular-nums">@Money(Data.Expenses)</td>
                    <td class="text-right font-bold tabular-nums">@Money(Data.Payroll)</td>
                    <td class="text-right font-bold tabular-nums">@Money(Data.TotalSpend)</td>
                    <td class="text-right font-bold tabular-nums">@Money(Data.StockVariance)</td>
                    <td class="text-right font-bold tabular-nums @(Data.NetProfit >= 0 ? "text-emerald-700" : "text-rose-600")">@Money(Data.NetProfit)</td>
                </tr>
            </tfoot>
        </table>
        <p class="p-4 text-xs text-slate-500">Sales are net of returns and discounts. Sales profit subtracts the cost of the goods sold. Idle non-working days without transactions are hidden.</p>
    </section>

    <!-- Suppliers Breakdown Section -->
    <section class="panel mb-6 table-scroll">
        <div class="panel-heading">
            <div>
                <h3 class="font-semibold text-slate-900">Suppliers · Stock deliveries & payments</h3>
                <p class="mt-0.5 text-xs text-slate-500">Total payments made and stock value received for each supplier during this month.</p>
            </div>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Supplier</th>
                    <th class="text-right">Stock Received (tStok In)</th>
                    <th class="text-right">Payments Paid (supPayment)</th>
                    <th class="text-right">Current Balance / Due</th>
                </tr>
            </thead>
            <tbody>
                @if (Data.Suppliers.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="p-4 text-center text-xs text-slate-400">No supplier deliveries or payments recorded for this month.</td>
                    </tr>
                }
                else
                {
                    @foreach (var supplier in Data.Suppliers)
                    {
                        <tr>
                            <td class="font-medium text-slate-900">@supplier.SupplierName</td>
                            <td class="text-right tabular-nums">@Money(supplier.StockReceived)</td>
                            <td class="text-right tabular-nums font-medium text-blue-700">@Money(supplier.PaymentsMade)</td>
                            <td class="text-right tabular-nums font-semibold @(supplier.CurrentDue > 0 ? "text-rose-600" : "text-slate-700")">@Money(supplier.CurrentDue)</td>
                        </tr>
                    }
                }
            </tbody>
            @if (Data.Suppliers.Count > 0)
            {
                <tfoot>
                    <tr>
                        <th>Total (@Data.Suppliers.Count suppliers)</th>
                        <td class="text-right font-bold tabular-nums">@Money(Data.Suppliers.Sum(s => s.StockReceived))</td>
                        <td class="text-right font-bold tabular-nums text-blue-700">@Money(Data.Suppliers.Sum(s => s.PaymentsMade))</td>
                        <td class="text-right font-bold tabular-nums text-rose-600">@Money(Data.Suppliers.Sum(s => s.CurrentDue))</td>
                    </tr>
                </tfoot>
            }
        </table>
    </section>

    <div class="mb-6 grid items-start gap-6 lg:grid-cols-2">
        <section class="panel table-scroll">
            <div class="panel-heading">
                <h3 class="font-semibold text-slate-900">Expenses by category</h3>
            </div>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th class="text-right">Spent</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Data.Categories)
                    {
                        <tr>
                            <td>@(category.Name ?? (category.Category == ExpenseCategory.Refreshments ? "Snacks / refreshments" : category.Category.ToString()))</td>
                            <td class="text-right tabular-nums">@Money(category.Amount)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th>Total expenses</th>
                        <td class="text-right font-bold tabular-nums">@Money(Data.Expenses)</td>
                    </tr>
                </tfoot>
            </table>
        </section>
        <section class="panel table-scroll">
            <div class="panel-heading">
                <h3 class="font-semibold text-slate-900">Money taken by each employee</h3>
            </div>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th class="text-right">Salary</th>
                        <th class="text-right">Salary paid</th>
                        <th class="text-right">Bonus</th>
                        <th class="text-right">Advance</th>
                        <th class="text-right">Total taken</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var employee in Data.Employees)
                    {
                        <tr>
                            <td>@employee.Employee</td>
                            <td class="text-right tabular-nums">@(employee.Salary is { } salary ? Money(salary) : "Not created")</td>
                            <td class="text-right tabular-nums">@Money(employee.SalaryPaid)</td>
                            <td class="text-right tabular-nums">@Money(employee.BonusPaid)</td>
                            <td class="text-right tabular-nums">@Money(employee.AdvancePaid)</td>
                            <td class="text-right tabular-nums font-semibold">@Money(employee.TotalPaid)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="5">Total payroll paid</th>
                        <td class="text-right font-bold tabular-nums">@Money(Data.Payroll)</td>
                    </tr>
                </tfoot>
            </table>
            <p class="p-4 text-xs text-slate-500">Includes money paid during this calendar month, including payments against older salaries. Applying an old advance moves no new money.</p>
        </section>
    </div>
    <section class="panel table-scroll">
        <div class="panel-heading">
            <h3 class="font-semibold text-slate-900">Business assets · opening versus closing</h3>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Asset / liability</th>
                    <th class="text-right">Opening</th>
                    <th class="text-right">Closing</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in AssetRows)
                {
                    <tr>
                        <td>@row.Label</td>
                        <td class="text-right tabular-nums">@Money(row.Opening)</td>
                        <td class="text-right tabular-nums">@Money(row.Closing)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th>Net assets</th>
                    <td class="text-right font-bold tabular-nums">@Money(Data.OpeningAssets.NetAssets)</td>
                    <td class="text-right font-bold tabular-nums">@Money(Data.ClosingAssets.NetAssets)</td>
                </tr>
                <tr>
                    <th colspan="2">Assets built / reduced this month</th>
                    <td class="text-right font-bold tabular-nums @(Data.AssetGrowth >= 0 ? "text-emerald-700" : "text-rose-600")">@Money(Data.AssetGrowth)</td>
                </tr>
            </tfoot>
        </table>
        <p class="p-4 text-xs text-slate-500">Stock value = quantity on hand × average cost across all locations, including warehouses. Opening balances are before the month starts; closing balances include entries through the selected month. Net assets = stock + cash + bank − supplier due + customer due − lender debt.</p>
    </section>
</section>

@code {
    [Parameter, EditorRequired]
    public MonthlyFinanceDetails Data { get; set; } = default!;

    [Parameter]
    public DateOnly MonthDate { get; set; }

    private (string Label, decimal Opening, decimal Closing)[] AssetRows =>
    [
        ("Stock value", Data.OpeningAssets.Stock, Data.ClosingAssets.Stock),
        ("Physical cash", Data.OpeningAssets.Cash, Data.ClosingAssets.Cash),
        ("Bank / digital balance", Data.OpeningAssets.Bank, Data.ClosingAssets.Bank),
        ("Supplier due (subtract)", Data.OpeningAssets.SupplierDue, Data.ClosingAssets.SupplierDue),
        ("Customer due (add)", Data.OpeningAssets.CustomerDue, Data.ClosingAssets.CustomerDue),
        ("Lender debt (subtract)", Data.OpeningAssets.Debt, Data.ClosingAssets.Debt)
    ];

    private string Money(decimal amount) => $"{Configuration["CurrencyCode"] ?? "BDT"} {amount:N2}";
}
