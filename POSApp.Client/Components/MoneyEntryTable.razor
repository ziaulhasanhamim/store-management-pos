@using POSApp.Client.DTOs

<div class="table-scroll">
    <table class="data-table">
        <thead>
            <tr>
                <th>Entry</th>
                <th>@PartyLabel</th>
                <th>Method</th>
                <th>Notes</th>
                <th class="text-right">Amount</th>
                <th>
                    <span class="sr-only">Edit</span>
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Loading)
            {
                <tr>
                    <td colspan="6" class="p-6 text-center" role="status">
                        <span class="form-submit-spinner"></span>
                        Loading entries…
                    </td>
                </tr>
            }
            else
            {
            @foreach (var row in Rows)
            {
                <tr @key="row.Id">
                    <td>
                        <span>#@row.Id</span>
                        @if (row.PurchaseId is not null)
                        {
                            <a href="@($"/receiving/{row.PurchaseId.Value}")" class="mt-1 block text-xs text-blue-700">Receipt #@row.PurchaseId.Value</a>
                        }
                    </td>
                    <td>
                        <div>@(PartyLabel == "Category" ? row.Category : row.Party)</div>
                        @if (!string.IsNullOrWhiteSpace(row.StockLocationName))
                        {
                            <span class="inline-block mt-0.5 text-xs text-slate-500 font-normal">@row.StockLocationName</span>
                        }
                    </td>
                    <td>@SplitPayments.MethodName(row.Method)</td>
                    <td>
                        <span>@row.Notes</span>
                        @if (!string.IsNullOrWhiteSpace(row.Receipt))
                        {
                            <span class="mt-1 block text-xs text-slate-400">@row.Receipt</span>
                        }
                    </td>
                    <td class="text-right whitespace-nowrap">@row.Amount.ToString("N2") @Currency</td>
                    <td>
                        @if (row.CanEdit)
                        {
                            <div class="flex items-center gap-1.5">
                                @if (ConfirmingVoidId == row.Id)
                                {
                                    <button type="button" class="btn-secondary text-xs bg-rose-50! text-rose-700! border-rose-300!"
                                            @onclick="() => ExecuteVoid(row)" disabled="@(Disabled || PendingIds.Contains(row.Id))">
                                        Confirm void
                                    </button>
                                    <button type="button" class="btn-secondary text-xs text-slate-500!"
                                            @onclick="() => ConfirmingVoidId = null">
                                        Cancel
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn-secondary text-xs" @onclick="() => OnEdit.InvokeAsync(row)"
                                            disabled="@(Disabled || PendingIds.Contains(row.Id))">
                                        Edit
                                    </button>
                                    @if (AllowVoid)
                                    {
                                        <button type="button" class="btn-secondary text-xs text-rose-600! hover:text-rose-700! hover:border-rose-300!"
                                                @onclick="() => ConfirmingVoidId = row.Id"
                                                disabled="@(Disabled || PendingIds.Contains(row.Id))"
                                                title="Void payment and restore balance">
                                            Void
                                        </button>
                                    }
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-xs text-slate-400">@row.LockedReason</span>
                        }
                    </td>
                </tr>
            }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<MoneyEntryRow> Rows { get; set; } = [];

    [Parameter]
    public string PartyLabel { get; set; } = "Category";

    [Parameter]
    public string Currency { get; set; } = "BDT";

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public IReadOnlySet<int> PendingIds { get; set; } = new HashSet<int>();

    [Parameter]
    public EventCallback<MoneyEntryRow> OnEdit { get; set; }

    [Parameter]
    public bool AllowVoid { get; set; }

    [Parameter]
    public EventCallback<MoneyEntryRow> OnVoid { get; set; }

    private int? ConfirmingVoidId;

    private async Task ExecuteVoid(MoneyEntryRow row)
    {
        ConfirmingVoidId = null;
        await OnVoid.InvokeAsync(row);
    }
}
