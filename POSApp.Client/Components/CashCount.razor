@using System.Globalization

@{
    var initialValue = Value?.ToString("0.00", CultureInfo.InvariantCulture) ?? "";
    decimal? diff = Value.HasValue ? Value.Value - Expected : null;
}

<label class="field-label" for="counted-cash">Counted cash (@Currency)</label>
<input id="counted-cash" name="@FieldName" class="field" type="text" inputmode="decimal"
       data-select-on-focus="true" required="@Required" pattern="[0-9]+([.][0-9]{1,2})?"
       value="@initialValue"
       data-cash-count data-expected="@Expected.ToString("0.00", CultureInfo.InvariantCulture)" data-currency="@Currency" />

<p class="mt-3 text-sm font-semibold @(diff is null ? "hidden" : diff == 0 ? "text-emerald-700" : "text-amber-700")"
   data-cash-count-diff role="status">
    @if (diff.HasValue)
    {
        @($"{(diff == 0 ? "Balanced" : diff < 0 ? "Shortage" : "Overage")} · {Currency} {Math.Abs(diff.Value).ToString("N2")}")
    }
</p>

@code {
    [Parameter]
    public decimal Expected { get; set; }

    [Parameter]
    public string Currency { get; set; } = "BDT";

    [Parameter]
    public string FieldName { get; set; } = "Close.ActualCash";

    [Parameter]
    public bool Required { get; set; } = true;

    [Parameter]
    public decimal? Value { get; set; }
}
