<th class="@(Numeric ? "text-right" : null)" aria-sort="@(Sort == Column ? "ascending" : Sort == Column + "-desc" ? "descending" : "none")">
    <button type="button" class="table-sort" disabled="@Disabled" @onclick="ToggleAsync">
        <span>@Label</span>
        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true" class="sort-icon">
            <path d="M8 2 12 6H4Z" opacity="@(Sort == Column ? "1" : ".3")" />
            <path d="m8 14 4-4H4Z" opacity="@(Sort == Column + "-desc" ? "1" : ".3")" />
        </svg>
    </button>
</th>

@code {
    private Task ToggleAsync() => Changed.InvokeAsync(Sort == Column ? Column + "-desc" : Column);

    [Parameter]
    public string Column { get; set; } = "";
    [Parameter]
    public string Label { get; set; } = "";
    [Parameter]
    public string Sort { get; set; } = "";
    [Parameter]
    public bool Numeric { get; set; }
    [Parameter]
    public bool Disabled { get; set; }
    [Parameter]
    public EventCallback<string> Changed { get; set; }
}
