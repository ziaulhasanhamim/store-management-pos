<form method="get" action="@($"/items/{ProductId}")" data-enhance class="flex min-w-48 flex-col gap-2">
    <label class="text-xs text-slate-500" for="history-location">Stock location</label>
    <select id="history-location" name="locationId" class="field" onchange="this.form.requestSubmit()">
        @foreach (var location in Locations)
        {
            <option value="@location.Id" selected="@(location.Id == SelectedLocationId)">
                @location.Name@(location.IsDeleted ? " (Archived)" : "")
            </option>
        }
    </select>
</form>

@code {
    [Parameter]
    public int ProductId { get; set; }

    [Parameter]
    public ProductStockLocation[] Locations { get; set; } = [];

    [Parameter]
    public int? SelectedLocationId { get; set; }
}
