@using System.ComponentModel.DataAnnotations
@using POSApp.Client.Services
@inject IAttributeDefinitionClient AttributeDefinitionsClient

<div class="grid items-start gap-6 xl:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)]">
    <section class="panel p-5">
        <h2 class="mb-4 font-semibold">@(Input.Id == 0 ? "Create an attribute" : $"Edit {Input.DisplayName}")</h2>
        <EditForm Model="Input" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <label class="field-label" for="attribute-key">Import key</label>
                    <InputText id="attribute-key" class="field" @bind-Value="Input.Key" placeholder="warranty" maxlength="80" />
                    <ValidationMessage For="() => Input.Key" />
                </div>
                <div>
                    <label class="field-label" for="attribute-name">Display name</label>
                    <InputText id="attribute-name" class="field" @bind-Value="Input.DisplayName" placeholder="Warranty" maxlength="120" />
                    <ValidationMessage For="() => Input.DisplayName" />
                </div>
            </div>

            <div class="mt-4">
                <label class="field-label" for="attribute-kind">Value type</label>
                <InputSelect id="attribute-kind" class="field" @bind-Value="Input.Kind" @bind-Value:after="KindChanged">
                    <option value="Text">Text</option>
                    <option value="Select">Select option</option>
                    <option value="Checkbox">Checkbox</option>
                    <option value="Number">Number</option>
                </InputSelect>
            </div>

            @if (Input.Kind == "Select")
            {
                <section class="mt-4 rounded-xl border border-slate-200 p-4">
                    <div class="mb-3 flex items-center justify-between gap-3">
                        <div>
                            <h3 class="text-sm font-semibold">Select options</h3>
                            <p class="mt-1 text-xs text-slate-500">Add each choice as its own row.</p>
                        </div>
                        <button type="button" class="btn-secondary" @onclick="AddOption">
                            <Icon Name="plus" />
                            Add another option
                        </button>
                    </div>
                    @for (var index = 0; index < Input.Options.Count; index++)
                    {
                        var optionIndex = index;
                        <div class="mb-3 grid gap-3 sm:grid-cols-[1fr_1fr_auto]">
                            <div>
                                <label class="field-label" for="@OptionValueId(optionIndex)">Option value</label>
                                <InputText id="@OptionValueId(optionIndex)" class="field" @bind-Value="Input.Options[optionIndex].Value" maxlength="120" placeholder="6-months" />
                            </div>
                            <div>
                                <label class="field-label" for="@OptionNameId(optionIndex)">Display name</label>
                                <InputText id="@OptionNameId(optionIndex)" class="field" @bind-Value="Input.Options[optionIndex].DisplayName" maxlength="120" placeholder="6 Months" />
                            </div>
                            <button type="button" class="btn-secondary self-end" aria-label="Remove option" @onclick="() => RemoveOption(optionIndex)">
                                <Icon Name="trash" />
                            </button>
                        </div>
                    }
                </section>
            }

            @if (Input.Kind == "Number")
            {
                <fieldset class="mt-4 rounded-xl border border-slate-200 p-4">
                    <legend class="px-1 text-sm font-semibold">Number rules</legend>
                    <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
                        <label class="flex items-center gap-2"><InputCheckbox @bind-Value="Input.AllowFraction" /> Allow fractions</label>
                        <label class="flex items-center gap-2"><InputCheckbox @bind-Value="Input.NonNegative" /> Zero or above</label>
                    </div>
                </fieldset>
            }

            <fieldset class="mt-5 rounded-xl border border-slate-200 p-4">
                <legend class="px-1 text-sm font-semibold">Show this attribute on</legend>
                <div class="grid gap-2 text-sm sm:grid-cols-2">
                    <label class="flex items-center gap-2"><InputCheckbox @bind-Value="Input.ShowInItems" /> Items page</label>
                    <label class="flex items-center gap-2"><InputCheckbox @bind-Value="Input.ShowInSales" /> Sales</label>
                    <label class="flex items-center gap-2"><InputCheckbox @bind-Value="Input.ShowInReceiving" /> Receiving</label>
                    <label class="flex items-center gap-2"><InputCheckbox @bind-Value="Input.ShowInStockAdjustment" /> Stock adjustment</label>
                </div>
            </fieldset>

            @if (Error is not null)
            {
                <p class="error-panel mt-4" role="alert">@Error</p>
            }
            @if (Saved)
            {
                <p class="success-panel mt-4" role="status">Attribute created and ready to use on products.</p>
            }

            <button type="submit" class="btn-primary mt-5" disabled="@Saving" data-submit-indication="true" data-pending-text="Saving…">
                <Icon Name="@(Input.Id == 0 ? "plus" : "check")" />
                @(Saving ? "Saving…" : Input.Id == 0 ? "Create attribute" : "Save changes")
            </button>
            @if (Input.Id != 0)
            {
                <button type="button" class="btn-secondary mt-5" @onclick="ResetForm" disabled="@Saving">Cancel edit</button>
            }
        </EditForm>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>Configured attributes</h2>
            <span class="badge">@Definitions.Count</span>
        </div>
        @if (Loading)
        {
            <p class="p-5 text-sm text-slate-500">Loading attributes…</p>
        }
        else if (Definitions.Count == 0)
        {
            <p class="p-5 text-sm text-slate-500">No product attributes configured yet.</p>
        }
        else
        {
            <div class="divide-y divide-slate-100">
                @foreach (var definition in Definitions)
                {
                    <article class="p-5">
                        <div class="flex flex-wrap items-start justify-between gap-2">
                            <div>
                                <h3 class="font-semibold text-slate-900">@definition.DisplayName</h3>
                                <p class="mt-1 font-mono text-xs text-slate-500">@definition.Key · @definition.Kind</p>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="badge">@(definition.ShowInItems ? "Items" : "Hidden on items")</span>
                                <button type="button" class="icon-button" aria-label="Edit @definition.DisplayName" title="Edit attribute" @onclick="() => BeginEdit(definition)">
                                    <Icon Name="edit" />
                                </button>
                            </div>
                        </div>
                        @if (definition.Options.Count > 0)
                        {
                            <p class="mt-2 text-xs text-slate-600">Options: @string.Join(", ", definition.Options.Select(option => option.DisplayName))</p>
                        }
                        <p class="mt-2 text-xs text-slate-500">Shown in: @Visibility(definition)</p>
                    </article>
                }
            </div>
        }
    </section>
</div>

@code {
    private ProductAttributeDefinitionInput Input = new();
    private IReadOnlyList<ProductAttributeDefinitionOption> Definitions = [];
    private bool Loading = true;
    private bool Saving;
    private bool Saved;
    private string? Error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Definitions = await AttributeDefinitionsClient.ReadAsync();
        }
        catch (Exception exception)
        {
            Error = ErrorMessage(exception);
        }
        finally
        {
            Loading = false;
        }
    }

    private void KindChanged()
    {
        Saved = false;
        Error = null;

        if (Input.Kind == "Select")
        {
            if (Input.Options.Count == 0)
            {
                Input.Options.Add(new());
            }
        }
        else
        {
            Input.Options.Clear();
        }

        if (Input.Kind != "Number")
        {
            Input.AllowFraction = false;
            Input.NonNegative = false;
        }
    }

    private void AddOption() => Input.Options.Add(new());

    private void BeginEdit(ProductAttributeDefinitionOption definition)
    {
        Input = new ProductAttributeDefinitionInput
        {
            Id = definition.Id,
            Key = definition.Key,
            DisplayName = definition.DisplayName,
            Kind = definition.Kind,
            AllowFraction = definition.AllowFraction,
            NonNegative = definition.NonNegative,
            ShowInItems = definition.ShowInItems,
            ShowInSales = definition.ShowInSales,
            ShowInReceiving = definition.ShowInReceiving,
            ShowInStockAdjustment = definition.ShowInStockAdjustment,
            Options = definition.Options.Select(option => new ProductAttributeOptionInput
            {
                Value = option.Value,
                DisplayName = option.DisplayName
            }).ToList()
        };
        Saved = false;
        Error = null;
    }

    private void ResetForm()
    {
        Input = new();
        Saved = false;
        Error = null;
    }

    private void RemoveOption(int index)
    {
        if (index >= 0 && index < Input.Options.Count)
        {
            Input.Options.RemoveAt(index);
        }
    }

    private async Task SaveAsync()
    {
        if (Saving)
        {
            return;
        }

        Saving = true;
        Saved = false;
        Error = null;

        try
        {
            await AttributeDefinitionsClient.SaveAsync(Input);
            Definitions = await AttributeDefinitionsClient.ReadAsync();
            Input = new();
            Saved = true;
        }
        catch (Exception exception)
        {
            Error = ErrorMessage(exception);
        }
        finally
        {
            Saving = false;
        }
    }

    private static string ErrorMessage(Exception exception) => exception is InventoryRequestException or ValidationException
        ? exception.Message
        : "Could not load or save attributes. Please try again.";

    private static string Visibility(ProductAttributeDefinitionOption definition)
    {
        var pages = new List<string>();
        if (definition.ShowInItems) pages.Add("items");
        if (definition.ShowInSales) pages.Add("sales");
        if (definition.ShowInReceiving) pages.Add("receiving");
        if (definition.ShowInStockAdjustment) pages.Add("stock adjustment");
        return pages.Count == 0 ? "not shown on any page" : string.Join(", ", pages);
    }

    private static string OptionValueId(int index) => $"option-value-{index}";

    private static string OptionNameId(int index) => $"option-name-{index}";
}
