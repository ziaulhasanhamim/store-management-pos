<form method="get" action="/items" data-enhance class="w-full">
    @if (!string.IsNullOrWhiteSpace(Search))
    {
        <input type="hidden" name="search" value="@Search" />
    }
    @if (!string.IsNullOrWhiteSpace(Sort))
    {
        <input type="hidden" name="sort" value="@Sort" />
    }
    <label for="items-location" class="field-label">Stock location</label>
    <select id="items-location" name="locationId" class="field" onchange="this.form.requestSubmit()">
        @foreach (var location in Locations)
        {
            <option value="@location.Id" selected="@(location.Id == SelectedLocationId)">
                @location.Name
            </option>
        }
    </select>
</form>

@code {
    [Parameter]
    public Lookup[] Locations { get; set; } = [];

    [Parameter]
    public int? SelectedLocationId { get; set; }

    [Parameter]
    public string? Search { get; set; }

    [Parameter]
    public string? Sort { get; set; }
}
