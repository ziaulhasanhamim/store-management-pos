@implements IAsyncDisposable
@inject ISalesClient Sales
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div @onkeydown="HandleShortcutAsync">
<div class="mb-3 flex items-center justify-between">
    <button type="button" id="pos-shortcuts-btn" @onclick="() => ShowShortcuts = true" class="inline-flex items-center gap-1.5 text-xs text-slate-500 hover:text-slate-800 transition-colors">
        <kbd class="rounded border border-slate-300 bg-slate-100 px-1.5 py-0.5 font-mono text-[10px] font-semibold text-slate-700 shadow-xs">F1</kbd>
        <span>Keyboard shortcuts</span>
    </button>
</div>

<LocalDraft TState="SalesEditorState" Kind="sales" State="DraftState" Empty="@(Lines.Count == 0 && string.IsNullOrWhiteSpace(Notes) && Discount == 0)" Paused="Busy" Restore="RestoreDraft" Clear="NewSale" ReadyChanged="@(ready => DraftReady = ready)" @ref="Recovery" />

@if (Error is not null)
{
    <p class="error-panel" role="alert">@Error</p>
}
@if (Notice is not null)
{
    <p class="success-panel" role="status">@Notice</p>
}
<fieldset disabled="@(!RendererInfo.IsInteractive || !DraftReady || Busy)" inert="@(CustomerDialog || CameraDialog)" class="min-w-0">
    <div class="grid items-start gap-6 xl:grid-cols-[minmax(0,1fr)_360px]">
        <section class="panel min-w-0">
            <div class="space-y-4 border-b border-slate-100 p-5">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <h2 class="font-semibold">Sale items</h2>
                    <select class="field w-auto!" aria-label="Stock location" value="@LocationId" @onchange="ChangeLocationAsync" disabled="@(Lines.Count > 0)">
                        @foreach (var location in Options.Locations)
                        {
                            <option value="@location.Id">@location.Name</option>
                        }
                    </select>
                </div>
                <div class="flex gap-2">
                    <input class="field flex-1" id="pos-search-input" aria-label="Search products or scan barcode"
                           placeholder="Scan barcode or search products…" autocomplete="off"
                           @bind="Search" @bind:event="oninput" @bind:after="SearchChangedAsync"
                           @onkeydown="SearchKeyAsync" @ref="SearchField" />
                    <button type="button" class="btn-secondary" @onclick="OpenCamera" aria-label="Scan with camera">
                        <Icon Name="camera" />
                    </button>
                </div>
                <label class="flex items-center gap-2 text-sm text-slate-600">
                    <input type="checkbox" @bind="ReturnMode" />
                    Add scanned / selected items as returns
                </label>
                @if (ReturnMode)
                {
                    <div class="rounded-xl border border-amber-200 bg-amber-50/60 p-3 sm:p-4 space-y-2.5">
                        <p class="text-xs text-amber-800">Use original unit prices for returns. You can also look up an original sale receipt to load its items automatically.</p>
                        <div class="flex flex-col sm:flex-row sm:items-end gap-2">
                            <div class="flex-1">
                                <label class="field-label text-amber-900" for="return-receipt-search">Original Receipt Number</label>
                                <input id="return-receipt-search" class="field bg-white" placeholder="e.g. SAL-1001" @bind="ReturnReceiptSearch" @onkeydown="ReturnReceiptKeyAsync" />
                            </div>
                            <button type="button" class="btn-secondary text-xs sm:text-sm px-4 py-2.5 whitespace-nowrap" disabled="@(string.IsNullOrWhiteSpace(ReturnReceiptSearch) || Busy)" @onclick="LookupReturnReceiptAsync">
                                @(LookingUpReceipt ? "Looking up…" : "Lookup Receipt")
                            </button>
                        </div>
                        @if (ReturnReceiptError is not null)
                        {
                            <p class="text-xs text-red-600">@ReturnReceiptError</p>
                        }
                        @if (LoadedReturnBill is not null)
                        {
                            <div class="rounded-lg border border-amber-300 bg-white p-2.5 text-xs text-slate-700 flex flex-wrap items-center justify-between gap-2">
                                <div>
                                    <strong class="text-slate-900">@LoadedReturnBill.Number</strong>
                                    <span class="text-slate-500 ml-1">(@LoadedReturnBill.Lines.Length items · Total @Money(LoadedReturnBill.Total))</span>
                                    @if (!string.IsNullOrWhiteSpace(LoadedReturnBill.Customer))
                                    {
                                        <span class="block text-slate-500 mt-0.5">Customer: @LoadedReturnBill.Customer</span>
                                    }
                                </div>
                                <button type="button" class="btn-primary text-xs px-3 py-1.5" @onclick="LoadReturnLinesAsync" disabled="@Busy">
                                    Load as Return Items
                                </button>
                            </div>
                        }
                    </div>
                }
                @if (Searching)
                {
                    <p class="text-xs text-slate-500" role="status">Searching…</p>
                }
                @if (!string.IsNullOrWhiteSpace(Search))
                {
                    <div class="max-h-64 divide-y divide-slate-100 overflow-y-auto rounded-lg border border-slate-200">
                        @for (var i = 0; i < Products.Count; i++)
                        {
                            var product = Products[i];
                            var isSelected = i == SelectedProductIndex;
                            <button type="button"
                                    id="@($"sales-search-result-{i}")"
                                    data-search-selected="@(isSelected ? "true" : "false")"
                                    class="flex w-full items-center justify-between gap-4 p-3 text-left transition-colors @(isSelected ? "bg-blue-100 ring-2 ring-inset ring-blue-500 font-medium" : "hover:bg-blue-50")"
                                    @onclick="() => SelectProductAsync(product)">
                                <span>
                                    <strong class="block text-sm text-slate-900">@product.Name</strong>
                                    <span class="mt-0.5 flex flex-wrap items-center gap-2 text-xs text-slate-500">
                                        <span>@(product.Barcode ?? "No barcode") · @(product.IsNonStocked ? "Non-stocked" : $"{product.Available:0.###} {product.Unit}")</span>
                                        @foreach (var itemAttribute in product.Attributes.Where(itemAttribute => itemAttribute.ShowInSales))
                                        {
                                            <span class="inline-flex items-center rounded bg-slate-100 px-1.5 py-0.5 text-[11px] font-medium text-slate-600">
                                                @itemAttribute.DisplayName: @itemAttribute.Value
                                            </span>
                                        }
                                    </span>
                                </span>
                                <strong class="text-sm text-blue-700 shrink-0">@Money(product.Price)</strong>
                            </button>
                        }
                        @if (!Searching && Products.Count == 0)
                        {
                            <p class="p-3 text-sm text-slate-500">No matching products.</p>
                        }
                    </div>
                }
            </div>
            @if (Lines.Count == 0)
            {
                <div class="empty-state">
                    <Icon Name="box" />
                    <p>Scan a barcode or search to add your first item.</p>
                </div>
            }
            else
            {
                <div class="table-scroll">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Quantity</th>
                                <th>Unit price</th>
                                <th class="text-right">Amount</th>
                                <th>
                                    <span class="sr-only">Remove</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var index = 0; index < Lines.Count; index++)
                            {
                                var line = Lines[index];
                                var isLastItem = (index == 0);
                                <tr @key="line.Key" class="@(line.Key == LastScannedLineKey ? "bg-emerald-50/80 transition-colors" : "")">
                                    <td>
                                        <strong class="block min-w-32 text-slate-900">@line.Product.Name</strong>
                                        @if (line.Quantity < 0)
                                        {
                                            <span class="badge mt-1">Return</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(line.Product.Barcode))
                                        {
                                            <span class="mt-1 block font-mono text-xs text-slate-500">@line.Product.Barcode</span>
                                        }
                                        <span class="mt-1 block text-xs text-slate-400">@(line.Product.IsNonStocked ? "Non-stocked" : $"{line.Product.Available:0.###} {line.Product.Unit} on hand")</span>
                                        @if (line.Product.Attributes.Any(a => a.ShowInSales))
                                        {
                                            <div class="mt-1 flex flex-wrap gap-1">
                                                @foreach (var itemAttribute in line.Product.Attributes.Where(itemAttribute => itemAttribute.ShowInSales))
                                                {
                                                    <span class="inline-flex items-center rounded bg-slate-100 px-1.5 py-0.5 text-[11px] font-medium text-slate-600">@itemAttribute.DisplayName: @itemAttribute.Value</span>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <DecimalField id="@(isLastItem ? "pos-last-line-qty" : null)" class="field min-w-24" @bind-Value="line.Quantity"
                                                      Minimum="-999999999999999.999m"
                                                      Maximum="999999999999999.999m" DecimalPlaces="@(line.Product.AllowFractionUnit ? 3 : 0)"
                                                      ValidityChanged="valid => line.QuantityValid = valid" aria-label="@($"Quantity for {line.Product.Name}")" />
                                    </td>
                                    <td>
                                        <DecimalField id="@(isLastItem ? "pos-last-line-price" : null)" class="field min-w-28" @bind-Value="line.Price"
                                                      ValidityChanged="valid => line.PriceValid = valid" aria-label="@($"Unit price for {line.Product.Name}")" />
                                    </td>
                                    <td class="text-right whitespace-nowrap font-semibold">@Money(line.Total)</td>
                                    <td>
                                        <button type="button" class="icon-button" aria-label="Remove @line.Product.Name" @onclick="() => Lines.Remove(line)">
                                            <Icon Name="trash" />
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <div class="border-t border-slate-100 p-5">
                <input class="field" placeholder="Notes (optional)" aria-label="Sale notes" @bind="Notes" />
            </div>
        </section>
        <section class="panel xl:sticky xl:top-6" id="checkout-section">
            <div class="panel-heading">
                <h2>Checkout</h2>
                <Icon Name="wallet" />
            </div>
            <div class="space-y-5 p-5">
                <div class="flex items-end gap-2">
                    <label class="min-w-0 flex-1">
                        <span class="field-label">Customer</span>
                        <select class="field" aria-label="Customer" @bind="CustomerId">
                            <option value="">Walk-in customer</option>
                            @foreach (var customer in Options.Customers)
                            {
                                <option value="@customer.Id">@customer.Name · Due @Money(customer.Balance)</option>
                            }
                        </select>
                    </label>
                    <button type="button" class="btn-secondary px-3!" aria-label="Add customer" @onclick="OpenCustomer">
                        <Icon Name="plus" />
                    </button>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-slate-500">Subtotal</span>
                    <strong>@Money(Subtotal)</strong>
                </div>
                <label class="block">
                    <span class="field-label">Order discount (@Currency)</span>
                    <DecimalField @key="(RequestId, DiscountRevision)" class="field" @bind-Value="Discount"
                                  Maximum="DiscountLimit" ValidityChanged="valid => DiscountValid = valid" />
                </label>
                <div class="flex justify-between border-t border-slate-100 pt-4 text-xl font-bold">
                    <span>Total</span>
                    <span>@Money(Total)</span>
                </div>
                <SplitPayments @key="(RequestId, Total < 0)" Total="Math.Abs(Total)" Currency="@Currency" Refund="@(Total < 0)" AllowCashChange="@(Total > 0)" @bind-Payments="Payments" />
                @if (!PaymentsValid)
                {
                    <p class="text-sm text-red-600" role="alert">Review confirmed payments after changing the order total.</p>
                }
                @if (WalkInUnsettled)
                {
                    <p class="text-xs text-slate-500">Select a customer to leave a due or credit balance.</p>
                }
                @if (Options.CanBackdate)
                {
                    <div class="rounded-xl border border-blue-200 bg-blue-50/70 p-3 space-y-1.5">
                        <label class="block">
                            <span class="field-label text-blue-900">Transaction Date & Time (Admin Backdate)</span>
                            <input type="datetime-local" class="field bg-white mt-1" @bind="CustomTransactionTime" />
                        </label>
                        <p class="text-[11px] text-blue-700">Leave blank for current time. Backfills land on earlier dates without interrupting live sales.</p>
                    </div>
                }
                <button type="button" id="pos-submit-btn" class="btn-primary w-full" disabled="@(Invalid || WalkInUnsettled)" @onclick="() => SaveAsync(true)">
                    @if (Busy)
                    {
                        <span class="form-submit-spinner"></span>
                    }
                    Complete sale
                </button>
                <div class="grid grid-cols-2 gap-2">
                    <button type="button" class="btn-secondary" disabled="@(Invalid || Busy)" @onclick="() => SaveAsync(false)">
                        @if (Busy)
                        {
                            <span class="form-submit-spinner"></span>
                        }
                        Save draft
                    </button>
                    <button type="button" class="btn-secondary" disabled="@Busy" @onclick="() => Recovery!.RequestResetAsync()">New sale</button>
                </div>
                @if (Options.Drafts.Length > 0)
                {
                    <div class="space-y-1.5">
                        <span class="field-label">Drafts (@Options.Drafts.Length)</span>
                        <div class="flex items-center gap-2">
                            <select class="field flex-1" value="@(IsCurrentDraft ? RequestId.ToString() : "")" @onchange="ResumeAsync">
                                <option value="">Choose draft to resume…</option>
                                @foreach (var draft in Options.Drafts)
                                {
                                    <option value="@draft.RequestId">@draft.Number · @draft.Customer · @Money(draft.Total)</option>
                                }
                            </select>
                            @if (IsCurrentDraft)
                            {
                                <button type="button" class="btn-secondary text-xs text-red-600 hover:text-red-700 hover:border-red-300 px-3 py-2.5 whitespace-nowrap" disabled="@Busy" @onclick="DiscardActiveDraftAsync" title="Discard this uncompleted draft">
                                    Discard
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>
    </div>
</fieldset>
@if (CustomerDialog)
{
    <Modal Title="Add customer" Busy="Busy" OnClose="CloseDialogsAsync">
        @if (CustomerError is not null)
        {
            <p class="error-panel" role="alert">@CustomerError</p>
        }
        <label class="block">
            Name
            <input class="field mt-1 w-full" @bind="CustomerName" maxlength="200" />
        </label>
        <label class="mt-3 block">
            Phone
            <input class="field mt-1 w-full" @bind="CustomerPhone" />
        </label>
        @if (Options.CanSetOpeningBalance)
        {
            <label class="mt-3 block">
                Opening due / credit (@Currency)
                <DecimalField class="field mt-1 w-full" @bind-Value="CustomerOpening" Minimum="-9999999999999999.99m" />
            </label>
        }
        <button type="button" class="btn-primary mt-4" disabled="@(Busy || string.IsNullOrWhiteSpace(CustomerName))" @onclick="AddCustomerAsync">
            @if (Busy)
            {
                <span class="form-submit-spinner"></span>
            }
            Save customer
        </button>
    </Modal>
}
@if (CameraDialog)
{
    <Modal Title="Scan barcode" OnClose="CloseDialogsAsync">
        <video class="w-full rounded-xl" autoplay muted playsinline @ref="Video"></video>
        @if (CameraError is not null)
        {
            <p class="error-panel mt-3" role="alert">@CameraError</p>
        }
    </Modal>
}

@if (ShowShortcuts)
{
    <Modal Title="Keyboard Shortcuts (POS)" OnClose="() => ShowShortcuts = false">
        <div class="space-y-3 text-sm">
            <div class="flex items-center justify-between py-2 border-b border-slate-100">
                <span class="text-slate-700">Search product / scan barcode</span>
                <div class="flex items-center gap-1.5 flex-wrap justify-end">
                    <kbd class="px-2 py-0.5 rounded border border-slate-300 bg-slate-100 font-mono text-xs font-semibold">F2</kbd>
                    <span class="text-xs text-slate-400">or</span>
                    <kbd class="px-2 py-0.5 rounded border border-slate-300 bg-slate-100 font-mono text-xs font-semibold">Alt+S</kbd>
                    <span class="text-xs text-slate-500 font-medium">(⌥S on Mac)</span>
                </div>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-slate-100">
                <span class="text-slate-700">Edit last item quantity</span>
                <div class="flex items-center gap-1.5 flex-wrap justify-end">
                    <kbd class="px-2 py-0.5 rounded border border-slate-300 bg-slate-100 font-mono text-xs font-semibold">F3</kbd>
                    <span class="text-xs text-slate-400">or</span>
                    <kbd class="px-2 py-0.5 rounded border border-slate-300 bg-slate-100 font-mono text-xs font-semibold">Alt+Q</kbd>
                    <span class="text-xs text-slate-500 font-medium">(⌥Q on Mac)</span>
                </div>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-slate-100">
                <span class="text-slate-700">Edit last item unit price</span>
                <div class="flex items-center gap-1.5 flex-wrap justify-end">
                    <kbd class="px-2 py-0.5 rounded border border-slate-300 bg-slate-100 font-mono text-xs font-semibold">F4</kbd>
                    <span class="text-xs text-slate-400">or</span>
                    <kbd class="px-2 py-0.5 rounded border border-slate-300 bg-slate-100 font-mono text-xs font-semibold">Alt+P</kbd>
                    <span class="text-xs text-slate-500 font-medium">(⌥P on Mac)</span>
                </div>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-slate-100">
                <span class="text-slate-700">Jump to payment amount</span>
                <div class="flex items-center gap-1.5 flex-wrap justify-end">
                    <kbd class="px-2 py-0.5 rounded border border-slate-300 bg-slate-100 font-mono text-xs font-semibold">F8</kbd>
                    <span class="text-xs text-slate-400">or</span>
                    <kbd class="px-2 py-0.5 rounded border border-slate-300 bg-slate-100 font-mono text-xs font-semibold">Alt+M</kbd>
                    <span class="text-xs text-slate-500 font-medium">(⌥M on Mac)</span>
                </div>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-slate-100">
                <span class="text-slate-700">Complete sale</span>
                <div class="flex items-center gap-1.5 flex-wrap justify-end">
                    <kbd class="px-2 py-0.5 rounded border border-slate-300 bg-slate-100 font-mono text-xs font-semibold">F9</kbd>
                    <span class="text-xs text-slate-400">or</span>
                    <kbd class="px-2 py-0.5 rounded border border-slate-300 bg-slate-100 font-mono text-xs font-semibold">Ctrl+Enter</kbd>
                    <span class="text-xs text-slate-500 font-medium">(⌘Enter on Mac)</span>
                </div>
            </div>
            <div class="flex items-center justify-between py-2">
                <span class="text-slate-700">Toggle shortcuts guide</span>
                <div class="flex items-center gap-1.5 flex-wrap justify-end">
                    <kbd class="px-2 py-0.5 rounded border border-slate-300 bg-slate-100 font-mono text-xs font-semibold">F1</kbd>
                    <span class="text-xs text-slate-400">or</span>
                    <kbd class="px-2 py-0.5 rounded border border-slate-300 bg-slate-100 font-mono text-xs font-semibold">?</kbd>
                </div>
            </div>
        </div>
        <div class="mt-6 flex justify-end">
            <button type="button" class="btn-primary" @onclick="() => ShowShortcuts = false">Got it</button>
        </div>
    </Modal>
}

@if (Lines.Count > 0)
{
    <aside class="xl:hidden fixed bottom-0 inset-x-0 z-30 border-t border-slate-200 bg-white/95 px-4 py-3 shadow-lg backdrop-blur-md">
        <div class="flex items-center justify-between gap-3">
            <div>
                <span class="block text-xs text-slate-500">Total (@Lines.Count @(Lines.Count == 1 ? "item" : "items"))</span>
                <strong class="text-lg font-bold text-slate-900">@Money(Total)</strong>
            </div>
            <button type="button" @onclick="ScrollToCheckoutAsync" class="btn-primary py-2 px-4 text-sm font-semibold shadow-sm">
                Pay / Checkout →
            </button>
        </div>
    </aside>
}


</div>
