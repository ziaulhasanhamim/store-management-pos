@page "/items"
@attribute [Authorize]
@attribute [StreamRendering]
@using Microsoft.AspNetCore.Authorization
@using POSApp.Components.Pages.Reports
@inject InventoryService Inventory
@inject NavigationManager Navigation
@inject IAuthorizationService AuthService
@inject ILogger<Index> Logger

<PageTitle>Items · @(Configuration["StoreName"] ?? "RetailPOS")</PageTitle>

<div class="page-heading">
    <div>
        <p class="eyebrow">Inventory</p>
        <h1>Items</h1>
    </div>

    <AuthorizeView Policy="@AppPolicies.ManageInventory">
        <div class="flex flex-wrap items-center gap-2">
            <a href="/items/categories" class="btn-secondary text-xs sm:text-sm px-3 sm:px-4 py-2 sm:py-2.5">Categories</a>
            <a href="/items/attributes" class="btn-secondary text-xs sm:text-sm px-3 sm:px-4 py-2 sm:py-2.5">Attributes</a>
            <a href="/items/bulk-edit" class="btn-secondary text-xs sm:text-sm px-3 sm:px-4 py-2 sm:py-2.5">Bulk edit</a>
            <a href="/items/import" class="btn-secondary text-xs sm:text-sm px-3 sm:px-4 py-2 sm:py-2.5">Import JSON</a>
            <a href="/items/new" class="btn-primary text-xs sm:text-sm px-3 sm:px-5 py-2 sm:py-2.5">
                <Icon Name="plus" />
                Add item
            </a>
        </div>
    </AuthorizeView>
</div>

<div class="mb-4 sm:mb-6 w-full max-w-xs">
    <ItemLocationSelector Locations="@Locations.ToArray()"
                          SelectedLocationId="@LocationId"
                          Search="@Search"
                          Sort="@Sort" />
</div>

<AuthorizeView Policy="@AppPolicies.MakeSales">
    <details class="mb-5 rounded-xl border border-slate-200 bg-white p-3 sm:p-4">
        <summary class="cursor-pointer font-semibold text-indigo-700 text-xs sm:text-sm">Export items · choose columns</summary>
        <form method="get" action="/api/reports/export/products" class="mt-3" data-enhance="false">
            <input type="hidden" name="search" value="@Search" />
            <input type="hidden" name="locationId" value="@LocationId" />
            <div class="mb-3 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-4">
                @foreach (var column in ExportColumns)
                {
                    <label class="flex items-center gap-2 text-xs sm:text-sm text-slate-700">
                        <input type="checkbox" name="columns" value="@column" checked />
                        <span class="truncate">@column</span>
                    </label>
                }
            </div>
            <button type="submit" class="btn-secondary text-xs sm:text-sm">Download CSV</button>
        </form>
    </details>
</AuthorizeView>

<section class="panel w-full min-w-0">
    <div class="panel-heading p-3 sm:px-5 sm:py-4">
        <form action="/items" method="get" class="flex w-full flex-wrap items-end gap-3" data-enhance data-auto-search="true">
            <input type="hidden" name="sort" value="@Sort" />
            <input type="hidden" name="direction" value="@Direction" />
            <input type="hidden" name="locationId" value="@LocationId" />
            <input type="hidden" name="category" value="@Category" />
            <input type="hidden" name="supplier" value="@Supplier" />
            <input type="hidden" name="minStock" value="@MinStock" />
            <input type="hidden" name="pageSize" value="@(PageSize <= 0 ? 30 : PageSize)" />
            <div class="w-full sm:max-w-lg">
                <label for="items-search" class="field-label">Search items</label>
                <div class="flex items-center gap-2 sm:gap-3">
                    <Icon Name="search" />
                    <input id="items-search" name="search" value="@Search" class="field" placeholder="Search name, category, supplier, barcode or ID" data-auto-search="true" autocomplete="off" data-permanent />
                </div>
            </div>
            @if (HasActiveFilters)
            {
                <div class="flex items-center flex-wrap gap-2 text-xs">
                    <span class="text-slate-500 font-medium">Filtered by:</span>
                    @if (!string.IsNullOrWhiteSpace(Category))
                    {
                        <a href="@ClearFilterUrl("category")" data-enhance class="inline-flex items-center gap-1 rounded-full bg-blue-50 px-2.5 py-0.5 text-blue-700 hover:bg-blue-100 font-medium" title="Remove category filter">
                            <span>Category: "@Category"</span>
                            <span class="font-bold">×</span>
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(Supplier))
                    {
                        <a href="@ClearFilterUrl("supplier")" data-enhance class="inline-flex items-center gap-1 rounded-full bg-blue-50 px-2.5 py-0.5 text-blue-700 hover:bg-blue-100 font-medium" title="Remove supplier filter">
                            <span>Supplier: "@Supplier"</span>
                            <span class="font-bold">×</span>
                        </a>
                    }
                    @if (MinStock.HasValue)
                    {
                        <a href="@ClearFilterUrl("minStock")" data-enhance class="inline-flex items-center gap-1 rounded-full bg-blue-50 px-2.5 py-0.5 text-blue-700 hover:bg-blue-100 font-medium" title="Remove stock filter">
                            <span>Stock ≥ @MinStock</span>
                            <span class="font-bold">×</span>
                        </a>
                    }
                    <a href="/items" data-enhance class="text-slate-400 hover:text-slate-600 underline">Reset all</a>
                </div>
            }
        </form>
    </div>

    <div class="table-scroll">
        @if (Items is null && !Failed)
        {
            <table class="data-table">
                <TableStatusRow Columns="ColumnCount" Loading="true" Message="Loading items…" />
            </table>
        }
        else if (Failed)
        {
            <table class="data-table">
                <TableStatusRow Columns="ColumnCount" Error="true" Message="Unable to load items. Please try again." />
            </table>
        }
        else if (Items!.Count == 0)
        {
            <table class="data-table">
                <TableStatusRow Columns="ColumnCount" Message="@(string.IsNullOrWhiteSpace(Search) && !HasActiveFilters ? "No items yet" : "No matching items")" />
            </table>
        }
        else
        {
            <QuickGrid Items="@ItemsQuery" Pagination="@pagination" class="data-table" aria-busy="@(Items is null && !Failed)">
                @if (canManageInventory)
                {
                    <TemplateColumn Class="w-10 pl-5 pr-2 text-center">
                        <HeaderTemplate Context="_">
                            <input type="checkbox" id="select-all-items" class="rounded border-slate-300 text-blue-600 focus:ring-blue-500 cursor-pointer" title="Select / deselect all items" />
                            <span class="sr-only">Select all items</span>
                        </HeaderTemplate>
                        <ChildContent Context="item">
                            <input type="checkbox" form="bulk-labels-form" name="Input.ProductIds" value="@item.Id" aria-label="@($"Select {item.Name} for labels")" class="rounded border-slate-300 text-blue-600 focus:ring-blue-500 cursor-pointer" />
                        </ChildContent>
                    </TemplateColumn>
                }

                <TemplateColumn Title="ID / Barcode" SortBy="@sortById" Sortable="true" Align="Align.Center" Class="w-20 text-center">
                    <HeaderTemplate Context="_">
                        <div class="flex items-center justify-center w-full">
                            <a class="col-title inline-flex items-center gap-1 justify-center @GetSortClass("id")" href="@GetSortUrl("id")" title="Sort by ID">
                                <span>ID / Barcode</span>
                                <span class="sort-indicator" aria-hidden="true"></span>
                            </a>
                        </div>
                    </HeaderTemplate>
                    <ChildContent Context="item">
                        <div class="flex flex-col items-center justify-center">
                            <a href="@($"/items/{item.Id}")" class="font-bold text-blue-700 hover:text-blue-800 text-xs">#@item.Id</a>
                            @if (!string.IsNullOrEmpty(item.Barcode))
                            {
                                <span class="font-mono text-[10px] text-slate-400 block truncate max-w-[70px]" title="@item.Barcode">@item.Barcode</span>
                            }
                        </div>
                    </ChildContent>
                </TemplateColumn>

                    <TemplateColumn Title="Item" SortBy="@sortByName" Sortable="true">
                        <HeaderTemplate Context="_">
                            <div class="flex items-center justify-between w-full">
                                <a class="col-title @GetSortClass("name")" href="@GetSortUrl("name")" title="Sort by item name">
                                    <span>Item</span>
                                    <span class="sort-indicator" aria-hidden="true"></span>
                                </a>
                                <details class="col-filter-details">
                                    <summary class="col-filter-btn @(!string.IsNullOrWhiteSpace(Category) ? "active" : "")" title="Filter by category">
                                        <Icon Name="filter" Class="size-3.5" />
                                    </summary>
                                    <div class="col-filter-card">
                                        <div class="font-semibold text-slate-800 text-xs mb-2">Filter Category</div>
                                        <label class="text-[11px] text-slate-500 block mb-1">Category name contains</label>
                                        <input type="text" data-col-filter="category" value="@Category" placeholder="e.g. Watch, Screen..." class="field text-xs py-1.5 mb-2 w-full" />
                                        <div class="flex items-center justify-between gap-2 mt-2">
                                            <a href="@FilterUrl("category", null)" data-enhance class="text-xs text-slate-500 hover:text-slate-800">Clear</a>
                                            <button type="button" class="btn-primary text-xs py-1 px-3 col-filter-apply">Apply</button>
                                        </div>
                                    </div>
                                </details>
                            </div>
                        </HeaderTemplate>
                        <ChildContent Context="item">
                            <a href="@($"/items/{item.Id}")" class="font-medium text-slate-900 hover:text-blue-600 block text-xs">@item.Name</a>
                            <div class="mt-0.5 text-[11px] text-slate-400">
                                <span>@(item.Category ?? "Uncategorized")</span>
                            </div>
                        </ChildContent>
                    </TemplateColumn>

                    @foreach (var attributeColumn in AttributeColumns)
                    {
                        <TemplateColumn Title="@attributeColumn.DisplayName">
                            <span class="text-xs whitespace-nowrap">@(context.Attributes.FirstOrDefault(attribute => attribute.Key == attributeColumn.Key)?.Value ?? "—")</span>
                        </TemplateColumn>
                    }

                    <TemplateColumn Title="Default supplier" SortBy="@sortBySupplier" Sortable="true">
                        <HeaderTemplate Context="_">
                            <div class="flex items-center justify-between w-full">
                                <a class="col-title @GetSortClass("supplier")" href="@GetSortUrl("supplier")" title="Sort by default supplier">
                                    <span>Default supplier</span>
                                    <span class="sort-indicator" aria-hidden="true"></span>
                                </a>
                                <details class="col-filter-details">
                                    <summary class="col-filter-btn @(!string.IsNullOrWhiteSpace(Supplier) ? "active" : "")" title="Filter by supplier">
                                        <Icon Name="filter" Class="size-3.5" />
                                    </summary>
                                    <div class="col-filter-card">
                                        <div class="font-semibold text-slate-800 text-xs mb-2">Filter Supplier</div>
                                        <label class="text-[11px] text-slate-500 block mb-1">Supplier name contains</label>
                                        <input type="text" data-col-filter="supplier" value="@Supplier" placeholder="e.g. Gadget, ST Mart..." class="field text-xs py-1.5 mb-2 w-full" />
                                        <div class="flex items-center justify-between gap-2 mt-2">
                                            <a href="@FilterUrl("supplier", null)" data-enhance class="text-xs text-slate-500 hover:text-slate-800">Clear</a>
                                            <button type="button" class="btn-primary text-xs py-1 px-3 col-filter-apply">Apply</button>
                                        </div>
                                    </div>
                                </details>
                            </div>
                        </HeaderTemplate>
                        <ChildContent Context="item">
                            <span class="text-xs truncate block max-w-[120px] text-slate-600" title="@item.Supplier">@item.Supplier</span>
                        </ChildContent>
                    </TemplateColumn>

                    <TemplateColumn Title="Stock" SortBy="@sortByStock" Sortable="true" Align="Align.Right">
                        <HeaderTemplate Context="_">
                            <div class="flex items-center justify-end gap-1.5 w-full">
                                <a class="col-title @GetSortClass("quantity")" href="@GetSortUrl("quantity")" title="Sort by stock">
                                    <span>Stock</span>
                                    <span class="sort-indicator" aria-hidden="true"></span>
                                </a>
                                <details class="col-filter-details">
                                    <summary class="col-filter-btn @(MinStock.HasValue ? "active" : "")" title="Filter by stock quantity">
                                        <Icon Name="filter" Class="size-3.5" />
                                    </summary>
                                    <div class="col-filter-card text-left">
                                        <div class="font-semibold text-slate-800 text-xs mb-2">Filter Stock</div>
                                        <label class="text-[11px] text-slate-500 block mb-1">Minimum stock on hand</label>
                                        <input type="number" step="any" data-col-filter="minStock" value="@MinStock" placeholder="e.g. 3" class="field text-xs py-1.5 mb-2 w-full" />
                                        <div class="flex items-center justify-between gap-2 mt-2">
                                            <a href="@FilterUrl("minStock", null)" data-enhance class="text-xs text-slate-500 hover:text-slate-800">Clear</a>
                                            <button type="button" class="btn-primary text-xs py-1 px-3 col-filter-apply">Apply</button>
                                        </div>
                                    </div>
                                </details>
                            </div>
                        </HeaderTemplate>
                        <ChildContent Context="item">
                            <div class="text-right whitespace-nowrap">
                                @if (item.IsNonStocked)
                                {
                                    <span class="badge text-[10px] px-2 py-0.5">Non-stocked</span>
                                }
                                else
                                {
                                    <div class="flex items-center justify-end gap-1.5">
                                        <span class="font-medium @(item.Stock <= 0 ? "text-amber-600 font-bold" : (item.Stock <= item.ReorderLevel ? "text-amber-700" : "text-slate-900"))">@item.Stock.ToString("0.###")</span>
                                        <span class="text-xs text-slate-400">@item.Unit</span>
                                        @if (item.Stock <= item.ReorderLevel)
                                        {
                                            <span class="inline-flex items-center justify-center size-4 rounded-full bg-amber-100 text-amber-700 text-[10px] font-bold" title="@($"Low stock: {item.Stock} on hand (threshold: {item.ReorderLevel})")" aria-label="Low stock">!</span>
                                        }
                                    </div>
                                }
                            </div>
                        </ChildContent>
                    </TemplateColumn>

                    @if (canViewCostPrice)
                    {
                        <TemplateColumn Title="Cost price" SortBy="@sortByCost" Sortable="true" Align="Align.Right">
                            <HeaderTemplate Context="_">
                                <a class="col-title @GetSortClass("cost")" href="@GetSortUrl("cost")" title="Sort by cost price">
                                    <span>Cost price</span>
                                    <span class="sort-indicator" aria-hidden="true"></span>
                                </a>
                            </HeaderTemplate>
                            <ChildContent Context="item">
                                <span class="text-right whitespace-nowrap text-xs text-slate-500 font-medium block">@Money(item.Cost ?? 0)</span>
                            </ChildContent>
                        </TemplateColumn>
                    }

                    <TemplateColumn Title="Selling price" SortBy="@sortByPrice" Sortable="true" Align="Align.Right">
                        <HeaderTemplate Context="_">
                            <a class="col-title @GetSortClass("price")" href="@GetSortUrl("price")" title="Sort by selling price">
                                <span>Selling price</span>
                                <span class="sort-indicator" aria-hidden="true"></span>
                            </a>
                        </HeaderTemplate>
                        <ChildContent Context="item">
                            <span class="text-right whitespace-nowrap text-xs font-semibold text-slate-900 block">@Money(item.Price)</span>
                        </ChildContent>
                    </TemplateColumn>

                    @if (canViewCostPrice)
                    {
                        <TemplateColumn Title="Stock value" SortBy="@sortByValue" Sortable="true" Align="Align.Right">
                            <HeaderTemplate Context="_">
                                <a class="col-title @GetSortClass("value")" href="@GetSortUrl("value")" title="Sort by stock value">
                                    <span>Stock value</span>
                                    <span class="sort-indicator" aria-hidden="true"></span>
                                </a>
                            </HeaderTemplate>
                            <ChildContent Context="item">
                                <span class="text-right whitespace-nowrap text-xs text-slate-500 font-medium block">@Money(item.Stock * (item.Cost ?? 0))</span>
                            </ChildContent>
                        </TemplateColumn>
                    }

                    <TemplateColumn Align="Align.Center" Class="w-10 pr-4">
                        <a href="@($"/items/{context.Id}")" class="icon-button size-7" aria-label="@($"View {context.Name}")">
                            <Icon Name="arrow" Class="size-3.5" />
                        </a>
                    </TemplateColumn>
                </QuickGrid>
            }
        </div>

        @if (canManageInventory)
        {
            <form id="bulk-labels-form" method="post" action="/items/labels" data-enhance data-submit-indication="true">
                <AntiforgeryToken />
                <input type="hidden" name="_handler" value="labels" />
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-t border-slate-100 px-6 py-4">
                    <div class="flex flex-wrap items-center gap-2">
                        <button class="btn-secondary w-full sm:w-auto text-xs sm:text-sm" type="submit" disabled="@(Items is null || Items.Count == 0)" data-pending-text="Generating…">Generate selected labels</button>
                        <a href="/items/bulk-edit" class="btn-primary w-full sm:w-auto text-xs sm:text-sm inline-flex items-center justify-center gap-1.5 @(Items is null || Items.Count == 0 ? "pointer-events-none opacity-50" : "")" id="bulk-edit-selected-btn">
                            <Icon Name="edit" />
                            Bulk edit selected
                        </a>
                    </div>
                    <span class="text-xs text-slate-400">Missing barcodes will be generated from product IDs.</span>
                </div>
            </form>
        }

    @if (TotalCount > 0)
    {
        <Paginator State="@pagination" />
    }
</section>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    public string? Search { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;

    [SupplyParameterFromQuery]
    public int PageSize { get; set; } = 30;

    [SupplyParameterFromQuery]
    public string Sort { get; set; } = "id";

    [SupplyParameterFromQuery]
    public string? Direction { get; set; }

    [SupplyParameterFromQuery]
    public int? LocationId { get; set; }

    [SupplyParameterFromQuery(Name = "category")]
    public string? Category { get; set; }

    [SupplyParameterFromQuery(Name = "supplier")]
    public string? Supplier { get; set; }

    [SupplyParameterFromQuery]
    public decimal? MinStock { get; set; }

    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(Category) || !string.IsNullOrWhiteSpace(Supplier) || MinStock.HasValue;

    private bool canManageInventory;
    private bool canViewCostPrice;

    private IReadOnlyList<Lookup> Locations = [];
    private IReadOnlyList<ItemAttributeColumn> AttributeColumns = [];
    private static readonly string[] ExportColumns = ["Item ID", "Item", "Category", "Supplier", "Barcode", "Unit", "Stock", "Selling price", "Cost price", "Stock value"];

    private readonly GridSort<ItemRow> sortById = GridSort<ItemRow>.ByAscending(i => i.Id);
    private readonly GridSort<ItemRow> sortByName = GridSort<ItemRow>.ByAscending(i => i.Name);
    private readonly GridSort<ItemRow> sortBySupplier = GridSort<ItemRow>.ByAscending(i => i.Supplier);
    private readonly GridSort<ItemRow> sortByStock = GridSort<ItemRow>.ByAscending(i => i.Stock);
    private readonly GridSort<ItemRow> sortByPrice = GridSort<ItemRow>.ByAscending(i => i.Price);
    private readonly GridSort<ItemRow> sortByCost = GridSort<ItemRow>.ByAscending(i => i.Cost ?? 0);
    private readonly GridSort<ItemRow> sortByValue = GridSort<ItemRow>.ByAscending(i => i.Stock * (i.Cost ?? 0));

    private int ColumnCount => 7
        + (HttpContext.User.IsInRole(AppRoles.Admin) || HttpContext.User.IsInRole(AppRoles.InventoryManager) || HttpContext.User.IsInRole(AppRoles.SalesAssociate) || HttpContext.User.IsInRole(AppRoles.InventoryViewer) ? 3 : 0)
        + AttributeColumns.Count;

    private readonly PaginationState pagination = new() { ItemsPerPage = 30 };
    private int TotalCount;
    private IReadOnlyList<ItemRow>? Items;
    private IQueryable<ItemRow>? ItemsQuery => Items?.AsQueryable();
    private bool Failed;

    protected override async Task OnParametersSetAsync()
    {
        pagination.ItemsPerPage = PageSize > 0 ? PageSize : 30;
        Sort = string.IsNullOrWhiteSpace(Sort) ? "id" : Sort;
        Items = null;
        Failed = false;

        try
        {
            var manageAuth = await AuthService.AuthorizeAsync(HttpContext.User, AppPolicies.ManageInventory);
            canManageInventory = manageAuth.Succeeded;

            var costAuth = await AuthService.AuthorizeAsync(HttpContext.User, AppPolicies.ViewCostPrice);
            canViewCostPrice = costAuth.Succeeded;

            if (Locations.Count == 0)
            {
                var options = await Inventory.ItemLocationsAsync(HttpContext.User, HttpContext.RequestAborted);
                Locations = options.Locations;
                AttributeColumns = await Inventory.ItemAttributeColumnsAsync(HttpContext.User, HttpContext.RequestAborted);
                if (!Locations.Any(location => location.Id == LocationId))
                {
                    LocationId = options.SelectedLocationId;
                }
            }
            else if (!Locations.Any(location => location.Id == LocationId))
            {
                LocationId = Locations.FirstOrDefault()?.Id;
            }

            var resolvedSort = ResolveSortParam(Sort, Direction);

            Items = await Inventory.ListAsync(
                HttpContext.User,
                Search,
                1,
                HttpContext.RequestAborted,
                locationId: LocationId,
                sort: resolvedSort,
                pageSize: 10000,
                category: Category,
                supplier: Supplier,
                minStock: MinStock);
            TotalCount = Items.Count;
        }
        catch (OperationCanceledException) when (HttpContext.RequestAborted.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Failed = true;
            Logger.LogError(exception, "Item list failed.");
        }
    }

    private static string ResolveSortParam(string? sort, string? direction)
    {
        if (string.IsNullOrWhiteSpace(sort))
        {
            return "id";
        }
        var cleanSort = sort.ToLowerInvariant();
        if (cleanSort.EndsWith("-desc") || cleanSort.EndsWith("-descending"))
        {
            return cleanSort.Replace("-descending", "-desc");
        }
        if (string.Equals(direction, "desc", StringComparison.OrdinalIgnoreCase) || string.Equals(direction, "descending", StringComparison.OrdinalIgnoreCase))
        {
            return $"{cleanSort}-desc";
        }
        return cleanSort;
    }

    private string GetSortUrl(string column)
    {
        var cleanSort = (Sort ?? "id").ToLowerInvariant().Replace("-descending", "").Replace("-desc", "");
        var isCurrent = string.Equals(cleanSort, column, StringComparison.OrdinalIgnoreCase);
        var currentIsDesc = (Sort ?? "").EndsWith("-desc", StringComparison.OrdinalIgnoreCase)
            || (Sort ?? "").EndsWith("-descending", StringComparison.OrdinalIgnoreCase)
            || string.Equals(Direction, "desc", StringComparison.OrdinalIgnoreCase)
            || string.Equals(Direction, "descending", StringComparison.OrdinalIgnoreCase);
        var nextDirection = isCurrent && !currentIsDesc ? "desc" : "asc";
        return Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["sort"] = nextDirection == "desc" ? $"{column}-desc" : column,
            ["direction"] = nextDirection,
            ["page"] = 1
        });
    }

    private string GetSortClass(string column)
    {
        var cleanSort = (Sort ?? "id").ToLowerInvariant().Replace("-descending", "").Replace("-desc", "");
        if (!string.Equals(cleanSort, column, StringComparison.OrdinalIgnoreCase))
        {
            return "";
        }
        var currentIsDesc = (Sort ?? "").EndsWith("-desc", StringComparison.OrdinalIgnoreCase)
            || (Sort ?? "").EndsWith("-descending", StringComparison.OrdinalIgnoreCase)
            || string.Equals(Direction, "desc", StringComparison.OrdinalIgnoreCase)
            || string.Equals(Direction, "descending", StringComparison.OrdinalIgnoreCase);
        return currentIsDesc ? "col-sort-desc" : "col-sort-asc";
    }

    private string FilterUrl(string key, object? value)
    {
        return Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            [key] = value,
            ["page"] = 1
        });
    }

    private string ClearFilterUrl(string paramToClear) => FilterUrl(paramToClear, null);

    private string Money(decimal value) => $"{value:N2} {Configuration["CurrencyCode"] ?? "BDT"}";
}
