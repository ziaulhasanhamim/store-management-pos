@page "/items/bulk-edit"
@attribute [Authorize(Policy = AppPolicies.ManageInventory)]
@inject InventoryService Inventory
@inject NavigationManager Navigation
@inject ILogger<BulkEdit> Logger

<PageTitle>Bulk Edit Items · @(Configuration["StoreName"] ?? "RetailPOS")</PageTitle>

<div class="page-heading">
    <div>
        <a href="/items" class="mb-3 inline-flex items-center gap-2 text-xs text-slate-500 hover:text-slate-800">
            <Icon Name="back" />
            Back to items
        </a>
        <h1>Bulk Edit Items</h1>
        <p class="text-xs text-slate-500">Reassign suppliers or update categories across inventory products in bulk.</p>
    </div>
    <div class="flex items-center gap-2">
        <a href="/items" class="btn-secondary text-xs sm:text-sm px-3 sm:px-4 py-2 sm:py-2.5">Items catalog</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(SuccessMessage))
{
    <div class="success-panel mb-6" role="status">
        <Icon Name="check" />
        <div>
            <strong>@SuccessMessage</strong>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="error-panel mb-6" role="alert">
        @ErrorMessage
    </div>
}

<div class="space-y-8">
    <!-- Card 1: Catalog-Wide Supplier Reassignment -->
    <section class="panel p-5 sm:p-6">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-5">
            <div>
                <h2 class="text-lg font-semibold text-slate-900">Reassign Supplier (Catalog-Wide)</h2>
                <p class="text-xs text-slate-500 mt-0.5">Transfer all products from one supplier to another in a single operation (e.g. from <em>nn watch gadget</em> to <em>nn gadget</em>).</p>
            </div>
            <span class="rounded-full bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-700">Quick Reassign</span>
        </div>

        <form method="post" action="/items/bulk-edit" data-enhance data-submit-indication="true">
            <AntiforgeryToken />
            <input type="hidden" name="Action" value="reassign-supplier" />
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 items-start">
                <div>
                    <label class="field-label" for="source-supplier">Current supplier (transfer from)</label>
                    <select id="source-supplier" name="SourceSupplierId" class="field" required>
                        <option value="">Select current supplier…</option>
                        @foreach (var s in SupplierCounts)
                        {
                            <option value="@s.Id">@s.Name (@s.ProductCount @(s.ProductCount == 1 ? "item" : "items"))</option>
                        }
                    </select>
                    <p class="text-xs text-slate-400 mt-1">Shows active products currently associated with each supplier.</p>
                </div>

                <div>
                    <label class="field-label" for="target-supplier">New supplier (transfer to)</label>
                    <select id="target-supplier" name="TargetSupplierId" class="field" required>
                        <option value="">Select target supplier…</option>
                        @foreach (var s in Suppliers)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                    <p class="text-xs text-slate-400 mt-1">All products matching the current supplier will be reassigned here.</p>
                </div>
            </div>

            <div class="mt-6 flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-slate-100">
                <span class="text-xs text-slate-500">Updates product catalog records immediately. Historical purchase records remain intact.</span>
                <button type="submit" class="btn-primary text-xs sm:text-sm" data-pending-text="Reassigning…">
                    <Icon Name="check" />
                    Reassign all matching products
                </button>
            </div>
        </form>
    </section>

    <!-- Card 2: Bulk Edit Specific Selected Products -->
    <section class="panel p-5 sm:p-6">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-5">
            <div>
                <h2 class="text-lg font-semibold text-slate-900">Bulk Edit Selected Products</h2>
                <p class="text-xs text-slate-500 mt-0.5">Apply a new supplier or category to specific items chosen from the catalog.</p>
            </div>
            <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700">@SelectedItems.Count items selected</span>
        </div>

        @if (SelectedItems.Count == 0)
        {
            <div class="empty-state">
                <Icon Name="box" />
                <p>No specific products currently selected.</p>
                <div class="mt-3">
                    <a href="/items" class="btn-secondary text-xs">
                        Go to Items catalog to select products →
                    </a>
                </div>
            </div>
        }
        else
        {
            <form method="post" action="/items/bulk-edit" data-enhance data-submit-indication="true">
                <AntiforgeryToken />
                <input type="hidden" name="Action" value="update-selected" />
                @foreach (var id in SelectedIds)
                {
                    <input type="hidden" name="ProductIds" value="@id" />
                }

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-6">
                    <div>
                        <label class="field-label" for="batch-target-supplier">Set default supplier</label>
                        <select id="batch-target-supplier" name="TargetSupplierId" class="field">
                            <option value="">— Keep existing supplier —</option>
                            @foreach (var s in Suppliers)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                        <p class="text-xs text-slate-400 mt-1">Leave unselected to keep each item's current supplier.</p>
                    </div>

                    <div>
                        <label class="field-label" for="batch-target-category">Set category</label>
                        <select id="batch-target-category" name="TargetCategoryId" class="field">
                            <option value="">— Keep existing category —</option>
                            @foreach (var c in Categories)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                        <p class="text-xs text-slate-400 mt-1">Leave unselected to keep each item's current category.</p>
                    </div>
                </div>

                <div class="table-scroll mb-5">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Item</th>
                                <th>Barcode</th>
                                <th>Current supplier</th>
                                <th>Current category</th>
                                <th class="text-right">Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in SelectedItems)
                            {
                                <tr>
                                    <td class="font-semibold text-blue-700">@item.Id</td>
                                    <td class="font-semibold text-slate-900">@item.Name</td>
                                    <td class="font-mono text-xs text-slate-500">@(item.Barcode ?? "—")</td>
                                    <td class="text-xs">@item.Supplier</td>
                                    <td class="text-xs">@(item.Category ?? "Uncategorized")</td>
                                    <td class="text-right font-medium">@item.SellingPrice.ToString("N2") @(Configuration["CurrencyCode"] ?? "BDT")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-slate-100">
                    <a href="/items" class="btn-secondary text-xs sm:text-sm">Cancel</a>
                    <button type="submit" class="btn-primary text-xs sm:text-sm" data-pending-text="Updating…">
                        <Icon Name="check" />
                        Apply changes to @SelectedItems.Count products
                    </button>
                </div>
            </form>
        }
    </section>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    public string? Ids { get; set; }

    [SupplyParameterFromForm]
    private BulkEditFormModel? Form { get; set; }

    private IReadOnlyList<BulkSupplierCount> SupplierCounts = [];
    private IReadOnlyList<Lookup> Suppliers = [];
    private IReadOnlyList<Lookup> Categories = [];
    private IReadOnlyList<BulkEditItemSummary> SelectedItems = [];
    private List<int> SelectedIds = [];
    private string? SuccessMessage;
    private string? ErrorMessage;

    public sealed class BulkEditFormModel
    {
        public string? Action { get; set; }
        public int? SourceSupplierId { get; set; }
        public int? TargetSupplierId { get; set; }
        public int? TargetCategoryId { get; set; }
        public List<int> ProductIds { get; set; } = [];
    }

    protected override async Task OnParametersSetAsync()
    {
        SuccessMessage = null;
        ErrorMessage = null;

        if (HttpMethods.IsPost(HttpContext.Request.Method) && Form is not null)
        {
            try
            {
                if (Form.Action == "reassign-supplier")
                {
                    if (Form.SourceSupplierId is null || Form.SourceSupplierId <= 0)
                    {
                        ErrorMessage = "Please select the current supplier to transfer from.";
                    }
                    else if (Form.TargetSupplierId is null || Form.TargetSupplierId <= 0)
                    {
                        ErrorMessage = "Please select the new target supplier to transfer to.";
                    }
                    else if (Form.SourceSupplierId == Form.TargetSupplierId)
                    {
                        ErrorMessage = "Current supplier and new target supplier must be different.";
                    }
                    else
                    {
                        var updated = await Inventory.BulkUpdateProductsAsync(HttpContext.User, new BulkEditInput
                        {
                            SourceSupplierId = Form.SourceSupplierId,
                            TargetSupplierId = Form.TargetSupplierId
                        }, HttpContext.RequestAborted);

                        SuccessMessage = $"Successfully reassigned {updated} {(updated == 1 ? "product" : "products")} to the new supplier.";
                    }
                }
                else if (Form.Action == "update-selected")
                {
                    if (Form.ProductIds.Count == 0)
                    {
                        ErrorMessage = "No products were selected for update.";
                    }
                    else if ((Form.TargetSupplierId is null || Form.TargetSupplierId <= 0) &&
                             (Form.TargetCategoryId is null || Form.TargetCategoryId <= 0))
                    {
                        ErrorMessage = "Please select a new supplier or category to apply.";
                    }
                    else
                    {
                        var updated = await Inventory.BulkUpdateProductsAsync(HttpContext.User, new BulkEditInput
                        {
                            ProductIds = Form.ProductIds,
                            TargetSupplierId = Form.TargetSupplierId > 0 ? Form.TargetSupplierId : null,
                            TargetCategoryId = Form.TargetCategoryId > 0 ? Form.TargetCategoryId : null
                        }, HttpContext.RequestAborted);

                        SuccessMessage = $"Successfully updated {updated} {(updated == 1 ? "product" : "products")}.";
                    }
                }
            }
            catch (Exception ex)
            {
                ErrorMessage = ex.Message;
                Logger.LogError(ex, "Bulk edit operation failed.");
            }
        }

        try
        {
            SupplierCounts = await Inventory.SupplierProductCountsAsync(HttpContext.User, HttpContext.RequestAborted);
            var options = await Inventory.OptionsAsync(HttpContext.User, HttpContext.RequestAborted);
            Suppliers = options.Suppliers.Select(s => new Lookup(s.Id, s.Name)).ToArray();
            Categories = await Inventory.CategoriesAsync(HttpContext.User, HttpContext.RequestAborted);

            SelectedIds.Clear();
            if (Form?.ProductIds.Count > 0)
            {
                SelectedIds.AddRange(Form.ProductIds.Distinct());
            }
            else if (HttpMethods.IsPost(HttpContext.Request.Method) && HttpContext.Request.HasFormContentType)
            {
                var formValues = HttpContext.Request.Form["Input.ProductIds"];
                if (formValues.Count == 0)
                {
                    formValues = HttpContext.Request.Form["ProductIds"];
                }
                foreach (var v in formValues)
                {
                    if (int.TryParse(v, out var id) && id > 0)
                    {
                        SelectedIds.Add(id);
                    }
                }
                SelectedIds = SelectedIds.Distinct().ToList();
            }
            
            if (SelectedIds.Count == 0 && !string.IsNullOrWhiteSpace(Ids))
            {
                var parsedIds = Ids.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                                   .Select(s => int.TryParse(s, out var id) ? id : 0)
                                   .Where(id => id > 0)
                                   .Distinct();
                SelectedIds.AddRange(parsedIds);
            }

            if (SelectedIds.Count > 0)
            {
                SelectedItems = await Inventory.GetProductsSummaryByIdsAsync(HttpContext.User, SelectedIds, HttpContext.RequestAborted);
            }
            else
            {
                SelectedItems = [];
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Failed to load supplier or catalog options.";
            Logger.LogError(ex, "Failed to load bulk edit dependencies.");
        }
    }
}
