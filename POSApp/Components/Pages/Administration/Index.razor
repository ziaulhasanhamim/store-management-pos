@page "/administration"
@attribute [Authorize(Policy = AppPolicies.ManageUsers)]

<PageTitle>Administration · @(Configuration["StoreName"] ?? "RetailPOS")</PageTitle>
<div class="page-heading">
    <div>
        <p class="eyebrow">Business setup</p>
        <h1>Administration</h1>
    </div>
</div>
<div class="grid gap-4 md:grid-cols-2">
    <HubCard Href="/users" Title="Users & roles" Hint="Account access and permissions" IconName="users" />
    <HubCard Href="/employees" Title="Employees" Hint="Staff records and salary setup" IconName="users" />
    <HubCard Href="/stock/locations" Title="Locations" Hint="Stores, warehouses and selling permissions" IconName="box" />
    <HubCard Href="/expenses/categories" Title="Expense categories" Hint="Organize business spending" IconName="wallet" />
    <HubCard Href="/finance/accounts" Title="Opening balances" Hint="Migrate existing cash, bank and party balances" IconName="wallet" />
    <HubCard Href="/administration/calendar" Title="Trading calendar" Hint="Manage non-trading days, store closures, and holiday exclusions" IconName="calendar" />
    <HubCard Href="/administration/audit" Title="Audit history" Hint="Review corrections, closings and reopenings" IconName="history" />
</div>

<div class="mt-8 rounded-2xl border border-slate-200/90 bg-white p-6 shadow-xs">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2">
                <span class="inline-flex size-2 rounded-full bg-emerald-500"></span>
                <h2 class="text-base font-semibold text-slate-900">Credits &amp; System Info</h2>
            </div>
            <p class="mt-1 text-xs text-slate-500">
                POS &amp; Retail Management System · Designed and engineered by Ziaul Hasan Hamim
            </p>
        </div>
        <a href="https://github.com/ziaulhasanhamim" target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-100 hover:text-blue-600 transition-colors shadow-2xs">
            <svg class="size-4 fill-current text-slate-700" viewBox="0 0 24 24">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <span>Ziaul Hasan Hamim on GitHub</span>
        </a>
    </div>
</div>
