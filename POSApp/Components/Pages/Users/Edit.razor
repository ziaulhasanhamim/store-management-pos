@page "/users/new"
@page "/users/{Id:int}/edit"
@attribute [Authorize(Policy = AppPolicies.ManageUsers)]
@using Microsoft.AspNetCore.Identity
@using POSApp.Client.DTOs
@using POSApp.Persistence.Entities
@using POSApp.Services
@inject UserAdministration Administration
@inject UserManager<User> UserManager
@inject SignInManager<User> SignInManager
@inject NavigationManager Navigation
@inject ILogger<Edit> Logger

<PageTitle>@(IsNew ? "Add user" : "Edit user") · @(Configuration["StoreName"] ?? "RetailPOS")</PageTitle>

<a href="/users" class="text-sm font-medium text-slate-500 hover:text-indigo-700">← Back to team</a>

<div class="mt-6 max-w-xl">
    <h1 class="text-3xl font-semibold tracking-tight text-slate-900">
        @(IsNew ? "Add a team member" : "Edit team member")
    </h1>
    <p class="mt-2 mb-6 text-sm text-slate-500">
        @(IsNew ? "Create a username account and assign a role." : "Update the username, role, or password for this account.")
    </p>

    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        @if (Errors.Length > 0)
        {
            <div role="alert" class="mb-6 rounded-lg bg-red-50 p-4 text-sm text-red-700">
                <ul class="list-inside list-disc">
                    @foreach (var error in Errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }

        @if (LoadFailed)
        {
            <div role="alert" class="text-sm text-red-700">
                We couldn't load this user.
                <a href="@HttpContext.Request.Path" class="font-semibold underline">Try again</a>
            </div>
        }
        else if (UserNotFound)
        {
            <h2 class="text-lg font-semibold text-slate-900">User not found</h2>
            <p class="mt-2 text-sm text-slate-500">This account no longer exists.</p>
        }
        else if (Input is not null)
        {
            <UserEditorForm Input="Input" Locations="Locations" IsNew="IsNew" OnValidSubmit="SaveAsync" OnInvalidSubmit="ClearPassword" />
        }
    </div>
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "user-editor")]
    private UserEditorInput? Input { get; set; }

    private bool IsNew => Id is null;
    private bool IsGet => HttpMethods.IsGet(HttpContext.Request.Method);
    private string[] Errors = [];
    private IReadOnlyList<Lookup> Locations = [];
    private bool UserNotFound;
    private bool LoadFailed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Locations = await Administration.SellingLocationsAsync(HttpContext.User, HttpContext.RequestAborted);

            if (Id is not null)
            {
                if (IsGet)
                {
                    var user = await Administration.FindAsync(HttpContext.User, Id.Value, HttpContext.RequestAborted);
                    if (user is not null)
                    {
                        Input = InputFor(user);
                    }
                    else
                    {
                        UserNotFound = true;
                    }
                }
            }
            else
            {
                Input ??= new() { MustChangePassword = true };
            }
        }
        catch (Exception exception) when (exception is not UnauthorizedAccessException)
        {
            LoadFailed = true;
            Logger.LogError(exception, "Failed to load user editing view for user {UserId}.", Id);
        }
    }

    private UserEditorInput InputFor(UserListItem user) => new()
    {
        Username = user.Username,
        Role = user.Roles.FirstOrDefault() ?? AppRoles.SalesAssociate,
        MustChangePassword = user.MustChangePassword,
        CashLocationId = user.CashLocationId
    };

    private async Task SaveAsync()
    {
        var result = await Administration.SaveAsync(HttpContext.User, Id, Input!.Username, Input.Password, Input.Role, Input.MustChangePassword, Input.CashLocationId);
        Input.Password = string.Empty;

        if (!result.Succeeded)
        {
            Errors = result.Errors.Select(error => error.Description).ToArray();
            return;
        }

        if (Id?.ToString() == UserManager.GetUserId(HttpContext.User))
        {
            var currentUser = await UserManager.GetUserAsync(HttpContext.User);
            if (currentUser is not null)
            {
                await SignInManager.RefreshSignInAsync(currentUser);
            }
        }

        Navigation.NavigateTo("/users?saved=true");
    }

    private void ClearPassword(EditContext _)
    {
        if (Input is not null)
        {
            Input.Password = string.Empty;
        }
    }
}
