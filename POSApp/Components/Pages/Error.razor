@page "/Error"
@using System.Diagnostics

<PageTitle>Something went wrong · @(Configuration["StoreName"] ?? "RetailPOS")</PageTitle>

<div class="min-h-[60vh] flex flex-col items-center justify-center px-4 py-12 text-center">
    <div class="size-16 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center mb-6 shadow-xs border border-rose-100">
        <svg class="size-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
    </div>
    <span class="text-xs font-semibold tracking-wider text-rose-600 uppercase mb-2">Error 500</span>
    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 mb-3">Something went wrong</h1>
    <p class="text-slate-600 max-w-md mb-8 text-sm sm:text-base leading-relaxed">
        An unexpected error occurred while processing your request. Please try again or return to the dashboard.
    </p>
    <div class="flex items-center gap-3">
        <a href="/" class="btn-primary">Return to dashboard</a>
        <a href="javascript:location.reload()" class="btn-secondary">Try again</a>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [PersistentState]
    public string? RequestId { get; set; }

    protected override void OnInitialized()
    {
        RequestId ??= Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }
}
