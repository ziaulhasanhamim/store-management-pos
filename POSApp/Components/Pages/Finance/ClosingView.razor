@using System.Text.Json
<div class="no-print mb-4 flex flex-wrap gap-2">
    <a href="@($"/reports/statements/cash?period=custom&start={Data.Start:yyyy-MM-dd}&end={Data.End:yyyy-MM-dd}")" class="btn-secondary">Cash statement</a>
    <a href="@($"/reports/statements/bank?period=custom&start={Data.Start:yyyy-MM-dd}&end={Data.End:yyyy-MM-dd}")" class="btn-secondary">Bank statement</a>
</div>
@if (Data.SelectedLocationName != null)
{
    <div class="mb-4 flex items-center justify-between rounded-xl border border-blue-200 bg-blue-50/70 p-3.5 text-blue-900">
        <div class="flex items-center gap-2 text-sm font-medium">
            <svg class="h-4 w-4 text-blue-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Filtered to: <strong>@Data.SelectedLocationName</strong> (Showing location sales, receiving & drawers)</span>
        </div>
        <a href="@(Kind == ClosingKind.Month ? $"/finance/month?month={Data.Start:yyyy-MM}" : $"/finance/day?date={Data.Start:yyyy-MM-dd}")" class="btn-secondary text-xs">View all locations</a>
    </div>
}

<div class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <!-- Card 1: Present office cash -->
    <div class="flex flex-col justify-between rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs transition hover:shadow-sm">
        <div>
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Present office cash</span>
                <span class="rounded-md bg-blue-50 px-2 py-0.5 text-[11px] font-semibold text-blue-700">Funds</span>
            </div>
            <div class="mt-2 text-2xl font-bold tracking-tight text-slate-900 tabular-nums">
                @Money(TotalClosingFunds)
            </div>
            <p class="mt-0.5 text-[11px] text-slate-400">Total office cash & bank funds</p>
        </div>
        <div class="mt-4 border-t border-slate-100 pt-3 space-y-1.5 text-xs">
            <div class="flex justify-between items-center text-slate-600">
                <span>Physical cash:</span>
                <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.CountedCash ?? Data.ClosingCash)</span>
            </div>
            <div class="flex justify-between items-center text-slate-600">
                <span>Bank / digital:</span>
                <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.ClosingBank)</span>
            </div>
        </div>
    </div>

    <!-- Card 2: Due & pay status -->
    <div class="flex flex-col justify-between rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs transition hover:shadow-sm">
        <div>
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Due & pay status</span>
                <span class="rounded-md bg-amber-50 px-2 py-0.5 text-[11px] font-semibold text-amber-700">Suppliers</span>
            </div>
            <div class="mt-2 text-2xl font-bold tracking-tight text-slate-900 tabular-nums">
                @Money(Data.SupplierPaid)
            </div>
            <p class="mt-0.5 text-[11px] text-slate-400">@(Kind == ClosingKind.Month ? "Supplier payments made this month" : "Supplier payments made today")</p>
        </div>
        <div class="mt-4 border-t border-slate-100 pt-3 space-y-1.5 text-xs">
            <div class="flex justify-between items-center text-slate-600">
                <span>Suppliers due (payable):</span>
                <span class="font-semibold text-rose-600 tabular-nums">@Money(Data.SupplierDue)</span>
            </div>
            <div class="flex justify-between items-center text-slate-600">
                <span>Customer due (receivable):</span>
                <span class="font-semibold text-emerald-700 tabular-nums">@Money(Data.CustomerDue)</span>
            </div>
            <div class="flex justify-between items-center text-slate-600">
                <span>Stock received (tStok In):</span>
                <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.PurchaseTotal)</span>
            </div>
        </div>
    </div>

    <!-- Card 3: Sales & margin -->
    <div class="flex flex-col justify-between rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs transition hover:shadow-sm">
        <div>
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Sales & margin</span>
                <span class="rounded-md bg-emerald-50 px-2 py-0.5 text-[11px] font-semibold text-emerald-700">Trading</span>
            </div>
            <div class="mt-2 text-2xl font-bold tracking-tight text-slate-900 tabular-nums">
                @Money(Data.Revenue)
            </div>
            <p class="mt-0.5 text-[11px] text-slate-400">@(Kind == ClosingKind.Month ? "Net revenue this month" : "Net revenue today")</p>
        </div>
        <div class="mt-4 border-t border-slate-100 pt-3 space-y-1.5 text-xs">
            <div class="flex justify-between items-center text-slate-600">
                <span>Cost of goods:</span>
                <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.Cogs)</span>
            </div>
            <div class="flex justify-between items-center text-slate-600">
                <span>Sales profit:</span>
                <span class="font-semibold text-emerald-700 tabular-nums">@Money(Data.Revenue - Data.Cogs)</span>
            </div>
            <div class="flex justify-between items-center text-slate-600">
                <span>Margin:</span>
                <span class="font-semibold text-slate-900 tabular-nums">@(Data.Revenue > 0 ? $"{(Data.Revenue - Data.Cogs) / Data.Revenue * 100:0.#}%" : "0%")</span>
            </div>
        </div>
    </div>

    <!-- Card 4: Spend & net profit -->
    <div class="flex flex-col justify-between rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs transition hover:shadow-sm">
        <div>
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Spend & net profit</span>
                <span class="rounded-md bg-indigo-50 px-2 py-0.5 text-[11px] font-semibold text-indigo-700">Result</span>
            </div>
            <div class="mt-2 text-2xl font-bold tracking-tight tabular-nums @(DayNetProfit >= 0 ? "text-emerald-700" : "text-rose-600")">
                @Money(DayNetProfit)
            </div>
            <p class="mt-0.5 text-[11px] text-slate-400">@(Kind == ClosingKind.Month ? "Month bottom line result" : "Day's bottom line result")</p>
        </div>
        <div class="mt-4 border-t border-slate-100 pt-3 space-y-1.5 text-xs">
            <div class="flex justify-between items-center text-slate-600">
                <span>Operational expenses:</span>
                <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.Expenses)</span>
            </div>
            <div class="flex justify-between items-center text-slate-600">
                <span>Payroll paid:</span>
                <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.PayrollPaid)</span>
            </div>
            <div class="flex justify-between items-center text-slate-600">
                <span>Total spend:</span>
                <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.Expenses + Data.PayrollPaid)</span>
            </div>
        </div>
    </div>
</div>

@if (Kind == ClosingKind.Day && Data.SelectedLocationName == null && Data.LocationBreakdown.Count > 0)
{
    <!-- Stock Locations Multi-Store Performance Section for Day -->
    <section class="panel mb-6 table-scroll">
        <div class="panel-heading">
            <div>
                <h3 class="font-semibold text-slate-900">Stock Locations · Today's Multi-Store Performance</h3>
                <p class="mt-0.5 text-xs text-slate-500">Sales, margins, stock deliveries, and on-hand inventory values across all shop branches today.</p>
            </div>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Store Location</th>
                    <th class="text-right">Net Sales</th>
                    <th class="text-right">Cost of Goods</th>
                    <th class="text-right">Sales Profit</th>
                    <th class="text-right">Margin %</th>
                    <th class="text-right">Stock Received (tStok In)</th>
                    <th class="text-right">Stock Inventory Value</th>
                    <th class="text-right no-print">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var loc in Data.LocationBreakdown)
                {
                    var margin = loc.Sales > 0 ? (loc.SalesProfit / loc.Sales * 100) : 0m;
                    <tr>
                        <td class="font-medium text-slate-900">@loc.LocationName</td>
                        <td class="text-right tabular-nums">@Money(loc.Sales)</td>
                        <td class="text-right tabular-nums">@Money(loc.Cogs)</td>
                        <td class="text-right tabular-nums font-semibold text-emerald-700">@Money(loc.SalesProfit)</td>
                        <td class="text-right tabular-nums">@margin.ToString("0.#")%</td>
                        <td class="text-right tabular-nums">@Money(loc.StockReceived)</td>
                        <td class="text-right tabular-nums font-medium text-slate-900">@Money(loc.StockValue)</td>
                        <td class="text-right no-print">
                            <a href="@($"/finance/day?date={Data.Start:yyyy-MM-dd}&locationId={loc.LocationId}")" class="text-xs font-semibold text-blue-700 hover:underline">Filter store</a>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th>Total (@Data.LocationBreakdown.Count @(Data.LocationBreakdown.Count == 1 ? "location" : "locations"))</th>
                    <td class="text-right font-bold tabular-nums">@Money(Data.LocationBreakdown.Sum(l => l.Sales))</td>
                    <td class="text-right font-bold tabular-nums">@Money(Data.LocationBreakdown.Sum(l => l.Cogs))</td>
                    <td class="text-right font-bold tabular-nums text-emerald-700">@Money(Data.LocationBreakdown.Sum(l => l.SalesProfit))</td>
                    <td class="text-right font-bold tabular-nums">
                        @{
                            var totalSales = Data.LocationBreakdown.Sum(l => l.Sales);
                            var totalProfit = Data.LocationBreakdown.Sum(l => l.SalesProfit);
                            var avgMargin = totalSales > 0 ? totalProfit / totalSales * 100 : 0m;
                        }
                        @avgMargin.ToString("0.#")%
                    </td>
                    <td class="text-right font-bold tabular-nums">@Money(Data.LocationBreakdown.Sum(l => l.StockReceived))</td>
                    <td class="text-right font-bold tabular-nums">@Money(Data.LocationBreakdown.Sum(l => l.StockValue))</td>
                    <td class="no-print"></td>
                </tr>
            </tfoot>
        </table>
    </section>
}
@if (Kind == ClosingKind.Day && Data.Locations.Count > 0)
{
    <section class="panel mb-6 table-scroll">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Cash location</th>
                    <th>Status</th>
                    <th class="text-right">Opening</th>
                    <th class="text-right">Expected</th>
                    <th class="text-right">Counted</th>
                    <th class="text-right">Difference</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var location in Data.Locations)
                {
                    <tr>
                        <td>
                            <a href="@($"/cash-drawer?sessionId={location.SessionId}")" class="text-blue-700">@location.Location</a>
                        </td>
                        <td>@location.Status</td>
                        <td class="text-right">@Money(location.Opening)</td>
                        <td class="text-right">@Money(location.Expected)</td>
                        <td class="text-right">@(location.Counted is not null ? Money(location.Counted.Value) : "—")</td>
                        <td class="text-right">@(location.Difference is not null ? Money(location.Difference.Value) : "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}

<!-- Balanced 2-Column Dashboard Grid: Domain Cards on Left (7 cols) + Action Panel & Visual Charts on Right (5 cols) -->
<div class="grid items-start gap-6 lg:grid-cols-12">
    <!-- Left Column: Themed Financial Cards -->
    <div class="space-y-6 lg:col-span-7">
        <div class="flex items-center justify-between">
            <h2 class="text-lg font-bold text-slate-900">Financial Breakdown</h2>
            <span class="text-xs font-semibold text-slate-500">@Data.Start.ToString("dd MMM yyyy") – @Data.End.ToString("dd MMM yyyy")</span>
        </div>

        @if (Data.AwaitingPayout is not null && Data.AwaitingPayout.TotalAmount > 0)
        {
            <div class="rounded-xl border border-indigo-200 bg-indigo-50/70 p-4 text-xs text-indigo-900 flex flex-wrap items-center justify-between gap-3 shadow-xs">
                <div class="flex items-center gap-2.5">
                    <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-indigo-600 text-white font-bold text-sm">৳</span>
                    <div>
                        <p class="font-bold text-indigo-950">Awaiting Merchant Payout (Clearing Account)</p>
                        <p class="text-indigo-700">Card: @Money(Data.AwaitingPayout.CardAmount) · Mobile Wallet: @Money(Data.AwaitingPayout.MobileWalletAmount) (@Data.AwaitingPayout.UnsettledCount pending transactions)</p>
                    </div>
                </div>
                <a href="/finance/clearing" class="btn-secondary text-xs bg-white! border-indigo-300! text-indigo-700!">Record provider payout &rarr;</a>
            </div>
        }

        <!-- Card 1: Trading & Profit (Emerald Theme) -->
        <section class="rounded-2xl border border-emerald-200/80 bg-white p-5 shadow-xs transition hover:shadow-sm">
            <div class="flex items-center justify-between border-b border-emerald-100/70 pb-3.5">
                <div class="flex items-center gap-2.5">
                    <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 text-white shadow-xs">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                        </svg>
                    </span>
                    <div>
                        <h3 class="font-bold text-slate-900">Trading & Profit</h3>
                        <p class="text-xs text-slate-500">Gross margin & bottom line result</p>
                    </div>
                </div>
                <span class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 border border-emerald-200/60">Income</span>
            </div>

            <dl class="mt-4 space-y-2.5 text-sm">
                <div class="flex justify-between items-center text-slate-600">
                    <span>Net sales</span>
                    <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.Revenue)</span>
                </div>
                <div class="flex justify-between items-center text-slate-600">
                    <span>Cost of goods sold</span>
                    <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.Cogs)</span>
                </div>
                <div class="flex justify-between items-center text-slate-600">
                    <span>Sales profit</span>
                    <span class="font-semibold text-emerald-700 tabular-nums">
                        @Money(Data.Revenue - Data.Cogs)
                        @if (Data.Revenue > 0)
                        {
                            <span class="ml-1 text-xs font-normal text-emerald-600">(@(((Data.Revenue - Data.Cogs) / Data.Revenue * 100).ToString("0.#"))%)</span>
                        }
                    </span>
                </div>
                <div class="flex justify-between items-center text-slate-600">
                    <span>Operational expenses</span>
                    <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.Expenses)</span>
                </div>
                <div class="flex justify-between items-center text-slate-600">
                    <span>Salary / bonus / advance expense</span>
                    <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.Salaries)</span>
                </div>
                @if (Data.StockVariance != 0)
                {
                    <div class="flex justify-between items-center text-slate-600">
                        <span>Stock take gain / loss (noncash)</span>
                        <span class="font-semibold tabular-nums @(Data.StockVariance >= 0 ? "text-emerald-700" : "text-rose-600")">@Money(Data.StockVariance)</span>
                    </div>
                }
                @if (CashVarianceAmount != 0)
                {
                    <div class="flex justify-between items-center text-slate-600">
                        <span>Cash @(CashVarianceAmount < 0 ? "shortage (loss)" : "overage (gain)")</span>
                        <span class="font-semibold tabular-nums @(CashVarianceAmount >= 0 ? "text-emerald-700" : "text-rose-600")">@Money(CashVarianceAmount)</span>
                    </div>
                }
            </dl>

            <div class="mt-4 rounded-xl border border-emerald-100 bg-emerald-50/60 p-3 flex justify-between items-center">
                <div>
                    <span class="text-xs font-semibold uppercase tracking-wider text-emerald-800">Net Profit</span>
                    <p class="text-[11px] text-emerald-700/80">Net trading bottom line</p>
                </div>
                <div class="text-xl font-bold tracking-tight tabular-nums @(DayNetProfit >= 0 ? "text-emerald-700" : "text-rose-600")">
                    @Money(DayNetProfit)
                </div>
            </div>
        </section>

        <!-- Card 2: Receipts & Payments (Indigo Theme) -->
        <section class="rounded-2xl border border-indigo-200/80 bg-white p-5 shadow-xs transition hover:shadow-sm">
            <div class="flex items-center justify-between border-b border-indigo-100/70 pb-3.5">
                <div class="flex items-center gap-2.5">
                    <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-blue-600 to-indigo-600 text-white shadow-xs">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                        </svg>
                    </span>
                    <div>
                        <h3 class="font-bold text-slate-900">Receipts & Payments</h3>
                        <p class="text-xs text-slate-500">Operating & financing cash flow</p>
                    </div>
                </div>
                <span class="rounded-full bg-indigo-50 px-2.5 py-0.5 text-xs font-semibold text-indigo-700 border border-indigo-200/60">Cash Flow</span>
            </div>

            <dl class="mt-4 space-y-2.5 text-sm">
                <div class="flex justify-between items-center text-slate-600">
                    <span>Sales receipts / refunds</span>
                    <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.SalesReceipts)</span>
                </div>
                <div class="flex justify-between items-center text-slate-600">
                    <span>Customer due collections</span>
                    <span class="font-semibold text-emerald-700 tabular-nums">@Money(Data.CustomerCollections)</span>
                </div>
                <div class="flex justify-between items-center text-slate-600">
                    <span>Purchases / returns (including credit)</span>
                    <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.PurchaseTotal)</span>
                </div>
                <div class="flex justify-between items-center text-slate-600">
                    <span>Supplier payments</span>
                    <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.SupplierPaid)</span>
                </div>
                <div class="flex justify-between items-center text-slate-600">
                    <span>Salary / advance / bonus payouts</span>
                    <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.PayrollPaid)</span>
                </div>
                <div class="flex justify-between items-center text-slate-600">
                    <span>New employee advances</span>
                    <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.AdvancesPaid)</span>
                </div>
                @if (Data.DebtBorrowed != 0 || Data.DebtRepaid != 0)
                {
                    <div class="flex justify-between items-center text-slate-600">
                        <span>Money borrowed</span>
                        <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.DebtBorrowed)</span>
                    </div>
                    <div class="flex justify-between items-center text-slate-600">
                        <span>Debt repayments</span>
                        <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.DebtRepaid)</span>
                    </div>
                }
            </dl>
        </section>

        <!-- Card 3: Cash & Bank Liquidity (Cyan Theme) -->
        <section class="rounded-2xl border border-cyan-200/80 bg-white p-5 shadow-xs transition hover:shadow-sm">
            <div class="flex items-center justify-between border-b border-cyan-100/70 pb-3.5">
                <div class="flex items-center gap-2.5">
                    <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-cyan-500 to-blue-600 text-white shadow-xs">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                        </svg>
                    </span>
                    <div>
                        <h3 class="font-bold text-slate-900">Cash & Bank Liquidity</h3>
                        <p class="text-xs text-slate-500">Drawer funds & digital accounts</p>
                    </div>
                </div>
                <span class="rounded-full bg-cyan-50 px-2.5 py-0.5 text-xs font-semibold text-cyan-700 border border-cyan-200/60">Liquidity</span>
            </div>

            <dl class="mt-4 space-y-2.5 text-sm">
                <div class="flex justify-between items-center text-slate-600">
                    <span>Physical cash in drawers</span>
                    <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.CountedCash ?? Data.ClosingCash)</span>
                </div>
                <div class="flex justify-between items-center text-slate-600">
                    <span>Bank / digital closing balance</span>
                    <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.ClosingBank)</span>
                </div>
                <div class="flex justify-between items-center text-slate-600">
                    <span>Opening bank</span>
                    <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.OpeningBank)</span>
                </div>
                <div class="flex justify-between items-center text-slate-600">
                    <span>Cash received (inflow)</span>
                    <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.CashIn)</span>
                </div>
                <div class="flex justify-between items-center text-slate-600">
                    <span>Cash paid out (outflow)</span>
                    <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.CashOut)</span>
                </div>
                @if (Data.CashVariance != 0)
                {
                    <div class="flex justify-between items-center text-slate-600">
                        <span>Cash count shortages / overages</span>
                        <span class="font-semibold tabular-nums @(Data.CashVariance >= 0 ? "text-emerald-700" : "text-rose-600")">@Money(Data.CashVariance)</span>
                    </div>
                }
            </dl>

            <div class="mt-4 rounded-xl border border-cyan-100 bg-cyan-50/60 p-3 flex justify-between items-center">
                <div>
                    <span class="text-xs font-semibold uppercase tracking-wider text-cyan-800">Total Closing Funds</span>
                    <p class="text-[11px] text-cyan-700/80">Available cash & bank funds</p>
                </div>
                <div class="text-xl font-bold tracking-tight text-cyan-900 tabular-nums">
                    @Money(TotalClosingFunds)
                </div>
            </div>
        </section>

        <!-- Card 4: Financial Position & Balance Sheet (Amber Theme) -->
        <section class="rounded-2xl border border-amber-200/80 bg-white p-5 shadow-xs transition hover:shadow-sm">
            <div class="flex items-center justify-between border-b border-amber-100/70 pb-3.5">
                <div class="flex items-center gap-2.5">
                    <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-amber-500 to-orange-600 text-white shadow-xs">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
                        </svg>
                    </span>
                    <div>
                        <h3 class="font-bold text-slate-900">Financial Position</h3>
                        <p class="text-xs text-slate-500">Payables, receivables & stock value</p>
                    </div>
                </div>
                <span class="rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-semibold text-amber-700 border border-amber-200/60">Position</span>
            </div>

            <dl class="mt-4 space-y-2.5 text-sm">
                <div class="flex justify-between items-center text-slate-600">
                    <span>Supplier due / payable</span>
                    <span class="font-semibold text-rose-600 tabular-nums">@Money(Data.SupplierDue)</span>
                </div>
                <div class="flex justify-between items-center text-slate-600">
                    <span>Customer due / receivable</span>
                    <span class="font-semibold text-emerald-700 tabular-nums">@Money(Data.CustomerDue)</span>
                </div>
                <div class="flex justify-between items-center text-slate-600">
                    <span>Stock inventory value</span>
                    <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.StockValue)</span>
                </div>
                <div class="flex justify-between items-center text-slate-600">
                    <span>Outstanding lender debt</span>
                    <span class="font-semibold text-rose-600 tabular-nums">@Money(Data.OutstandingDebt)</span>
                </div>
            </dl>
        </section>

        <!-- Card 5: Owner Equity (Slate Theme) -->
        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs transition hover:shadow-sm">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3.5">
                <div class="flex items-center gap-2.5">
                    <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-slate-600 text-white shadow-xs">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                    </span>
                    <div>
                        <h3 class="font-bold text-slate-900">Owner Equity</h3>
                        <p class="text-xs text-slate-500">Capital contributions & draws</p>
                    </div>
                </div>
                <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600">No Profit Effect</span>
            </div>

            <dl class="mt-4 space-y-2.5 text-sm">
                <div class="flex justify-between items-center text-slate-600">
                    <span>Owner contributions</span>
                    <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.OwnerContributions)</span>
                </div>
                <div class="flex justify-between items-center text-slate-600">
                    <span>Owner withdrawals</span>
                    <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.OwnerWithdrawals)</span>
                </div>
                <div class="flex justify-between items-center text-slate-600">
                    <span>Net owner funding</span>
                    <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.OwnerContributions - Data.OwnerWithdrawals)</span>
                </div>
            </dl>
        </section>

        <p class="text-xs text-slate-500 px-1">Opening cash + cash received − cash paid out = expected cash. Bank payments stay separate. Borrowing and debt repayments affect funds and debt, without changing profit. Payroll includes salary, bonus and advances when paid; applying an old advance does not count it again.</p>
    </div>

    <!-- Right Column: Closing Status & Consolidated Action Panel + Visual Charts -->
    <div class="space-y-6 lg:col-span-5 no-print">
        <!-- Panel 1: Closing Status or Action Form -->
        <section class="rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs">
            @if (Data.ClosedAt is not null)
            {
                <div class="flex items-center justify-between border-b border-slate-100 pb-3.5">
                    <div class="flex items-center gap-2">
                        <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-emerald-100 text-emerald-700">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                            </svg>
                        </span>
                        <h3 class="font-bold text-emerald-800">Period closed</h3>
                    </div>
                    <span class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-700 border border-emerald-200">Locked</span>
                </div>
                <p class="mt-3 text-sm text-slate-500">Saved @Data.ClosedAt.Value.ToBusinessTime(Configuration).ToString("dd MMM yyyy, HH:mm"). New postings and corrections to this period are blocked.</p>
                @if (Data.CountedCash is not null)
                {
                    <div class="mt-3 rounded-xl border border-slate-100 bg-slate-50/60 p-3 text-xs space-y-1">
                        <div class="flex justify-between items-center text-slate-600">
                            <span>Counted cash:</span>
                            <span class="font-semibold text-slate-900 tabular-nums">@Money(Data.CountedCash.Value)</span>
                        </div>
                        <div class="flex justify-between items-center text-slate-600">
                            <span>Shortage / overage:</span>
                            <span class="font-semibold tabular-nums @(Data.Difference >= 0 ? "text-emerald-700" : "text-rose-600")">@Money(Data.Difference ?? 0)</span>
                        </div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Data.Notes))
                {
                    <p class="mt-3 text-xs text-slate-600 bg-slate-50 rounded-lg p-2.5 border border-slate-100 italic">"@Data.Notes"</p>
                }
                <div class="mt-4 flex flex-col gap-2">
                    <a href="@($"/finance/reopen?kind={(Kind == ClosingKind.Month ? "month" : "day")}&date={Data.Start:yyyy-MM-dd}")" class="btn-secondary w-full justify-center">Reopen @(Kind == ClosingKind.Month ? "month" : "day")</a>
                    @if (Kind == ClosingKind.Day)
                    {
                        <a class="btn-primary w-full justify-center" href="@($"/accounting-date?date={Data.Start.AddDays(1):yyyy-MM-dd}")">Open next working day</a>
                    }
                </div>
            }
            else if (Kind == ClosingKind.Day && !Data.IsWorkingDay)
            {
                <h3 class="font-bold text-slate-900">Non-working Day</h3>
                <p class="mt-2 text-sm text-slate-500">Viewing another day. Open the working day to record its opening and closing.</p>
                <a class="btn-secondary mt-4 inline-flex" href="/finance/day">Current working day</a>
            }
            else if (HideActions)
            {
                <h3 class="font-bold text-slate-900">Review Mode</h3>
                <p class="mt-2 text-sm text-slate-500">Confirm the reviewed closing above, or keep this period open.</p>
            }
            else
            {
                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                    <h3 class="font-bold text-slate-900">Consolidated closing</h3>
                    <span class="rounded-full bg-blue-50 px-2.5 py-0.5 text-[11px] font-semibold text-blue-700 border border-blue-200">Open</span>
                </div>
                <form method="post" @formname="period-closing" @onsubmit="OnSave" data-enhance data-submit-indication="true">
                    <AntiforgeryToken />
                    <input type="hidden" name="Input.Date" value="@Data.Start.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="Input.Kind" value="@Kind" />
                    <p class="mt-3 text-xs text-slate-500">Opening cash is calculated from location drawers. Count and close each location separately; this business closing totals those counts without counting cash again.</p>
                    <a href="/cash-drawer" class="btn-secondary mt-3 text-xs w-full justify-center">Review location drawers</a>
                    <label class="field-label mt-4" for="period-notes">Notes / shortage or overage explanation</label>
                    <textarea id="period-notes" name="Input.Notes" class="field text-sm" maxlength="2000" rows="3">@Data.Notes</textarea>
                    <div class="mt-4 flex flex-col gap-2">
                        <button name="Action" value="review" class="btn-primary w-full justify-center" data-pending-text="Reviewing…">Review & close @(Kind == ClosingKind.Day ? "day" : "month")</button>
                        <button name="Action" value="save" class="btn-secondary w-full justify-center text-xs" data-pending-text="Saving…">Refresh summary</button>
                    </div>
                    <p class="mt-2 text-[11px] text-slate-400">Close every active location drawer first. Closing freezes the combined summary.</p>
                </form>
            }
        </section>

        <!-- Chart 1: Profit & Cost Structure Bar Chart -->
        <div class="rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs transition hover:shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <h4 class="font-bold text-slate-900">Profit & Cost Structure</h4>
                    <p class="text-xs text-slate-500">Revenue, COGS, operating spend and net result</p>
                </div>
                <span class="rounded-full bg-indigo-50 px-2.5 py-0.5 text-[11px] font-semibold text-indigo-700 border border-indigo-200/60">Structure</span>
            </div>
            <div class="relative h-64 w-full">
                <canvas id="finance-profit-bar"
                        data-chart="bar"
                        data-currency="@Currency"
                        data-labels='["Structure"]'
                        data-datasets="@JsonSerializer.Serialize(BarDatasets)">
                </canvas>
            </div>
        </div>

        <!-- Chart 2: Funds & Asset Allocation Donut Chart -->
        <div class="rounded-2xl border border-slate-200/90 bg-white p-5 shadow-xs transition hover:shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <h4 class="font-bold text-slate-900">Funds & Asset Allocation</h4>
                    <p class="text-xs text-slate-500">Distribution between cash drawers, bank and stock</p>
                </div>
                <span class="rounded-full bg-cyan-50 px-2.5 py-0.5 text-[11px] font-semibold text-cyan-700 border border-cyan-200/60">Holdings</span>
            </div>
            <div class="relative h-60 w-full flex items-center justify-center">
                <canvas id="finance-liquidity-donut"
                        data-chart="donut"
                        data-currency="@Currency"
                        data-labels='["Drawer Cash", "Bank Balance", "Stock Value"]'
                        data-values="@JsonSerializer.Serialize(DonutValues)"
                        data-colors='["#06b6d4", "#4f46e5", "#f59e0b"]'>
                </canvas>
            </div>
        </div>
    </div>
</div>

@if (Data.Daily is not null)
{
    <DailyBreakdown Data="Data.Daily" Date="Data.Start" />
}

@if (Data.Monthly is not null)
{
    <MonthlyBreakdown Data="Data.Monthly" MonthDate="Data.Start" />
}

@code {
    [Parameter, EditorRequired]
    public ClosingTotals Data { get; set; } = default!;

    [Parameter]
    public bool HideActions { get; set; }

    [Parameter]
    public ClosingKind Kind { get; set; }

    [Parameter]
    public EventCallback OnSave { get; set; }

    private decimal TotalClosingFunds => (Data.CountedCash ?? Data.ClosingCash) + Data.ClosingBank;
    private decimal CashVarianceAmount => Data.Difference ?? (Data.CountedCash.HasValue ? Data.CountedCash.Value - Data.ClosingCash : Data.CashVariance);
    private decimal DayNetProfit => Data.Revenue - Data.Cogs - Data.Expenses - Data.Salaries + Data.StockVariance + CashVarianceAmount;
    private string Currency => Configuration["CurrencyCode"] ?? "BDT";
    private string Money(decimal amount) => $"{Currency} {amount:N2}";

    private decimal[] DonutValues =>
    [
        Math.Max(0, Data.CountedCash ?? Data.ClosingCash),
        Math.Max(0, Data.ClosingBank),
        Math.Max(0, Data.StockValue)
    ];

    private object[] BarDatasets =>
    [
        new { label = "Net Sales", data = new[] { Math.Max(0, Data.Revenue) }, color = "#4f46e5" },
        new { label = "Cost of Goods", data = new[] { Math.Max(0, Data.Cogs) }, color = "#f59e0b" },
        new { label = "Operating Spend", data = new[] { Math.Max(0, Data.Expenses + Data.Salaries) }, color = "#ef4444" },
        new { label = "Net Profit", data = new[] { DayNetProfit }, color = DayNetProfit >= 0 ? "#10b981" : "#e11d48" }
    ];
}
