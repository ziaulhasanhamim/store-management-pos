<nav class="mb-6 flex flex-wrap gap-2 no-print" aria-label="Cash drawer pages">
    <a href="/cash-drawer" class="@(View == "drawer" ? "filter-chip active" : "filter-chip")">Operate / count</a>
    <a href="/cash-drawer?view=counts" class="@(View == "counts" ? "filter-chip active" : "filter-chip")">Count checkpoints</a>
    <a href="/cash-drawer?view=locations" class="@(View == "locations" ? "filter-chip active" : "filter-chip")">Locations</a>
    @if (Data.Admin)
    {
        <a href="/cash-drawer?view=transfer" class="@(View == "transfer" ? "filter-chip active" : "filter-chip")">Cash movements</a>
        <a href="/finance/bank" class="filter-chip">Bank & digital balance</a>
    }
    @if (Data.Admin)
    {
        <a href="/reports/statements/cash" class="filter-chip">Cash statement</a>
    }
    <a href="/cash-drawer?view=history" class="@(View == "history" ? "filter-chip active" : "filter-chip")">Session history</a>
</nav>
<DrawerControls Data="Data" View="@View" Location="Location" Transfer="Transfer" Assignment="Assignment" SelectLocationAsync="SelectLocationAsync" TransferAsync="TransferAsync" AssignAsync="AssignAsync" />


@if (View == "drawer")
{
    var selectedLoc = Data?.Locations.FirstOrDefault(l => l.Id == Data.SelectedLocationId);
    if (selectedLoc is not null)
    {
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
            <div>
                <h2 class="text-xl font-bold text-slate-900">@selectedLoc.Name · Physical Cash Drawer</h2>
                <p class="text-xs text-slate-500">Continuous cash drawer. Record sales, expenses, and physical cash counts at any time.</p>
            </div>
            <div>
                @if (Data?.LastCount is not null)
                {
                    var ageHours = (DateTimeOffset.UtcNow - Data.LastCount.CountedAt).TotalHours;
                    if (ageHours < 24)
                    {
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                            <span class="size-2 rounded-full bg-emerald-500"></span> Counted today (@Time(Data.LastCount.CountedAt))
                        </span>
                    }
                    else if (ageHours < 48)
                    {
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                            <span class="size-2 rounded-full bg-amber-500"></span> Counted yesterday (@Time(Data.LastCount.CountedAt))
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200">
                            <span class="size-2 rounded-full bg-rose-500"></span> Count overdue (@Time(Data.LastCount.CountedAt))
                        </span>
                    }
                }
                else
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200">
                        <span class="size-2 rounded-full bg-rose-500"></span> Never counted
                    </span>
                }
            </div>
        </div>

        <div class="mb-6 grid gap-4 sm:grid-cols-3">
            <div class="metric">
                <p>Current book cash</p>
                <strong class="text-2xl!">@Money(Data.CurrentCash)</strong>
            </div>
            <div class="metric">
                <p>Last physically counted</p>
                <strong class="text-2xl!">@(Data.LastCount is not null ? Money(Data.LastCount.CountedCash) : "—")</strong>
            </div>
            <div class="metric">
                <p>Pending variance</p>
                <strong class="text-2xl! @(Data.PendingCount is null || Data.PendingCount.Variance == 0 ? "text-slate-900" : Data.PendingCount.Variance < 0 ? "text-rose-600" : "text-blue-600")">
                    @(Data.PendingCount is not null ? Money(Data.PendingCount.Variance) : "৳0.00")
                </strong>
            </div>
        </div>

        @if (Data.PendingCount is not null)
        {
            <div class="mb-6 max-w-2xl rounded-xl border border-amber-200 bg-amber-50 p-5 text-amber-900 shadow-xs">
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold uppercase tracking-wider bg-amber-200 text-amber-900">Pending Review</span>
                            <h3 class="font-bold text-slate-900">Physical Cash Count Variance: @Money(Data.PendingCount.Variance)</h3>
                        </div>
                        <p class="text-xs text-slate-700 mt-1">
                            Counted by <strong>@Data.PendingCount.CountedBy</strong> on @Time(Data.PendingCount.CountedAt).
                            Expected: <strong>@Money(Data.PendingCount.ExpectedCash)</strong> · Counted: <strong>@Money(Data.PendingCount.CountedCash)</strong>
                        </p>
                        @if (!string.IsNullOrWhiteSpace(Data.PendingCount.Notes))
                        {
                            <p class="text-xs text-slate-600 mt-2 bg-white/70 p-2 rounded border border-amber-100">
                                <span class="font-semibold text-slate-700">Note:</span> @Data.PendingCount.Notes
                            </p>
                        }
                        <p class="text-xs text-slate-500 mt-2">
                            The drawer book balance remains unadjusted until an admin reviews and accepts this variance. Accepting establishes an immutable physical cash anchor without posting synthetic movements.
                        </p>
                    </div>
                    @if (Data?.Admin == true)
                    {
                        <div class="shrink-0 flex flex-col gap-2">
                            @if (Data.UndepositedServicingProfit > 0)
                            {
                                <div class="text-xs text-amber-800 font-medium">
                                    ⚠️ Deposit servicing profit before accepting variance!
                                </div>
                            }
                            <form method="post" @formname="cash-variance-accept" @onsubmit="AcceptVarianceAsync" data-enhance data-submit-indication="true">
                                <AntiforgeryToken />
                                <input type="hidden" name="AcceptVarianceInput.CountId" value="@Data.PendingCount.Id" />
                                <input type="hidden" name="AcceptVarianceInput.CashCountId" value="@Data.PendingCount.Id" />
                                <input type="hidden" name="AcceptVarianceInput.Confirmed" value="true" />
                                <button type="submit" class="btn-primary text-xs py-2 px-3 whitespace-nowrap" data-pending-text="Accepting…" disabled="@(Data.UndepositedServicingProfit > 0)">
                                    Accept Variance (Set Anchor)
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }

        @if (Data.UndepositedServicingProfit > 0)
        {
            <div class="mb-6 max-w-2xl rounded-xl border border-amber-200 bg-amber-50 p-4 text-amber-900 shadow-xs">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                    <div class="flex items-start gap-3">
                        <div class="rounded-lg bg-amber-100 p-2 text-amber-700">
                            <Icon Name="service" Class="size-5" />
                        </div>
                        <div>
                            <h3 class="font-semibold text-slate-900">Undeposited mobile servicing profit: @Money(Data.UndepositedServicingProfit)</h3>
                            <p class="text-xs text-slate-600 mt-0.5">There is mobile servicing profit earned today that has not been deposited into this drawer yet. Deposit it before closing so your expected cash matches your physical count.</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 shrink-0 sm:self-center">
                        <form method="post" @formname="cash-deposit-servicing" @onsubmit="DepositServicingProfitAsync" data-enhance data-submit-indication="true">
                            <AntiforgeryToken />
                            <button type="submit" class="btn-primary text-xs py-2 px-3 whitespace-nowrap" data-pending-text="Depositing…">
                                Deposit @Money(Data.UndepositedServicingProfit)
                            </button>
                        </form>
                        <a href="/servicing" class="btn-secondary text-xs py-2 px-3 whitespace-nowrap">View jobs</a>
                    </div>
                </div>
            </div>
        }

        <div class="mb-6 max-w-2xl">
            <section class="panel p-6">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h2 class="font-semibold text-lg text-slate-900">Physical Cash Count</h2>
                        <p class="text-xs text-slate-500">Verify and record the physical cash currently in this drawer.</p>
                    </div>
                    <span class="text-xs font-semibold px-2.5 py-1 bg-slate-100 rounded text-slate-700">Book balance: @Money(Data.CurrentCash)</span>
                </div>
                <form method="post" @formname="cash-count" @onsubmit="SubmitCountAsync" data-enhance data-submit-indication="true">
                    <AntiforgeryToken />
                    <input type="hidden" name="CountInput.CashDrawerId" value="@(Data.Viewed?.DrawerId ?? selectedLoc.Id)" />
                    <CashCount Value="CountInput?.CountedCash" Expected="Data.CurrentCash" Currency="@Currency" FieldName="CountInput.CountedCash" @rendermode="InteractiveAuto" />
                    @if (Data.Admin)
                    {
                        <div class="mt-3 pt-3 border-t border-slate-100">
                            <label class="inline-flex items-center gap-2 cursor-pointer text-xs font-medium text-slate-600 hover:text-slate-800">
                                <input type="checkbox" name="CountInput.IsBackdate" value="true" class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer"
                                       checked="@CountInput?.IsBackdate"
                                       onchange="var p = document.getElementById('backdate-count-box'); if (p) p.classList.toggle('hidden', !this.checked);" />
                                <span>Record historical count (backdate)</span>
                            </label>
                            <div id="backdate-count-box" class="@(CountInput?.IsBackdate == true ? "" : "hidden") mt-2.5 p-3 rounded-lg bg-amber-50/60 border border-amber-200/80">
                                <label class="field-label text-xs" for="count-time">Counted at (physical date & time)</label>
                                <input type="datetime-local" id="count-time" name="CountInput.CountedAt" class="field text-xs max-w-xs"
                                       min="@(Data.LastCount?.CountedAt.ToBusinessTime(Configuration).ToString("yyyy-MM-ddTHH:mm"))"
                                       value="@(CountInput?.CountedAt?.ToBusinessTime(Configuration).ToString("yyyy-MM-ddTHH:mm"))" />
                                <p class="mt-1 text-[11px] text-amber-800">
                                    Must be after the last accepted count (@(Data.LastCount is not null ? Data.LastCount.CountedAt.ToBusinessTime(Configuration).ToString("dd MMM yyyy, hh:mm tt") : "start of drawer")). Historical expected cash will be calculated as of that moment.
                                </p>
                            </div>
                        </div>
                    }
                    <label class="field-label mt-4" for="count-notes">Count notes</label>
                    <textarea id="count-notes" name="CountInput.Notes" class="field" rows="2" maxlength="2000" placeholder="Required if counted cash differs from book balance...">@CountInput?.Notes</textarea>
                    <p class="mt-2 text-xs text-slate-500">If physical cash matches book cash, the count finishes immediately. If there is a variance, it is queued for admin approval.</p>
                    <button class="btn-primary mt-4" data-pending-text="Saving count…">Submit Physical Count</button>
                </form>
            </section>
        </div>
    }
    else
    {
        <section class="panel max-w-2xl p-6">
            <h2 class="mb-3 font-semibold">Choose a cash location</h2>
            <p class="mb-4 text-sm text-slate-500">Select the selling location whose drawer you want to open or count.</p>
            <a href="/cash-drawer?view=locations" class="btn-primary">Select location</a>
        </section>
    }
}
@if (View == "counts")
{
    <section class="panel mb-6 table-scroll">
        <div class="panel-heading">
            <div>
                <h2>Physical Cash Count Checkpoints</h2>
                <p class="mt-1 text-xs text-slate-500">Audit trail of all physical cash counts, variances, and admin approvals.</p>
            </div>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Count #</th>
                    <th>Time</th>
                    <th>Counted by</th>
                    <th class="text-right">Expected</th>
                    <th class="text-right">Counted</th>
                    <th class="text-right">Variance</th>
                    <th>Status</th>
                    <th>Notes / Review</th>
                    @if (Data?.Admin == true)
                    {
                        <th>Action</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Data.CountHistory.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="p-4 text-center text-sm text-slate-500">No physical cash counts recorded yet.</td>
                    </tr>
                }
                @foreach (var count in Data.CountHistory)
                {
                    <tr>
                        <td>#@count.Id</td>
                        <td>
                            <div class="font-medium text-slate-800">@Time(count.CountedAt)</div>
                            @if (count.RecordedAt != count.CountedAt)
                            {
                                <div class="text-[10px] text-slate-400 font-mono">Recorded: @Time(count.RecordedAt)</div>
                            }
                        </td>
                        <td>@count.CountedBy</td>
                        <td class="text-right">@Money(count.ExpectedCash)</td>
                        <td class="text-right font-medium">@Money(count.CountedCash)</td>
                        <td class="text-right font-bold @(count.Variance == 0 ? "text-emerald-700" : count.Variance < 0 ? "text-rose-700" : "text-blue-700")">
                            @if (count.HasVarianceDrift)
                            {
                                <div class="text-xs text-slate-500 font-normal">Accepted: @Money(count.AcceptedVariance ?? 0)</div>
                                <div class="text-xs font-bold text-amber-700">Now: @Money(count.LiveVariance)</div>
                                <div class="text-[10px] text-amber-600 font-normal">(Shifted by retroactive entries)</div>
                            }
                            else
                            {
                                @(count.Variance == 0 ? "Balanced" : Money(count.Variance))
                            }
                        </td>
                        <td>
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold @(count.Status switch
                            {
                                CashCountStatus.Completed => "bg-emerald-100 text-emerald-800",
                                CashCountStatus.PendingReview => "bg-amber-100 text-amber-800",
                                CashCountStatus.VarianceAccepted => "bg-blue-100 text-blue-800",
                                CashCountStatus.Voided => "bg-slate-100 text-slate-600",
                                _ => "bg-slate-100 text-slate-700"
                            })">
                                @count.Status
                            </span>
                        </td>
                        <td class="text-xs">
                            @if (!string.IsNullOrWhiteSpace(count.Notes))
                            {
                                <div>@count.Notes</div>
                            }
                            @if (count.CompletedAt is not null && count.CompletedBy is not null)
                            {
                                <div class="text-slate-500 mt-0.5">Reviewed by @count.CompletedBy on @Time(count.CompletedAt.Value)</div>
                            }
                        </td>
                        @if (Data?.Admin == true)
                        {
                            <td>
                                @if (count.Status == CashCountStatus.PendingReview)
                                {
                                    <a href="/cash-drawer" class="btn-secondary text-xs py-1 px-2 whitespace-nowrap">
                                        Review in Drawer
                                    </a>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </section>
}
@if (View == "drawer" && Data is { Admin: true, Current: { } statementSession })
{
    <AccountStatement DrawerId="statementSession.DrawerId" Date="statementSession.BusinessDate" />
}
@if (View == "transfer" && Data is { Admin: true, Current: { ClosedAt: null } currentSession })
{
    <CashMovementForm SessionId="currentSession.Id" Adjustment="Adjustment" AdjustAsync="AdjustAsync" />
}
@if (View == "history")
{
    @if (Data?.Viewed is not null)
    {
        var viewed = Data.Viewed;
        <section class="panel mb-6">
            <div class="panel-heading">
                <div>
                    <h2>@viewed.Location · session #@viewed.Id · opened by @viewed.Cashier</h2>
                    <p class="mt-1 text-xs text-slate-500">@Time(viewed.OpenedAt) · @(viewed.ClosedAt is null ? "Open" : $"Closed {Time(viewed.ClosedAt.Value)}")</p>
                </div>
            </div>
            <dl class="grid gap-3 border-t border-slate-100 p-5 text-sm sm:grid-cols-3">
                <div>
                    <dt class="text-slate-500">Opening float</dt>
                    <dd class="mt-1 font-semibold">@Money(viewed.Opening)</dd>
                </div>
                @foreach (var summary in Data.Breakdown)
                {
                    <div>
                        <dt class="text-slate-500">@MovementName(summary.Kind)</dt>
                        <dd class="mt-1 font-semibold">@Money(summary.Amount)</dd>
                    </div>
                }
            </dl>
            @if (viewed.ClosedAt is not null)
            {
                <div class="border-t border-slate-100 p-5">
                    <p>Expected @Money(viewed.Expected) · Counted @Money(viewed.Actual ?? 0)</p>
                    <p class="mt-1 font-semibold @((viewed.Difference ?? 0) == 0 ? "text-emerald-700" : "text-amber-700")">
                        @((viewed.Difference ?? 0) == 0 ? "Balanced" : viewed.Difference < 0 ? "Shortage" : "Overage") · @Money(Math.Abs(viewed.Difference ?? 0))
                    </p>
                    <p class="mt-1 text-sm text-slate-500">@viewed.Notes</p>
                    @if (Data?.Admin == true)
                    {
                        <a href="@($"/finance/reopen?kind=drawer&id={viewed.Id}")" class="btn-secondary mt-4">Reopen drawer</a>
                    }
                </div>
            }
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Movement</th>
                            <th>Reference / notes</th>
                            <th class="text-right">Cash change</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var move in Data.Movements)
                        {
                            <tr>
                                <td>@Time(move.At)</td>
                                <td>@MovementName(move.Kind)</td>
                                <td>@move.Notes</td>
                                <td class="text-right">@Money(move.Amount)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3">Displayed movements</th>
                            <td class="text-right">@Money(Data.Movements.Sum(move => move.Amount))</td>
                        </tr>
                        <tr>
                            <th colspan="3">All session movements</th>
                            <td class="text-right">@Money(Data.Breakdown.Sum(summary => summary.Amount))</td>
                        </tr>
                    </tfoot>
                </table>
                @if (Data.MovementPagination is not null)
                {
                    <PageNavigation Info="Data.MovementPagination" QueryName="movementPage" Label="movements" />
                }
                <p class="p-4 text-xs text-slate-500">Expected cash includes every movement.</p>
            </div>
        </section>
    }
    @if (Data is not null)
    {
        <section class="panel table-scroll">
            <div class="panel-heading">
                <h2>@(Data.Admin ? "Recent location closings" : "Location sessions")</h2>
            </div>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Session</th>
                        <th>Location / opened by</th>
                        <th>Opened</th>
                        <th>Status</th>
                        <th class="text-right">Expected</th>
                        <th class="text-right">Counted</th>
                        <th class="text-right">Over / short</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var shift in Data.Recent)
                    {
                        <tr>
                            <td>
                                <a class="text-blue-700" href="@($"/cash-drawer?sessionId={shift.Id}")">#@shift.Id</a>
                            </td>
                            <td>@shift.Location · @shift.Cashier</td>
                            <td>@Time(shift.OpenedAt)</td>
                            <td>@(shift.ClosedAt is null ? "Open" : "Closed")</td>
                            <td class="text-right">@Money(shift.Expected)</td>
                            <td class="text-right">@(shift.Actual is not null ? Money(shift.Actual.Value) : "—")</td>
                            <td class="text-right">@(shift.Difference is not null ? Money(shift.Difference.Value) : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (Data.SessionPagination is not null)
            {
                <PageNavigation Info="Data.SessionPagination" QueryName="sessionPage" Label="sessions" />
            }
        </section>
    }

}

@code {
    [Parameter]
    public string View { get; set; } = "drawer";

    [Parameter, EditorRequired]
    public CashDrawerPage Data { get; set; } = default!;

    [Parameter, EditorRequired]
    public OpenCashInput Open { get; set; } = default!;

    [Parameter, EditorRequired]
    public CloseCashInput Close { get; set; } = default!;

    [Parameter, EditorRequired]
    public CashAdjustmentInput Adjustment { get; set; } = default!;

    [Parameter]
    public EventCallback OpenAsync { get; set; }

    [Parameter]
    public EventCallback CloseAsync { get; set; }

    [Parameter]
    public EventCallback AdjustAsync { get; set; }

    [Parameter, EditorRequired]
    public CashLocationInput Location { get; set; } = default!;

    [Parameter, EditorRequired]
    public CashTransferInput Transfer { get; set; } = default!;

    [Parameter, EditorRequired]
    public AssignCashDrawerInput Assignment { get; set; } = default!;

    [Parameter, EditorRequired]
    public CashCountInput CountInput { get; set; } = default!;

    [Parameter, EditorRequired]
    public AcceptVarianceInput AcceptVarianceInput { get; set; } = default!;

    [Parameter]
    public EventCallback SubmitCountAsync { get; set; }

    [Parameter]
    public EventCallback AcceptVarianceAsync { get; set; }

    [Parameter]
    public EventCallback SelectLocationAsync { get; set; }

    [Parameter]
    public EventCallback TransferAsync { get; set; }

    [Parameter]
    public EventCallback AssignAsync { get; set; }

    [Parameter]
    public EventCallback DepositServicingProfitAsync { get; set; }

    private string Currency => Configuration["CurrencyCode"] ?? "BDT";

    private static string MovementName(CashMovementKind kind) => kind switch
    {
        CashMovementKind.Sale => "Cash sales less refunds",
        CashMovementKind.SupplierPayment => "Supplier payments",
        CashMovementKind.Expense => "Cash expenses",
        CashMovementKind.Payroll => "Salary / advance payouts",
        CashMovementKind.OwnerContribution => "Owner contribution",
        CashMovementKind.OwnerWithdrawal => "Owner withdrawal",
        CashMovementKind.CashIn => "Cash added (legacy)",
        CashMovementKind.Payout => "Other payouts",
        CashMovementKind.Transfer => "Cash transfer",
        CashMovementKind.DebtBorrowing => "Money borrowed",
        CashMovementKind.DebtRepayment => "Debt repayments",
        CashMovementKind.OpeningBalance => "Opening balance",
        CashMovementKind.Reversal => "Transaction reversals",
        _ => "Other movement"
    };

    private string Money(decimal amount) => $"{Currency} {amount:N2}";
    private string Time(DateTimeOffset at) => at.ToBusinessTime(Configuration).ToString("dd MMM, HH:mm");
}
