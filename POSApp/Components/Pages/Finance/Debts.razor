@page "/finance/debt"
@attribute [Authorize(Policy = AppPolicies.ManageUsers)]
@attribute [StreamRendering]
@using System.ComponentModel.DataAnnotations
@inject DebtService DebtAccounts
@inject NavigationManager Navigation

<PageTitle>Loans & debt · @(Configuration["StoreName"] ?? "RetailPOS")</PageTitle>
<div class="page-heading">
    <h1>Loans & debt</h1>
    <a href="/finance/debt/payments" class="btn-primary">
        <Icon Name="wallet" />
        Borrow / repay
    </a>
</div>
@if (Error is not null)
{
    <p class="error-panel" role="alert">@Error</p>
}
@if (Data is null)
{
    <LoadingPanel Message="Loading lenders…" />
}
else
{
    <div class="mb-6 grid gap-4 sm:grid-cols-3">
        <div class="metric">
            <p>Outstanding debt</p>
            <strong class="text-2xl!">@Money(Data.TotalOutstanding)</strong>
        </div>
        <div class="metric">
            <p>Borrowed · @Data.WorkingDate.ToString("dd MMM yyyy")</p>
            <strong class="text-2xl!">@Money(Data.BorrowedToday)</strong>
        </div>
        <div class="metric">
            <p>Repaid · working day</p>
            <strong class="text-2xl!">@Money(Data.RepaidToday)</strong>
        </div>
    </div>
    <section class="panel mb-6 table-scroll">
        <div class="panel-heading">
            <h2>Lenders</h2>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Phone</th>
                    <th class="text-right">Opening debt</th>
                    <th class="text-right">Outstanding</th>
                    <th>
                        <span class="sr-only">History and payments</span>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lender in Data.Lenders)
                {
                    <tr>
                        <td>@lender.Name</td>
                        <td>@(string.IsNullOrWhiteSpace(lender.Phone) ? "—" : lender.Phone)</td>
                        <td class="text-right">@Money(lender.Opening)</td>
                        <td class="text-right font-semibold">@Money(lender.Balance)</td>
                        <td>
                            <a href="@($"/finance/debt/payments?lenderId={lender.Id}")" class="btn-secondary">Payments / history</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Data.LenderPagination is not null)
        {
            <PageNavigation Info="Data.LenderPagination" Label="lenders" />
        }
        @if (Data.Lenders.Count == 0)
        {
            <p class="empty-state">Add your first lender below.</p>
        }
    </section>
    @if (Data.CanPost)
    {
        <section class="panel max-w-2xl p-6">
            <h2 class="mb-4 font-semibold">Add lender</h2>
            <form method="post" @formname="lender" @onsubmit="SaveAsync" data-enhance data-submit-indication="true">
                <AntiforgeryToken />
                <input type="hidden" name="Input.RequestId" value="@Input!.RequestId" />
                <input type="hidden" name="Input.WorkingDate" value="@Input.WorkingDate.ToString("yyyy-MM-dd")" />
                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label for="lender-name" class="field-label">Name</label>
                        <input id="lender-name" name="Input.Name" value="@Input.Name" class="field" maxlength="200" required />
                    </div>
                    <div>
                        <label for="lender-phone" class="field-label">Phone</label>
                        <input id="lender-phone" name="Input.Phone" value="@Input.Phone" class="field" maxlength="64" />
                    </div>
                    <div>
                        <label for="lender-opening" class="field-label">Existing debt (optional)</label>
                        <input id="lender-opening" name="Input.OpeningBalance" value="@Input.OpeningBalance" class="field" inputmode="decimal" required />
                    </div>
                </div>
                <p class="mt-3 text-xs text-slate-500">Existing debt is carried into the working day without adding cash or bank funds. Record new money using Borrow / repay.</p>
                <button class="btn-primary mt-4" data-pending-text="Adding…">
                    <Icon Name="plus" />
                    Add lender
                </button>
            </form>
        </section>
    }
    else
    {
        <p class="text-sm text-slate-500">Open a working day to add lenders or record payments.</p>
    }
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "lender")]
    private LenderInput? Input { get; set; }

    [SupplyParameterFromQuery]
    public int Page { get; set; } = 1;

    [SupplyParameterFromQuery]
    public int PageSize { get; set; } = 30;

    private DebtPage? Data;
    private string? Error;

    protected override async Task OnParametersSetAsync()
    {
        Data = await DebtAccounts.ReadAsync(HttpContext.User, ct: HttpContext.RequestAborted, page: Page, pageSize: PageSize);
        Input ??= new() { WorkingDate = Data.WorkingDate };
    }

    private async Task SaveAsync()
    {
        try
        {
            var id = await DebtAccounts.AddLenderAsync(HttpContext.User, Input!, HttpContext.RequestAborted);
            Navigation.NavigateTo($"/finance/debt/payments?lenderId={id}");
        }
        catch (ValidationException exception)
        {
            Error = exception.Message;
        }
    }

    private string Money(decimal amount) => $"{amount:N2} {Configuration["CurrencyCode"] ?? "BDT"}";
}
