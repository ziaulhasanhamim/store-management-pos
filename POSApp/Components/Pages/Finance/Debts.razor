@page "/finance/debt"
@attribute [Authorize(Policy = AppPolicies.ManageDebtAndBanking)]
@attribute [StreamRendering]
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@inject DebtService DebtAccounts
@inject NavigationManager Navigation

<PageTitle>Loans & debt · @(Configuration["StoreName"] ?? "RetailPOS")</PageTitle>
<div class="page-heading">
    <h1>Loans & debt</h1>
    <a href="/finance/debt/payments" class="btn-primary">
        <Icon Name="wallet" />
        Borrow / repay
    </a>
</div>
@if (Error is not null)
{
    <p class="error-panel" role="alert">@Error</p>
}
@if (Data is null)
{
    <LoadingPanel Message="Loading lenders…" />
}
else
{
    <div class="mb-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="metric">
            <p>Outstanding debt</p>
            <strong class="text-2xl!">@Money(Data.TotalOutstanding)</strong>
            <span class="metric-note">Across all lenders</span>
        </div>
        <div class="metric">
            <p>Borrowed · @Data.WorkingDate.ToString("dd MMM yyyy")</p>
            <strong class="text-2xl! text-emerald-700">@Money(Data.BorrowedToday)</strong>
            <span class="metric-note text-emerald-600">Debt taken today</span>
        </div>
        <div class="metric">
            <p>Repaid · @Data.WorkingDate.ToString("dd MMM yyyy")</p>
            <strong class="text-2xl! text-amber-700">@Money(Data.RepaidToday)</strong>
            <span class="metric-note text-amber-600">Debt paid today</span>
        </div>
        <div class="metric">
            <p>Net debt change · @Data.WorkingDate.ToString("dd MMM yyyy")</p>
            <strong class="text-2xl! @(Data.DayNet > 0 ? "text-rose-700" : Data.DayNet < 0 ? "text-emerald-700" : "")">
                @(Data.DayNet > 0 ? $"+{Money(Data.DayNet)}" : Money(Data.DayNet))
            </strong>
            <span class="metric-note">@Data.DayCount @(Data.DayCount == 1 ? "entry" : "entries") today</span>
        </div>
    </div>

    <section class="panel mb-6 table-scroll">
        <div class="panel-heading">
            <div>
                <h2>Today's debt activity · @Data.WorkingDate.ToString("dd MMM yyyy")</h2>
                <p class="text-xs text-slate-500">Borrowings and repayments recorded on the current working day.</p>
            </div>
            <a href="/finance/debt/payments" class="btn-primary text-xs">
                <Icon Name="wallet" />
                Borrow / repay
            </a>
        </div>
        @if (Data.DayEntries.Count > 0)
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Time / Ref</th>
                        <th>Lender</th>
                        <th>Type</th>
                        <th>Method</th>
                        <th>Notes</th>
                        <th class="text-right">Borrowed (+)</th>
                        <th class="text-right">Repaid (-)</th>
                        <th class="text-right">Balance after</th>
                        <th>
                            <span class="sr-only">Actions</span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Data.DayEntries)
                    {
                        <tr>
                            <td>
                                <span class="font-medium">#@row.Id</span>
                                @if (row.OccurredAt.HasValue)
                                {
                                    <span class="block text-xs text-slate-500">@UserTime.Format(row.OccurredAt.Value, "hh:mm tt")</span>
                                }
                            </td>
                            <td class="font-medium">@row.Lender</td>
                            <td>
                                @if (row.Kind == DebtEntryKind.Borrowing)
                                {
                                    <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">Borrowing</span>
                                }
                                else if (row.Kind == DebtEntryKind.Repayment)
                                {
                                    <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">Repayment</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold bg-slate-100 text-slate-700">Opening</span>
                                }
                            </td>
                            <td>
                                <span>@(row.Method.HasValue ? SplitPayments.MethodName(row.Method.Value) : "—")</span>
                                @if (!string.IsNullOrWhiteSpace(row.CashLocation))
                                {
                                    <span class="block text-xs text-slate-500">@row.CashLocation</span>
                                }
                            </td>
                            <td class="max-w-xs truncate">@row.Notes</td>
                            <td class="text-right text-emerald-700 font-medium tabular-nums whitespace-nowrap">
                                @(row.Kind == DebtEntryKind.Borrowing ? Money(Math.Abs(row.Amount)) : "—")
                            </td>
                            <td class="text-right text-amber-700 font-medium tabular-nums whitespace-nowrap">
                                @(row.Kind == DebtEntryKind.Repayment ? Money(Math.Abs(row.Amount)) : "—")
                            </td>
                            <td class="text-right font-semibold tabular-nums whitespace-nowrap">@Money(row.BalanceAfter)</td>
                            <td>
                                @if (row.Kind != DebtEntryKind.OpeningBalance)
                                {
                                    <a href="@($"/admin/records/debt/{row.Id}/edit")" class="btn-secondary text-xs" title="Edit or void transaction">Edit / Void</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="font-bold bg-slate-50 border-t-2 border-slate-300">
                        <td colspan="5" class="py-3 px-4 text-right text-slate-700">
                            Today's totals (@Data.DayEntries.Count @(Data.DayEntries.Count == 1 ? "entry" : "entries")):
                        </td>
                        <td class="text-right py-3 px-4 text-emerald-700 tabular-nums whitespace-nowrap">@Money(Data.DayBorrowed)</td>
                        <td class="text-right py-3 px-4 text-amber-700 tabular-nums whitespace-nowrap">@Money(Data.DayRepaid)</td>
                        <td class="text-right py-3 px-4 font-extrabold tabular-nums whitespace-nowrap @(Data.DayNet > 0 ? "text-rose-700" : Data.DayNet < 0 ? "text-emerald-700" : "text-slate-800")">
                            Net: @(Data.DayNet > 0 ? $"+{Money(Data.DayNet)}" : Money(Data.DayNet))
                        </td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        }
        else
        {
            <div class="empty-state">
                <p>No borrowings or repayments recorded today (@Data.WorkingDate.ToString("dd MMM yyyy")).</p>
                <a href="/finance/debt/payments" class="btn-secondary mt-2 inline-block">Record borrowing or repayment</a>
            </div>
        }
    </section>

    <section class="panel mb-6 table-scroll">
        <div class="panel-heading">
            <h2>Lenders & balances</h2>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Phone</th>
                    <th class="text-right">Opening debt</th>
                    <th class="text-right">Outstanding</th>
                    <th>
                        <span class="sr-only">History and payments</span>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lender in Data.Lenders)
                {
                    <tr>
                        <td>@lender.Name</td>
                        <td>@(string.IsNullOrWhiteSpace(lender.Phone) ? "—" : lender.Phone)</td>
                        <td class="text-right tabular-nums whitespace-nowrap">@Money(lender.Opening)</td>
                        <td class="text-right font-semibold tabular-nums whitespace-nowrap">@Money(lender.Balance)</td>
                        <td>
                            <a href="@($"/finance/debt/payments?lenderId={lender.Id}")" class="btn-secondary">Payments / history</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Data.LenderPagination is not null)
        {
            <PageNavigation Info="Data.LenderPagination" Label="lenders" />
        }
        @if (Data.Lenders.Count == 0)
        {
            <p class="empty-state">Add your first lender below.</p>
        }
    </section>
    @if (Data.CanPost)
    {
        <section class="panel max-w-2xl p-6">
            <h2 class="mb-4 font-semibold">Add lender</h2>
            <form method="post" @formname="lender" @onsubmit="SaveAsync" data-enhance data-submit-indication="true">
                <AntiforgeryToken />
                <input type="hidden" name="Input.RequestId" value="@Input!.RequestId" />
                <input type="hidden" name="Input.WorkingDate" value="@Input.WorkingDate.ToString("yyyy-MM-dd")" />
                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label for="lender-name" class="field-label">Name</label>
                        <input id="lender-name" name="Input.Name" value="@Input.Name" class="field" maxlength="200" required />
                    </div>
                    <div>
                        <label for="lender-phone" class="field-label">Phone</label>
                        <input id="lender-phone" name="Input.Phone" value="@Input.Phone" class="field" maxlength="64" />
                    </div>
                    <div>
                        <label for="lender-opening" class="field-label">Existing debt (optional)</label>
                        <input id="lender-opening" name="Input.OpeningBalance" value="@(Input.OpeningBalance > 0 ? Input.OpeningBalance.ToString("0.##", CultureInfo.InvariantCulture) : "")" placeholder="0.00" class="field" inputmode="decimal" />
                    </div>
                </div>
                <p class="mt-3 text-xs text-slate-500">Existing debt is carried into the working day without adding cash or bank funds. Record new money using Borrow / repay.</p>
                <button class="btn-primary mt-4" data-pending-text="Adding…">
                    <Icon Name="plus" />
                    Add lender
                </button>
            </form>
        </section>
    }
    else
    {
        <p class="text-sm text-slate-500">Open a working day to add lenders or record payments.</p>
    }
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "lender")]
    private LenderInput? Input { get; set; }

    [SupplyParameterFromQuery]
    public int Page { get; set; } = 1;

    [SupplyParameterFromQuery]
    public int PageSize { get; set; } = 30;

    private DebtPage? Data;
    private string? Error;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            Data = await DebtAccounts.ReadAsync(HttpContext.User, ct: HttpContext.RequestAborted, page: Page, pageSize: PageSize);
            Input ??= new() { WorkingDate = Data.WorkingDate };
        }
        catch (ValidationException exception)
        {
            Error = exception.Message;
        }
        catch (Exception exception)
        {
            Error = exception.Message;
        }
    }

    private async Task SaveAsync()
    {
        try
        {
            var id = await DebtAccounts.AddLenderAsync(HttpContext.User, Input!, HttpContext.RequestAborted);
            Navigation.NavigateTo($"/finance/debt/payments?lenderId={id}");
        }
        catch (ValidationException exception)
        {
            Error = exception.Message;
        }
    }

    private string Money(decimal amount) => $"{amount:N2} {Configuration["CurrencyCode"] ?? "BDT"}";
}
