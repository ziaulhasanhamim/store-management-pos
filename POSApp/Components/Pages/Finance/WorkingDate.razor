@page "/accounting-date"
@attribute [Authorize(Policy = AppPolicies.ManageUsers)]
@using System.ComponentModel.DataAnnotations
@inject ClosingService Closings
@inject NavigationManager Navigation

<PageTitle>Working date · @(Configuration["StoreName"] ?? "RetailPOS")</PageTitle>
<div class="page-heading">
    <h1>Working day management</h1>
</div>

@if (Input is null)
{
    <LoadingPanel Message="Loading working date…" />
}
else
{
    <div class="max-w-xl space-y-6">
        @if (Error is not null)
        {
            <p class="error-panel" role="alert">@Error</p>
        }
        @if (SuccessMessage is not null)
        {
            <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm font-medium text-emerald-800" role="status">
                @SuccessMessage
            </div>
        }

        @if (IsOpenDay)
        {
            <section class="panel p-6 border-blue-200 bg-blue-50/50">
                <div class="flex flex-wrap items-start justify-between gap-4">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="size-2 rounded-full bg-emerald-500 animate-pulse"></span>
                            <span class="text-xs font-semibold uppercase tracking-wider text-blue-800">Currently active working day</span>
                        </div>
                        <h2 class="mt-1 text-2xl font-bold tracking-tight text-slate-900">@Overview!.Date.ToString("dddd, dd MMM yyyy")</h2>
                        <p class="mt-1 text-xs text-slate-600">This working day is currently open. Sales, payments, and stock movements are being recorded under this date.</p>
                    </div>
                </div>

                <div class="mt-5 border-t border-blue-200/80 pt-4">
                    <h3 class="text-xs font-semibold uppercase tracking-wider text-rose-700">Mistakenly opened this day?</h3>
                    <p class="mt-1 text-xs text-slate-600">If today is a weekend, holiday, or this date was opened by accident, you can delete it. This will cancel the day and restore the previous working day. Deletion is only allowed if no transactions have been recorded.</p>
                    <form method="post" @formname="delete-working-day" @onsubmit="DeleteAsync" class="mt-3" data-enhance data-submit-indication="true">
                        <AntiforgeryToken />
                        <button type="submit" class="btn-secondary text-rose-700 border-rose-300 bg-white hover:bg-rose-50 shadow-2xs text-xs font-semibold"
                                onclick="return confirm('Are you sure you want to delete / cancel working day @Overview.Date.ToString("dd MMM yyyy")?\n\nThis will remove the day and revert the working day to the previous date.');">
                            Delete mistakenly opened day
                        </button>
                    </form>
                </div>
            </section>
        }

        <section class="panel p-6">
            <h2 class="text-lg font-bold text-slate-900">@(IsOpenDay ? "Advance to next working day" : "Open working day")</h2>
            @if (IsOpenDay)
            {
                <div class="my-4 rounded-lg border border-amber-200 bg-amber-50/80 p-3.5 text-xs text-amber-900">
                    <p class="font-medium">The working day for @Overview!.Date.ToString("dd MMM yyyy") is still open.</p>
                    <p class="mt-1">To open the next working day, you must first count cash drawers and close the day on the Day finance page (or delete it above if opened mistakenly).</p>
                    <div class="mt-2.5">
                        <a href="/finance/day" class="btn-secondary text-xs bg-white">Go to Day finance & review closing &rarr;</a>
                    </div>
                </div>
            }
            else
            {
                <p class="mb-4 text-sm text-slate-500">New sales, receiving payments and stock transfers use the shared working day. All users work on the same day. Close it before opening the next day; counted closing cash becomes its opening balance. Actual entry timestamps remain recorded.</p>
                <form method="post" @formname="working-date" @onsubmit="SaveAsync" data-enhance data-submit-indication="true">
                    <AntiforgeryToken />
                    <label class="field-label" for="working-date">Working date</label>
                    <input id="working-date" name="Input.Date" type="date" class="field" value="@Input!.Date.ToString("yyyy-MM-dd")" required />
                    <p class="mt-3 text-xs text-slate-500">Each selling location carries its own previous counted cash. Set initial cash once on the Cash drawers page; this page only advances the shared business date.</p>
                    <button class="btn-primary mt-4" data-pending-text="Selecting…">Open working day</button>
                </form>
            }
        </section>
    </div>
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    public DateOnly? Date { get; set; }

    [SupplyParameterFromForm(FormName = "working-date")]
    private DateInput? Input { get; set; }

    private DayOverview? Overview;
    private string? Error;
    private string? SuccessMessage;
    private bool IsOpenDay => Overview is not null && Overview.ClosedAt is null;

    protected override async Task OnParametersSetAsync()
    {
        await LoadStateAsync();
    }

    private async Task LoadStateAsync()
    {
        try
        {
            Overview = await Closings.OverviewAsync(HttpContext.User, HttpContext.RequestAborted);
            var selectedDate = await Closings.SelectedAsync(HttpContext.User, HttpContext.RequestAborted);
            Input ??= new() { Date = Date ?? (Overview?.ClosedAt != null ? selectedDate.AddDays(1) : selectedDate) };
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
    }

    private async Task SaveAsync()
    {
        try
        {
            await Closings.SelectAsync(HttpContext.User, Input!.Date, HttpContext.RequestAborted);
            Navigation.NavigateTo("/cash-drawer");
        }
        catch (ValidationException exception)
        {
            Error = exception.Message;
        }
    }

    private async Task DeleteAsync()
    {
        try
        {
            if (Overview is null) return;
            var deletedDate = Overview.Date;
            await Closings.DeleteWorkingDayAsync(HttpContext.User, deletedDate, HttpContext.RequestAborted);
            SuccessMessage = $"Working day {deletedDate:dd MMM yyyy} has been deleted. System reverted to the previous working day.";
            Error = null;
            await LoadStateAsync();
            Input = new() { Date = Overview?.ClosedAt != null ? Overview.Date.AddDays(1) : Overview!.Date };
        }
        catch (ValidationException exception)
        {
            Error = exception.Message;
        }
    }

    public sealed class DateInput
    {
        public DateOnly Date { get; set; }
    }
}
