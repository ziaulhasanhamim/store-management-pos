@page "/finance/debt/payments"
@attribute [Authorize(Policy = AppPolicies.ManageUsers)]
@attribute [StreamRendering]
@using System.ComponentModel.DataAnnotations
@inject DebtService DebtAccounts
@inject NavigationManager Navigation

<PageTitle>Borrowing & repayments · @(Configuration["StoreName"] ?? "RetailPOS")</PageTitle>
<div class="page-heading">
    <h1>Borrowing & repayments</h1>
    <a href="/finance/debt" class="btn-secondary">Lenders</a>
</div>
@if (Error is not null)
{
    <p class="error-panel" role="alert">@Error</p>
}
@if (Data is null && Error is null)
{
    <LoadingPanel Message="Loading debt history…" />
}
else if (Data is not null)
{
    <div class="mb-6 grid gap-4 sm:grid-cols-2">
        <div class="metric">
            <p>@(Selected is null ? "Total outstanding debt" : $"Outstanding · {Selected.Name}")</p>
            <strong class="text-2xl!">@Money(Selected?.Balance ?? Data.TotalOutstanding)</strong>
        </div>
        <div class="metric">
            <p>Working day</p>
            <strong>@Data.WorkingDate.ToString("dd MMM yyyy")</strong>
            <a href="/accounting-date" class="metric-note text-blue-700">Manage working day</a>
        </div>
    </div>
    @if (Data.CanPost && Data.Lenders.Count > 0)
    {
        <section class="panel mb-6 max-w-3xl p-6">
            <form method="post" @formname="debt-payment" data-draft-instance="@Input!.RequestId" data-draft-key="debt" data-draft-success="@Saved" @onsubmit="SaveAsync" data-enhance data-submit-indication="true">
                <AntiforgeryToken />
                <input type="hidden" name="Input.RequestId" value="@Input!.RequestId" />
                <input type="hidden" name="Input.WorkingDate" value="@Input.WorkingDate.ToString("yyyy-MM-dd")" />
                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label for="debt-lender" class="field-label">Lender</label>
                        <select id="debt-lender" class="field" name="Input.LenderId" @bind="Input.LenderId" required>
                            <option value="0">Select lender</option>
                            @foreach (var lender in Data.Lenders)
                            {
                                <option value="@lender.Id">@lender.Name · due @Money(lender.Balance)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label for="debt-kind" class="field-label">Transaction</label>
                        <select id="debt-kind" class="field" name="Input.Kind" @bind="Input.Kind">
                            <option value="@DebtEntryKind.Borrowing">Borrow money (receive)</option>
                            <option value="@DebtEntryKind.Repayment">Repay lender (pay out)</option>
                        </select>
                    </div>
                    <div>
                        <label for="debt-amount" class="field-label">Amount</label>
                        <input id="debt-amount" class="field" name="Input.Amount" value="@Input.Amount" inputmode="decimal" required />
                    </div>
                    <div>
                        <label for="debt-method" class="field-label">Payment method</label>
                        <select id="debt-method" class="field" name="Input.Method" @bind="Input.Method">
                            @foreach (var method in Enum.GetValues<PaymentMethod>())
                            {
                                <option value="@method">@SplitPayments.MethodName(method)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label for="debt-location" class="field-label">Cash location</label>
                        <select id="debt-location" class="field" name="Input.CashLocationId" @bind="Input.CashLocationId">
                            <option value="">Select location for cash</option>
                            @foreach (var location in Data.Locations)
                            {
                                <option value="@location.Id">@location.Name</option>
                            }
                        </select>
                        <p class="mt-2 text-xs text-slate-500">Cash requires this location's open drawer. Other methods use bank / digital funds.</p>
                    </div>
                    <div>
                        <label for="debt-notes" class="field-label">Notes / reference (optional)</label>
                        <textarea id="debt-notes" class="field" name="Input.Notes" maxlength="2000">@Input.Notes</textarea>
                    </div>
                </div>
                <button class="btn-primary mt-4" data-pending-text="Recording…">
                    <Icon Name="check" />
                    Record transaction
                </button>
            </form>
        </section>
    }
    else
    {
        <p class="mb-6 text-sm text-slate-500">@(Data.Lenders.Count == 0 ? "Add a lender first." : "The working day is closed. Open the next day to record transactions.")</p>
    }
    <section class="panel table-scroll">
        <div class="panel-heading">
            <h2>Transaction history</h2>
            <form method="get" class="flex gap-3" data-enhance data-submit-indication="true">
                <select class="field" name="lenderId" aria-label="Filter lender">
                    <option value="">All lenders</option>
                    @foreach (var lender in Data.Lenders)
                    {
                        <option value="@lender.Id" selected="@(LenderId == lender.Id)">@lender.Name</option>
                    }
                </select>
                <button class="btn-secondary">View</button>
            </form>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Lender</th>
                    <th>Type</th>
                    <th>Method / location</th>
                    <th>Notes</th>
                    <th class="text-right">Debt change</th>
                    <th class="text-right">Balance after</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Data.History)
                {
                    <tr>
                        <td>@row.Date.ToString("dd MMM yyyy")</td>
                        <td>@row.Lender</td>
                        <td>@(row.Kind == DebtEntryKind.OpeningBalance ? "Opening debt" : row.Kind.ToString())</td>
                        <td>
                            <span>@(row.Method is { } method ? SplitPayments.MethodName(method) : "—")</span>
                            @if (row.CashLocation is not null)
                            {
                                <span class="block text-xs text-slate-500">@row.CashLocation</span>
                            }
                        </td>
                        <td>@row.Notes</td>
                        <td class="text-right">@Money(row.Amount)</td>
                        <td class="text-right">@Money(row.BalanceAfter)</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Data.HistoryPagination is not null)
        {
            <PageNavigation Info="Data.HistoryPagination" Label="transactions" />
        }
        @if (Data.History.Count == 0)
        {
            <p class="empty-state">No transactions yet.</p>
        }
        <p class="p-4 text-xs text-slate-500">Borrowing increases debt; repayment reduces it. No interest is charged.</p>
    </section>
}

@code {
    [SupplyParameterFromQuery]
    public bool Saved { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "lenderId")]
    public int? LenderId { get; set; }

    [SupplyParameterFromForm(FormName = "debt-payment")]
    private DebtPaymentInput? Input { get; set; }

    [SupplyParameterFromQuery]
    public int Page { get; set; } = 1;

    [SupplyParameterFromQuery]
    public int PageSize { get; set; } = 30;

    private DebtPage? Data;
    private string? Error;
    private LenderRow? Selected => Data?.Lenders.FirstOrDefault(lender => lender.Id == LenderId);

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            Data = await DebtAccounts.ReadAsync(HttpContext.User, LenderId, HttpContext.RequestAborted, pageSize: PageSize, historyPage: Page);
            Input ??= new()
            {
                WorkingDate = Data.WorkingDate,
                LenderId = LenderId ?? 0,
                CashLocationId = Data.Locations.Count == 1 ? Data.Locations[0].Id : null
            };
        }
        catch (ValidationException exception)
        {
            Error = exception.Message;
        }
    }

    private async Task SaveAsync()
    {
        try
        {
            await DebtAccounts.PostAsync(HttpContext.User, Input!, HttpContext.RequestAborted);
            Navigation.NavigateTo($"/finance/debt/payments?saved=true&savedRequest={Input!.RequestId}&lenderId={Input!.LenderId}");
        }
        catch (ValidationException exception)
        {
            Error = exception.Message;
        }
    }

    private string Money(decimal amount) => $"{amount:N2} {Configuration["CurrencyCode"] ?? "BDT"}";
}
