@page "/cash-drawer"
@attribute [Authorize(Policy = AppPolicies.ManageDrawer)]
@using System.ComponentModel.DataAnnotations
@inject CashDrawerService Drawers
@inject FinanceService Finance
@inject NavigationManager Navigation
@inject ILogger<Drawer> Logger

<PageTitle>Cash drawer · @(Configuration["StoreName"] ?? "RetailPOS")</PageTitle>
<div class="page-heading">
    <h1>Location cash drawers</h1>
    <div class="flex gap-2">
        <a href="/finance" class="btn-secondary">Finance</a>
        <a href="/sales" class="btn-primary">Sales</a>
    </div>
</div>
@if (Error is not null)
{
    <p class="error-panel" role="alert">@Error</p>
}
@if (Data is not null)
{
    <DrawerView View="@View" Data="Data" Open="Open!" Close="Close!" Adjustment="Adjustment!" Location="Location!" Transfer="Transfer!" Assignment="Assignment!" CountInput="CountInput!" AcceptVarianceInput="AcceptVarianceInput!" DeleteCount="DeleteCount!" SelectLocationAsync="SelectLocationAsync" TransferAsync="TransferAsync" AssignAsync="AssignAsync" OpenAsync="OpenAsync" CloseAsync="CloseAsync" AdjustAsync="AdjustAsync" SubmitCountAsync="SubmitCountAsync" AcceptVarianceAsync="AcceptVarianceAsync" DeleteCountAsync="DeleteCountAsync" DepositServicingProfitAsync="DepositServicingProfitAsync" />
}
else
{
    <LoadingPanel Message="Loading cash drawer…" />
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    public string View { get; set; } = "drawer";

    [SupplyParameterFromQuery]
    public int? SessionId { get; set; }

    [SupplyParameterFromForm(FormName = "cash-open")]
    private OpenCashInput? Open { get; set; }

    [SupplyParameterFromForm(FormName = "cash-close")]
    private CloseCashInput? Close { get; set; }

    [SupplyParameterFromForm(FormName = "cash-adjust")]
    private CashAdjustmentInput? Adjustment { get; set; }

    [SupplyParameterFromForm(FormName = "cash-location")]
    private CashLocationInput? Location { get; set; }

    [SupplyParameterFromForm(FormName = "cash-transfer")]
    private CashTransferInput? Transfer { get; set; }

    [SupplyParameterFromForm(FormName = "cash-assign")]
    private AssignCashDrawerInput? Assignment { get; set; }

    [SupplyParameterFromForm(FormName = "cash-count")]
    private CashCountInput? CountInput { get; set; }

    [SupplyParameterFromForm(FormName = "cash-variance-accept")]
    private AcceptVarianceInput? AcceptVarianceInput { get; set; }

    [SupplyParameterFromForm(FormName = "cash-count-delete")]
    private DeleteCountInput? DeleteCount { get; set; }

    [SupplyParameterFromQuery(Name = "countsPage")]
    public int CountsPage { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "from")]
    public string? FromDateStr { get; set; }

    [SupplyParameterFromQuery(Name = "to")]
    public string? ToDateStr { get; set; }

    private CashDrawerPage? Data;
    private string? Error;

    protected override async Task OnParametersSetAsync()
    {
        View = View is "drawer" or "locations" or "transfer" or "history" or "counts" ? View : SessionId is not null ? "history" : "drawer";
        Open ??= new();
        Close ??= new();
        Adjustment ??= new();
        Location ??= new();
        Transfer ??= new();
        Assignment ??= new();
        CountInput ??= new();
        AcceptVarianceInput ??= new();
        DeleteCount ??= new();
        try
        {
            Data = await LoadAsync();
        }
        catch (ValidationException ex)
        {
            Error = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load cash drawer page.");
            Error = "Unable to load cash drawer data. Reload to try again.";
        }
    }

    [SupplyParameterFromQuery]
    public int MovementPage { get; set; } = 1;

    [SupplyParameterFromQuery]
    public int SessionPage { get; set; } = 1;

    [SupplyParameterFromQuery]
    public int PageSize { get; set; } = 30;

    private Task<CashDrawerPage> LoadAsync()
    {
        DateOnly? fromDate = DateOnly.TryParse(FromDateStr, out var f) ? f : null;
        DateOnly? toDate = DateOnly.TryParse(ToDateStr, out var t) ? t : null;
        return Drawers.ReadAsync(HttpContext.User, SessionId, HttpContext.RequestAborted, MovementPage, SessionPage, PageSize, CountsPage, fromDate, toDate);
    }

    private Task SelectLocationAsync() => SubmitAsync(() => Drawers.SelectLocationAsync(HttpContext.User, Location!.LocationId, HttpContext.RequestAborted), "/cash-drawer");
    private Task TransferAsync() => SubmitAsync(() => Drawers.TransferAsync(HttpContext.User, Transfer!, HttpContext.RequestAborted), "/cash-drawer?view=transfer");
    private Task AssignAsync() => SubmitAsync(() => Drawers.AssignAsync(HttpContext.User, Assignment!, HttpContext.RequestAborted), "/cash-drawer?view=locations");

    private Task OpenAsync() => SubmitAsync(async () => await Drawers.OpenAsync(HttpContext.User, Open!, HttpContext.RequestAborted));
    private async Task CloseAsync()
    {
        if (Close is not null)
        {
            Close.Confirmed = true;
            await SubmitAsync(() => Drawers.CloseAsync(HttpContext.User, Close, HttpContext.RequestAborted), $"/cash-drawer?view=history&sessionId={Close.SessionId}");
        }
    }
    private Task AdjustAsync() => SubmitAsync(() => Drawers.AdjustAsync(HttpContext.User, Adjustment!, HttpContext.RequestAborted), "/cash-drawer?view=transfer");
    private Task SubmitCountAsync() => SubmitAsync(() => Drawers.SubmitCountAsync(HttpContext.User, CountInput!, HttpContext.RequestAborted), "/cash-drawer");
    private Task AcceptVarianceAsync() => SubmitAsync(() => Drawers.AcceptVarianceAsync(HttpContext.User, AcceptVarianceInput!, HttpContext.RequestAborted), "/cash-drawer");
    private Task DeleteCountAsync() => SubmitAsync(() => Drawers.DeleteCountAsync(HttpContext.User, DeleteCount!.CountId, HttpContext.RequestAborted), "/cash-drawer" + (View == "counts" ? "?view=counts" : ""));
    private Task DepositServicingProfitAsync() => Task.CompletedTask;

    private async Task SubmitAsync(Func<Task> action, string? target = null)
    {
        try
        {
            await action();
            Navigation.NavigateTo(target ?? "/cash-drawer");
        }
        catch (ValidationException exception)
        {
            Error = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Cash drawer operation failed.");
            Error = "Unable to save. Reload and try again.";
        }
    }

}
