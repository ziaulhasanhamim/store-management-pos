@page "/payroll"
@attribute [Authorize(Policy = AppPolicies.ManageUsers)]
@using System.ComponentModel.DataAnnotations
@inject FinanceService Finance
@inject ClosingService Closings
@inject NavigationManager Navigation
@inject ILogger<Payroll> Logger

<PageTitle>Payroll · @(Configuration["StoreName"] ?? "RetailPOS")</PageTitle>
<div class="page-heading">
    <h1>Payroll</h1>
    <a href="/cash-drawer" class="btn-secondary">Cash drawer</a>
</div>
@if (Error is not null)
{
    <p class="error-panel" role="alert">@Error</p>
}
@if (!Initialized)
{
    <LoadingPanel Message="Loading accounting date…" />
}
else if (HttpMethods.IsGet(HttpContext.Request.Method))
{
    <FinanceLoad TData="FinancePage" Load="LoadAsync" Message="Loading payroll…">
        <ChildContent Context="loaded">
            <PayrollView Data="loaded" PayrollForm="PayrollForm!" Period="@Period" Start="Start" End="End" Saved="Saved" AddPayrollAsync="AddPayrollAsync" />
        </ChildContent>
    </FinanceLoad>
}
else if (Data is not null)
{
    <PayrollView Data="Data" PayrollForm="PayrollForm!" Period="@Period" Start="Start" End="End" Saved="Saved" AddPayrollAsync="AddPayrollAsync" />
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    public string Period { get; set; } = "";

    [SupplyParameterFromQuery]
    public DateOnly? Start { get; set; }

    [SupplyParameterFromQuery]
    public DateOnly? End { get; set; }

    [SupplyParameterFromQuery]
    public int Page { get; set; } = 1;

    [SupplyParameterFromQuery]
    public bool Saved { get; set; }

    [SupplyParameterFromQuery]
    public int? EmployeeId { get; set; }

    [SupplyParameterFromQuery]
    public DateTime? SalaryMonth { get; set; }

    [SupplyParameterFromForm(FormName = "payroll")]
    private PayrollInput? PayrollForm { get; set; }

    private FinancePage? Data;
    private string? Error;
    private bool Initialized;

    protected override async Task OnParametersSetAsync()
    {
        var selected = (await Closings.SelectedAsync(HttpContext.User, HttpContext.RequestAborted)).ToDateTime(TimeOnly.MinValue);
        if (string.IsNullOrWhiteSpace(Period))
        {
            Period = "custom";
            Start = DateOnly.FromDateTime(selected);
            End = Start;
        }
        PayrollForm ??= new() { Date = selected, Month = SalaryMonth ?? selected, EmployeeId = EmployeeId ?? 0 };
        Initialized = true;
        try
        {
            if (!HttpMethods.IsGet(HttpContext.Request.Method))
            {
                Data = await LoadAsync();
            }
        }
        catch (ValidationException exception)
        {
            Error = exception.Message;
        }
    }

    private Task<FinancePage> LoadAsync() => Finance.ReadAsync(HttpContext.User, Period, Start, End, Page, HttpContext.RequestAborted, PayrollForm is null ? null : new DateOnly(PayrollForm.Month.Year, PayrollForm.Month.Month, 1), payrollOnly: true);

    private Task AddPayrollAsync() => SaveAsync(async () =>
    {
        var form = await HttpContext.Request.ReadFormAsync(HttpContext.RequestAborted);
        if (form.ContainsKey("PayrollForm.AdvanceApplied"))
        {
            throw new ValidationException("The payroll form has changed. Reload before recording this payment.");
        }
        await Finance.AddPayrollAsync(HttpContext.User, PayrollForm!, HttpContext.RequestAborted);
    });

    private async Task SaveAsync(Func<Task> action)
    {
        try
        {
            await action();
            Navigation.NavigateTo($"/payroll?saved=true&savedRequest={PayrollForm!.RequestId}");
        }
        catch (ValidationException exception)
        {
            Error = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Finance entry failed.");
            Error = "Unable to save. Reload and try again.";
        }
    }

}
