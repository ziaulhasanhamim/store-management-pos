@page "/payroll"
@attribute [Authorize(Policy = AppPolicies.ManageUsers)]
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@inject FinanceService Finance
@inject ClosingService Closings
@inject NavigationManager Navigation
@inject RecordAdministration Records
@inject ILogger<Payroll> Logger

<PageTitle>Payroll · @(Configuration["StoreName"] ?? "RetailPOS")</PageTitle>
<div class="page-heading">
    <h1>Payroll</h1>
    <a href="/cash-drawer" class="btn-secondary">Cash drawer</a>
</div>
@if (Error is not null)
{
    <p class="error-panel" role="alert">@Error</p>
}
@if (!Initialized)
{
    <LoadingPanel Message="Loading accounting date…" />
}
else if (HttpMethods.IsGet(HttpContext.Request.Method))
{
    <FinanceLoad TData="FinancePage" Load="LoadAsync" Message="Loading payroll…">
        <ChildContent Context="loaded">
            <PayrollView
                Data="loaded"
                PayrollForm="PayrollForm!"
                Period="@Period"
                Start="Start"
                End="End"
                Saved="Saved"
                SavedEmp="@SavedEmp"
                SavedAmt="@SavedAmt"
                SavedKind="@SavedKind"
                SavedMethod="@SavedMethod"
                Voided="Voided"
                VoidedEmp="@VoidedEmp"
                VoidedAmt="@VoidedAmt"
                AddPayrollAsync="AddPayrollAsync"
                VoidPayrollAsync="VoidPayrollAsync" />
        </ChildContent>
    </FinanceLoad>
}
else if (Data is not null)
{
    <PayrollView
        Data="Data"
        PayrollForm="PayrollForm!"
        Period="@Period"
        Start="Start"
        End="End"
        Saved="Saved"
        SavedEmp="@SavedEmp"
        SavedAmt="@SavedAmt"
        SavedKind="@SavedKind"
        SavedMethod="@SavedMethod"
        Voided="Voided"
        VoidedEmp="@VoidedEmp"
        VoidedAmt="@VoidedAmt"
        AddPayrollAsync="AddPayrollAsync"
        VoidPayrollAsync="VoidPayrollAsync" />
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    public string Period { get; set; } = "";

    [SupplyParameterFromQuery]
    public DateOnly? Start { get; set; }

    [SupplyParameterFromQuery]
    public DateOnly? End { get; set; }

    [SupplyParameterFromQuery]
    public int Page { get; set; } = 1;

    [SupplyParameterFromQuery]
    public bool Saved { get; set; }

    [SupplyParameterFromQuery]
    public string? SavedEmp { get; set; }

    [SupplyParameterFromQuery]
    public decimal? SavedAmt { get; set; }

    [SupplyParameterFromQuery]
    public string? SavedKind { get; set; }

    [SupplyParameterFromQuery]
    public string? SavedMethod { get; set; }

    [SupplyParameterFromQuery]
    public bool Voided { get; set; }

    [SupplyParameterFromQuery]
    public string? VoidedEmp { get; set; }

    [SupplyParameterFromQuery]
    public decimal? VoidedAmt { get; set; }

    [SupplyParameterFromQuery]
    public int? EmployeeId { get; set; }

    [SupplyParameterFromQuery]
    public DateOnly? SalaryMonth { get; set; }

    [SupplyParameterFromForm(FormName = "payroll")]
    private PayrollInput? PayrollForm { get; set; }

    private FinancePage? Data;
    private string? Error;
    private bool Initialized;

    protected override async Task OnParametersSetAsync()
    {
        var selected = await Closings.SelectedAsync(HttpContext.User, HttpContext.RequestAborted);
        if (string.IsNullOrWhiteSpace(Period))
        {
            Period = "custom";
            Start = selected;
            End = Start;
        }
        if (Saved || Voided || PayrollForm is null)
        {
            PayrollForm = new()
            {
                RequestId = Guid.NewGuid(),
                Date = selected,
                Month = SalaryMonth ?? selected,
                EmployeeId = (Saved || Voided) ? 0 : (EmployeeId ?? 0)
            };
        }
        Initialized = true;
        try
        {
            if (!HttpMethods.IsGet(HttpContext.Request.Method))
            {
                Data = await LoadAsync();
            }
        }
        catch (ValidationException exception)
        {
            Error = exception.Message;
        }
    }

    private Task<FinancePage> LoadAsync() => Finance.ReadAsync(
        HttpContext.User,
        Period,
        Start,
        End,
        Page,
        HttpContext.RequestAborted,
        PayrollForm is null ? null : new DateOnly(PayrollForm.Month.Year, PayrollForm.Month.Month, 1),
        payrollOnly: true);

    private Task AddPayrollAsync() => SaveAsync(async () =>
    {
        var form = await HttpContext.Request.ReadFormAsync(HttpContext.RequestAborted);
        if (form.ContainsKey("PayrollForm.AdvanceApplied"))
        {
            throw new ValidationException("The payroll form has changed. Reload before recording this payment.");
        }
        if (PayrollForm?.IsBackdate == true && PayrollForm?.TransactionTime.HasValue == true)
        {
            PayrollForm.TransactionTime = BusinessTime.FromBusinessWallClockToUtc(PayrollForm.TransactionTime.Value.DateTime, Configuration);
        }
        await Finance.AddPayrollAsync(HttpContext.User, PayrollForm!, HttpContext.RequestAborted);
    });

    private async Task SaveAsync(Func<Task> action)
    {
        try
        {
            var staffList = Data?.Staff;
            if (staffList is null)
            {
                var preloaded = await LoadAsync();
                staffList = preloaded.Staff;
            }
            var empName = PayrollForm?.EmployeeId > 0
                ? staffList.FirstOrDefault(e => e.Id == PayrollForm.EmployeeId)?.Name ?? "Employee"
                : "Employee";
            var amt = PayrollForm?.Amount ?? 0;
            var kind = PayrollForm?.Kind.ToString() ?? "Salary";
            var method = PayrollForm?.Method.ToString() ?? "Cash";

            await action();

            var queryParams = new Dictionary<string, object?>
            {
                ["period"] = string.IsNullOrWhiteSpace(Period) ? null : Period,
                ["start"] = Start?.ToString("yyyy-MM-dd"),
                ["end"] = End?.ToString("yyyy-MM-dd"),
                ["saved"] = "true",
                ["savedEmp"] = empName,
                ["savedAmt"] = amt.ToString(CultureInfo.InvariantCulture),
                ["savedKind"] = kind,
                ["savedMethod"] = method
            };
            var url = Navigation.GetUriWithQueryParameters("/payroll", queryParams);
            Navigation.NavigateTo(url);
        }
        catch (ValidationException exception)
        {
            Error = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Finance entry failed.");
            Error = "Unable to save. Reload and try again.";
        }
    }

    private async Task VoidPayrollAsync((int Id, string Employee, decimal Paid) entry)
    {
        try
        {
            await Records.ChangeAsync(HttpContext.User, "payroll", entry.Id, new RecordCorrectionInput
            {
                Reason = "Voided by user from payroll history"
            }, delete: true, HttpContext.RequestAborted);

            var queryParams = new Dictionary<string, object?>
            {
                ["period"] = string.IsNullOrWhiteSpace(Period) ? null : Period,
                ["start"] = Start?.ToString("yyyy-MM-dd"),
                ["end"] = End?.ToString("yyyy-MM-dd"),
                ["page"] = Page > 1 ? Page.ToString() : null,
                ["voided"] = "true",
                ["voidedEmp"] = entry.Employee,
                ["voidedAmt"] = entry.Paid.ToString(CultureInfo.InvariantCulture)
            };
            var url = Navigation.GetUriWithQueryParameters("/payroll", queryParams);
            Navigation.NavigateTo(url);
        }
        catch (ValidationException exception)
        {
            Error = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Finance entry void failed for payroll {Id}", entry.Id);
            Error = "Unable to void payroll entry: " + exception.Message;
        }
    }
}
