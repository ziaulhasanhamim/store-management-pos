@page "/finance/clearing"
@attribute [Authorize(Policy = AppPolicies.MakeSales)]
@attribute [StreamRendering]
@using POSApp.Client.Components
@using POSApp.Client.DTOs
@using POSApp.Services
@inject PaymentClearingService ClearingService
@inject IConfiguration Configuration
@inject ILogger<Clearing> Logger

<PageTitle>Card & Wallet Clearing · @(Configuration["StoreName"] ?? "RetailPOS")</PageTitle>

<div class="page-heading">
    <div>
        <nav class="breadcrumb">
            <a href="/">Dashboard</a>
            <span>/</span>
            <a href="/finance">Finance</a>
            <span>/</span>
            <span>Card & mobile wallet clearing</span>
        </nav>
        <h1 class="mt-1">Card & Wallet Clearing</h1>
        <p class="text-sm text-slate-500">Track unsettled card and wallet sales, reconcile provider settlements, and attribute processing fees.</p>
    </div>
</div>

@if (Error is not null)
{
    <p class="error-panel" role="alert">@Error</p>
}
else if (Data is null)
{
    <LoadingPanel Message="Loading clearing accounts and pending balances…" />
}
else
{
    <PaymentClearingManager InitialData="Data" Currency="@(Configuration["CurrencyCode"] ?? "BDT")" @rendermode="InteractiveAuto" />
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private PaymentClearingPageData? Data;
    private string? Error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Data = await ClearingService.GetPageDataAsync(HttpContext.User, null, null, HttpContext.RequestAborted);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load Clearing page data.");
            Error = ex.Message;
        }
    }
}
