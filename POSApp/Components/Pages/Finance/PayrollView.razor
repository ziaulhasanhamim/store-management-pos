@inject FinanceService Finance

@if (Data is not null)
{
    @if (Saved)
    {
        <div class="mb-6 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-emerald-900 shadow-sm flex items-start justify-between gap-3" role="status">
            <div class="flex items-start gap-2.5">
                <svg class="w-5 h-5 text-emerald-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <div>
                    <p class="font-medium text-sm">
                        @if (!string.IsNullOrWhiteSpace(SavedEmp) && SavedAmt.HasValue)
                        {
                            <span>Payroll recorded: <strong>@Money(SavedAmt.Value)</strong> paid to <strong>@SavedEmp</strong> @(SavedKind is not null ? $"({SavedKind})" : "").</span>
                        }
                        else
                        {
                            <span>Payroll payment recorded successfully.</span>
                        }
                    </p>
                    <p class="text-xs text-emerald-700 mt-0.5">The form has been cleared. You can now record another payment below.</p>
                </div>
            </div>
            <a href="@CleanUrl" class="text-xs font-semibold text-emerald-700 hover:text-emerald-900 underline shrink-0">Dismiss</a>
        </div>
    }
    @if (Voided)
    {
        <div class="mb-6 rounded-xl border border-amber-200 bg-amber-50 p-4 text-amber-900 shadow-sm flex items-start justify-between gap-3" role="status">
            <div class="flex items-start gap-2.5">
                <svg class="w-5 h-5 text-amber-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                <div>
                    <p class="font-medium text-sm">
                        @if (!string.IsNullOrWhiteSpace(VoidedEmp) && VoidedAmt.HasValue)
                        {
                            <span>Payroll payment of <strong>@Money(VoidedAmt.Value)</strong> for <strong>@VoidedEmp</strong> has been voided.</span>
                        }
                        else
                        {
                            <span>Payroll entry voided.</span>
                        }
                    </p>
                    <p class="text-xs text-amber-700 mt-0.5">All associated cash/bank movements have been reversed and employee salary balance has been restored.</p>
                </div>
            </div>
            <a href="@CleanUrl" class="text-xs font-semibold text-amber-700 hover:text-amber-900 underline shrink-0">Dismiss</a>
        </div>
    }
    <RangePicker Path="/payroll" Period="@Period" Range="Data.Range" />
    <div class="mb-6 grid gap-4 sm:grid-cols-3">
        @if (Data.Admin)
        {
            <div class="metric">
                <p>Payroll expense (paid)</p>
                <strong class="text-2xl!">@Money(Data.Salaries)</strong>
                <span class="metric-note">Salary, bonus and advances when paid</span>
            </div>
            <div class="metric">
                <p>Payroll paid out</p>
                <strong class="text-2xl!">@Money(Data.PayrollOutflow)</strong>
                <span class="metric-note">Including @Money(Data.AdvancesPaid) new advances</span>
            </div>
        }
    </div>
    <div class="mb-6 max-w-3xl">
        @if (Data.Admin)
        {
            <section class="panel p-6">
                <div class="mb-4 flex items-center justify-between gap-3">
                    <h2 class="font-semibold">Pay employee</h2>
                    <a href="/employees" class="text-sm text-blue-700">Employees & salaries</a>
                </div>
                <form method="post" @formname="payroll" data-draft-instance="@PayrollForm!.RequestId" data-draft-success="@Saved" @onsubmit="AddPayrollAsync" data-enhance data-submit-indication="true">
                    <AntiforgeryToken />
                    <input type="hidden" name="PayrollForm.WorkingDate" value="@PayrollForm!.Date.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="PayrollForm.RequestId" value="@PayrollForm!.RequestId" />
                    <PayrollFields
                        Employees="Data.Staff"
                        InitialEmployeeId="PayrollForm.EmployeeId"
                        InitialKind="PayrollForm.Kind"
                        InitialAmount="PayrollForm.Amount"
                        Month="PayrollForm.Month"
                        Currency="@Currency"
                        RequestId="@PayrollForm.RequestId"
                        @rendermode="InteractiveAuto" />
                    <input type="hidden" name="PayrollForm.Month" value="@PayrollForm.Month.ToString("yyyy-MM-dd")" />
                    <p class="mt-3 text-sm text-slate-500">Salary month: @PayrollForm.Month.ToString("MMMM yyyy")</p>
                    <div class="mt-4 grid gap-4 sm:grid-cols-2">
                        <div>
                            <label class="field-label" for="payroll-method">Paid with</label>
                            <select id="payroll-method" name="PayrollForm.Method" class="field">
                                @foreach (var method in Enum.GetValues<PaymentMethod>())
                                {
                                    <option value="@method" selected="@(PayrollForm.Method == method)">@SplitPayments.MethodName(method)</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="field-label" for="payroll-date">Date</label>
                            <input type="hidden" name="PayrollForm.Date" value="@PayrollForm.Date.ToString("yyyy-MM-dd")" />
                            <p id="payroll-date" class="py-2 text-sm">@PayrollForm.Date.ToString("dd MMM yyyy") · working day</p>
                        </div>
                    </div>
                    @if (Data.Admin)
                    {
                        <div class="rounded-xl border border-blue-200 bg-blue-50/70 p-3 space-y-2 mt-4">
                            <label class="inline-flex items-center gap-2 cursor-pointer text-xs font-semibold text-blue-900 select-none">
                                <input type="checkbox" id="payroll-backdate-toggle" name="PayrollForm.IsBackdate" value="true" class="rounded border-blue-300 text-blue-600 focus:ring-blue-500 cursor-pointer"
                                       checked="@(PayrollForm?.IsBackdate == true)"
                                       onchange="document.getElementById('payroll-backdate-box').classList.toggle('hidden', !this.checked)" />
                                <span>Record historical payroll (backdate)</span>
                            </label>
                            <div id="payroll-backdate-box" class="@(PayrollForm?.IsBackdate == true ? "" : "hidden")">
                                <label for="payroll-time" class="field-label text-blue-900 text-xs">Payment Date & Time</label>
                                <input id="payroll-time" type="datetime-local" class="field bg-white mt-1 text-xs max-w-xs" name="PayrollForm.TransactionTime"
                                       value="@(PayrollForm?.TransactionTime?.ToString("yyyy-MM-ddTHH:mm"))" />
                                <p class="text-[11px] text-blue-700 mt-1">Backfills land on earlier dates without interrupting live operations.</p>
                            </div>
                        </div>
                    }
                    <label class="field-label mt-4" for="payroll-note">Notes</label>
                    <input id="payroll-note" name="PayrollForm.Notes" class="field" value="@(PayrollForm?.Notes ?? "")" placeholder="e.g. November 2026 salary" maxlength="2000" required />
                    <p class="mt-3 text-xs text-slate-500">Create the monthly salary first. Salary payments can be split over the month; salary overpayments become an advance for the next month. Choose Bonus for money that is not recoverable.</p>
                    <button class="btn-primary mt-4" data-pending-text="Recording…">Record payroll</button>
                </form>
            </section>
        }
    </div>
    @if (Data.Admin)
    {
        <section class="panel table-scroll">
            <div class="panel-heading">
                <h2>Payroll history</h2>
            </div>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Employee</th>
                        <th>Type / month</th>
                        <th class="text-right">Amount</th>
                        <th class="text-right">Advance applied automatically</th>
                        <th class="text-right">New advance</th>
                        <th class="text-right">Paid out</th>
                        <th>Method / notes</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Data.Payroll)
                    {
                        <tr>
                            <td>@Date(entry.At)</td>
                            <td>@entry.Employee</td>
                            <td>@entry.Kind · @entry.Month.ToString("MMM yyyy")</td>
                            <td class="text-right">@Money(entry.Amount)</td>
                            <td class="text-right">@Money(entry.AdvanceApplied)</td>
                            <td class="text-right">@Money(entry.AdvanceCreated)</td>
                            <td class="text-right">@Money(entry.Paid)</td>
                            <td>@SplitPayments.MethodName(entry.Method) · @entry.Notes</td>
                            <td class="text-right">
                                <div class="inline-flex items-center justify-end gap-2">
                                    <form method="post" @formname="@($"void-payroll-{entry.Id}")" @onsubmit="() => VoidPayrollAsync.InvokeAsync((entry.Id, entry.Employee, entry.Paid))" class="inline" data-enhance>
                                        <AntiforgeryToken />
                                        <button type="submit" class="btn-danger py-1 px-2.5 text-xs font-semibold rounded-lg hover:bg-rose-50 text-rose-700 border border-rose-200 transition-colors inline-flex items-center gap-1"
                                                onclick="return confirm('Void payroll payment #@entry.Id of @Money(entry.Paid) for @entry.Employee? This will reverse the cash/bank transaction and restore employee salary balance.')">
                                            Void
                                        </button>
                                    </form>
                                    <a href="@($"/admin/records/payroll/{entry.Id}/edit")" class="text-xs text-slate-500 hover:text-slate-800 underline">
                                        Details
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (Data.PayrollPagination is not null)
            {
                <PageNavigation Info="Data.PayrollPagination" Label="salary payments" />
            }
            <p class="p-4 text-xs text-slate-500">Totals include every entry in the period.</p>
        </section>
    }
}

@code {
    [Parameter, EditorRequired]
    public FinancePage Data { get; set; } = default!;

    [Parameter, EditorRequired]
    public PayrollInput PayrollForm { get; set; } = default!;

    [Parameter]
    public EventCallback AddPayrollAsync { get; set; }

    [Parameter]
    public EventCallback<(int Id, string Employee, decimal Paid)> VoidPayrollAsync { get; set; }

    [Parameter]
    public string Period { get; set; } = "month";

    [Parameter]
    public DateOnly? Start { get; set; }

    [Parameter]
    public DateOnly? End { get; set; }

    [Parameter]
    public bool Saved { get; set; }

    [Parameter]
    public string? SavedEmp { get; set; }

    [Parameter]
    public decimal? SavedAmt { get; set; }

    [Parameter]
    public string? SavedKind { get; set; }

    [Parameter]
    public string? SavedMethod { get; set; }

    [Parameter]
    public bool Voided { get; set; }

    [Parameter]
    public string? VoidedEmp { get; set; }

    [Parameter]
    public decimal? VoidedAmt { get; set; }

    private string CleanUrl => $"/payroll?period={Uri.EscapeDataString(Period)}&start={Start:yyyy-MM-dd}&end={End:yyyy-MM-dd}";

    private string Currency => Configuration["CurrencyCode"] ?? "BDT";

    private string Date(DateTimeOffset at) => at.ToBusinessTime(Configuration).ToString("dd MMM yyyy");
    private string Money(decimal amount) => $"{Currency} {amount:N2}";
    private string PageLink(int page) => $"/payroll?period={Uri.EscapeDataString(Period)}&start={Start:yyyy-MM-dd}&end={End:yyyy-MM-dd}&page={page}";
}
