@page "/finance/bank"
@attribute [Authorize(Policy = AppPolicies.ManageUsers)]
@attribute [StreamRendering]
@using System.ComponentModel.DataAnnotations
@inject BankService Banks
@inject ClosingService Closings
@inject NavigationManager Navigation

<PageTitle>Bank & digital balance · @(Configuration["StoreName"] ?? "RetailPOS")</PageTitle>
<div class="page-heading">
    <h1>Bank & digital balance</h1>
    <div class="flex gap-2">
        <a href="/reports/statements/bank" class="btn-secondary">Bank statement</a>
        <a href="/finance/day" class="btn-secondary">Day / month closing</a>
    </div>
</div>
@if (Error is not null)
{
    <p class="error-panel" role="alert">@Error</p>
}
@if (Saved)
{
    <p class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50/80 p-3.5 text-sm font-medium text-emerald-800" role="status">
        Bank movement recorded successfully.
    </p>
}
@if (Data is null)
{
    <LoadingPanel Message="Loading bank balance…" />
}
else
{
    <div class="mb-6 grid gap-4 sm:grid-cols-3">
        <div class="metric">
            <p>Current balance</p>
            <strong class="text-2xl!">@Money(Data?.Balance ?? 0)</strong>
            <span class="metric-note">Combined bank, card and mobile wallet funds</span>
        </div>
        <div class="metric">
            <p>This month's opening</p>
            <strong class="text-2xl!">@Money(Data?.MonthOpening ?? 0)</strong>
            <span class="metric-note">@(Data?.MonthDate?.ToString("MMMM yyyy") ?? "Current month") starting position</span>
        </div>
        <div class="metric">
            <p>Account opening balance</p>
            <strong class="text-2xl!">@Money(Data?.Opening ?? 0)</strong>
            <span class="metric-note">@(Data?.OpeningDate?.ToString("dd MMM yyyy") ?? "Not recorded yet")</span>
        </div>
    </div>

    <section class="panel mb-6 max-w-2xl p-6">
        <div class="mb-5 flex border-b border-slate-200">
            <a href="/finance/bank?tab=transfer" class="pb-2.5 px-3 text-sm font-semibold transition border-b-2 @(ActiveTab == "transfer" ? "border-primary text-primary" : "border-transparent text-slate-500 hover:text-slate-700")">
                Cash Drawer ↔ Bank Transfer
            </a>
            <a href="/finance/bank?tab=adjustment" class="pb-2.5 px-3 text-sm font-semibold transition border-b-2 @(ActiveTab == "adjustment" ? "border-primary text-primary" : "border-transparent text-slate-500 hover:text-slate-700")">
                Bank Balance Adjustment
            </a>
        </div>

        @if (ActiveTab == "transfer")
        {
            <div class="mb-4 rounded-xl border border-blue-100 bg-blue-50/60 p-3 text-xs text-blue-900">
                <strong>Cash Drawer Transfer:</strong> Requires an open active cash drawer. Moves physical cash between drawer and bank account.
            </div>
            <form method="post" @formname="bank" @onsubmit="SaveAsync" data-enhance data-submit-indication="true">
                <AntiforgeryToken />
                <input type="hidden" name="Input.RequestId" value="@Input!.RequestId" />
                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label class="field-label" for="bank-action">Transfer direction</label>
                        <select id="bank-action" name="Input.Action" class="field">
                            <option value="deposit">Cash drawer → bank (Deposit)</option>
                            <option value="withdraw">Bank → cash drawer (Withdrawal)</option>
                        </select>
                    </div>
                    <div>
                        <label class="field-label" for="bank-amount">Amount</label>
                        <input id="bank-amount" name="Input.Amount" class="field" inputmode="decimal" min="0.01" step="0.01" required />
                    </div>
                    <div>
                        <label class="field-label" for="bank-date">Accounting date</label>
                        <input name="Input.Date" type="hidden" value="@Input.Date.ToString("yyyy-MM-dd")" />
                        <p id="bank-date" class="py-2 text-sm text-slate-700">@Input.Date.ToString("dd MMM yyyy") · working day</p>
                    </div>
                </div>
                <label class="field-label mt-4" for="bank-notes">Reason / reference</label>
                <input id="bank-notes" name="Input.Notes" class="field" maxlength="2000" placeholder="e.g. Daily cash deposit to main account" required />

                <div class="mt-4 rounded-xl border border-blue-200 bg-blue-50/70 p-3 space-y-2">
                    <label class="inline-flex items-center gap-2 cursor-pointer text-xs font-semibold text-blue-900 select-none">
                        <input type="checkbox" id="bank-backdate-toggle" name="Input.IsBackdate" value="true" class="rounded border-blue-300 text-blue-600 focus:ring-blue-500 cursor-pointer"
                               checked="@(Input?.IsBackdate == true)"
                               onchange="document.getElementById('bank-backdate-box').classList.toggle('hidden', !this.checked)" />
                        <span>Record historical transfer (backdate)</span>
                    </label>
                    <div id="bank-backdate-box" class="@(Input?.IsBackdate == true ? "" : "hidden")">
                        <label class="field-label text-blue-900 text-xs" for="bank-time">Transfer Date & Time</label>
                        <div class="relative max-w-xs flex items-center">
                            <input id="bank-time" type="datetime-local" name="Input.OccurredAt" class="field bg-white mt-1 text-xs w-full pr-8"
                                   value="@(Input?.OccurredAt?.ToBusinessTime(Configuration).ToString("yyyy-MM-ddTHH:mm"))" />
                            <button type="button" data-datetime-trigger="bank-time" class="absolute right-2 top-2 text-slate-400 hover:text-slate-600 cursor-pointer p-1" title="Open calendar with Done button">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                            </button>
                        </div>
                        <p class="text-[11px] text-blue-700 mt-1">Backfills land on earlier dates without interrupting live accounts.</p>
                    </div>
                </div>

                <button class="btn-primary mt-5" data-pending-text="Transferring…">Transfer funds</button>
            </form>
        }
        else
        {
            <div class="mb-4 rounded-xl border border-amber-100 bg-amber-50/60 p-3 text-xs text-amber-900">
                <strong>Bank Ledger Adjustment:</strong> Directly adjusts bank balance without affecting cash drawers. Use signed amounts (+ for interest/deposits, - for fees/corrections).
            </div>
            <form method="post" @formname="bank" @onsubmit="SaveAsync" data-enhance data-submit-indication="true">
                <AntiforgeryToken />
                <input type="hidden" name="Input.RequestId" value="@Input!.RequestId" />
                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label class="field-label" for="bank-action">Adjustment type</label>
                        <select id="bank-action" name="Input.Action" class="field">
                            @if (Data?.OpeningDate is null)
                            {
                                <option value="opening">Opening balance</option>
                            }
                            <option value="adjustment">Reconciliation adjustment (signed amount)</option>
                        </select>
                    </div>
                    <div>
                        <label class="field-label" for="bank-amount">Adjustment amount (+ / -)</label>
                        <input id="bank-amount" name="Input.Amount" class="field" inputmode="decimal" step="0.01" required />
                    </div>
                    <div>
                        <label class="field-label" for="bank-date">Accounting date</label>
                        <input name="Input.Date" type="hidden" value="@Input.Date.ToString("yyyy-MM-dd")" />
                        <p id="bank-date" class="py-2 text-sm text-slate-700">@Input.Date.ToString("dd MMM yyyy") · working day</p>
                    </div>
                </div>
                <label class="field-label mt-4" for="bank-notes">Reason / statement reference</label>
                <input id="bank-notes" name="Input.Notes" class="field" maxlength="2000" placeholder="e.g. Bank charges or statement reconciliation" required />
                <button class="btn-primary mt-5" data-pending-text="Recording…">Record adjustment</button>
            </form>
        }
    </section>
    <AccountStatement Account="bank" Date="Input!.Date" />
}

@code {
    [SupplyParameterFromQuery]
    public string? Tab { get; set; }

    [SupplyParameterFromQuery]
    public bool Saved { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "bank")]
    private BankInput? Input { get; set; }

    private BankPage? Data;
    private string? Error;
    private string ActiveTab => (Tab == "adjustment" || Input?.Action is "opening" or "adjustment") ? "adjustment" : "transfer";

    protected override async Task OnParametersSetAsync()
    {
        var selectedDate = await Closings.SelectedAsync(HttpContext.User, HttpContext.RequestAborted);
        if (HttpContext.Request.Method != "POST" || Input is null)
        {
            var defaultAction = ActiveTab == "adjustment" ? "adjustment" : "deposit";
            Input = new() { RequestId = Guid.NewGuid(), Date = selectedDate, Action = defaultAction };
        }
        Data = await Banks.ReadAsync(HttpContext.User, HttpContext.RequestAborted);
    }

    private async Task SaveAsync()
    {
        try
        {
            if (Input?.IsBackdate == true && Input?.OccurredAt.HasValue == true)
            {
                Input.OccurredAt = BusinessTime.FromBusinessWallClockToUtc(Input.OccurredAt.Value.DateTime, Configuration);
            }
            else if (Input?.IsBackdate != true && Input is not null)
            {
                Input.OccurredAt = null;
            }
            Input!.RequestId = Guid.NewGuid();
            await Banks.SaveAsync(HttpContext.User, Input!, HttpContext.RequestAborted);
            Navigation.NavigateTo($"/finance/bank?tab={ActiveTab}&saved=true");
        }
        catch (ValidationException exception)
        {
            Error = exception.Message;
        }
    }

    private string Money(decimal amount) => $"{Configuration["CurrencyCode"] ?? "BDT"} {amount:N2}";
}
