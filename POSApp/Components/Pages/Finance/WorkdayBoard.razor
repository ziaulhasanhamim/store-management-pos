@attribute [StreamRendering]
@inject ClosureService Closures
@inject IConfiguration Configuration
@inject ILogger<WorkdayBoard> Logger

@if (Data is null && Error is null)
{
    <LoadingPanel Message="Loading store operations…" />
}
else if (Error is not null)
{
    <p class="error-panel" role="alert">@Error</p>
}
else if (Data is not null)
{
    var day = Data;
    <section class="workday-board mb-7">
        <div class="flex flex-wrap items-start justify-between gap-5">
            <div>
                <p class="eyebrow text-blue-200!">Store operations</p>
                <h2 class="mt-2 text-2xl font-bold tracking-tight text-white">@day.Date.ToString("dddd, dd MMM yyyy")</h2>
                <p class="mt-2 text-sm text-blue-100">Continuous timeline active · Transactions are recorded live without working day locks</p>
            </div>
            <span class="status-pill @(day.OpenDrawers > 0 ? "status-pill-live" : "")">
                <span class="size-2 rounded-full @(day.OpenDrawers > 0 ? "bg-emerald-400 animate-pulse" : "bg-white/40")"></span>
                @day.OpenDrawers active shift@(day.OpenDrawers == 1 ? "" : "s") · @day.ClosedDrawers counted
            </span>
        </div>
        <div class="mt-6 flex flex-wrap gap-3">
            <a href="/sales" class="btn-primary bg-linear-to-r from-blue-500 to-indigo-600 hover:from-blue-400 hover:to-indigo-500 shadow-md shadow-blue-900/30">Start / Continue sales</a>
            <AuthorizeView Policy="@AppPolicies.ManageDrawer">
                <a href="/cash-drawer" class="inline-flex items-center justify-center rounded-lg border border-white/20 bg-white/10 px-4 py-2.5 text-sm font-medium text-white hover:bg-white/20 transition">Cash drawers & shifts</a>
            </AuthorizeView>
            <AuthorizeView Policy="@AppPolicies.ManageUsers">
                <a href="/finance/summary" class="inline-flex items-center justify-center rounded-lg border border-white/20 bg-white/10 px-4 py-2.5 text-sm font-medium text-white hover:bg-white/20 transition">Financial summary</a>
                <a href="/admin/date-corrections" class="inline-flex items-center justify-center rounded-lg border border-white/20 bg-white/10 px-4 py-2.5 text-sm font-medium text-white hover:bg-white/20 transition">Date audit log</a>
            </AuthorizeView>
        </div>
    </section>
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private OperatingDay? Data;
    private string? Error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Data = await Closures.OperatingDayAsync(HttpContext.User, HttpContext.RequestAborted);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Store operations could not load.");
            Error = "Unable to load store operations. Please reload.";
        }
    }
}
