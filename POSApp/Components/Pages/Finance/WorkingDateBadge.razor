@attribute [StreamRendering]
@inject ClosingService Closings
@inject CashDrawerService Drawers
@inject IConfiguration Configuration

@if (Date is not null)
{
    <div class="hidden sm:flex items-center gap-2">
        <AuthorizeView Policy="@AppPolicies.ManageUsers">
            <Authorized>
                <a href="/finance/summary" class="inline-flex items-center gap-1.5 rounded-lg bg-indigo-50/70 px-2.5 py-1 text-xs font-medium text-indigo-700 hover:bg-indigo-100/70 transition">
                    <span class="size-2 rounded-full bg-emerald-500"></span>
                    Today · @Date?.ToString("dd MMM")
                </a>
            </Authorized>
            <NotAuthorized>
                <span class="inline-flex items-center gap-1.5 rounded-lg bg-indigo-50/70 px-2.5 py-1 text-xs font-medium text-indigo-700">
                    <span class="size-2 rounded-full bg-emerald-500"></span>
                    Today · @Date?.ToString("dd MMM")
                </span>
            </NotAuthorized>
        </AuthorizeView>
        <AuthorizeView Policy="@AppPolicies.ManageDrawer">
            <a href="/cash-drawer" class="inline-flex items-center rounded-lg bg-slate-100 px-2 py-1 text-xs font-medium text-slate-700 hover:bg-slate-200 transition">
                Cash: @(CashLocation ?? "select location")
            </a>
        </AuthorizeView>
    </div>
    <div class="flex sm:hidden items-center">
        <AuthorizeView Policy="@AppPolicies.ManageUsers">
            <Authorized>
                <a href="/finance/summary" class="inline-flex items-center gap-1 rounded-md bg-indigo-50 px-2 py-1 text-[11px] font-semibold text-indigo-700" title="Today · @(Date?.ToString("dd MMM yyyy") ?? "…") · Cash: @(CashLocation ?? "select location")">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @(Date?.ToString("dd MMM") ?? "…")
                </a>
            </Authorized>
            <NotAuthorized>
                <span class="inline-flex items-center gap-1 rounded-md bg-indigo-50 px-2 py-1 text-[11px] font-semibold text-indigo-700" title="Today · @(Date?.ToString("dd MMM yyyy") ?? "…")">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @(Date?.ToString("dd MMM") ?? "…")
                </span>
            </NotAuthorized>
        </AuthorizeView>
    </div>
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private DateOnly? Date;
    private string? CashLocation;

    protected override async Task OnInitializedAsync()
    {
        Date = AccountingCalendar.Today(Configuration);
        try
        {
            CashLocation = await Drawers.SelectedLocationNameAsync(HttpContext.User, HttpContext.RequestAborted);
        }
        catch
        {
            CashLocation = null;
        }
    }
}
