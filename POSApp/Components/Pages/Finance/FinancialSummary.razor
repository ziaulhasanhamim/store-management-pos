@page "/finance/summary"
@page "/finance/closing"
@page "/finance/day"
@page "/finance/month"
@attribute [Authorize(Policy = AppPolicies.ManageUsers)]
@using System.ComponentModel.DataAnnotations
@inject ClosingService Closings
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<PageTitle>@(Kind == ClosingKind.Month ? "Month Financial Summary" : "Day Financial Summary") · @(Configuration["StoreName"] ?? "JAS International")</PageTitle>
<div class="page-heading no-print">
    <div>
        <h1>@(Kind == ClosingKind.Month ? "Monthly Financial Summary" : "Daily Financial Summary")</h1>
        <p class="text-xs text-slate-500 mt-1">Real-time continuous financial calculation based on current transactions</p>
    </div>
    <div class="flex flex-wrap gap-2">
        <a class="btn-primary" href="@($"/api/finance/summary.xlsx?date={Selected:yyyy-MM-dd}&period={Period}{(LocationId.HasValue ? $"&locationId={LocationId.Value}" : "")}")" data-enhance-nav="false">Export Excel (.xlsx)</a>
        <button type="button" class="btn-secondary" data-print>Print / PDF</button>
    </div>
</div>

<form method="get" action="@(Kind == ClosingKind.Month ? "/finance/month" : "/finance/day")" class="no-print mb-6 flex flex-wrap items-end gap-4" data-enhance data-submit-indication="true">
    <div>
        <label class="field-label" for="summary-date">@(Kind == ClosingKind.Month ? "Month" : "Day")</label>
        @if (Kind == ClosingKind.Month)
        {
            <input id="summary-date" type="month" name="month" class="field" value="@Selected.ToString("yyyy-MM")" required />
        }
        else
        {
            <input id="summary-date" type="date" name="date" class="field" value="@Selected.ToString("yyyy-MM-dd")" required />
        }
    </div>
    <div>
        <label class="field-label" for="location-filter">Stock location</label>
        <select id="location-filter" name="locationId" class="field">
            <option value="">All locations (Consolidated)</option>
            @foreach (var loc in Locations)
            {
                <option value="@loc.Id" selected="@(LocationId == loc.Id)">@loc.Name</option>
            }
        </select>
    </div>
    <button class="btn-secondary">View calculation</button>
    <a href="@(Kind == ClosingKind.Month ? $"/finance/day{(LocationId.HasValue ? $"?locationId={LocationId.Value}" : "")}" : $"/finance/month{(LocationId.HasValue ? $"?locationId={LocationId.Value}" : "")}")" class="btn-secondary">@(Kind == ClosingKind.Month ? "Switch to Day" : "Switch to Month")</a>
    <a href="/finance" class="btn-secondary">Finance overview</a>
</form>

@if (Error is not null)
{
    <p class="error-panel" role="alert">@Error</p>
}

@if (!Initialized)
{
    <LoadingPanel Message="Loading financial calculation…" />
}
else
{
    <FinanceLoad TData="ClosingTotals" Load="LoadAsync" Message="Calculating dynamic summary…">
        <ChildContent Context="loaded">
            <FinancialSummaryView Data="loaded" Kind="Kind" />
        </ChildContent>
    </FinanceLoad>
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    public DateOnly? Date { get; set; }

    [SupplyParameterFromQuery]
    public string? Period { get; set; }

    [SupplyParameterFromQuery]
    public string? Month { get; set; }

    [SupplyParameterFromQuery(Name = "locationId")]
    public int? LocationId { get; set; }

    private IReadOnlyList<StockLocationOption> Locations = [];
    private DateOnly Selected;
    private string? Error;
    private bool Initialized;
    private ClosingKind Kind => Period == "month" ? ClosingKind.Month : ClosingKind.Day;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            var path = new Uri(Navigation.Uri).AbsolutePath;
            Period = path == "/finance/month" || path == "/finance/closing" && Period == "month" ? "month" : "day";
            Locations = await Closings.LocationsAsync(HttpContext.User, HttpContext.RequestAborted);
            Selected = Date ?? await Closings.SelectedAsync(HttpContext.User, HttpContext.RequestAborted);
            if (Kind == ClosingKind.Month)
            {
                if (DateOnly.TryParseExact($"{Month}-01", "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.None, out var month))
                {
                    Selected = month;
                }
                Selected = new(Selected.Year, Selected.Month, 1);
            }
            Initialized = true;
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
    }

    private Task<ClosingTotals> LoadAsync() => Closings.ReadAsync(HttpContext.User, Selected, Kind, HttpContext.RequestAborted, LocationId);
}
