@page "/sales/{Id:int}/bill"
@page "/sales/bill/{Id:int}"
@attribute [Authorize(Policy = AppPolicies.MakeSales)]
@attribute [StreamRendering]
@inject SalesService Sales

<PageTitle>Invoice #@Id · @(Configuration["StoreName"] ?? "JAS International")</PageTitle>

<div class="page-heading no-print">
    <div class="flex flex-wrap items-center justify-between gap-4 w-full">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Invoice #@Id</h1>
            <p class="text-xs text-slate-500">Commercial Sales Bill & Receipt</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <!-- Format View Toggle -->
            <div class="inline-flex rounded-xl bg-slate-100 p-1 text-xs font-semibold text-slate-600">
                <button type="button" class="rounded-lg px-3 py-1.5 transition-colors @(ViewMode == "a4" ? "bg-white text-slate-900 shadow-sm" : "hover:text-slate-900")"
                        @onclick='() => ViewMode = "a4"'>
                    Full A4 Invoice
                </button>
                <button type="button" class="rounded-lg px-3 py-1.5 transition-colors @(ViewMode == "thermal" ? "bg-white text-slate-900 shadow-sm" : "hover:text-slate-900")"
                        @onclick='() => ViewMode = "thermal"'>
                    Thermal Receipt (80mm)
                </button>
            </div>

            <a href="/sales" class="btn-secondary">New sale</a>

            @if (Data?.IsVoided != true)
            {
                <button type="button" class="btn-primary" data-print="a4">
                    <Icon Name="printer" />
                    Print Invoice (A4)
                </button>
                <button type="button" class="btn-secondary" data-print="thermal">
                    <Icon Name="printer" />
                    Print Receipt (80mm)
                </button>
            }
            else
            {
                <span class="inline-flex items-center gap-1 rounded-xl bg-slate-100 px-4 py-2 text-xs font-semibold text-slate-500">
                    <Icon Name="lock" />
                    Printing Disabled (Voided)
                </span>
            }
        </div>
    </div>
</div>

<AuthorizeView Policy="@AppPolicies.ManageUsers">
    <a href="@($"/admin/records/sale/{Id}/edit")" class="no-print btn-secondary mb-5 inline-flex items-center gap-2">
        <Icon Name="edit" />
        Admin correction / delete
    </a>
</AuthorizeView>

@if (Loading)
{
    <LoadingPanel Message="Loading invoice…" />
}
else if (Data is null)
{
    <p class="text-slate-500">Invoice not found or unavailable to your account.</p>
}
else
{
    @if (Data.IsVoided)
    {
        <div class="mb-5 rounded-xl border border-rose-300 bg-rose-50 p-4 text-rose-800 shadow-sm flex items-center justify-between no-print">
            <div class="flex items-center gap-3">
                <Icon Name="trash" Class="text-rose-600 h-6 w-6 shrink-0" />
                <div>
                    <strong class="text-base font-bold uppercase tracking-wide">Transaction Voided / Reversed</strong>
                    <p class="text-xs text-rose-700">This sale was officially voided@(Data.VoidedAt is not null ? $" on {Data.VoidedAt.Value.ToBusinessTime(Configuration):dd MMM yyyy, HH:mm}" : ""). All inventory and payment postings have been reversed.</p>
                </div>
            </div>
            <span class="rounded bg-rose-200 px-3 py-1 text-xs font-bold uppercase tracking-wider text-rose-900">Voided</span>
        </div>
    }

    <!-- ========================================== -->
    <!-- 1. PROFESSIONAL FULL A4 INVOICE FORMAT     -->
    <!-- ========================================== -->
    <article class="invoice-sheet rounded-xl p-8 sm:p-10 border border-slate-200 relative @(ViewMode == "a4" ? "block" : "hidden sm:block")">
        @if (Data.IsVoided)
        {
            <div class="mb-6 rounded border-2 border-dashed border-rose-600 bg-rose-50/80 p-2 text-center font-bold uppercase tracking-widest text-rose-700">
                *** VOIDED TRANSACTION ***
            </div>
        }

        <!-- Top Header: Logo on Left, Store Contact on Right -->
        <header class="invoice-header flex flex-col sm:flex-row justify-between items-start gap-4">
            <div class="flex items-center gap-3.5">
                <img src="/images/jas-logo-dark.png" alt="Store Logo" class="h-14 w-14 object-contain shrink-0" />
                <div>
                    <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 uppercase font-sans">
                        @(Configuration["StoreName"] ?? "JAS INTERNATIONAL")
                    </h2>
                    <p class="text-xs text-slate-500 font-medium tracking-wide mt-0.5">
                        @(Configuration["StoreSubtitle"] ?? "Quality with Perfection")
                    </p>
                </div>
            </div>

            <div class="text-left sm:text-right text-xs leading-relaxed text-slate-600">
                <strong class="text-sm font-bold text-slate-900 block">@(Configuration["StoreName"] ?? "JAS International")</strong>
                <p>@(Configuration["Store:Address"] ?? "Khulna Shopping Complex, 41/42, 2nd Floor,")</p>
                <p>Khulna 9100, Bangladesh</p>
                <p class="font-medium text-slate-800">@(Configuration["Store:Phone"] ?? "01811-644447")</p>
                <p class="text-sky-600">@(Configuration["Store:Email"] ?? "info@jasinternational.com")</p>
            </div>
        </header>

        <!-- Cyan/Teal Horizontal Divider -->
        <div class="my-5 border-b border-sky-400"></div>

        <!-- Meta Section: Customer Info (Left) & Invoice Identifier (Right) -->
        <section class="invoice-meta grid grid-cols-1 sm:grid-cols-2 gap-6 items-start">
            <div class="border-l-4 border-sky-600 pl-3">
                <span class="block text-[11px] font-bold tracking-widest text-slate-400 uppercase">INVOICE TO:</span>
                <strong class="block text-xl font-black text-slate-900 mt-0.5">@(Data.Customer ?? "Walk-in Customer")</strong>
                @if (!string.IsNullOrWhiteSpace(Data.CustomerAddress))
                {
                    <p class="text-xs text-slate-600 mt-0.5">@Data.CustomerAddress</p>
                }
                @if (!string.IsNullOrWhiteSpace(Data.CustomerPhone))
                {
                    <p class="text-xs font-semibold text-slate-800 mt-0.5">@Data.CustomerPhone</p>
                }
            </div>

            <div class="text-left sm:text-right">
                <h3 class="text-2xl sm:text-3xl font-black text-sky-600 tracking-tight">INVOICE : @Data.Id</h3>
                <p class="text-xs text-slate-700 mt-1">Date of Invoice: <span class="font-bold text-slate-900">@Data.At.ToBusinessTime(Configuration).ToString("dd/MM/yyyy")</span></p>
                <p class="text-xs text-slate-500 mt-0.5">Time: @Data.At.ToBusinessTime(Configuration).ToString("hh:mm:ss tt") · Sold by: <span class="font-medium text-slate-800">@Data.Cashier</span></p>
            </div>
        </section>

        <!-- Line Items Table (with Multi-Page Repeat Header Support) -->
        <table class="invoice-table w-full text-xs mt-6 border-collapse">
            <thead>
                <tr class="border-y-2 border-black font-bold text-slate-900 uppercase tracking-wider">
                    <th class="py-2.5 px-2 text-left w-10">#</th>
                    <th class="py-2.5 px-2 text-left">DESCRIPTION</th>
                    <th class="py-2.5 px-2 text-center w-24">QUANTITY</th>
                    <th class="py-2.5 px-2 text-right w-28">UNIT PRICE</th>
                    <th class="py-2.5 px-2 text-right w-24">DISCOUNT</th>
                    <th class="py-2.5 px-2 text-right w-28">TOTAL</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
                @{
                    int index = 1;
                    decimal totalQty = 0;
                }
                @foreach (var line in Data.Lines)
                {
                    totalQty += line.Quantity;
                    <tr class="text-slate-800">
                        <td class="py-2 px-2 text-left font-medium">@(index++)</td>
                        <td class="py-2 px-2 text-left font-semibold">
                            <span class="text-slate-900">@line.Name</span>
                            @if (!string.IsNullOrWhiteSpace(line.Warranty))
                            {
                                <span class="inline-block ml-1.5 rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-normal text-slate-600">ⓦ @line.Warranty</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(line.Barcode))
                            {
                                <span class="block text-[10px] text-slate-400 font-mono font-normal">@line.Barcode</span>
                            }
                        </td>
                        <td class="py-2 px-2 text-center font-medium whitespace-nowrap">@line.Quantity.ToString("0.###")</td>
                        <td class="py-2 px-2 text-right font-medium whitespace-nowrap font-mono">@line.UnitPrice.ToString("N2")</td>
                        <td class="py-2 px-2 text-right font-medium whitespace-nowrap font-mono">@line.UnitDiscount.ToString("N2")</td>
                        <td class="py-2 px-2 text-right font-bold text-slate-900 whitespace-nowrap font-mono">
                            @(line.Total < 0 ? $"-{Math.Abs(line.Total):N2}" : line.Total.ToString("N2"))
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="border-t-2 border-black font-bold text-slate-900">
                    <td colspan="2" class="py-2.5 px-2 text-right text-xs uppercase tracking-wider">Total Qnty</td>
                    <td class="py-2.5 px-2 text-center font-black text-sm">@totalQty.ToString("0.###")</td>
                    <td colspan="3" class="py-2.5 px-2"></td>
                </tr>
            </tfoot>
        </table>

        <!-- Summary & Financial Breakdown (Bottom Section) -->
        <footer class="invoice-summary-block mt-8 flex flex-col md:flex-row justify-between items-start gap-8 pt-4">
            <!-- Left: Thank you & Barcode -->
            <div class="flex-1">
                <h4 class="text-2xl sm:text-3xl font-light text-slate-800 tracking-tight font-sans">Thank you!</h4>
                @if (!string.IsNullOrWhiteSpace(Data.Notes))
                {
                    <p class="text-xs text-slate-500 mt-2 max-w-sm">@Data.Notes</p>
                }
                <div class="mt-5 flex flex-col items-start">
                    <div class="barcode-wrapper w-44">
                        @((MarkupString)BarcodeService.Svg($"POS {Data.Id}"))
                    </div>
                    <span class="mt-1 text-xs font-mono font-bold tracking-widest text-slate-800">POS @Data.Id</span>
                </div>
                <p class="mt-4 text-[10px] text-slate-400 max-w-sm leading-relaxed">
                    There is no return, exchange or refund policy, Must be checked for official defects here.
                </p>
            </div>

            <!-- Right: Financial Breakdown Table -->
            <div class="w-full md:w-80 border-t border-slate-200 md:border-none pt-2 md:pt-0">
                <table class="w-full text-xs font-medium text-slate-700">
                    <tr class="border-b border-slate-200">
                        <td class="py-1.5 text-left uppercase text-slate-600">SUB TOTAL</td>
                        <td class="py-1.5 text-right font-mono font-bold text-slate-900">@Data.Subtotal.ToString("N2")</td>
                    </tr>
                    @if (Data.Discount > 0)
                    {
                        <tr class="border-b border-slate-200 text-rose-600">
                            <td class="py-1.5 text-left uppercase">DISCOUNT</td>
                            <td class="py-1.5 text-right font-mono font-bold">-@Data.Discount.ToString("N2")</td>
                        </tr>
                    }
                    <tr class="border-b border-slate-200">
                        <td class="py-1.5 text-left uppercase text-slate-600">INVOICE TOTAL</td>
                        <td class="py-1.5 text-right font-mono font-bold text-slate-900">@Data.Total.ToString("N2")</td>
                    </tr>
                    @if (Data.PreviousDue > 0)
                    {
                        <tr class="border-b border-slate-200">
                            <td class="py-1.5 text-left uppercase text-slate-600">PREVIOUS DUES</td>
                            <td class="py-1.5 text-right font-mono font-bold text-slate-900">@Data.PreviousDue.ToString("N2")</td>
                        </tr>
                    }
                    <tr class="border-b border-slate-200">
                        <td class="py-1.5 text-left uppercase text-slate-600">GRAND TOTAL</td>
                        <td class="py-1.5 text-right font-mono font-bold text-slate-900">@((Data.Total + Data.PreviousDue).ToString("N2"))</td>
                    </tr>
                    <tr class="border-b border-slate-200">
                        <td class="py-1.5 text-left uppercase text-slate-600">PAYMENT</td>
                        <td class="py-1.5 text-right font-mono font-bold text-slate-900">@Data.Paid.ToString("N2")</td>
                    </tr>
                </table>

                @{
                    var presentDue = Data.Total + Data.PreviousDue - Data.Paid;
                }
                <div class="mt-3 pt-2.5 border-t-2 border-black flex justify-between items-center">
                    @if (presentDue > 0)
                    {
                        <span class="text-base font-black text-emerald-700 tracking-tight uppercase">PRESENT DUES</span>
                        <span class="text-base font-black text-emerald-700 font-mono">@presentDue.ToString("N2")</span>
                    }
                    else if (Data.Tendered > Data.Paid)
                    {
                        <span class="text-base font-black text-emerald-700 tracking-tight uppercase">CHANGE DUE</span>
                        <span class="text-base font-black text-emerald-700 font-mono">@((Data.Tendered - Data.Paid).ToString("N2"))</span>
                    }
                    else
                    {
                        <span class="text-base font-black text-emerald-700 tracking-tight uppercase">PAID IN FULL</span>
                        <span class="text-base font-black text-emerald-700 font-mono">0.00</span>
                    }
                </div>
            </div>
        </footer>
    </article>

    <!-- ========================================== -->
    <!-- 2. COMPACT THERMAL 80MM RECEIPT FORMAT     -->
    <!-- ========================================== -->
    <article class="thermal-sheet rounded-xl p-5 border border-slate-200 relative @(ViewMode == "thermal" ? "block" : "hidden")">
        @if (Data.IsVoided)
        {
            <div class="mb-3 rounded border-2 border-dashed border-rose-600 bg-rose-50/80 p-2 text-center font-bold uppercase tracking-widest text-rose-700">
                *** VOIDED TRANSACTION ***
            </div>
        }

        <div class="text-center pb-2">
            <div class="flex items-center justify-center gap-2 mb-1">
                <img src="/images/jas-logo-dark.png" alt="Logo" class="h-7 w-7 object-contain shrink-0" />
                <span class="text-lg font-black tracking-tight uppercase">@(Configuration["StoreName"] ?? "JAS INTERNATIONAL")</span>
            </div>
            <p class="text-xs leading-tight">@(Configuration["Store:Address"] ?? "Khulna Shopping Complex, 41/42, 2nd Floor, Khulna 9100")</p>
            <p class="text-xs leading-tight">@(Configuration["Store:Phone"] ?? "01811-644447")</p>
            <h3 class="mt-2 text-xs font-bold uppercase tracking-wide">Mini Invoice</h3>
            <div class="my-1 border-b border-dashed border-neutral-400"></div>
            <div class="text-[11px] space-y-0.5">
                <p>Sold by: @(Data.Cashier)</p>
                <p>@Data.At.ToBusinessTime(Configuration).ToString("dd.MM.yyyy hh:mm:ss tt")</p>
            </div>
        </div>

        <table class="w-full text-xs my-2 border-collapse">
            <thead>
                <tr class="border-y border-black font-bold">
                    <th class="py-1 text-left">Item</th>
                    <th class="py-1 text-center px-1">Qty</th>
                    <th class="py-1 text-right">Total</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-neutral-200">
                @foreach (var line in Data.Lines)
                {
                    <tr>
                        <td class="py-1 pr-1 text-left leading-tight">
                            <span class="font-medium">@line.Name</span>
                            @if (!string.IsNullOrWhiteSpace(line.Warranty))
                            {
                                <span class="inline-block ml-1 text-[10px]">ⓦ @line.Warranty</span>
                            }
                        </td>
                        <td class="py-1 text-center font-medium px-1 whitespace-nowrap align-top">@line.Quantity.ToString("0.###")</td>
                        <td class="py-1 text-right font-medium whitespace-nowrap align-top font-mono">
                            @(line.Total < 0 ? $"-{Math.Abs(line.Total):N2}" : line.Total.ToString("N2"))
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="border-t border-black pt-2 space-y-1 text-xs">
            <div class="flex justify-between items-center text-sm font-black">
                <span>Total</span>
                <span>@Data.Total.ToString("N2")</span>
            </div>
            @if (Data.Paid != 0)
            {
                <div class="flex justify-between items-center text-xs">
                    <span>Cash</span>
                    <span>-@Data.Paid.ToString("N2")</span>
                </div>
            }
            <div class="flex justify-between items-center text-xs font-semibold">
                <span>Change Due</span>
                <span>@((Data.Tendered > Data.Paid ? Data.Tendered - Data.Paid : 0m).ToString("N2"))</span>
            </div>
        </div>

        <div class="mt-4 text-center text-[10px] leading-tight text-neutral-600">
            There is no return, exchange or refund policy, Must be checked for official defects here.
        </div>

        <div class="mt-3 flex flex-col items-center justify-center">
            <div class="barcode-wrapper w-40">
                @((MarkupString)BarcodeService.Svg($"POS {Data.Id}"))
            </div>
            <span class="mt-0.5 text-xs font-mono font-bold tracking-widest">POS @Data.Id</span>
        </div>
    </article>
}

@code {
    [Parameter]
    public int Id { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private SaleBill? Data;
    private bool Loading = true;
    private string ViewMode = "a4";

    protected override async Task OnParametersSetAsync()
    {
        Data = await Sales.BillAsync(HttpContext.User, Id, HttpContext.RequestAborted);
        Loading = false;
    }
}
