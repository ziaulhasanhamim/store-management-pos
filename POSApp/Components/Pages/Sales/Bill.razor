@page "/sales/{Id:int}/bill"
@page "/sales/bill/{Id:int}"
@attribute [Authorize(Policy = AppPolicies.MakeSales)]
@attribute [StreamRendering]
@inject SalesService Sales

<PageTitle>Bill #@Id · @(Configuration["StoreName"] ?? "JAS International")</PageTitle>

<div class="page-heading no-print">
    <h1>Bill #@Id</h1>
    <div class="flex flex-wrap items-center gap-2">
        <a href="/sales" class="btn-secondary">New sale</a>
        @if (Data?.IsVoided != true)
        {
            <button type="button" class="btn-primary" data-print="thermal">
                <Icon Name="printer" />
                Print receipt (80mm)
            </button>
            <button type="button" class="btn-secondary" data-print="a4">
                <Icon Name="file-text" />
                Print A4
            </button>
        }
        else
        {
            <span class="inline-flex items-center gap-1 rounded-xl bg-slate-100 px-4 py-2 text-xs font-semibold text-slate-500">
                <Icon Name="lock" />
                Printing Disabled (Voided)
            </span>
        }
    </div>
</div>

<AuthorizeView Policy="@AppPolicies.ManageUsers">
    <a href="@($"/admin/records/sale/{Id}/edit")" class="no-print btn-secondary mb-5 inline-flex items-center gap-2">
        <Icon Name="edit" />
        Admin correction / delete
    </a>
</AuthorizeView>

@if (Loading)
{
    <LoadingPanel Message="Loading bill…" />
}
else if (Data is null)
{
    <p class="text-slate-500">Bill not found or unavailable to your account.</p>
}
else
{
    @if (Data.IsVoided)
    {
        <div class="mb-5 rounded-xl border border-rose-300 bg-rose-50 p-4 text-rose-800 shadow-sm flex items-center justify-between no-print">
            <div class="flex items-center gap-3">
                <Icon Name="trash" Class="text-rose-600 h-6 w-6 shrink-0" />
                <div>
                    <strong class="text-base font-bold uppercase tracking-wide">Transaction Voided / Reversed</strong>
                    <p class="text-xs text-rose-700">This sale was officially voided@(Data.VoidedAt is not null ? $" on {Data.VoidedAt.Value.ToBusinessTime(Configuration):dd MMM yyyy, HH:mm}" : ""). All inventory and payment postings have been reversed.</p>
                </div>
            </div>
            <span class="rounded bg-rose-200 px-3 py-1 text-xs font-bold uppercase tracking-wider text-rose-900">Voided</span>
        </div>
    }

    <article class="bill print-area mx-auto max-w-[420px] rounded-2xl bg-white p-6 shadow-sm border border-slate-200 relative text-black">
        @if (Data.IsVoided)
        {
            <div class="mb-4 rounded border-2 border-dashed border-rose-600 bg-rose-50/80 p-2 text-center font-bold uppercase tracking-widest text-rose-700">
                *** VOIDED TRANSACTION ***
            </div>
        }

        <!-- Store Header -->
        <div class="store-header text-center">
            <div class="flex items-center justify-center gap-2 mb-1.5">
                <img src="/images/jas-logo-dark.png" alt="JAS Logo" class="h-8 w-8 object-contain shrink-0" />
                <span class="text-xl font-black tracking-tight uppercase font-sans">@(Configuration["StoreName"] ?? "JAS INTERNATIONAL")</span>
            </div>
            <p class="text-xs leading-tight text-neutral-800">@(Configuration["Store:Address"] ?? "Khulna Shopping Complex, 41/42,")</p>
            <p class="text-xs leading-tight text-neutral-800">2nd Floor, Khulna 9100</p>
            <p class="text-xs leading-tight text-neutral-800">@(Configuration["Store:Phone"] ?? "01811-644447")</p>

            <h3 class="mt-3 text-sm font-bold tracking-wide">Mini Invoice</h3>
            <div class="my-1.5 border-b border-dashed border-neutral-400"></div>
            <div class="text-xs text-neutral-800 space-y-0.5">
                <p>Sold by: @(Data.Cashier)</p>
                <p>@Data.At.ToBusinessTime(Configuration).ToString("dd.MM.yyyy hh:mm:ss tt")</p>
            </div>
            @if (!string.IsNullOrWhiteSpace(Data.Customer) && !Data.Customer.Equals("Walk-in", StringComparison.OrdinalIgnoreCase))
            {
                <p class="text-xs text-neutral-600 mt-1">Customer: @Data.Customer</p>
            }
        </div>

        <!-- Items Table -->
        <table class="w-full text-xs my-3 border-collapse">
            <thead>
                <tr class="border-y border-black font-bold text-neutral-900">
                    <th class="py-1.5 text-left">Item</th>
                    <th class="py-1.5 text-center px-2">Qty</th>
                    <th class="py-1.5 text-right">Total</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-neutral-200">
                @foreach (var line in Data.Lines)
                {
                    <tr>
                        <td class="py-1.5 pr-2 text-left leading-tight text-neutral-900">
                            <span class="font-medium">@line.Name</span>
                            @if (!string.IsNullOrWhiteSpace(line.Warranty))
                            {
                                <span class="inline-block ml-1 text-[11px] font-normal text-neutral-700">ⓦ @line.Warranty</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(line.Barcode))
                            {
                                <span class="block text-[10px] text-neutral-500 font-mono">@line.Barcode</span>
                            }
                        </td>
                        <td class="py-1.5 text-center font-medium px-2 whitespace-nowrap align-top">
                            @line.Quantity.ToString("0.###")
                        </td>
                        <td class="py-1.5 text-right font-medium whitespace-nowrap align-top">
                            @(line.Total < 0 ? $"-৳. {Math.Abs(line.Total):N2}" : $"৳. {line.Total:N2}")
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Totals & Payment Breakdown -->
        <div class="border-t-2 border-black pt-2 space-y-1 text-xs">
            <div class="flex justify-between items-center text-base font-black">
                <span>Total</span>
                <span>@(Data.Total < 0 ? $"-৳. {Math.Abs(Data.Total):N2}" : $"৳. {Data.Total:N2}")</span>
            </div>
            @if (Data.Paid != 0)
            {
                <div class="flex justify-between items-center text-xs font-semibold text-neutral-800">
                    <span>Cash</span>
                    <span>-৳. @Data.Paid.ToString("N2")</span>
                </div>
            }
            <div class="flex justify-between items-center text-xs font-semibold text-neutral-800">
                <span>Change Due</span>
                <span>৳. @((Data.Tendered > Data.Paid ? Data.Tendered - Data.Paid : 0m).ToString("N2"))</span>
            </div>
            @if (Data.Total > Data.Paid)
            {
                <div class="flex justify-between items-center text-xs font-bold text-neutral-900 border-t border-dashed border-neutral-300 pt-1">
                    <span>Due</span>
                    <span>৳. @((Data.Total - Data.Paid).ToString("N2"))</span>
                </div>
            }
        </div>

        @if (Data.Payments.Length > 1)
        {
            <div class="mt-2 pt-2 border-t border-dashed border-neutral-300 space-y-0.5 text-[11px] text-neutral-600">
                @foreach (var payment in Data.Payments)
                {
                    <div class="flex justify-between">
                        <span>@SplitPayments.MethodName(payment.Method)</span>
                        <span>৳. @Math.Abs(payment.Amount).ToString("N2")</span>
                    </div>
                }
            </div>
        }

        <!-- Official Return Policy Note -->
        <div class="mt-5 text-center text-[10px] leading-tight text-neutral-700 font-medium">
            There is no return, exchange or refund policy, Must be checked for official defects here.
        </div>

        <!-- Scannable Code 128 Barcode -->
        <div class="mt-3 flex flex-col items-center justify-center">
            <div class="barcode-wrapper w-44">
                @((MarkupString)BarcodeService.Svg($"POS {Data.Id}"))
            </div>
            <span class="mt-0.5 text-xs font-mono font-bold tracking-widest text-neutral-900">POS @Data.Id</span>
        </div>
    </article>
}

@code {
    [Parameter]
    public int Id { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private SaleBill? Data;
    private bool Loading = true;

    protected override async Task OnParametersSetAsync()
    {
        Data = await Sales.BillAsync(HttpContext.User, Id, HttpContext.RequestAborted);
        Loading = false;
    }
}
