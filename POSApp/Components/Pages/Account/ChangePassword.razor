@page "/account/change-password"
@layout AuthLayout
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using POSApp.Persistence.Entities
@using POSApp.Services
@inject UserAdministration Administration
@inject UserManager<User> UserManager
@inject SignInManager<User> SignInManager
@inject NavigationManager Navigation

<PageTitle>Change password · @(Configuration["StoreName"] ?? "RetailPOS")</PageTitle>

<h1 class="text-2xl font-semibold tracking-tight text-slate-900">Update your password</h1>
<p class="mt-2 mb-6 text-sm text-slate-500">
    Choose a strong personal password of at least 8 characters (including at least one digit) to secure your account.
</p>

@if (Errors.Length > 0)
{
    <div role="alert" class="mb-5 rounded-lg bg-red-50 p-3 text-sm text-red-700">
        <ul class="list-inside list-disc">
            @foreach (var err in Errors)
            {
                <li>@err</li>
            }
        </ul>
    </div>
}

<EditForm Model="Input" method="post" FormName="change-password" Enhance data-submit-indication="true" OnValidSubmit="SubmitAsync" OnInvalidSubmit="ClearPasswords">
    <DataAnnotationsValidator />
    <div class="space-y-5">
        <div>
            <label for="current-password" class="field-label">Current password</label>
            <InputText id="current-password" @bind-Value="Input!.CurrentPassword" type="password" class="field" autocomplete="current-password" autofocus required />
            <ValidationMessage For="() => Input!.CurrentPassword" />
        </div>
        <div>
            <label for="new-password" class="field-label">New password</label>
            <InputText id="new-password" @bind-Value="Input!.NewPassword" type="password" class="field" autocomplete="new-password" minlength="8" required />
            <ValidationMessage For="() => Input!.NewPassword" />
        </div>
        <div>
            <label for="confirm-password" class="field-label">Confirm new password</label>
            <InputText id="confirm-password" @bind-Value="Input!.ConfirmPassword" type="password" class="field" autocomplete="new-password" minlength="8" required />
            <ValidationMessage For="() => Input!.ConfirmPassword" />
        </div>

        <button type="submit" class="btn-primary w-full" data-pending-text="Updating password…">
            Save new password
        </button>

        <div class="flex items-center justify-between pt-2 text-xs text-slate-500">
            <a href="/" class="hover:text-indigo-600">Return to workspace</a>
            <a href="/account/logout" class="hover:text-rose-600">Sign out</a>
        </div>
    </div>
</EditForm>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "change-password")]
    private ChangePasswordInput? Input { get; set; }

    private string[] Errors = [];

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private async Task SubmitAsync()
    {
        var result = await Administration.ChangeOwnPasswordAsync(
            HttpContext.User,
            Input!.CurrentPassword,
            Input.NewPassword,
            Input.ConfirmPassword);

        ClearPasswords(null);

        if (!result.Succeeded)
        {
            Errors = result.Errors.Select(e => e.Description).ToArray();
            return;
        }

        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is not null)
        {
            await SignInManager.RefreshSignInAsync(user);
        }

        Navigation.NavigateTo("/");
    }

    private void ClearPasswords(EditContext? _)
    {
        if (Input is not null)
        {
            Input.CurrentPassword = string.Empty;
            Input.NewPassword = string.Empty;
            Input.ConfirmPassword = string.Empty;
        }
    }
}
