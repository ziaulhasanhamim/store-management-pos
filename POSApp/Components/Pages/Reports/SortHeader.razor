@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation

<th class="@Class @(Numeric ? "text-right" : null)" aria-sort="@Direction">
    <a href="@SortUrl" data-enhance class="table-sort" title="@($"Sort {Label} {NextDescendingText}")">
        <span>@Label</span>
        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true" class="sort-icon">
            <path d="M8 2 12 6H4Z" opacity="@(IsAsc ? "1" : ".3")" />
            <path d="m8 14 4-4H4Z" opacity="@(IsDesc ? "1" : ".3")" />
        </svg>
    </a>
</th>

@code {
    [Parameter]
    public string? Class { get; set; }

    [Parameter, EditorRequired]
    public string Column { get; set; } = "";

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public string Sort { get; set; } = "";

    [Parameter]
    public bool Numeric { get; set; }

    private bool IsAsc => string.Equals(Sort, Column, StringComparison.OrdinalIgnoreCase);
    private bool IsDesc => string.Equals(Sort, Column + "-desc", StringComparison.OrdinalIgnoreCase) || string.Equals(Sort, Column + "-descending", StringComparison.OrdinalIgnoreCase);
    private string Direction => IsAsc ? "ascending" : IsDesc ? "descending" : "none";
    private string NextDescendingText => IsAsc ? "descending" : "ascending";

    private string SortUrl
    {
        get
        {
            var uri = new Uri(Navigation.Uri);
            var query = QueryHelpers.ParseQuery(uri.Query)
                .ToDictionary(pair => pair.Key, pair => (string?)pair.Value.ToString());
            query["sort"] = IsAsc ? $"{Column}-desc" : Column;
            query["page"] = "1";
            return QueryHelpers.AddQueryString(uri.AbsolutePath, query);
        }
    }
}
