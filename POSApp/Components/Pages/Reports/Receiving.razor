@page "/reports/receiving"
@attribute [Authorize(Policy = AppPolicies.ManageInventory)]
@attribute [StreamRendering]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.QuickGrid
@inject ReceivingReportService Reports
@inject NavigationManager Navigation
@inject ILogger<Receiving> Logger

<PageTitle>Receiving & transfers report · @(Configuration["StoreName"] ?? "RetailPOS")</PageTitle>

<div class="page-heading no-print">
    <h1>Receiving & transfers report</h1>
    <div class="flex gap-3">
        <a href="/receiving" class="btn-secondary">Receive / transfer</a>
        <button type="button" class="btn-secondary" data-print>Print</button>
    </div>
</div>
<ReportFilters Path="/reports/receiving" Period="@Period" Range="Data?.Range" Start="Start" End="End" Search="@Search" Sort="@Sort"
    SortOptions="SortOptions" SearchHint="Purchase / transfer ID, supplier or location" PageSize="PageSize"
    ShowLocation="true" LocationId="LocationId" Locations="@(Data?.Locations ?? [])" />

@if (Error is not null)
{
    <p class="error-panel" role="alert">@Error</p>
}
<section class="print-area">
    @if (Data is not null)
    {
        <p class="mb-4 text-sm text-slate-500">
            @Data.Range.Start.ToString("dd MMM yyyy") – @Data.Range.End.ToString("dd MMM yyyy") ·
            @(Data.Locations.FirstOrDefault(location => location.Id == LocationId)?.Name ?? "All locations")
        </p>
        <div class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
            <div class="metric">
                <p>Purchases / supplier returns</p>
                <strong class="text-2xl!">@Money(Data.PurchaseValue)</strong>
            </div>
            <div class="metric">
                <p>Purchase payments</p>
                <strong class="text-2xl!">@Money(Data.SupplierPaid)</strong>
                <span class="metric-note">Unpaid / credit @Money(Data.SupplierUnpaid)</span>
            </div>
            <div class="metric">
                <p>Transfers in</p>
                <strong class="text-2xl!">@Money(Data.TransferInValue)</strong>
            </div>
            <div class="metric">
                <p>Transfers out</p>
                <strong class="text-2xl!">@Money(Data.TransferOutValue)</strong>
            </div>
            <div class="metric">
                <p>Net received value</p>
                <strong class="text-2xl!">@Money(Data.NetValue)</strong>
            </div>
        </div>
    }

    <div class="panel table-scroll">
        @if (Data is null)
        {
            <table class="data-table compact-table w-full" aria-busy="true">
                <tbody>
                    <TableStatusRow Columns="6" Loading="@(Error is null)" Error="@(Error is not null)"
                        Message="@(Error ?? "Loading receiving and transfers…")" />
                </tbody>
            </table>
        }
        else
        {
            <QuickGrid ItemsProvider="@itemsProvider" Pagination="@pagination" class="data-table compact-table w-full" aria-busy="@(Data is null && Error is null)">
                <TemplateColumn Title="ID" SortBy="@sortById" Class="w-24 text-center" HeaderClass="@GetSortClass("id")" Align="Align.Center">
                    <HeaderTemplate>
                        <a href="@GetSortUrl("id")" class="col-title" data-enhance>ID</a>
                    </HeaderTemplate>
                    <ChildContent>
                        <a href="@(context.IsTransfer ? $"/receiving?mode=transfer#transfer-{context.Id}" : $"/receiving/{context.Id}")" class="font-bold text-blue-700 text-xs hover:underline">
                            @(context.IsTransfer ? "Transfer" : "Purchase") #@context.Id
                        </a>
                        <span class="mt-0.5 block text-[10px] text-slate-400">
                            @(context.IsTransfer ? (context.Quantity >= 0 ? "Transfer in" : "Transfer out") : (context.Quantity >= 0 ? "Receiving" : "Supplier return"))
                        </span>
                        @if (!string.IsNullOrWhiteSpace(context.Number))
                        {
                            <span class="block max-w-28 truncate font-mono text-[10px] text-slate-400 mx-auto" title="@context.Number">@context.Number</span>
                        }
                    </ChildContent>
                </TemplateColumn>
                <TemplateColumn Title="Date" SortBy="@sortByDate" HeaderClass="@GetSortClass("date")" Class="whitespace-nowrap">
                    <HeaderTemplate>
                        <a href="@GetSortUrl("date")" class="col-title" data-enhance>Date</a>
                    </HeaderTemplate>
                    <ChildContent>
                        <span class="text-xs text-slate-600 font-mono">@context.At.ToBusinessTime(Configuration).ToString("dd MMM yyyy, HH:mm")</span>
                    </ChildContent>
                </TemplateColumn>
                <TemplateColumn Title="From → to" SortBy="@sortBySource" HeaderClass="@GetSortClass("source")">
                    <HeaderTemplate>
                        <a href="@GetSortUrl("source")" class="col-title" data-enhance>From → to</a>
                    </HeaderTemplate>
                    <ChildContent>
                        <span class="text-xs font-medium text-slate-800">@context.Source → @context.Destination</span>
                        @if (context.Items.Count > 0)
                        {
                            <details class="mt-1">
                                <summary class="cursor-pointer text-[11px] font-semibold text-blue-700 hover:text-blue-900">View @context.Items.Count @(context.Items.Count == 1 ? "item" : "items")</summary>
                                <div class="mt-1.5 rounded border border-slate-200 bg-white p-2">
                                    <ReceivingLineTable Items="context.Items" />
                                </div>
                            </details>
                        }
                    </ChildContent>
                </TemplateColumn>
                <TemplateColumn Title="Quantity" SortBy="@sortByQuantity" Align="Align.Right" Class="whitespace-nowrap" HeaderClass="@GetSortClass("quantity")">
                    <HeaderTemplate>
                        <a href="@GetSortUrl("quantity")" class="col-title" data-enhance>Quantity</a>
                    </HeaderTemplate>
                    <ChildContent>
                        <span class="font-mono text-xs text-slate-800">@context.Quantity.ToString("+0.###;-0.###;0")</span>
                    </ChildContent>
                </TemplateColumn>
                <TemplateColumn Title="Stock value" SortBy="@sortByValue" Align="Align.Right" Class="whitespace-nowrap" HeaderClass="@GetSortClass("value")">
                    <HeaderTemplate>
                        <a href="@GetSortUrl("value")" class="col-title" data-enhance>Stock value</a>
                    </HeaderTemplate>
                    <ChildContent>
                        <span class="font-mono text-xs font-semibold text-slate-900">@Money(context.Value)</span>
                    </ChildContent>
                </TemplateColumn>
                <TemplateColumn Title="Paid / Due" Align="Align.Right" Class="whitespace-nowrap">
                    <HeaderTemplate>
                        <span class="text-xs font-semibold text-slate-700">Paid / Due</span>
                    </HeaderTemplate>
                    <ChildContent>
                        @if (!context.IsTransfer)
                        {
                            <span class="font-mono text-xs text-slate-700">@Money(context.Paid)</span>
                            @if (context.Unpaid != 0)
                            {
                                <span class="block font-mono text-[10px] font-semibold @(context.Unpaid > 0 ? "text-rose-600" : "text-emerald-600")">
                                    @(context.Unpaid > 0 ? "Due: " : "Credit: ")@Money(Math.Abs(context.Unpaid))
                                </span>
                            }
                        }
                        else
                        {
                            <span class="text-xs text-slate-400">—</span>
                        }
                    </ChildContent>
                </TemplateColumn>
            </QuickGrid>
            @if (Data is not null && Data.Rows.Count > 0)
            {
                <div class="border-t border-slate-200 bg-slate-50/80 px-4 py-2.5 flex flex-wrap items-center justify-between gap-3 text-xs">
                    <span class="font-medium text-slate-600">This page net received: <strong class="text-slate-900 font-mono">@Money(Data.Rows.Sum(row => row.Value))</strong></span>
                    <span class="font-medium text-slate-600">All matching transactions (@Data.Count): <strong class="text-emerald-700 font-bold font-mono">@Money(Data.NetValue)</strong></span>
                </div>
            }
            @if (Data is not null && Data.Count == 0)
            {
                <p class="p-6 text-sm text-slate-500">No receiving or transfers in this date range.</p>
            }
        }
        <p class="p-4 text-xs text-slate-500">Transfer values use average cost saved when stock moved. All locations includes both sides, so transfers net to zero. Net received value covers purchases, supplier returns and transfers; it is not the closing inventory value.</p>
    </div>
    @if (TotalCount > 0)
    {
        <Paginator State="@pagination" />
    }

</section>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    public string Period { get; set; } = "today";

    [SupplyParameterFromQuery]
    public DateOnly? Start { get; set; }

    [SupplyParameterFromQuery]
    public DateOnly? End { get; set; }

    [SupplyParameterFromQuery]
    public int? LocationId { get; set; }

    [SupplyParameterFromQuery]
    public string? Search { get; set; }

    [SupplyParameterFromQuery]
    public string Sort { get; set; } = "id";

    [SupplyParameterFromQuery]
    public int Page { get; set; } = 1;

    [SupplyParameterFromQuery]
    public int PageSize { get; set; } = 30;

    private readonly PaginationState pagination = new() { ItemsPerPage = 30 };
    private GridItemsProvider<ReceivingActivityRow>? itemsProvider;
    private int TotalCount;

    private readonly GridSort<ReceivingActivityRow> sortById = GridSort<ReceivingActivityRow>.ByAscending(r => r.Id);
    private readonly GridSort<ReceivingActivityRow> sortByDate = GridSort<ReceivingActivityRow>.ByAscending(r => r.At);
    private readonly GridSort<ReceivingActivityRow> sortBySource = GridSort<ReceivingActivityRow>.ByAscending(r => r.Source);
    private readonly GridSort<ReceivingActivityRow> sortByQuantity = GridSort<ReceivingActivityRow>.ByAscending(r => r.Quantity);
    private readonly GridSort<ReceivingActivityRow> sortByValue = GridSort<ReceivingActivityRow>.ByAscending(r => r.Value);

    private ReceivingActivityReport? Data;
    private string? Error;
    private static readonly Dictionary<string, string> SortOptions = new()
    {
        ["product-desc"] = "Item · Z–A",
        ["source"] = "Source · A–Z",
        ["source-desc"] = "Source · Z–A",
        ["date-desc"] = "Date · newest first",
        ["date"] = "Date · oldest first",
        ["id-desc"] = "ID · high to low",
        ["id"] = "ID · low to high",
        ["product"] = "Item · A–Z",
        ["quantity-desc"] = "Quantity · high to low",
        ["quantity"] = "Quantity · low to high",
        ["value-desc"] = "Value · high to low",
        ["value"] = "Value · low to high",
        ["cost-desc"] = "Cost · high to low",
        ["cost"] = "Cost · low to high"
    };

    protected override async Task OnParametersSetAsync()
    {
        Sort = string.IsNullOrWhiteSpace(Sort) ? "id" : Sort;
        Period = string.IsNullOrWhiteSpace(Period) ? "today" : Period;
        Data = null;
        Error = null;
        itemsProvider = null;
        try
        {
            var size = QueryPagination.Size(PageSize);
            pagination.ItemsPerPage = size;

            Data = await Reports.ReadAsync(HttpContext.User, Period, Start, End, LocationId, Page,
                HttpContext.RequestAborted, Search, Sort, size);
            TotalCount = Data.Count;

            var maxPageIndex = Math.Max(0, (TotalCount - 1) / pagination.ItemsPerPage);
            var targetPageIndex = Math.Clamp(Data.Page - 1, 0, maxPageIndex);
            if (pagination.CurrentPageIndex != targetPageIndex)
            {
                await pagination.SetCurrentPageIndexAsync(targetPageIndex);
            }

            itemsProvider = req => ValueTask.FromResult(GridItemsProviderResult.From(Data.Rows.ToList(), TotalCount));
        }
        catch (ValidationException exception)
        {
            Error = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Receiving report loading failed.");
            Error = "Unable to load this report. Try again.";
        }
    }

    private string GetSortUrl(string column)
    {
        var cleanSort = (Sort ?? "id").ToLowerInvariant().Replace("-descending", "").Replace("-desc", "");
        var isCurrent = string.Equals(cleanSort, column, StringComparison.OrdinalIgnoreCase);
        var currentIsDesc = (Sort ?? "").EndsWith("-desc", StringComparison.OrdinalIgnoreCase)
            || (Sort ?? "").EndsWith("-descending", StringComparison.OrdinalIgnoreCase);
        var nextDirection = isCurrent && !currentIsDesc ? $"{column}-desc" : column;
        return Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["sort"] = nextDirection,
            ["page"] = 1
        });
    }

    private string GetSortClass(string column)
    {
        var cleanSort = (Sort ?? "id").ToLowerInvariant().Replace("-descending", "").Replace("-desc", "");
        if (!string.Equals(cleanSort, column, StringComparison.OrdinalIgnoreCase))
        {
            return "";
        }
        var currentIsDesc = (Sort ?? "").EndsWith("-desc", StringComparison.OrdinalIgnoreCase)
            || (Sort ?? "").EndsWith("-descending", StringComparison.OrdinalIgnoreCase);
        return currentIsDesc ? "col-sort-desc" : "col-sort-asc";
    }

    private string Money(decimal value) => $"{value:N2} {Configuration["CurrencyCode"] ?? "BDT"}";
}
