@page "/reports/receiving"
@attribute [Authorize(Policy = AppPolicies.ManageInventory)]
@attribute [StreamRendering]
@using System.ComponentModel.DataAnnotations
@inject ReceivingReportService Reports
@inject NavigationManager Navigation
@inject ILogger<Receiving> Logger

<PageTitle>Receiving & transfers report · @(Configuration["StoreName"] ?? "RetailPOS")</PageTitle>

<div class="page-heading no-print">
    <h1>Receiving & transfers report</h1>
    <div class="flex gap-3">
        <a href="/receiving" class="btn-secondary">Receive / transfer</a>
        <button type="button" class="btn-secondary" data-print>Print</button>
    </div>
</div>
<ReportFilters Path="/reports/receiving" Period="@Period" Range="Data?.Range" Start="Start" End="End" Search="@Search" Sort="@Sort"
    SortOptions="SortOptions" SearchHint="Purchase / transfer ID, supplier or location" PageSize="PageSize"
    ShowLocation="true" LocationId="LocationId" Locations="@(Data?.Locations ?? [])" />

@if (Error is not null)
{
    <p class="error-panel" role="alert">@Error</p>
}
<section class="print-area">
    @if (Data is not null)
    {
        <p class="mb-4 text-sm text-slate-500">
            @Data.Range.Start.ToString("dd MMM yyyy") – @Data.Range.End.ToString("dd MMM yyyy") ·
            @(Data.Locations.FirstOrDefault(location => location.Id == LocationId)?.Name ?? "All locations")
        </p>
        <div class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
            <div class="metric">
                <p>Purchases / supplier returns</p>
                <strong class="text-2xl!">@Money(Data.PurchaseValue)</strong>
            </div>
            <div class="metric">
                <p>Purchase payments</p>
                <strong class="text-2xl!">@Money(Data.SupplierPaid)</strong>
                <span class="metric-note">Unpaid / credit @Money(Data.SupplierUnpaid)</span>
            </div>
            <div class="metric">
                <p>Transfers in</p>
                <strong class="text-2xl!">@Money(Data.TransferInValue)</strong>
            </div>
            <div class="metric">
                <p>Transfers out</p>
                <strong class="text-2xl!">@Money(Data.TransferOutValue)</strong>
            </div>
            <div class="metric">
                <p>Net received value</p>
                <strong class="text-2xl!">@Money(Data.NetValue)</strong>
            </div>
        </div>
    }

    <div class="panel table-scroll">
        <table id="receiving-table" class="data-table compact-table w-full" aria-busy="@(Data is null && Error is null)">
            <thead>
                <tr>
                    <SortHeader Column="id" Label="ID" Sort="@Sort" Numeric="false" Class="w-24 text-center" />
                    <SortHeader Column="date" Label="Date" Sort="@Sort" Numeric="false" Class="whitespace-nowrap" />
                    <SortHeader Column="source" Label="From → to" Sort="@Sort" Numeric="false" />
                    <th class="text-right whitespace-nowrap text-xs font-semibold text-slate-700">Items</th>
                    <SortHeader Column="quantity" Label="Quantity" Sort="@Sort" Numeric="true" Class="whitespace-nowrap" />
                    <SortHeader Column="value" Label="Stock value" Sort="@Sort" Numeric="true" Class="whitespace-nowrap" />
                    <th class="text-right whitespace-nowrap text-xs font-semibold text-slate-700">Paid / Due</th>
                </tr>
            </thead>
            <tbody>
                @if (Data is null)
                {
                    <TableStatusRow Columns="7" Loading="@(Error is null)" Error="@(Error is not null)"
                        Message="@(Error ?? "Loading receiving and transfers…")" />
                }
                @foreach (var row in Data?.Rows ?? [])
                {
                    <tr class="hover:bg-slate-50/60 transition-colors">
                        <td class="w-24 text-center">
                            <a href="@(row.IsTransfer ? $"/receiving?mode=transfer#transfer-{row.Id}" : $"/receiving/{row.Id}")" class="font-bold text-blue-700 text-xs hover:underline">
                                @(row.IsTransfer ? "Transfer" : "Purchase") #@row.Id
                            </a>
                            <span class="mt-0.5 block text-[10px] text-slate-400">
                                @(row.IsTransfer ? (row.Quantity >= 0 ? "Transfer in" : "Transfer out") : (row.Quantity >= 0 ? "Receiving" : "Supplier return"))
                            </span>
                            @if (!string.IsNullOrWhiteSpace(row.Number))
                            {
                                <span class="block max-w-28 truncate font-mono text-[10px] text-slate-400 mx-auto" title="@row.Number">@row.Number</span>
                            }
                        </td>
                        <td class="whitespace-nowrap">
                            <span class="text-xs text-slate-600 font-mono">@row.At.ToBusinessTime(Configuration).ToString("dd MMM yyyy, HH:mm")</span>
                        </td>
                        <td>
                            <span class="text-xs font-medium text-slate-800">@row.Source → @row.Destination</span>
                        </td>
                        <td class="text-right whitespace-nowrap">
                            <span class="font-mono text-xs text-slate-600">@row.Items.Count @(row.Items.Count == 1 ? "item" : "items")</span>
                        </td>
                        <td class="text-right whitespace-nowrap">
                            <span class="font-mono text-xs text-slate-800">@row.Quantity.ToString("+0.###;-0.###;0")</span>
                        </td>
                        <td class="text-right whitespace-nowrap">
                            <span class="font-mono text-xs font-semibold text-slate-900">@Money(row.Value)</span>
                        </td>
                        <td class="text-right whitespace-nowrap">
                            @if (!row.IsTransfer)
                            {
                                <span class="font-mono text-xs text-slate-700">@Money(row.Paid)</span>
                                @if (row.Unpaid != 0)
                                {
                                    <span class="block font-mono text-[10px] font-semibold @(row.Unpaid > 0 ? "text-rose-600" : "text-emerald-600")">
                                        @(row.Unpaid > 0 ? "Due: " : "Credit: ")@Money(Math.Abs(row.Unpaid))
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-slate-400 text-xs">—</span>
                            }
                        </td>
                    </tr>
                    @if (row.Items.Count > 0)
                    {
                        <tr class="report-detail-row bg-slate-50/50">
                            <td colspan="7" class="px-4 py-2 border-t-0">
                                <details class="group">
                                    <summary class="cursor-pointer text-xs font-semibold text-blue-700 hover:text-blue-900 inline-flex items-center gap-1.5 select-none py-1">
                                        <span class="text-[10px] text-blue-600 transition-transform duration-150 inline-block group-open:rotate-90">▶</span>
                                        <span>View @row.Items.Count @(row.Items.Count == 1 ? "item" : "items")</span>
                                    </summary>
                                    <div class="mt-2 mb-2 overflow-hidden rounded-lg border border-slate-200 bg-white p-2.5 shadow-xs">
                                        <ReceivingLineTable Items="row.Items" />
                                    </div>
                                </details>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        @if (Data is not null && Data.Rows.Count > 0)
        {
            <div class="border-t border-slate-200 bg-slate-50/80 px-4 py-2.5 flex flex-wrap items-center justify-between gap-3 text-xs">
                <span class="font-medium text-slate-600">This page (@Data.Rows.Count): <strong class="text-slate-900 font-mono">@Money(Data.Rows.Sum(row => row.Value))</strong></span>
                <span class="font-medium text-slate-600">All matching transactions (@Data.Count): <strong class="text-emerald-700 font-bold font-mono">@Money(Data.NetValue)</strong></span>
            </div>
        }
        @if (Data is not null && Data.Count == 0)
        {
            <p class="p-6 text-sm text-slate-500">No receiving or transfers in this date range.</p>
        }
        <p class="p-4 text-xs text-slate-500">Transfer values use average cost saved when stock moved. All locations includes both sides, so transfers net to zero. Net received value covers purchases, supplier returns and transfers; it is not the closing inventory value.</p>
    </div>
    @if (Data is not null && Data.Count > 0)
    {
        <PageNavigation Info="@(new PageInfo(Data.Page, QueryPagination.Size(PageSize), Data.Count))" Label="transactions" />
    }

</section>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    public string Period { get; set; } = "today";

    [SupplyParameterFromQuery]
    public DateOnly? Start { get; set; }

    [SupplyParameterFromQuery]
    public DateOnly? End { get; set; }

    [SupplyParameterFromQuery]
    public int? LocationId { get; set; }

    [SupplyParameterFromQuery]
    public string? Search { get; set; }

    [SupplyParameterFromQuery]
    public string Sort { get; set; } = "id";

    [SupplyParameterFromQuery]
    public int Page { get; set; } = 1;

    [SupplyParameterFromQuery]
    public int PageSize { get; set; } = 30;

    private ReceivingActivityReport? Data;
    private string? Error;
    private static readonly Dictionary<string, string> SortOptions = new()
    {
        ["product-desc"] = "Item · Z–A",
        ["source"] = "Source · A–Z",
        ["source-desc"] = "Source · Z–A",
        ["date-desc"] = "Date · newest first",
        ["date"] = "Date · oldest first",
        ["id-desc"] = "ID · high to low",
        ["id"] = "ID · low to high",
        ["product"] = "Item · A–Z",
        ["quantity-desc"] = "Quantity · high to low",
        ["quantity"] = "Quantity · low to high",
        ["value-desc"] = "Value · high to low",
        ["value"] = "Value · low to high",
        ["cost-desc"] = "Cost · high to low",
        ["cost"] = "Cost · low to high"
    };

    protected override async Task OnParametersSetAsync()
    {
        Sort = string.IsNullOrWhiteSpace(Sort) ? "id" : Sort;
        Period = string.IsNullOrWhiteSpace(Period) ? "today" : Period;
        Data = null;
        Error = null;
        try
        {
            var size = QueryPagination.Size(PageSize);
            Data = await Reports.ReadAsync(HttpContext.User, Period, Start, End, LocationId, Page,
                HttpContext.RequestAborted, Search, Sort, size);
        }
        catch (ValidationException exception)
        {
            Error = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Receiving report loading failed.");
            Error = "Unable to load this report. Try again.";
        }
    }

    private string Money(decimal value) => $"{value:N2} {Configuration["CurrencyCode"] ?? "BDT"}";
}
