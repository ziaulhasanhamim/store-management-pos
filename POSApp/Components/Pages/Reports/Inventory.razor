@page "/reports/inventory"
@attribute [Authorize(Policy = AppPolicies.ManageInventory)]
@attribute [StreamRendering]
@using Microsoft.AspNetCore.Components.QuickGrid
@inject InventoryValuation Valuation
@inject NavigationManager Navigation
@inject ILogger<Inventory> Logger

<PageTitle>Inventory valuation · @(Configuration["StoreName"] ?? "RetailPOS")</PageTitle>
<div class="page-heading no-print">
    <h1>Inventory valuation</h1>
    <div class="flex gap-3">
        <a href="/reports" class="btn-secondary">Reports</a>
        <button type="button" class="btn-secondary" data-print>Print</button>
    </div>
</div>
@if (Error is not null)
{
    <p role="alert" class="error-panel">@Error</p>
}
<form method="get" action="/reports/inventory" class="no-print mb-6 flex flex-wrap items-end gap-3" data-enhance data-auto-search="true">
    <div>
        <label for="value-supplier" class="field-label">Default supplier</label>
        <select id="value-supplier" class="field" name="supplierId">
            <option value="">All suppliers</option>
            @foreach (var supplier in Data?.Suppliers ?? [])
            {
                <option value="@supplier.Id" selected="@(SupplierId == supplier.Id)">@supplier.Name</option>
            }
        </select>
    </div>
    <div>
        <label for="value-location" class="field-label">Stock location</label>
        <select id="value-location" class="field" name="locationId">
            <option value="">All locations</option>
            @foreach (var location in Data?.Locations ?? [])
            {
                <option value="@location.Id" selected="@(LocationId == location.Id)">@location.Name</option>
            }
        </select>
    </div>
    <div>
        <label for="value-search" class="field-label">Search</label>
        <input id="value-search" class="field" name="search" value="@Search" placeholder="Name or barcode" data-auto-search="true" autocomplete="off" data-permanent />
    </div>
    <input type="hidden" name="sort" value="@Sort" />
    <input type="hidden" name="pageSize" value="@PageSize" />
    <button class="btn-primary">Search</button>
</form>
@if (Data is not null)
{
    <details class="no-print mb-6 rounded-xl border border-slate-200 bg-white p-4">
        <summary class="cursor-pointer font-semibold text-indigo-700">Export inventory · choose columns</summary>
        <form method="get" action="/api/reports/export/inventory" class="mt-3" data-enhance="false">
            <input type="hidden" name="supplierId" value="@SupplierId" />
            <input type="hidden" name="locationId" value="@LocationId" />
            <input type="hidden" name="search" value="@Search" />
            <input type="hidden" name="sort" value="@Sort" />
            <div class="mb-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
                @foreach (var column in ExportColumns)
                {
                    <label class="flex items-center gap-2 text-sm text-slate-700">
                        <input type="checkbox" name="columns" value="@column" checked />
                        @column
                    </label>
                }
            </div>
            <button type="submit" class="btn-secondary">Download CSV</button>
        </form>
    </details>
    <div class="mb-6 grid gap-4 sm:grid-cols-3">
        <div class="metric">
            <p>Inventory value at cost price</p>
            <strong class="text-2xl!">@Money(Data.TotalValue)</strong>
            <span class="metric-note">@Data.Count items · includes archived stock</span>
        </div>
        @if (Data.SupplierDue is not null)
        {
            var due = Data.SupplierDue.Value;
            <div class="metric">
                <p>Supplier balance</p>
                <strong class="text-2xl!">@Money(due)</strong>
            </div>
            <div class="metric">
                <p>Inventory value less supplier balance</p>
                <strong class="text-2xl!">@Money(Data.TotalValue - due)</strong>
            </div>
        }
    </div>
}

<section class="panel table-scroll">
    @if (Data is null)
    {
        <table class="data-table compact-table w-full" aria-busy="true">
            <tbody>
                <TableStatusRow Columns="6" Loading="@(Error is null)" Error="@(Error is not null)"
                    Message="@(Error ?? "Loading inventory valuation…")" />
            </tbody>
        </table>
    }
    else
    {
        <QuickGrid ItemsProvider="@itemsProvider" Pagination="@pagination" class="data-table compact-table w-full" aria-busy="@(Data is null && Error is null)">
            <TemplateColumn Title="ID" SortBy="@sortById" Class="w-16 text-center" Align="Align.Center">
                <HeaderTemplate>
                    <a href="@GetSortUrl("id")" class="col-title @GetSortClass("id")" data-enhance>ID</a>
                </HeaderTemplate>
                <ChildContent>
                    <a href="@($"/items/{context.Id}")" class="font-bold text-blue-700 text-xs">#@context.Id</a>
                </ChildContent>
            </TemplateColumn>
            <TemplateColumn Title="Item" SortBy="@sortByName">
                <HeaderTemplate>
                    <a href="@GetSortUrl("name")" class="col-title @GetSortClass("name")" data-enhance>Item</a>
                </HeaderTemplate>
                <ChildContent>
                    <a href="@($"/items/{context.Id}")" class="font-semibold text-blue-700 text-xs hover:underline">@context.Name</a>
                    <span class="mt-0.5 block font-mono text-[10px] text-slate-400">@context.Barcode @(context.Archived ? "· Archived" : "")</span>
                </ChildContent>
            </TemplateColumn>
            <TemplateColumn Title="Default supplier" SortBy="@sortBySupplier">
                <HeaderTemplate>
                    <a href="@GetSortUrl("supplier")" class="col-title @GetSortClass("supplier")" data-enhance>Default supplier</a>
                </HeaderTemplate>
                <ChildContent>
                    <span class="text-xs text-slate-700">@(string.IsNullOrWhiteSpace(context.Supplier) ? "—" : context.Supplier)</span>
                </ChildContent>
            </TemplateColumn>
            <TemplateColumn Title="Quantity" SortBy="@sortByQuantity" Align="Align.Right" Class="whitespace-nowrap">
                <HeaderTemplate>
                    <a href="@GetSortUrl("quantity")" class="col-title @GetSortClass("quantity")" data-enhance>Quantity</a>
                </HeaderTemplate>
                <ChildContent>
                    <span class="font-mono text-xs text-slate-800">@context.Quantity.ToString("0.###") <span class="text-[10px] text-slate-400">@context.Unit</span></span>
                </ChildContent>
            </TemplateColumn>
            <TemplateColumn Title="Cost price" SortBy="@sortByCost" Align="Align.Right" Class="whitespace-nowrap">
                <HeaderTemplate>
                    <a href="@GetSortUrl("cost")" class="col-title @GetSortClass("cost")" data-enhance>Cost price</a>
                </HeaderTemplate>
                <ChildContent>
                    <span class="font-mono text-xs text-slate-600">@Money(context.UnitCost)</span>
                </ChildContent>
            </TemplateColumn>
            <TemplateColumn Title="Stock value" SortBy="@sortByValue" Align="Align.Right" Class="whitespace-nowrap">
                <HeaderTemplate>
                    <a href="@GetSortUrl("value")" class="col-title @GetSortClass("value")" data-enhance>Stock value</a>
                </HeaderTemplate>
                <ChildContent>
                    <span class="font-mono text-xs font-semibold text-slate-900">@Money(context.Value)</span>
                </ChildContent>
            </TemplateColumn>
        </QuickGrid>
        @if (Data is not null && Data.Rows.Count > 0)
        {
            <div class="border-t border-slate-200 bg-slate-50/80 px-4 py-2.5 flex flex-wrap items-center justify-between gap-3 text-xs">
                <span class="font-medium text-slate-600">This page value: <strong class="text-slate-900">@Money(Data.Rows.Sum(row => row.Value))</strong></span>
                <span class="font-medium text-slate-600">All matching items (@Data.Count): <strong class="text-emerald-700 font-bold">@Money(Data.TotalValue)</strong></span>
            </div>
        }
    }
</section>
@if (Data is not null)
{
    <p class="no-print mt-4 text-xs text-slate-500">Supplier association uses the product’s default supplier.</p>
}
@if (TotalCount > 0)
{
    <Paginator State="@pagination" />
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    public int? SupplierId { get; set; }

    [SupplyParameterFromQuery]
    public int? LocationId { get; set; }

    [SupplyParameterFromQuery]
    public string? Search { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;

    [SupplyParameterFromQuery]
    public int PageSize { get; set; } = 30;

    [SupplyParameterFromQuery]
    public string Sort { get; set; } = "id";

    private readonly PaginationState pagination = new() { ItemsPerPage = 30 };
    private GridItemsProvider<InventoryValueRow>? itemsProvider;
    private int TotalCount;

    private readonly GridSort<InventoryValueRow> sortById = GridSort<InventoryValueRow>.ByAscending(r => r.Id);
    private readonly GridSort<InventoryValueRow> sortByName = GridSort<InventoryValueRow>.ByAscending(r => r.Name);
    private readonly GridSort<InventoryValueRow> sortBySupplier = GridSort<InventoryValueRow>.ByAscending(r => r.Supplier);
    private readonly GridSort<InventoryValueRow> sortByQuantity = GridSort<InventoryValueRow>.ByAscending(r => r.Quantity);
    private readonly GridSort<InventoryValueRow> sortByCost = GridSort<InventoryValueRow>.ByAscending(r => r.UnitCost);
    private readonly GridSort<InventoryValueRow> sortByValue = GridSort<InventoryValueRow>.ByAscending(r => r.Value);

    private static readonly Dictionary<string, string> SortOptions = new()
    {
        ["id"] = "ID · low to high",
        ["id-desc"] = "ID · high to low",
        ["supplier"] = "Supplier · A–Z",
        ["supplier-desc"] = "Supplier · Z–A",
        ["name"] = "Name · A–Z",
        ["name-desc"] = "Name · Z–A",
        ["quantity-desc"] = "Quantity · high to low",
        ["quantity"] = "Quantity · low to high",
        ["cost-desc"] = "Cost · high to low",
        ["cost"] = "Cost · low to high",
        ["value-desc"] = "Value · high to low",
        ["value"] = "Value · low to high"
    };

    private InventoryValueReport? Data;
    private string? Error;
    private static readonly string[] ExportColumns = ["Item ID", "Item", "Barcode", "Default supplier", "Quantity", "Cost price", "Stock value"];

    protected override async Task OnParametersSetAsync()
    {
        Sort = string.IsNullOrWhiteSpace(Sort) ? "id" : Sort;
        itemsProvider = null;
        try
        {
            var size = QueryPagination.Size(PageSize);
            pagination.ItemsPerPage = size;

            Data = await Valuation.ReadAsync(HttpContext.User, SupplierId, LocationId, Search, Page,
                HttpContext.RequestAborted, Sort, size);
            TotalCount = Data.Count;

            var maxPageIndex = Math.Max(0, (TotalCount - 1) / pagination.ItemsPerPage);
            var targetPageIndex = Math.Clamp(Data.Page - 1, 0, maxPageIndex);
            if (pagination.CurrentPageIndex != targetPageIndex)
            {
                await pagination.SetCurrentPageIndexAsync(targetPageIndex);
            }

            itemsProvider = req => ValueTask.FromResult(GridItemsProviderResult.From(Data.Rows.ToList(), TotalCount));
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Inventory valuation failed.");
            Error = "Unable to load inventory valuation.";
        }
    }

    private string GetSortUrl(string column)
    {
        var cleanSort = (Sort ?? "id").ToLowerInvariant().Replace("-descending", "").Replace("-desc", "");
        var isCurrent = string.Equals(cleanSort, column, StringComparison.OrdinalIgnoreCase);
        var currentIsDesc = (Sort ?? "").EndsWith("-desc", StringComparison.OrdinalIgnoreCase)
            || (Sort ?? "").EndsWith("-descending", StringComparison.OrdinalIgnoreCase);
        var nextDirection = isCurrent && !currentIsDesc ? $"{column}-desc" : column;
        return Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["sort"] = nextDirection,
            ["page"] = 1
        });
    }

    private string GetSortClass(string column)
    {
        var cleanSort = (Sort ?? "id").ToLowerInvariant().Replace("-descending", "").Replace("-desc", "");
        if (!string.Equals(cleanSort, column, StringComparison.OrdinalIgnoreCase))
        {
            return "";
        }
        var currentIsDesc = (Sort ?? "").EndsWith("-desc", StringComparison.OrdinalIgnoreCase)
            || (Sort ?? "").EndsWith("-descending", StringComparison.OrdinalIgnoreCase);
        return currentIsDesc ? "col-sort-desc" : "col-sort-asc";
    }

    private string Money(decimal amount) => $"{Configuration["CurrencyCode"] ?? "BDT"} {amount:N2}";
}
