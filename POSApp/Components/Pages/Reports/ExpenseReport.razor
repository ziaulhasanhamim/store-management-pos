@page "/reports/expenses"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Policy = AppPolicies.MakeSales)]
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using POSApp.Client.DTOs
@using POSApp.Client.Enums
@using POSApp.Client.Security
@using POSApp.Services
@inject ExpenseReportService ReportService
@inject ClosingService ClosingService
@inject MoneyEntryService MoneyEntryService
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject ILogger<ExpenseReport> Logger

<PageTitle>Expense Analysis & Location Comparison · @(Configuration["StoreName"] ?? "RetailPOS")</PageTitle>

<div class="page-heading">
    <div>
        <nav class="breadcrumb">
            <a href="/">Dashboard</a>
            <span>/</span>
            <a href="/reports">Reports</a>
            <span>/</span>
            <span>Expense analysis</span>
        </nav>
        <h1 class="mt-1">Expense Analysis & Location Comparison</h1>
        <p class="text-sm text-slate-500">Monitor spending across store locations, compare expense categories, and audit payment processing fees.</p>
    </div>
    <div class="flex flex-wrap gap-2 no-print">
        <button type="button" class="btn-secondary" @onclick="ExportCsvAsync">
            <Icon Name="history" Class="size-4 mr-1.5" />
            Export CSV
        </button>
        <a href="/expenses" class="btn-secondary">
            Manage expenses
        </a>
    </div>
</div>

@if (Error is not null)
{
    <p class="error-panel mb-4" role="alert">@Error</p>
}

<!-- Filter Presets & Controls -->
<div class="report-filters no-print mb-6">
    <div class="mb-4 flex flex-wrap items-center gap-2">
        @foreach (var preset in Presets)
        {
            <button type="button" class="@(Period == preset.Key ? "filter-chip active" : "filter-chip")"
                    @onclick="() => SelectPreset(preset.Key)">
                @preset.Value
            </button>
        }
    </div>

    <div class="grid items-end gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <div>
            <label class="field-label" for="filter-location">Store Location</label>
            <select id="filter-location" class="field" value="@LocationId" @onchange="OnLocationChanged">
                <option value="">All store locations</option>
                @foreach (var loc in Locations)
                {
                    <option value="@loc.Id">@loc.Name</option>
                }
            </select>
        </div>

        <div>
            <label class="field-label" for="filter-category">Expense Category</label>
            <select id="filter-category" class="field" value="@CategoryId" @onchange="OnCategoryChanged">
                <option value="">All categories</option>
                @foreach (var cat in Categories)
                {
                    <option value="@cat.Id">@cat.Name</option>
                }
            </select>
        </div>

        <div>
            <label class="field-label" for="filter-search">Search Notes / Receipt</label>
            <input id="filter-search" class="field" value="@SearchTerm" @oninput="OnSearchInput" placeholder="Filter text..." />
        </div>

        <div>
            <button type="button" class="btn-primary w-full py-2" @onclick="LoadReportAsync">
                <Icon Name="search" Class="size-4 mr-1.5" />
                Apply Filters
            </button>
        </div>
    </div>
</div>

@if (Data is null)
{
    <LoadingPanel Message="Aggregating store expenses and comparative statistics…" />
}
else
{
    <!-- KPI Summary Cards -->
    <div class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <div class="metric rounded-2xl border border-rose-100 bg-white p-5 shadow-xs">
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Expenses</p>
            <strong class="text-2xl! font-bold text-rose-700 tabular-nums">@Money(Data.TotalExpenses)</strong>
            <p class="mt-1 text-xs text-slate-500">@Data.Items.Count expense entries in period</p>
        </div>

        <div class="metric rounded-2xl border border-slate-200 bg-white p-5 shadow-xs">
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Highest Spending Store</p>
            <strong class="text-2xl! font-bold text-slate-900 truncate block">@(Data.TopLocationName ?? "—")</strong>
            <p class="mt-1 text-xs text-slate-500 tabular-nums">
                @Money(Data.TopLocationAmount) (@Data.TopLocationPercentage.ToString("0.0")% of company total)
            </p>
        </div>

        <div class="metric rounded-2xl border border-slate-200 bg-white p-5 shadow-xs">
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Top Expense Category</p>
            <strong class="text-2xl! font-bold text-slate-900 truncate block">@(Data.TopCategoryName ?? "—")</strong>
            <p class="mt-1 text-xs text-slate-500 tabular-nums">
                @Money(Data.TopCategoryAmount) (@Data.TopCategoryPercentage.ToString("0.0")% of spend)
            </p>
        </div>

        <div class="metric rounded-2xl border border-indigo-100 bg-white p-5 shadow-xs">
            <p class="text-xs font-semibold text-indigo-700 uppercase tracking-wider">Payment Processing Fees</p>
            <strong class="text-2xl! font-bold text-indigo-700 tabular-nums">@Money(Data.ProcessingFeesTotal)</strong>
            <p class="mt-1 text-xs text-slate-500">Merchant card & wallet settlement fees</p>
        </div>
    </div>

    <!-- Location Comparison Board -->
    <section class="panel mb-6 p-6">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
            <div>
                <h2 class="text-lg font-bold text-slate-900">Store Location Comparison</h2>
                <p class="text-xs text-slate-500">Side-by-side expense distribution and net impact across retail branches</p>
            </div>
            <span class="text-xs font-semibold text-slate-500">
                Period: @Data.Range.Start.ToString("dd MMM yyyy") – @Data.Range.End.ToString("dd MMM yyyy")
            </span>
        </div>

        <!-- Proportional spend bar -->
        @if (Data.TotalExpenses > 0)
        {
            <div class="mb-6">
                <div class="mb-1.5 flex justify-between text-xs font-semibold text-slate-600">
                    <span>Expense Distribution by Location</span>
                    <span>100%</span>
                </div>
                <div class="flex h-3 w-full overflow-hidden rounded-full bg-slate-100">
                    @foreach (var loc in Data.Locations.Where(l => l.TotalExpense > 0))
                    {
                        var colorClass = ColorForIndex(Data.Locations.ToList().IndexOf(loc));
                        <div class="@colorClass" style="width: @(loc.SharePercentage)%" title="@loc.LocationName: @Money(loc.TotalExpense) (@loc.SharePercentage%)"></div>
                    }
                </div>
            </div>
        }

        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Store Location</th>
                        <th class="text-right">Total Spent</th>
                        <th class="text-right">Share %</th>
                        <th>Top Category at Store</th>
                        <th class="text-right">Card Fees</th>
                        <th class="text-right">Store Revenue</th>
                        <th class="text-right">Net Impact</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var loc in Data.Locations)
                    {
                        <tr>
                            <td>
                                <strong>@loc.LocationName</strong>
                            </td>
                            <td class="text-right font-bold tabular-nums text-slate-900">@Money(loc.TotalExpense)</td>
                            <td class="text-right tabular-nums">
                                <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold bg-slate-100 text-slate-700">
                                    @loc.SharePercentage.ToString("0.0")%
                                </span>
                            </td>
                            <td>
                                @if (loc.TopCategoryName is not null)
                                {
                                    <span class="text-slate-800">@loc.TopCategoryName</span>
                                    <span class="text-xs text-slate-400 block">@Money(loc.TopCategoryAmount)</span>
                                }
                                else
                                {
                                    <span class="text-slate-400">—</span>
                                }
                            </td>
                            <td class="text-right tabular-nums text-indigo-700 font-semibold">
                                @(loc.ProcessingFees > 0 ? Money(loc.ProcessingFees) : "—")
                            </td>
                            <td class="text-right tabular-nums text-emerald-700 font-semibold">
                                @Money(loc.SalesRevenue)
                            </td>
                            <td class="text-right tabular-nums font-bold @(loc.NetExpenseImpact >= 0 ? "text-emerald-700" : "text-rose-600")">
                                @(loc.NetExpenseImpact >= 0 ? "+" : "")@Money(loc.NetExpenseImpact)
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="font-bold bg-slate-50">
                        <th>Company Total</th>
                        <td class="text-right tabular-nums">@Money(Data.TotalExpenses)</td>
                        <td class="text-right">100.0%</td>
                        <td>—</td>
                        <td class="text-right tabular-nums text-indigo-700">@Money(Data.ProcessingFeesTotal)</td>
                        <td class="text-right tabular-nums text-emerald-700">@Money(Data.Locations.Sum(l => l.SalesRevenue))</td>
                        <td class="text-right tabular-nums">
                            @Money(Data.Locations.Sum(l => l.SalesRevenue) - Data.TotalExpenses)
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </section>

    <!-- Category Spending & Itemized Section -->
    <div class="grid gap-6 lg:grid-cols-3 mb-6">
        <!-- Category Summary -->
        <section class="panel p-5 lg:col-span-1">
            <h3 class="mb-4 font-bold text-slate-900">Category Breakdown</h3>
            <div class="table-scroll">
                <table class="data-table text-xs">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th class="text-right">Spent</th>
                            <th class="text-right">Share</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Data.Categories.Count == 0)
                        {
                            <tr><td colspan="3" class="p-4 text-center text-slate-400">No expenses recorded</td></tr>
                        }
                        else
                        {
                            @foreach (var cat in Data.Categories)
                            {
                                <tr>
                                    <td><strong>@cat.CategoryName</strong></td>
                                    <td class="text-right tabular-nums">@Money(cat.TotalAmount)</td>
                                    <td class="text-right tabular-nums">
                                        <span class="px-1.5 py-0.5 rounded bg-slate-100 font-semibold">@cat.SharePercentage.ToString("0.0")%</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Itemized Entries Log -->
        <section class="panel p-5 lg:col-span-2">
            <div class="mb-4 flex items-center justify-between">
                <div>
                    <h3 class="font-bold text-slate-900">Itemized Expense Log</h3>
                    <p class="text-xs text-slate-500">@Data.Items.Count transactions recorded</p>
                </div>
            </div>
            <div class="table-scroll max-h-96 overflow-y-auto">
                <table class="data-table text-xs">
                    <thead class="sticky top-0 bg-white">
                        <tr>
                            <th>Date</th>
                            <th>Store</th>
                            <th>Category</th>
                            <th>Method</th>
                            <th class="text-right">Amount</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Data.Items.Count == 0)
                        {
                            <tr><td colspan="6" class="p-4 text-center text-slate-400">No matching expense entries</td></tr>
                        }
                        else
                        {
                            @foreach (var item in Data.Items)
                            {
                                <tr>
                                    <td>@item.OccurredAt.ToString("dd MMM HH:mm")</td>
                                    <td><strong class="text-slate-800">@item.LocationName</strong></td>
                                    <td>@item.CategoryName</td>
                                    <td>@item.Method</td>
                                    <td class="text-right font-semibold tabular-nums">@Money(item.Amount)</td>
                                    <td>
                                        <span>@item.Notes</span>
                                        @if (!string.IsNullOrWhiteSpace(item.ReceiptReference))
                                        {
                                            <span class="block text-slate-400 font-mono">Ref: @item.ReceiptReference</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
}

@code {
    private string Currency => Configuration["CurrencyCode"] ?? "BDT";
    private string? Error;
    private ExpenseReportDto? Data;

    private string Period = "month";
    private int? LocationId;
    private int? CategoryId;
    private string SearchTerm = "";

    private IReadOnlyList<StockLocationOption> Locations = [];
    private IReadOnlyList<ExpenseCategoryOption> Categories = [];

    private static readonly Dictionary<string, string> Presets = new()
    {
        ["today"] = "Today",
        ["yesterday"] = "Yesterday",
        ["week"] = "Last 7 days",
        ["month"] = "This month",
        ["lastmonth"] = "Last month",
        ["year"] = "This year"
    };

    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private async Task<ClaimsPrincipal> GetUserAsync()
    {
        var authState = await AuthStateTask;
        return authState.User;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = await GetUserAsync();
            Locations = await ClosingService.LocationsAsync(user);

            var catPage = await MoneyEntryService.CategoriesPageAsync(user, 1, 100);
            Categories = catPage.Items;

            await LoadReportAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to initialize Expense Report.");
            Error = ex.Message;
        }
    }

    private async Task SelectPreset(string preset)
    {
        Period = preset;
        await LoadReportAsync();
    }

    private async Task OnLocationChanged(ChangeEventArgs e)
    {
        LocationId = int.TryParse(e.Value?.ToString(), out var id) ? id : null;
        await LoadReportAsync();
    }

    private async Task OnCategoryChanged(ChangeEventArgs e)
    {
        CategoryId = int.TryParse(e.Value?.ToString(), out var id) ? id : null;
        await LoadReportAsync();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchTerm = e.Value?.ToString() ?? "";
    }

    private async Task LoadReportAsync()
    {
        Error = null;
        try
        {
            var user = await GetUserAsync();
            Data = await ReportService.GetExpenseReportAsync(
                user,
                Period,
                null,
                null,
                LocationId,
                CategoryId,
                SearchTerm);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load expense report.");
            Error = ex.Message;
        }
    }

    private async Task ExportCsvAsync()
    {
        try
        {
            var user = await GetUserAsync();
            var csv = await ReportService.ExportCsvAsync(
                user,
                Period,
                null,
                null,
                LocationId,
                CategoryId,
                SearchTerm);

            var bytes = System.Text.Encoding.UTF8.GetBytes(csv);
            var base64 = Convert.ToBase64String(bytes);
            Navigation.NavigateTo($"data:text/csv;base64,{base64}", forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to export expense CSV.");
            Error = ex.Message;
        }
    }

    private static string ColorForIndex(int index) => (index % 6) switch
    {
        0 => "bg-indigo-500",
        1 => "bg-emerald-500",
        2 => "bg-purple-500",
        3 => "bg-blue-500",
        4 => "bg-amber-500",
        _ => "bg-rose-500"
    };

    private string Money(decimal amount) => $"{amount:N2} {Currency}";
}
