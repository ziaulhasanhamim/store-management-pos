@page "/reports/categories"
@attribute [Authorize(Policy = AppPolicies.MakeSales)]
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using POSApp.Client.DTOs
@using POSApp.Client.Security
@using POSApp.Services
@inject AnalyticsService Analytics
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Category Sales Performance · @(Configuration["StoreName"] ?? "RetailPOS")</PageTitle>

<div class="page-heading">
    <div>
        <nav class="breadcrumb">
            <a href="/">Dashboard</a>
            <span>/</span>
            <a href="/reports">Reports</a>
            <span>/</span>
            <span>Category sales performance</span>
        </nav>
        <h1 class="mt-1">Category Sales Performance</h1>
        <p class="text-sm text-slate-500">Revenue breakdown, profit margins, sales velocity, and category market share</p>
    </div>
    <div class="flex flex-wrap gap-2 no-print">
        <a href="@ExportCsvUrl" class="btn-secondary" download>
            <Icon Name="history" Class="size-4 mr-1.5" />
            Export CSV
        </a>
        <a href="/reports/sales" class="btn-secondary">
            <Icon Name="wallet" Class="size-4 mr-1.5" />
            Sales report
        </a>
    </div>
</div>

@if (Error is not null)
{
    <p class="error-panel mb-4" role="alert">@Error</p>
}

@if (Data is null)
{
    <LoadingPanel Message="Crunching category sales statistics…" />
}
else
{
    <!-- Filter Presets & Controls -->
    <div class="report-filters no-print mb-6">
        <div class="mb-4 flex flex-wrap items-center gap-2">
            @foreach (var preset in Presets)
            {
                <a href="@PresetLink(preset.Key)" class="@(Period == preset.Key ? "filter-chip active" : "filter-chip")">@preset.Value</a>
            }
        </div>

        <form method="get" action="/reports/categories" class="grid items-end gap-3 sm:grid-cols-2 xl:grid-cols-4" data-enhance data-auto-search="false">
            <input type="hidden" name="period" value="custom" />
            <div class="sm:col-span-2">
                <label class="field-label">Date range</label>
                <DateRangePicker Id="category-date-range" Start="@EffectiveStart" End="@EffectiveEnd" AutoSubmit="false" />
            </div>

            <div>
                <label class="field-label" for="filter-location">Store Location</label>
                <select id="filter-location" name="locationId" class="field">
                    <option value="">All store locations</option>
                    @foreach (var loc in Data.Locations)
                    {
                        <option value="@loc.Id" selected="@(LocationId == loc.Id)">@loc.Name</option>
                    }
                </select>
            </div>

            <div class="flex items-end">
                <button type="submit" class="btn-primary w-full py-2 px-4">
                    <Icon Name="search" Class="size-4 mr-1" />
                    Filter categories
                </button>
            </div>
        </form>
    </div>

    <!-- Summary KPI Cards -->
    <div class="mb-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        <div class="metric bg-white border border-slate-200/80 shadow-xs">
            <div class="flex items-center justify-between">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Categories Sold</p>
                <span class="inline-flex size-7 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600">
                    <Icon Name="box" Class="size-4" />
                </span>
            </div>
            <strong class="text-2xl mt-1 text-slate-900">@Data.Categories.Count</strong>
            <span class="text-xs text-slate-400 mt-0.5">Contributing departments</span>
        </div>

        <div class="metric bg-white border border-slate-200/80 shadow-xs">
            <div class="flex items-center justify-between">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Total Revenue</p>
                <span class="inline-flex size-7 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
                    <Icon Name="wallet" Class="size-4" />
                </span>
            </div>
            <strong class="text-2xl mt-1 text-blue-600">@Money(Data.TotalRevenue)</strong>
            <span class="text-xs text-slate-400 mt-0.5">@EffectiveStart.ToString("dd MMM") – @EffectiveEnd.ToString("dd MMM yyyy")</span>
        </div>

        <div class="metric bg-white border border-slate-200/80 shadow-xs">
            <div class="flex items-center justify-between">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Cost of Goods</p>
                <span class="inline-flex size-7 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
                    <Icon Name="receive" Class="size-4" />
                </span>
            </div>
            <strong class="text-2xl mt-1 text-slate-700">@Money(Data.TotalCost)</strong>
            <span class="text-xs text-slate-400 mt-0.5">Wholesale product cost</span>
        </div>

        <div class="metric bg-white border border-slate-200/80 shadow-xs">
            <div class="flex items-center justify-between">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Gross Profit</p>
                <span class="inline-flex size-7 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600">
                    <Icon Name="history" Class="size-4" />
                </span>
            </div>
            <strong class="text-2xl mt-1 text-emerald-600">@Money(Data.TotalProfit)</strong>
            <span class="text-xs text-slate-400 mt-0.5">Retained margin</span>
        </div>

        <div class="metric bg-white border border-slate-200/80 shadow-xs">
            <div class="flex items-center justify-between">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Overall Margin</p>
                <span class="inline-flex size-7 items-center justify-center rounded-lg bg-violet-50 text-violet-600">
                    <Icon Name="dashboard" Class="size-4" />
                </span>
            </div>
            <strong class="text-2xl mt-1 text-violet-600">@Data.OverallMarginPercent.ToString("0.0")%</strong>
            <span class="text-xs text-slate-400 mt-0.5">Weighted avg profit margin</span>
        </div>
    </div>

    <!-- Visual Charts Row -->
    @if (Data.Categories.Count > 0)
    {
        <div class="mb-6 grid gap-6 lg:grid-cols-12 no-print">
            <!-- Market Share Donut Chart -->
            <div class="chart-card lg:col-span-5 bg-white">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h3 class="chart-title">Revenue Share by Category</h3>
                        <p class="chart-subtitle">Proportion of gross sales turnover</p>
                    </div>
                    <span class="stat-pill bg-indigo-50 text-indigo-700">Market Share</span>
                </div>
                <div class="relative h-64 w-full flex items-center justify-center">
                    <canvas id="category-share-donut"
                            data-chart="donut"
                            data-currency="@Currency"
                            data-labels="@JsonSerializer.Serialize(Data.Categories.Select(c => c.CategoryName))"
                            data-values="@JsonSerializer.Serialize(Data.Categories.Select(c => c.TotalRevenue))">
                    </canvas>
                </div>
            </div>

            <!-- Revenue vs Profit Comparison Bar Chart -->
            <div class="chart-card lg:col-span-7 bg-white">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h3 class="chart-title">Revenue & Profit Comparison</h3>
                        <p class="chart-subtitle">Top departments ranked by total revenue</p>
                    </div>
                    <span class="stat-pill bg-emerald-50 text-emerald-700">Financial Performance</span>
                </div>
                <div class="relative h-64 w-full">
                    <canvas id="category-revenue-bar"
                            data-chart="bar"
                            data-currency="@Currency"
                            data-labels="@JsonSerializer.Serialize(Data.Categories.Take(8).Select(c => c.CategoryName))"
                            data-datasets="@JsonSerializer.Serialize(new object[] {
                                new { label = "Revenue", data = Data.Categories.Take(8).Select(c => c.TotalRevenue).ToArray(), color = "#4f46e5" },
                                new { label = "Gross Profit", data = Data.Categories.Take(8).Select(c => c.GrossProfit).ToArray(), color = "#10b981" }
                            })">
                    </canvas>
                </div>
            </div>
        </div>
    }

    <!-- Detailed Performance Data Table -->
    <section class="panel bg-white shadow-xs">
        <div class="panel-heading border-b border-slate-100 px-5 py-4 flex items-center justify-between">
            <h2 class="text-base font-bold text-slate-800">Category Breakdown</h2>
            <span class="text-xs font-semibold text-slate-500">@Data.Categories.Count records</span>
        </div>
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th class="text-right">Unique Items</th>
                        <th class="text-right">Units Sold</th>
                        <th class="text-right">Total Revenue</th>
                        <th class="text-right">Total Cost</th>
                        <th class="text-right">Gross Profit</th>
                        <th class="text-right">Margin %</th>
                        <th class="text-right">Share %</th>
                        <th>Top Product</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Data.Categories.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="empty-state py-8 text-center text-slate-400">
                                No sales recorded for the selected date range and filters.
                            </td>
                        </tr>
                    }
                    @foreach (var cat in Data.Categories)
                    {
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="font-semibold text-slate-900">
                                @cat.CategoryName
                            </td>
                            <td class="text-right tabular-nums text-slate-600">@cat.ProductCount</td>
                            <td class="text-right tabular-nums font-medium text-slate-900">@cat.UnitsSold.ToString("N0")</td>
                            <td class="text-right tabular-nums font-semibold text-blue-600">@Money(cat.TotalRevenue)</td>
                            <td class="text-right tabular-nums text-slate-500">@Money(cat.TotalCost)</td>
                            <td class="text-right tabular-nums font-semibold text-emerald-600">@Money(cat.GrossProfit)</td>
                            <td class="text-right tabular-nums">
                                <span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold @(cat.MarginPercent >= 30 ? "bg-emerald-50 text-emerald-700" : cat.MarginPercent >= 15 ? "bg-blue-50 text-blue-700" : "bg-amber-50 text-amber-700")">
                                    @cat.MarginPercent.ToString("0.0")%
                                </span>
                            </td>
                            <td class="text-right tabular-nums">
                                <div class="flex items-center justify-end gap-2">
                                    <div class="w-16 h-1.5 rounded-full bg-slate-100 overflow-hidden">
                                        <div class="h-full bg-indigo-500 rounded-full" style="width: @(Math.Min(100, cat.RevenueSharePercent))%"></div>
                                    </div>
                                    <span class="text-xs font-medium text-slate-600">@cat.RevenueSharePercent.ToString("0.0")%</span>
                                </div>
                            </td>
                            <td class="text-xs font-medium text-slate-700 max-w-xs truncate" title="@cat.TopProductName">
                                @cat.TopProductName
                            </td>
                        </tr>
                    }
                </tbody>
                @if (Data.Categories.Count > 0)
                {
                    <tfoot>
                        <tr class="font-bold bg-slate-50/80 border-t-2 border-slate-200">
                            <th>Total</th>
                            <th class="text-right tabular-nums">@Data.Categories.Sum(c => c.ProductCount)</th>
                            <th class="text-right tabular-nums">@Data.Categories.Sum(c => c.UnitsSold).ToString("N0")</th>
                            <th class="text-right tabular-nums text-blue-700">@Money(Data.TotalRevenue)</th>
                            <th class="text-right tabular-nums text-slate-600">@Money(Data.TotalCost)</th>
                            <th class="text-right tabular-nums text-emerald-700">@Money(Data.TotalProfit)</th>
                            <th class="text-right tabular-nums text-violet-700">@Data.OverallMarginPercent.ToString("0.0")%</th>
                            <th class="text-right tabular-nums">100.0%</th>
                            <th></th>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </section>
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    public string Period { get; set; } = "month";

    [SupplyParameterFromQuery]
    public DateOnly? Start { get; set; }

    [SupplyParameterFromQuery]
    public DateOnly? End { get; set; }

    [SupplyParameterFromQuery]
    public int? LocationId { get; set; }

    private CategoryPerformanceReportData? Data;
    private string? Error;

    private static readonly KeyValuePair<string, string>[] Presets =
    [
        new("today", "Today"),
        new("yesterday", "Yesterday"),
        new("week", "This week"),
        new("month", "This month"),
        new("lastmonth", "Last month"),
        new("year", "This year"),
        new("custom", "Custom")
    ];

    private DateOnly EffectiveStart => Data?.StartDate ?? DateOnly.FromDateTime(DateTime.UtcNow);
    private DateOnly EffectiveEnd => Data?.EndDate ?? DateOnly.FromDateTime(DateTime.UtcNow);
    private string Currency => Configuration["CurrencyCode"] ?? "BDT";

    private string ExportCsvUrl =>
        $"/api/reports/export/categories?period={Period}&start={EffectiveStart:yyyy-MM-dd}&end={EffectiveEnd:yyyy-MM-dd}&locationId={LocationId}";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var zone = AccountingCalendar.Zone(Configuration);
            var range = ReportService.ResolveRange(Period, Start, End, zone, DateTimeOffset.UtcNow);

            Data = await Analytics.GetCategoryPerformanceAsync(
                HttpContext.User,
                range.Start,
                range.End,
                LocationId,
                HttpContext.RequestAborted);
        }
        catch (ValidationException ex)
        {
            Error = ex.Message;
        }
        catch (Exception ex)
        {
            Error = "Failed to load category performance: " + ex.Message;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await JS.InvokeVoidAsync("PosCharts.initDeclarativeCharts");
        }
        catch
        {
            // Ignore if JS interop is unavailable during SSR
        }
    }

    private string PresetLink(string preset)
    {
        var query = new List<string> { $"period={preset}" };
        if (LocationId.HasValue) query.Add($"locationId={LocationId.Value}");
        return $"/reports/categories?{string.Join("&", query)}";
    }

    private string Money(decimal amount) => $"{amount:N2} {Currency}";
}
