<div class="table-scroll">
    <table class="data-table report-lines compact-table w-full">
        <thead>
            <tr>
                <th class="text-xs">Item / barcode</th>
                <th class="text-right text-xs">Quantity</th>
                @if (CanViewCosts)
                {
                    <th class="text-right text-xs">Unit cost</th>
                }
                <th class="text-right text-xs">Selling price</th>
                <th class="text-right text-xs">Subtotal</th>
                <th class="text-right text-xs">Discount</th>
                <th class="text-right text-xs">Net sales</th>
                @if (CanViewCosts)
                {
                    <th class="text-right text-xs">Cost</th>
                    <th class="text-right text-xs">Profit</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Items)
            {
                <tr class="hover:bg-slate-50/50">
                    <td>
                        <strong class="text-xs text-slate-900">@item.Name</strong>
                        @if (!string.IsNullOrWhiteSpace(item.Barcode))
                        {
                            <span class="block font-mono text-[10px] text-slate-500">@item.Barcode</span>
                        }
                    </td>
                    <td class="text-right font-mono text-xs whitespace-nowrap">@item.Quantity.ToString("0.###") <span class="text-[10px] text-slate-400">@item.Unit</span></td>
                    @if (CanViewCosts)
                    {
                        <td class="text-right font-mono text-xs whitespace-nowrap text-slate-600">@Money(item.UnitCost ?? 0)</td>
                    }
                    <td class="text-right font-mono text-xs whitespace-nowrap">@Money(item.UnitPrice)</td>
                    <td class="text-right font-mono text-xs whitespace-nowrap text-slate-600">@Money(item.Subtotal)</td>
                    <td class="text-right font-mono text-xs whitespace-nowrap text-amber-700">@Money(item.Subtotal - item.Total)</td>
                    <td class="text-right font-mono text-xs whitespace-nowrap font-semibold text-slate-900">@Money(item.Total)</td>
                    @if (CanViewCosts)
                    {
                        <td class="text-right font-mono text-xs whitespace-nowrap text-slate-600">@Money(item.Cost ?? 0)</td>
                        <td class="text-right font-mono text-xs whitespace-nowrap font-semibold @(item.Profit < 0 ? "text-rose-700" : "text-emerald-700")">@Money(item.Profit ?? 0)</td>
                    }
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="font-semibold text-xs">
                <th colspan="@(CanViewCosts ? 4 : 3)" class="text-xs">Sale totals</th>
                <td class="text-right font-mono text-xs">@Money(Items.Sum(item => item.Subtotal))</td>
                <td class="text-right font-mono text-xs text-amber-700">@Money(Items.Sum(item => item.Subtotal - item.Total))</td>
                <td class="text-right font-mono text-xs text-slate-900 font-bold">@Money(Items.Sum(item => item.Total))</td>
                @if (CanViewCosts)
                {
                    <td class="text-right font-mono text-xs text-slate-600">@Money(Items.Sum(item => item.Cost ?? 0))</td>
                    <td class="text-right font-mono text-xs font-bold @(Items.Sum(item => item.Profit ?? 0) < 0 ? "text-rose-700" : "text-emerald-700")">@Money(Items.Sum(item => item.Profit ?? 0))</td>
                }
            </tr>
        </tfoot>
    </table>
</div>

@code {
    [Parameter]
    public IReadOnlyList<SalesReportLine> Items { get; set; } = [];

    [Parameter]
    public bool CanViewCosts { get; set; }

    private string Money(decimal value) => $"{value:N2} {Configuration["CurrencyCode"] ?? "BDT"}";
}
