@page "/reports/items"
@attribute [Authorize(Policy = AppPolicies.ManageInventory)]
@attribute [StreamRendering]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.QuickGrid
@inject ReportService Reports
@inject NavigationManager Navigation
@inject ILogger<Products> Logger

<PageTitle>Item sales & returns · @(Configuration["StoreName"] ?? "RetailPOS")</PageTitle>
<div class="page-heading no-print">
    <div>
        <p class="eyebrow">Product performance</p>
        <h1>Item sales & returns</h1>
    </div>
    <div class="flex gap-3">
        <a href="/reports" class="btn-secondary">Reports</a>
        <button type="button" class="btn-secondary" data-print>Print</button>
    </div>
</div>
<ReportFilters Path="/reports/items" Period="@Period" Range="Data?.Range" Start="Start" End="End" Search="@Search" Sort="@Sort"
    SortOptions="SortOptions" SearchHint="Item name, barcode or ID" PageSize="PageSize"
    ShowLocation="true" LocationId="LocationId" Locations="@(Data?.Locations ?? [])" />
@if (Error is not null)
{
    <p class="error-panel" role="alert">@Error</p>
}
@if (Data is not null)
{
    <div class="mb-6 grid gap-4 sm:grid-cols-3">
        <div class="metric">
            <p>Net sales</p>
            <strong class="text-2xl!">@Money(Data.Total)</strong>
        </div>
        <div class="metric">
            <p>Cost of goods sold</p>
            <strong class="text-2xl!">@Money(Data.Cost)</strong>
        </div>
        <div class="metric metric-profit">
            <p>Gross profit</p>
            <strong class="text-2xl!">@Money(Data.Profit)</strong>
        </div>
    </div>
}

<section class="panel table-scroll print-area">
    @if (Data is not null)
    {
        <div class="panel-heading">
            <h2>@Data.Range.Start.ToString("dd MMM yyyy") – @Data.Range.End.ToString("dd MMM yyyy")</h2>
            <span class="text-xs text-slate-500">@Data.Count matching items</span>
        </div>
    }
    @if (Data is null)
    {
        <table class="data-table compact-table w-full">
            <TableStatusRow Columns="10" Loading="@(Error is null)" Error="@(Error is not null)"
                Message="@(Error ?? "Calculating item performance…")" />
        </table>
    }
    else if (Data.Count == 0)
    {
        <table class="data-table compact-table w-full">
            <TableStatusRow Columns="10" Message="No sales or returns match these filters." />
        </table>
    }
    else
    {
        <QuickGrid ItemsProvider="@itemsProvider" Pagination="@pagination" class="data-table compact-table w-full" aria-busy="@(Data is null && Error is null)">
            <TemplateColumn Title="ID" SortBy="@sortById" Sortable="true" Class="w-16 text-center pl-3" Align="Align.Center">
                <HeaderTemplate Context="_">
                    <a class="col-title @GetSortClass("id")" href="@GetSortUrl("id")" title="Sort by ID">
                        <span>ID</span>
                        <span class="sort-indicator" aria-hidden="true"></span>
                    </a>
                </HeaderTemplate>
                <ChildContent Context="item">
                    <a href="@($"/items/{item.ProductId}")" class="font-bold text-blue-700 hover:text-blue-800 text-xs">#@item.ProductId</a>
                </ChildContent>
            </TemplateColumn>

            <TemplateColumn Title="Item" SortBy="@sortByName" Sortable="true" Class="min-w-[140px]">
                <HeaderTemplate Context="_">
                    <a class="col-title @GetSortClass("name")" href="@GetSortUrl("name")" title="Sort by item name">
                        <span>Item</span>
                        <span class="sort-indicator" aria-hidden="true"></span>
                    </a>
                </HeaderTemplate>
                <ChildContent Context="item">
                    <a href="@($"/items/{item.ProductId}")" class="font-medium text-slate-900 hover:text-blue-600 block text-xs truncate max-w-[180px]" title="@item.Name">@item.Name</a>
                    @if (!string.IsNullOrWhiteSpace(item.Barcode))
                    {
                        <span class="font-mono text-[10px] text-slate-400 block truncate max-w-[120px]" title="@item.Barcode">@item.Barcode</span>
                    }
                </ChildContent>
            </TemplateColumn>

            <TemplateColumn Title="Net Qty" SortBy="@sortByQuantity" Sortable="true" Align="Align.Right" Class="whitespace-nowrap">
                <HeaderTemplate Context="_">
                    <a class="col-title @GetSortClass("quantity")" href="@GetSortUrl("quantity")" title="Sort by net quantity">
                        <span>Net Qty</span>
                        <span class="sort-indicator" aria-hidden="true"></span>
                    </a>
                </HeaderTemplate>
                <ChildContent Context="item">
                    <span class="text-xs font-medium text-slate-700">@item.Quantity.ToString("0.###")</span>
                    <span class="text-[10px] text-slate-400 ml-0.5">@item.Unit</span>
                </ChildContent>
            </TemplateColumn>

            <TemplateColumn Title="Cost price" SortBy="@sortByCost" Sortable="true" Align="Align.Right" Class="whitespace-nowrap">
                <HeaderTemplate Context="_">
                    <a class="col-title @GetSortClass("average-cost")" href="@GetSortUrl("average-cost")" title="Sort by cost price">
                        <span>Cost price</span>
                        <span class="sort-indicator" aria-hidden="true"></span>
                    </a>
                </HeaderTemplate>
                <ChildContent Context="item">
                    <span class="text-xs text-slate-500">@(item.AverageCost is not null ? Money(item.AverageCost.Value) : "—")</span>
                </ChildContent>
            </TemplateColumn>

            <TemplateColumn Title="Avg price" SortBy="@sortByPrice" Sortable="true" Align="Align.Right" Class="whitespace-nowrap">
                <HeaderTemplate Context="_">
                    <a class="col-title @GetSortClass("average-price")" href="@GetSortUrl("average-price")" title="Sort by average price">
                        <span>Avg price</span>
                        <span class="sort-indicator" aria-hidden="true"></span>
                    </a>
                </HeaderTemplate>
                <ChildContent Context="item">
                    <span class="text-xs text-slate-500">@(item.AveragePrice is not null ? Money(item.AveragePrice.Value) : "—")</span>
                </ChildContent>
            </TemplateColumn>

            <TemplateColumn Title="Subtotal" SortBy="@sortBySubtotal" Sortable="true" Align="Align.Right" Class="whitespace-nowrap">
                <HeaderTemplate Context="_">
                    <a class="col-title @GetSortClass("subtotal")" href="@GetSortUrl("subtotal")" title="Sort by subtotal">
                        <span>Subtotal</span>
                        <span class="sort-indicator" aria-hidden="true"></span>
                    </a>
                </HeaderTemplate>
                <ChildContent Context="item">
                    <span class="text-xs text-slate-600">@Money(item.Subtotal)</span>
                </ChildContent>
            </TemplateColumn>

            <TemplateColumn Title="Discount" SortBy="@sortByDiscount" Sortable="true" Align="Align.Right" Class="whitespace-nowrap">
                <HeaderTemplate Context="_">
                    <a class="col-title @GetSortClass("discount")" href="@GetSortUrl("discount")" title="Sort by discount">
                        <span>Discount</span>
                        <span class="sort-indicator" aria-hidden="true"></span>
                    </a>
                </HeaderTemplate>
                <ChildContent Context="item">
                    <span class="text-xs text-slate-500">@Money(item.Discount)</span>
                </ChildContent>
            </TemplateColumn>

            <TemplateColumn Title="Net sales" SortBy="@sortByTotal" Sortable="true" Align="Align.Right" Class="whitespace-nowrap">
                <HeaderTemplate Context="_">
                    <a class="col-title @GetSortClass("total")" href="@GetSortUrl("total")" title="Sort by net sales">
                        <span>Net sales</span>
                        <span class="sort-indicator" aria-hidden="true"></span>
                    </a>
                </HeaderTemplate>
                <ChildContent Context="item">
                    <span class="text-xs font-semibold text-slate-900">@Money(item.Total)</span>
                </ChildContent>
            </TemplateColumn>

            <TemplateColumn Title="Cost" SortBy="@sortByCostTotal" Sortable="true" Align="Align.Right" Class="whitespace-nowrap">
                <HeaderTemplate Context="_">
                    <a class="col-title @GetSortClass("cost")" href="@GetSortUrl("cost")" title="Sort by cost">
                        <span>Cost</span>
                        <span class="sort-indicator" aria-hidden="true"></span>
                    </a>
                </HeaderTemplate>
                <ChildContent Context="item">
                    <span class="text-xs text-slate-500">@Money(item.Cost)</span>
                </ChildContent>
            </TemplateColumn>

            <TemplateColumn Title="Profit" SortBy="@sortByProfit" Sortable="true" Align="Align.Right" Class="whitespace-nowrap pr-3">
                <HeaderTemplate Context="_">
                    <a class="col-title @GetSortClass("profit")" href="@GetSortUrl("profit")" title="Sort by profit">
                        <span>Profit</span>
                        <span class="sort-indicator" aria-hidden="true"></span>
                    </a>
                </HeaderTemplate>
                <ChildContent Context="item">
                    <span class="text-xs font-bold @(item.Profit < 0 ? "text-rose-700" : "text-emerald-700")">@Money(item.Profit)</span>
                </ChildContent>
            </TemplateColumn>
        </QuickGrid>

        @if (Data is not null)
        {
            <div class="border-t border-slate-200 bg-slate-50/80 px-4 py-2.5 flex flex-wrap items-center justify-between gap-3 text-xs">
                <div class="flex flex-wrap items-center gap-x-5 gap-y-1">
                    <span class="font-semibold uppercase tracking-wider text-slate-500 text-[10px]">All Matching (@Data.Count items)</span>
                    <span class="text-slate-600">Net Sales: <strong class="text-slate-900 font-semibold">@Money(Data.Total)</strong></span>
                    <span class="text-slate-600">COGS: <strong class="text-slate-900 font-semibold">@Money(Data.Cost)</strong></span>
                    <span class="text-slate-600">Gross Profit: <strong class="font-bold @(Data.Profit < 0 ? "text-rose-700" : "text-emerald-700")">@Money(Data.Profit)</strong></span>
                </div>
                <div class="text-slate-400 text-[11px]">
                    Page Sales: @Money(Data.Rows.Sum(i => i.Total)) · Page Profit: @Money(Data.Rows.Sum(i => i.Profit))
                </div>
            </div>
        }
    }
    <p class="p-4 text-xs text-slate-500">Gross profit is strictly calculated as Net sales minus the total sum of all costs of the items recorded at selling time (total selling amount minus the sum of historical transaction costs, reflecting changing item costs such as ৳300 vs ৳400 exactly), not by multiplying average cost. Average cost and price are shown for reference. Returns subtract quantity, revenue, and saved cost. Discounts are included.</p>
</section>
@if (TotalCount > 0)
{
    <Paginator State="@pagination" />
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    public string Period { get; set; } = "month";

    [SupplyParameterFromQuery]
    public DateOnly? Start { get; set; }

    [SupplyParameterFromQuery]
    public DateOnly? End { get; set; }

    [SupplyParameterFromQuery]
    public int? LocationId { get; set; }

    [SupplyParameterFromQuery]
    public string? Search { get; set; }

    [SupplyParameterFromQuery]
    public string Sort { get; set; } = "id";

    [SupplyParameterFromQuery]
    public int Page { get; set; } = 1;

    [SupplyParameterFromQuery]
    public int PageSize { get; set; } = 30;

    private readonly PaginationState pagination = new() { ItemsPerPage = 30 };
    private GridItemsProvider<ProductSalesRow>? itemsProvider;
    private int TotalCount;

    private readonly GridSort<ProductSalesRow> sortById = GridSort<ProductSalesRow>.ByAscending(i => i.ProductId);
    private readonly GridSort<ProductSalesRow> sortByName = GridSort<ProductSalesRow>.ByAscending(i => i.Name);
    private readonly GridSort<ProductSalesRow> sortByQuantity = GridSort<ProductSalesRow>.ByAscending(i => i.Quantity);
    private readonly GridSort<ProductSalesRow> sortByCost = GridSort<ProductSalesRow>.ByAscending(i => i.AverageCost ?? 0);
    private readonly GridSort<ProductSalesRow> sortByPrice = GridSort<ProductSalesRow>.ByAscending(i => i.AveragePrice ?? 0);
    private readonly GridSort<ProductSalesRow> sortBySubtotal = GridSort<ProductSalesRow>.ByAscending(i => i.Subtotal);
    private readonly GridSort<ProductSalesRow> sortByDiscount = GridSort<ProductSalesRow>.ByAscending(i => i.Discount);
    private readonly GridSort<ProductSalesRow> sortByTotal = GridSort<ProductSalesRow>.ByAscending(i => i.Total);
    private readonly GridSort<ProductSalesRow> sortByCostTotal = GridSort<ProductSalesRow>.ByAscending(i => i.Cost);
    private readonly GridSort<ProductSalesRow> sortByProfit = GridSort<ProductSalesRow>.ByAscending(i => i.Profit);

    private ProductSalesReport? Data;
    private string? Error;
    private static readonly Dictionary<string, string> SortOptions = new()
    {
        ["id"] = "Item ID · low to high",
        ["id-desc"] = "Item ID · high to low",
        ["profit-desc"] = "Profit · high to low",
        ["profit"] = "Profit · low to high",
        ["average-cost"] = "Cost price · low to high",
        ["average-cost-desc"] = "Cost price · high to low",
        ["average-price"] = "Average price · low to high",
        ["average-price-desc"] = "Average price · high to low",
        ["subtotal"] = "Subtotal · low to high",
        ["subtotal-desc"] = "Subtotal · high to low",
        ["discount"] = "Discount · low to high",
        ["discount-desc"] = "Discount · high to low",
        ["name"] = "Name · A–Z",
        ["name-desc"] = "Name · Z–A",
        ["quantity-desc"] = "Quantity · high to low",
        ["quantity"] = "Quantity · low to high",
        ["total-desc"] = "Sales · high to low",
        ["total"] = "Sales · low to high",
        ["cost-desc"] = "Cost · high to low",
        ["cost"] = "Cost · low to high"
    };

    protected override async Task OnParametersSetAsync()
    {
        Sort = string.IsNullOrWhiteSpace(Sort) ? "id" : Sort;
        Period = string.IsNullOrWhiteSpace(Period) ? "month" : Period;
        Data = null;
        Error = null;
        itemsProvider = null;
        try
        {
            var size = QueryPagination.Size(PageSize);
            pagination.ItemsPerPage = size;

            Data = await Reports.ProductsAsync(HttpContext.User, Period, Start, End, Page,
                HttpContext.RequestAborted, Search, Sort, LocationId, size);
            TotalCount = Data.Count;

            var maxPageIndex = Math.Max(0, (TotalCount - 1) / pagination.ItemsPerPage);
            var targetPageIndex = Math.Clamp(Data.Page - 1, 0, maxPageIndex);
            if (pagination.CurrentPageIndex != targetPageIndex)
            {
                await pagination.SetCurrentPageIndexAsync(targetPageIndex);
            }

            itemsProvider = req => ValueTask.FromResult(GridItemsProviderResult.From(Data.Rows.ToList(), TotalCount));
        }
        catch (ValidationException exception)
        {
            Error = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Item sales report failed.");
            Error = "Unable to load item sales. Please try again.";
        }
    }

    private string GetSortUrl(string column)
    {
        var cleanSort = (Sort ?? "id").ToLowerInvariant().Replace("-descending", "").Replace("-desc", "");
        var isCurrent = string.Equals(cleanSort, column, StringComparison.OrdinalIgnoreCase);
        var currentIsDesc = (Sort ?? "").EndsWith("-desc", StringComparison.OrdinalIgnoreCase)
            || (Sort ?? "").EndsWith("-descending", StringComparison.OrdinalIgnoreCase);
        var nextDirection = isCurrent && !currentIsDesc ? $"{column}-desc" : column;
        return Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["sort"] = nextDirection,
            ["page"] = 1
        });
    }

    private string GetSortClass(string column)
    {
        var cleanSort = (Sort ?? "id").ToLowerInvariant().Replace("-descending", "").Replace("-desc", "");
        if (!string.Equals(cleanSort, column, StringComparison.OrdinalIgnoreCase))
        {
            return "";
        }
        var currentIsDesc = (Sort ?? "").EndsWith("-desc", StringComparison.OrdinalIgnoreCase)
            || (Sort ?? "").EndsWith("-descending", StringComparison.OrdinalIgnoreCase);
        return currentIsDesc ? "col-sort-desc" : "col-sort-asc";
    }

    private string Money(decimal value) => $"{value:N2} {Configuration["CurrencyCode"] ?? "BDT"}";
}
