@attribute [StreamRendering]
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using Microsoft.AspNetCore.Components.QuickGrid
@using POSApp.Client.DTOs
@inject ReportService Reports
@inject AnalyticsService Analytics
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<TransactionReport> Logger

<PageTitle>@Title report · @(Configuration["StoreName"] ?? "RetailPOS")</PageTitle>

<div class="page-heading no-print">
    <h1>@Title report</h1>
    <div class="flex gap-3">
        <a href="/reports" class="btn-secondary">Reports</a>
        <button type="button" class="btn-secondary" data-print>Print</button>
    </div>
</div>
<ReportFilters Path="@Path" Period="@Period" Range="Data?.Range" Start="Start" End="End" Search="@Search" Sort="@Sort"
    SortOptions="SortOptions" SearchHint="ID, reference or customer"
    ShowLocation="true" LocationId="LocationId" Locations="@(Data?.Locations ?? [])" />

@if (Error is not null)
{
    <p role="alert" class="error-panel">@Error</p>
}
<section class="print-area">
    @if (Data is not null)
    {
        <h2 class="mb-4 text-sm text-slate-500">@Data.Range.Start.ToString("dd MMM yyyy") – @Data.Range.End.ToString("dd MMM yyyy")</h2>
        <div class="@(Data.CanViewCosts && Sales ? "mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-5" : "mb-6 grid gap-4 sm:grid-cols-3")">
            <div class="metric">
                <p>Transactions</p>
                <strong>@Data.Count</strong>
            </div>
            <div class="metric">
                <p>Net total</p>
                <strong class="text-2xl!">@Money(Data.Total)</strong>
                @if (Sales && Timeline is not null && Timeline.Points.Count > 0)
                {
                    <span class="metric-note">Avg: @Money(Data.Total / Timeline.Points.Count) / day (@Timeline.Points.Count trading @(Timeline.Points.Count == 1 ? "day" : "days"))</span>
                }
            </div>
            @if (Data.CanViewCosts && Sales)
            {
                <div class="metric">
                    <p>Cost of goods sold</p>
                    <strong class="text-2xl!">@Money(Data.Cost ?? 0)</strong>
                </div>
                <div class="metric metric-profit">
                    <p>Gross profit</p>
                    <strong class="text-2xl!">@Money(Data.Profit ?? 0)</strong>
                </div>
            }
            <div class="metric">
                <p>Paid</p>
                <strong class="text-2xl!">@Money(Data.Paid)</strong>
            </div>
        </div>

        @if (Sales && Timeline is not null && Timeline.Points.Count > 1)
        {
            <div class="grid grid-cols-1 xl:grid-cols-2 gap-6 mb-6 no-print">
                <!-- Chart 1: Sales & Profit Trend -->
                <div class="chart-card bg-white rounded-xl border border-slate-200/80 p-5 shadow-xs">
                    <div class="flex items-center justify-between mb-4">
                        <div>
                            <h3 class="text-base font-bold text-slate-800">Sales &amp; Profit Trend</h3>
                            <p class="text-xs text-slate-500">Daily revenue and gross profit progression across period</p>
                        </div>
                        <div class="flex items-center gap-2">
                            @if (Timeline.ClosedDaysExcludedCount > 0)
                            {
                                <span class="stat-pill bg-amber-50 text-amber-700 font-semibold text-xs px-2.5 py-1 rounded-full border border-amber-200" title="@string.Join(", ", Timeline.ClosedDays?.Select(d => d.ToString("dd MMM yyyy")) ?? [])">
                                    @Timeline.ClosedDaysExcludedCount closed @(Timeline.ClosedDaysExcludedCount == 1 ? "day" : "days") excluded
                                </span>
                            }
                            <AuthorizeView Policy="@AppPolicies.ManageUsers">
                                <a href="/administration/calendar" class="text-xs text-indigo-600 hover:text-indigo-800 font-medium">Manage closed days</a>
                            </AuthorizeView>
                            <span class="stat-pill bg-indigo-50 text-indigo-700 font-semibold text-xs px-2.5 py-1 rounded-full">Trend</span>
                        </div>
                    </div>
                    <div class="relative h-64 w-full">
                        <canvas id="sales-timeline-chart"
                                data-chart="line"
                                data-currency="@(Configuration["CurrencyCode"] ?? "BDT")"
                                data-labels="@JsonSerializer.Serialize(Timeline.Points.Select(p => p.Date.ToString("dd MMM")))"
                                data-datasets="@JsonSerializer.Serialize(TimelineDatasets)">
                        </canvas>
                    </div>
                </div>

                <!-- Chart 2: Profit Margin Trend -->
                <div class="chart-card bg-white rounded-xl border border-slate-200/80 p-5 shadow-xs">
                    <div class="flex items-center justify-between mb-4">
                        <div>
                            <h3 class="text-base font-bold text-slate-800">Gross Profit Margin Trend</h3>
                            <p class="text-xs text-slate-500">Daily gross profit margin percentage across period</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="stat-pill bg-teal-50 text-teal-700 font-semibold text-xs px-2.5 py-1 rounded-full border border-teal-200">Margin %</span>
                        </div>
                    </div>
                    <div class="relative h-64 w-full">
                        <canvas id="sales-margin-chart"
                                data-chart="line"
                                data-currency="%"
                                data-labels="@JsonSerializer.Serialize(Timeline.Points.Select(p => p.Date.ToString("dd MMM")))"
                                data-datasets="@JsonSerializer.Serialize(MarginDatasets)">
                        </canvas>
                    </div>
                </div>
            </div>
        }
    }

    <div class="panel table-scroll">
        @if (Data is null)
        {
            <table class="data-table compact-table w-full" aria-busy="true">
                <tbody>
                    <TableStatusRow Columns="ColumnCount" Loading="@(Error is null)" Error="@(Error is not null)"
                        Message="@(Error ?? "Loading report…")" />
                </tbody>
            </table>
        }
        else
        {
            <QuickGrid ItemsProvider="@itemsProvider" Pagination="@pagination" class="data-table compact-table w-full" aria-busy="@(Data is null && Error is null)">
                <TemplateColumn Title="ID" SortBy="@sortById" Class="w-20 text-center" Align="Align.Center">
                    <HeaderTemplate>
                        <a href="@GetSortUrl("id")" class="col-title @GetSortClass("id")" data-enhance>ID</a>
                    </HeaderTemplate>
                    <ChildContent>
                        <a href="@(Sales ? $"/sales/{context.Id}/bill" : $"/receiving/{context.Id}")" class="font-bold text-blue-700 text-xs hover:underline">#@context.Id</a>
                        <span class="block max-w-28 truncate font-mono text-[10px] text-slate-400 mx-auto" title="@context.Number">@context.Number</span>
                    </ChildContent>
                </TemplateColumn>
                <TemplateColumn Title="@(Sales ? "Customer" : "Supplier")" SortBy="@sortByParty">
                    <HeaderTemplate>
                        <a href="@GetSortUrl("party")" class="col-title @GetSortClass("party")" data-enhance>@(Sales ? "Customer" : "Supplier")</a>
                    </HeaderTemplate>
                    <ChildContent>
                        <span class="font-medium text-slate-900 text-xs">@context.Party</span>
                        @if (Sales && context.Items.Count > 0)
                        {
                            <details class="mt-1">
                                <summary class="cursor-pointer text-[11px] font-semibold text-blue-700 hover:text-blue-900">View @context.Items.Count @(context.Items.Count == 1 ? "item" : "items")</summary>
                                <div class="mt-1.5 rounded border border-slate-200 bg-white p-2">
                                    <SalesLineTable Items="context.Items" CanViewCosts="CanViewCosts" />
                                </div>
                            </details>
                        }
                    </ChildContent>
                </TemplateColumn>
                <TemplateColumn Title="Date" SortBy="@sortByDate" Class="whitespace-nowrap">
                    <HeaderTemplate>
                        <a href="@GetSortUrl("date")" class="col-title @GetSortClass("date")" data-enhance>Date</a>
                    </HeaderTemplate>
                    <ChildContent>
                        <span class="text-xs text-slate-600 font-mono">@TimeZoneInfo.ConvertTime(context.At, Zone).ToString("dd MMM yyyy, HH:mm")</span>
                    </ChildContent>
                </TemplateColumn>
                <TemplateColumn Title="Total" SortBy="@sortByTotal" Align="Align.Right" Class="whitespace-nowrap">
                    <HeaderTemplate>
                        <a href="@GetSortUrl("total")" class="col-title @GetSortClass("total")" data-enhance>Total</a>
                    </HeaderTemplate>
                    <ChildContent>
                        <span class="font-mono text-xs font-semibold text-slate-900">@Money(context.Total)</span>
                    </ChildContent>
                </TemplateColumn>
                @if (CanViewCosts && Sales)
                {
                    <TemplateColumn Title="Cost" SortBy="@sortByCost" Align="Align.Right" Class="whitespace-nowrap">
                        <HeaderTemplate>
                            <a href="@GetSortUrl("cost")" class="col-title @GetSortClass("cost")" data-enhance>Cost</a>
                        </HeaderTemplate>
                        <ChildContent>
                            <span class="font-mono text-xs text-slate-600">@Money(context.Cost ?? 0)</span>
                        </ChildContent>
                    </TemplateColumn>
                    <TemplateColumn Title="Profit" SortBy="@sortByProfit" Align="Align.Right" Class="whitespace-nowrap">
                        <HeaderTemplate>
                            <a href="@GetSortUrl("profit")" class="col-title @GetSortClass("profit")" data-enhance>Profit</a>
                        </HeaderTemplate>
                        <ChildContent>
                            <span class="font-mono text-xs font-semibold @(context.Profit < 0 ? "text-rose-700" : "text-emerald-700")">@Money(context.Profit ?? 0)</span>
                        </ChildContent>
                    </TemplateColumn>
                }
                <TemplateColumn Title="Paid" SortBy="@sortByPaid" Align="Align.Right" Class="whitespace-nowrap">
                    <HeaderTemplate>
                        <a href="@GetSortUrl("paid")" class="col-title @GetSortClass("paid")" data-enhance>Paid</a>
                    </HeaderTemplate>
                    <ChildContent>
                        <span class="font-mono text-xs text-slate-700">@Money(context.Paid)</span>
                    </ChildContent>
                </TemplateColumn>
                <TemplateColumn Title="@(Sales ? "Due" : "Net unpaid / credit")" SortBy="@sortByDue" Align="Align.Right" Class="whitespace-nowrap">
                    <HeaderTemplate>
                        <a href="@GetSortUrl("due")" class="col-title @GetSortClass("due")" data-enhance>@(Sales ? "Due" : "Net unpaid / credit")</a>
                    </HeaderTemplate>
                    <ChildContent>
                        @{
                            var unpaid = context.Total - context.Paid;
                        }
                        <span class="font-mono text-xs font-semibold @(unpaid > 0 ? "text-amber-700" : "text-slate-500")">@Money(unpaid)</span>
                    </ChildContent>
                </TemplateColumn>
            </QuickGrid>
            @if (Data is not null && Data.Rows.Count > 0)
            {
                <div class="border-t border-slate-200 bg-slate-50/80 px-4 py-2.5 flex flex-col gap-2 text-xs">
                    @foreach (var summary in Summaries)
                    {
                        <div class="flex flex-wrap items-center justify-between gap-3">
                            <span class="font-semibold text-slate-700">@summary.Label</span>
                            <div class="flex flex-wrap items-center gap-4">
                                <span>Total: <strong class="text-slate-900 font-mono">@Money(summary.Total)</strong></span>
                                @if (CanViewCosts && Sales)
                                {
                                    <span>Cost: <strong class="text-slate-600 font-mono">@Money(summary.Cost)</strong></span>
                                    <span>Profit: <strong class="@(summary.Total - summary.Cost < 0 ? "text-rose-700" : "text-emerald-700") font-bold font-mono">@Money(summary.Total - summary.Cost)</strong></span>
                                }
                                <span>Paid: <strong class="text-slate-700 font-mono">@Money(summary.Paid)</strong></span>
                                <span>Due: <strong class="text-amber-700 font-bold font-mono">@Money(summary.Total - summary.Paid)</strong></span>
                            </div>
                        </div>
                    }
                </div>
            }
            @if (Data is not null && Data.Rows.Count == 0)
            {
                <p class="p-6 text-sm text-slate-500">No transactions in this date range.</p>
            }
        }
    </div>
    @if (TotalCount > 0)
    {
        <Paginator State="@pagination" />
    }

</section>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [Parameter]
    public bool Sales { get; set; }

    [Parameter]
    public string Period { get; set; } = "today";

    [Parameter]
    public DateOnly? Start { get; set; }

    [Parameter]
    public DateOnly? End { get; set; }

    [Parameter]
    public int? LocationId { get; set; }

    [Parameter]
    public string? Search { get; set; }

    [Parameter]
    public string Sort { get; set; } = "id";

    [Parameter]
    public int Page { get; set; }

    [Parameter]
    public int PageSize { get; set; } = 30;

    private readonly PaginationState pagination = new() { ItemsPerPage = 30 };
    private GridItemsProvider<ReportRow>? itemsProvider;
    private int TotalCount;

    private readonly GridSort<ReportRow> sortById = GridSort<ReportRow>.ByAscending(r => r.Id);
    private readonly GridSort<ReportRow> sortByParty = GridSort<ReportRow>.ByAscending(r => r.Party);
    private readonly GridSort<ReportRow> sortByDate = GridSort<ReportRow>.ByAscending(r => r.At);
    private readonly GridSort<ReportRow> sortByTotal = GridSort<ReportRow>.ByAscending(r => r.Total);
    private readonly GridSort<ReportRow> sortByCost = GridSort<ReportRow>.ByAscending(r => r.Cost ?? 0);
    private readonly GridSort<ReportRow> sortByProfit = GridSort<ReportRow>.ByAscending(r => r.Profit ?? 0);
    private readonly GridSort<ReportRow> sortByPaid = GridSort<ReportRow>.ByAscending(r => r.Paid);
    private readonly GridSort<ReportRow> sortByDue = GridSort<ReportRow>.ByAscending(r => r.Total - r.Paid);

    private bool CanViewCosts => Data?.CanViewCosts
        ?? (HttpContext.User.IsInRole(AppRoles.Admin) || HttpContext.User.IsInRole(AppRoles.InventoryManager));
    private int ColumnCount => CanViewCosts && Sales ? 8 : 6;
    private ReportPage? Data;
    private SalesTimelineReportData? Timeline;
    private string? Error;
    private string Title => Sales ? "Sales" : "Receiving";
    private string Path => Sales ? "/reports/sales" : "/reports/receiving";
    private TimeZoneInfo Zone => TimeZoneInfo.FindSystemTimeZoneById(Configuration["BusinessTimeZone"] ?? "Asia/Dhaka");
    private IReadOnlyDictionary<string, string> SortOptions
    {
        get
        {
            var options = new Dictionary<string, string>
            {
                ["due"] = "Due · low to high",
                ["due-desc"] = "Due · high to low",
                ["date-desc"] = "Date · newest first",
                ["date"] = "Date · oldest first",
                ["id-desc"] = "ID · high to low",
                ["id"] = "ID · low to high",
                ["party"] = "Customer · A–Z",
                ["party-desc"] = "Customer · Z–A",
                ["total-desc"] = "Sales · high to low",
                ["total"] = "Sales · low to high",
                ["paid-desc"] = "Paid · high to low",
                ["paid"] = "Paid · low to high"
            };
            if (Data?.CanViewCosts == true)
            {
                options["profit-desc"] = "Profit · high to low";
                options["profit"] = "Profit · low to high";
                options["cost-desc"] = "Cost · high to low";
                options["cost"] = "Cost · low to high";
            }
            return options;
        }
    }

    private (string Label, decimal Total, decimal Paid, decimal Cost)[] Summaries => Data is null ? [] :
    [
        ("This page", Data.Rows.Sum(row => row.Total), Data.Rows.Sum(row => row.Paid), Data.Rows.Sum(row => row.Cost ?? 0)),
        ($"All matching transactions ({Data.Count})", Data.Total, Data.Paid, Data.Cost ?? 0)
    ];

    private object[] TimelineDatasets => Timeline is null ? [] :
    [
        new {
            label = "Sales Revenue",
            data = Timeline.Points.Select(p => p.SalesRevenue).ToList(),
            color = "#4f46e5",
            fillColor = "rgba(79, 70, 229, 0.12)"
        },
        new {
            label = "Gross Profit",
            data = Timeline.Points.Select(p => p.GrossProfit).ToList(),
            color = "#10b981",
            fillColor = "rgba(16, 185, 129, 0.08)"
        }
    ];

    private object[] MarginDatasets => Timeline is null ? [] :
    [
        new {
            label = "Gross Margin %",
            data = Timeline.Points.Select(p => p.MarginPercentage).ToList(),
            color = "#0d9488",
            fillColor = "rgba(13, 148, 136, 0.12)"
        }
    ];

    protected override async Task OnParametersSetAsync()
    {
        Sort = string.IsNullOrWhiteSpace(Sort) ? "id" : Sort;
        Period = string.IsNullOrWhiteSpace(Period) ? "today" : Period;
        Data = null;
        Timeline = null;
        Error = null;
        itemsProvider = null;
        try
        {
            var size = QueryPagination.Size(PageSize);
            pagination.ItemsPerPage = size;

            Data = await Reports.ReadAsync(HttpContext.User, Sales, Period, Start, End, Page,
                HttpContext.RequestAborted, Search, Sort, LocationId, size);
            TotalCount = Data.Count;

            var maxPageIndex = Math.Max(0, (TotalCount - 1) / pagination.ItemsPerPage);
            var targetPageIndex = Math.Clamp(Data.Page - 1, 0, maxPageIndex);
            if (pagination.CurrentPageIndex != targetPageIndex)
            {
                await pagination.SetCurrentPageIndexAsync(targetPageIndex);
            }

            itemsProvider = req => ValueTask.FromResult(GridItemsProviderResult.From(Data.Rows.ToList(), TotalCount));

            if (Sales && Data is not null && Data.Range.Start != Data.Range.End)
            {
                Timeline = await Analytics.GetSalesTimelineAsync(
                    HttpContext.User,
                    Data.Range.Start,
                    Data.Range.End,
                    LocationId,
                    HttpContext.RequestAborted);
            }
        }
        catch (ValidationException exception)
        {
            Error = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Report loading failed.");
            Error = "Unable to load this report. Try again.";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await JS.InvokeVoidAsync("PosCharts.initDeclarativeCharts");
        }
        catch
        {
        }
    }

    private string GetSortUrl(string column)
    {
        var cleanSort = (Sort ?? "id").ToLowerInvariant().Replace("-descending", "").Replace("-desc", "");
        var isCurrent = string.Equals(cleanSort, column, StringComparison.OrdinalIgnoreCase);
        var currentIsDesc = (Sort ?? "").EndsWith("-desc", StringComparison.OrdinalIgnoreCase)
            || (Sort ?? "").EndsWith("-descending", StringComparison.OrdinalIgnoreCase);
        var nextDirection = isCurrent && !currentIsDesc ? $"{column}-desc" : column;
        return Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["sort"] = nextDirection,
            ["page"] = 1
        });
    }

    private string GetSortClass(string column)
    {
        var cleanSort = (Sort ?? "id").ToLowerInvariant().Replace("-descending", "").Replace("-desc", "");
        if (!string.Equals(cleanSort, column, StringComparison.OrdinalIgnoreCase))
        {
            return "";
        }
        var currentIsDesc = (Sort ?? "").EndsWith("-desc", StringComparison.OrdinalIgnoreCase)
            || (Sort ?? "").EndsWith("-descending", StringComparison.OrdinalIgnoreCase);
        return currentIsDesc ? "col-sort-desc" : "col-sort-asc";
    }

    private string Money(decimal amount) => $"{amount:N2} {Configuration["CurrencyCode"] ?? "BDT"}";
}
