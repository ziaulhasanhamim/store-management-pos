@page "/reports/margin-matrix"
@attribute [Authorize(Policy = AppPolicies.MakeSales)]
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using POSApp.Client.DTOs
@using POSApp.Client.Security
@using POSApp.Services
@inject AnalyticsService Analytics
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Profit Margin Matrix · @(Configuration["StoreName"] ?? "RetailPOS")</PageTitle>

<div class="page-heading">
    <div>
        <nav class="breadcrumb">
            <a href="/">Dashboard</a>
            <span>/</span>
            <a href="/reports">Reports</a>
            <span>/</span>
            <span>Profit margin matrix</span>
        </nav>
        <h1 class="mt-1">Profit Margin Matrix</h1>
        <p class="text-sm text-slate-500">Portfolio quadrant analysis categorizing products by sales volume and profitability</p>
    </div>
    <div class="flex flex-wrap gap-2 no-print">
        <a href="@ExportCsvUrl" class="btn-secondary" download>
            <Icon Name="history" Class="size-4 mr-1.5" />
            Export CSV
        </a>
        <a href="/reports/sales" class="btn-secondary">
            <Icon Name="wallet" Class="size-4 mr-1.5" />
            Sales report
        </a>
    </div>
</div>

@if (Error is not null)
{
    <p class="error-panel mb-4" role="alert">@Error</p>
}

@if (Data is null)
{
    <LoadingPanel Message="Constructing product profitability matrix…" />
}
else
{
    <!-- Filter Presets & Controls -->
    <div class="report-filters no-print mb-6">
        <div class="mb-4 flex flex-wrap items-center gap-2">
            @foreach (var preset in Presets)
            {
                <a href="@PresetLink(preset.Key)" class="@(Period == preset.Key ? "filter-chip active" : "filter-chip")">@preset.Value</a>
            }
        </div>

        <form method="get" action="/reports/margin-matrix" class="grid items-end gap-3 sm:grid-cols-2 xl:grid-cols-4" data-enhance data-auto-search="false">
            <input type="hidden" name="period" value="custom" />
            <input type="hidden" name="quadrant" value="@QuadrantFilter" />

            <div class="sm:col-span-2">
                <label class="field-label">Date range</label>
                <DateRangePicker Id="margin-date-range" Start="@EffectiveStart" End="@EffectiveEnd" AutoSubmit="false" />
            </div>

            <div>
                <label class="field-label" for="filter-location">Store Location</label>
                <select id="filter-location" name="locationId" class="field">
                    <option value="">All store locations</option>
                    @foreach (var loc in Data.Locations)
                    {
                        <option value="@loc.Id" selected="@(LocationId == loc.Id)">@loc.Name</option>
                    }
                </select>
            </div>

            <div class="flex items-end">
                <button type="submit" class="btn-primary w-full py-2 px-4">
                    <Icon Name="search" Class="size-4 mr-1" />
                    Analyze matrix
                </button>
            </div>
        </form>
    </div>

    <!-- Summary KPI Quadrant Cards -->
    <div class="mb-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <!-- Stars Card -->
        <a href="@QuadrantLink("star")" class="metric bg-white border border-indigo-200/80 shadow-xs hover:border-indigo-400 transition-all cursor-pointer @(QuadrantFilter == "star" ? "ring-2 ring-indigo-500 bg-indigo-50/20" : "")">
            <div class="flex items-center justify-between">
                <p class="text-xs font-bold uppercase tracking-wider text-indigo-700">⭐ Stars</p>
                <span class="inline-flex size-7 items-center justify-center rounded-lg bg-indigo-100 text-indigo-700 text-xs font-bold">
                    @Data.StarsCount
                </span>
            </div>
            <strong class="text-2xl mt-1 text-indigo-700">@Data.StarsCount items</strong>
            <span class="text-xs text-slate-500 mt-0.5">High Volume & High Margin</span>
        </a>

        <!-- Cash Cows Card -->
        <a href="@QuadrantLink("cashcow")" class="metric bg-white border border-blue-200/80 shadow-xs hover:border-blue-400 transition-all cursor-pointer @(QuadrantFilter == "cashcow" ? "ring-2 ring-blue-500 bg-blue-50/20" : "")">
            <div class="flex items-center justify-between">
                <p class="text-xs font-bold uppercase tracking-wider text-blue-700">💰 Cash Cows</p>
                <span class="inline-flex size-7 items-center justify-center rounded-lg bg-blue-100 text-blue-700 text-xs font-bold">
                    @Data.CashCowsCount
                </span>
            </div>
            <strong class="text-2xl mt-1 text-blue-700">@Data.CashCowsCount items</strong>
            <span class="text-xs text-slate-500 mt-0.5">High Volume & Lower Margin</span>
        </a>

        <!-- Opportunities Card -->
        <a href="@QuadrantLink("opportunity")" class="metric bg-white border border-emerald-200/80 shadow-xs hover:border-emerald-400 transition-all cursor-pointer @(QuadrantFilter == "opportunity" ? "ring-2 ring-emerald-500 bg-emerald-50/20" : "")">
            <div class="flex items-center justify-between">
                <p class="text-xs font-bold uppercase tracking-wider text-emerald-700">🚀 Opportunities</p>
                <span class="inline-flex size-7 items-center justify-center rounded-lg bg-emerald-100 text-emerald-700 text-xs font-bold">
                    @Data.OpportunitiesCount
                </span>
            </div>
            <strong class="text-2xl mt-1 text-emerald-700">@Data.OpportunitiesCount items</strong>
            <span class="text-xs text-slate-500 mt-0.5">Low Volume & High Margin</span>
        </a>

        <!-- Laggards Card -->
        <a href="@QuadrantLink("laggard")" class="metric bg-white border border-slate-200/80 shadow-xs hover:border-amber-400 transition-all cursor-pointer @(QuadrantFilter == "laggard" ? "ring-2 ring-amber-500 bg-amber-50/20" : "")">
            <div class="flex items-center justify-between">
                <p class="text-xs font-bold uppercase tracking-wider text-slate-600">⚠️ Laggards</p>
                <span class="inline-flex size-7 items-center justify-center rounded-lg bg-slate-100 text-slate-700 text-xs font-bold">
                    @Data.LaggardsCount
                </span>
            </div>
            <strong class="text-2xl mt-1 text-slate-700">@Data.LaggardsCount items</strong>
            <span class="text-xs text-slate-500 mt-0.5">Low Volume & Lower Margin</span>
        </a>
    </div>

    <!-- Visual Charts & Quadrant Breakdown -->
    <div class="mb-6 grid gap-6 lg:grid-cols-2">
        <!-- Quadrant Distribution Chart -->
        <div class="chart-card bg-white rounded-xl border border-slate-200/80 p-5 shadow-xs">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <h2 class="text-base font-bold text-slate-800">Portfolio Quadrant Share</h2>
                    <p class="text-xs text-slate-500">Distribution across performance segments</p>
                </div>
                <span class="stat-pill bg-indigo-50 text-indigo-700 font-semibold text-xs px-2.5 py-1 rounded-full">Share</span>
            </div>
            <div class="relative h-72 w-full">
                @{
                    var qLabels = new[] { "⭐ Stars", "💰 Cash Cows", "🚀 Opportunities", "⚠️ Laggards" };
                    var qValues = new[] { Data.StarsCount, Data.CashCowsCount, Data.OpportunitiesCount, Data.LaggardsCount };
                    var qColors = new[] { "#4f46e5", "#3b82f6", "#10b981", "#64748b" };
                }
                <canvas id="margin-quadrant-donut"
                        data-chart="donut"
                        data-currency=""
                        data-labels="@JsonSerializer.Serialize(qLabels)"
                        data-values="@JsonSerializer.Serialize(qValues)"
                        data-colors="@JsonSerializer.Serialize(qColors)">
                </canvas>
            </div>
        </div>

        <!-- Strategy Matrix Legend & Guide -->
        <div class="chart-card bg-white rounded-xl border border-slate-200/80 p-5 shadow-xs flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-base font-bold text-slate-800">Matrix Strategic Directives</h2>
                    <span class="stat-pill bg-slate-100 text-slate-700 font-semibold text-xs px-2.5 py-1 rounded-full">Guide</span>
                </div>
                <p class="text-xs text-slate-500 mb-4">Actionable merchandising recommendations according to sales velocity and margins:</p>

                <div class="space-y-3">
                    <div class="flex items-start gap-3 p-2.5 rounded-lg bg-indigo-50/60 border border-indigo-100">
                        <span class="text-lg">⭐</span>
                        <div class="text-xs">
                            <strong class="text-indigo-900 block font-semibold">Stars (@Data.StarsCount SKUs)</strong>
                            <span class="text-indigo-800">Your top winners. Maintain constant inventory, feature on prime store shelves, and protect supplier stock lines.</span>
                        </div>
                    </div>

                    <div class="flex items-start gap-3 p-2.5 rounded-lg bg-blue-50/60 border border-blue-100">
                        <span class="text-lg">💰</span>
                        <div class="text-xs">
                            <strong class="text-blue-900 block font-semibold">Cash Cows (@Data.CashCowsCount SKUs)</strong>
                            <span class="text-blue-800">High foot-traffic drivers. Maintain bulk procurement discounts and bundle with high-margin items to lift basket profit.</span>
                        </div>
                    </div>

                    <div class="flex items-start gap-3 p-2.5 rounded-lg bg-emerald-50/60 border border-emerald-100">
                        <span class="text-lg">🚀</span>
                        <div class="text-xs">
                            <strong class="text-emerald-900 block font-semibold">Opportunities (@Data.OpportunitiesCount SKUs)</strong>
                            <span class="text-emerald-800">Lucrative profit margins but underperforming in unit sales. Train staff to cross-sell and run shelf promotions.</span>
                        </div>
                    </div>

                    <div class="flex items-start gap-3 p-2.5 rounded-lg bg-slate-50 border border-slate-200">
                        <span class="text-lg">⚠️</span>
                        <div class="text-xs">
                            <strong class="text-slate-900 block font-semibold">Laggards (@Data.LaggardsCount SKUs)</strong>
                            <span class="text-slate-600">Low turnover and low profit. Reprice to improve margins or clear existing stock and allocate shelf space elsewhere.</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
                <span>Thresholds: Vol &ge; <strong>@Data.MedianVolume</strong> units</span>
                <span>Margin &ge; <strong>@Data.MedianMargin.ToString("0.0")%</strong></span>
            </div>
        </div>
    </div>

    <!-- Filter Tabs for Table -->
    <div class="mb-4 flex flex-wrap items-center gap-2">
        <a href="@QuadrantLink(null)" class="@(string.IsNullOrEmpty(QuadrantFilter) ? "filter-chip active" : "filter-chip")">
            All Products (@Data.Items.Count)
        </a>
        <a href="@QuadrantLink("star")" class="@(QuadrantFilter == "star" ? "filter-chip active" : "filter-chip")">
            ⭐ Stars (@Data.StarsCount)
        </a>
        <a href="@QuadrantLink("cashcow")" class="@(QuadrantFilter == "cashcow" ? "filter-chip active" : "filter-chip")">
            💰 Cash Cows (@Data.CashCowsCount)
        </a>
        <a href="@QuadrantLink("opportunity")" class="@(QuadrantFilter == "opportunity" ? "filter-chip active" : "filter-chip")">
            🚀 Opportunities (@Data.OpportunitiesCount)
        </a>
        <a href="@QuadrantLink("laggard")" class="@(QuadrantFilter == "laggard" ? "filter-chip active" : "filter-chip")">
            ⚠️ Laggards (@Data.LaggardsCount)
        </a>
    </div>

    <!-- Product Matrix Table -->
    <section class="panel bg-white border border-slate-200/80 shadow-xs rounded-xl overflow-hidden mb-8">
        <div class="border-b border-slate-200/80 px-5 py-4 flex flex-wrap items-center justify-between gap-3">
            <div>
                <h2 class="text-base font-bold text-slate-800">Product Portfolio Matrix</h2>
                <p class="text-xs text-slate-500">Classified by volume and profit margin thresholds</p>
            </div>
            <div class="text-xs font-semibold text-slate-500">
                Showing @FilteredItems.Count products
            </div>
        </div>

        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Category</th>
                        <th class="text-right">Units Sold</th>
                        <th class="text-right">Total Revenue</th>
                        <th class="text-right">Total Cost</th>
                        <th class="text-right">Gross Profit</th>
                        <th class="text-right">Margin %</th>
                        <th>Quadrant</th>
                        <th>Strategic Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (FilteredItems.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="p-8 text-center text-slate-400">
                                No products found matching your current quadrant filter.
                            </td>
                        </tr>
                    }
                    @foreach (var item in FilteredItems)
                    {
                        <tr>
                            <td>
                                <a href="/items/@item.ProductId" class="font-semibold text-blue-700 hover:underline">
                                    @item.ProductName
                                </a>
                            </td>
                            <td class="text-slate-600">@item.CategoryName</td>
                            <td class="text-right tabular-nums font-semibold text-slate-800">@item.UnitsSold.ToString("N0")</td>
                            <td class="text-right tabular-nums font-semibold text-blue-700">@Money(item.TotalRevenue)</td>
                            <td class="text-right tabular-nums text-slate-500">@Money(item.TotalCost)</td>
                            <td class="text-right tabular-nums font-bold @(item.TotalProfit < 0 ? "text-rose-600" : "text-emerald-700")">
                                @Money(item.TotalProfit)
                            </td>
                            <td class="text-right tabular-nums">
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold @(item.MarginPercent >= 25 ? "bg-emerald-50 text-emerald-700" : (item.MarginPercent >= 10 ? "bg-blue-50 text-blue-700" : "bg-amber-50 text-amber-700"))">
                                    @item.MarginPercent.ToString("0.0")%
                                </span>
                            </td>
                            <td>
                                @switch (item.Quadrant)
                                {
                                    case MarginQuadrant.Star:
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200">
                                            ⭐ Star
                                        </span>
                                        break;
                                    case MarginQuadrant.CashCow:
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200">
                                            💰 Cash Cow
                                        </span>
                                        break;
                                    case MarginQuadrant.Opportunity:
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            🚀 Opportunity
                                        </span>
                                        break;
                                    case MarginQuadrant.Laggard:
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600 border border-slate-200">
                                            ⚠️ Laggard
                                        </span>
                                        break;
                                }
                            </td>
                            <td class="text-xs text-slate-600 font-medium">
                                @switch (item.Quadrant)
                                {
                                    case MarginQuadrant.Star:
                                        <span class="text-indigo-700 font-semibold">Promote & secure stock</span>
                                        break;
                                    case MarginQuadrant.CashCow:
                                        <span class="text-blue-700">Volume & cashflow driver</span>
                                        break;
                                    case MarginQuadrant.Opportunity:
                                        <span class="text-emerald-700">Feature & boost awareness</span>
                                        break;
                                    case MarginQuadrant.Laggard:
                                        <span class="text-slate-500">Reprice or clear stock</span>
                                        break;
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                @if (FilteredItems.Count > 0)
                {
                    <tfoot>
                        <tr class="font-bold bg-slate-50/80 border-t-2 border-slate-200">
                            <th colspan="2">Filtered Total (@FilteredItems.Count products)</th>
                            <th class="text-right tabular-nums">@FilteredItems.Sum(i => i.UnitsSold).ToString("N0")</th>
                            <th class="text-right tabular-nums text-blue-700">@Money(FilteredItems.Sum(i => i.TotalRevenue))</th>
                            <th class="text-right tabular-nums text-slate-600">@Money(FilteredItems.Sum(i => i.TotalCost))</th>
                            <th class="text-right tabular-nums text-emerald-700">@Money(FilteredItems.Sum(i => i.TotalProfit))</th>
                            <th colspan="3"></th>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </section>
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    public string Period { get; set; } = "month";

    [SupplyParameterFromQuery]
    public DateOnly? Start { get; set; }

    [SupplyParameterFromQuery]
    public DateOnly? End { get; set; }

    [SupplyParameterFromQuery]
    public int? LocationId { get; set; }

    [SupplyParameterFromQuery(Name = "quadrant")]
    public string? QuadrantFilter { get; set; }

    private MarginMatrixReportData? Data;
    private string? Error;

    private static readonly KeyValuePair<string, string>[] Presets =
    [
        new("today", "Today"),
        new("yesterday", "Yesterday"),
        new("week", "This week"),
        new("month", "This month"),
        new("lastmonth", "Last month"),
        new("year", "This year"),
        new("custom", "Custom")
    ];

    private DateOnly EffectiveStart => Data?.StartDate ?? DateOnly.FromDateTime(DateTime.UtcNow);
    private DateOnly EffectiveEnd => Data?.EndDate ?? DateOnly.FromDateTime(DateTime.UtcNow);
    private string Currency => Configuration["CurrencyCode"] ?? "BDT";

    private IReadOnlyList<MarginMatrixRow> FilteredItems => Data?.Items.Where(i =>
        string.IsNullOrEmpty(QuadrantFilter) ||
        (QuadrantFilter == "star" && i.Quadrant == MarginQuadrant.Star) ||
        (QuadrantFilter == "cashcow" && i.Quadrant == MarginQuadrant.CashCow) ||
        (QuadrantFilter == "opportunity" && i.Quadrant == MarginQuadrant.Opportunity) ||
        (QuadrantFilter == "laggard" && i.Quadrant == MarginQuadrant.Laggard)
    ).ToList() ?? [];

    private string ExportCsvUrl =>
        $"/api/reports/export/margin-matrix?period={Period}&start={EffectiveStart:yyyy-MM-dd}&end={EffectiveEnd:yyyy-MM-dd}&locationId={LocationId}&search={Uri.EscapeDataString(QuadrantFilter ?? "")}";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var zone = AccountingCalendar.Zone(Configuration);
            var range = ReportService.ResolveRange(Period, Start, End, zone, DateTimeOffset.UtcNow);

            Data = await Analytics.GetMarginMatrixAsync(
                HttpContext.User,
                range.Start,
                range.End,
                LocationId,
                HttpContext.RequestAborted);
        }
        catch (ValidationException ex)
        {
            Error = ex.Message;
        }
        catch (Exception ex)
        {
            Error = "Failed to load margin matrix: " + ex.Message;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await JS.InvokeVoidAsync("PosCharts.initDeclarativeCharts");
        }
        catch
        {
            // Ignore if JS interop is unavailable during SSR
        }
    }

    private string PresetLink(string preset)
    {
        var query = new List<string> { $"period={preset}" };
        if (LocationId.HasValue) query.Add($"locationId={LocationId.Value}");
        if (!string.IsNullOrEmpty(QuadrantFilter)) query.Add($"quadrant={QuadrantFilter}");
        return $"/reports/margin-matrix?{string.Join("&", query)}";
    }

    private string QuadrantLink(string? quadrant)
    {
        var query = new List<string> { $"period={Period}" };
        if (Start.HasValue) query.Add($"start={Start.Value:yyyy-MM-dd}");
        if (End.HasValue) query.Add($"end={End.Value:yyyy-MM-dd}");
        if (LocationId.HasValue) query.Add($"locationId={LocationId.Value}");
        if (!string.IsNullOrEmpty(quadrant)) query.Add($"quadrant={quadrant}");
        return $"/reports/margin-matrix?{string.Join("&", query)}";
    }

    private string Money(decimal amount) => $"{amount:N2} {Currency}";
}
