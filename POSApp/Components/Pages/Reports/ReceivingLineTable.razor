@inject IConfiguration Configuration

<div class="table-scroll">
    <table class="data-table report-lines">
        <thead>
            <tr>
                <th>Item / barcode</th>
                <th class="text-right">Quantity</th>
                <th class="text-right">Unit cost</th>
                <th class="text-right">Stock value</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Items)
            {
                <tr>
                    <td>
                        <strong>@item.Product</strong>
                        @if (!string.IsNullOrWhiteSpace(item.Barcode))
                        {
                            <span class="block font-mono text-xs text-slate-500">@item.Barcode</span>
                        }
                    </td>
                    <td class="text-right">@item.Quantity.ToString("+0.###;-0.###;0") @item.Unit</td>
                    <td class="text-right">@Money(item.UnitCost)</td>
                    <td class="text-right font-medium">@Money(item.Value)</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3">Total</th>
                <td class="text-right font-medium">@Money(Items.Sum(item => item.Value))</td>
            </tr>
        </tfoot>
    </table>
</div>

@code {
    [Parameter]
    public IReadOnlyList<ReceivingActivityLine> Items { get; set; } = [];

    private string Money(decimal value) => $"{value:N2} {Configuration["CurrencyCode"] ?? "BDT"}";
}
