@inject IConfiguration Configuration

<div class="table-scroll">
    <table class="data-table report-lines compact-table w-full">
        <thead>
            <tr>
                <th class="text-xs">Item / barcode</th>
                <th class="text-right text-xs">Quantity</th>
                <th class="text-right text-xs">Unit cost</th>
                <th class="text-right text-xs">Stock value</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Items)
            {
                <tr class="hover:bg-slate-50/50">
                    <td>
                        <strong class="text-xs text-slate-900">@item.Product</strong>
                        @if (!string.IsNullOrWhiteSpace(item.Barcode))
                        {
                            <span class="block font-mono text-[10px] text-slate-400">@item.Barcode</span>
                        }
                    </td>
                    <td class="text-right font-mono text-xs whitespace-nowrap">@item.Quantity.ToString("+0.###;-0.###;0") <span class="text-[10px] text-slate-400">@item.Unit</span></td>
                    <td class="text-right font-mono text-xs whitespace-nowrap text-slate-600">@Money(item.UnitCost)</td>
                    <td class="text-right font-mono text-xs whitespace-nowrap font-semibold text-slate-900">@Money(item.Value)</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="font-semibold text-xs">
                <th colspan="3" class="text-xs">Total</th>
                <td class="text-right font-mono text-xs text-slate-900 font-bold">@Money(Items.Sum(item => item.Value))</td>
            </tr>
        </tfoot>
    </table>
</div>

@code {
    [Parameter]
    public IReadOnlyList<ReceivingActivityLine> Items { get; set; } = [];

    private string Money(decimal value) => $"{value:N2} {Configuration["CurrencyCode"] ?? "BDT"}";
}
