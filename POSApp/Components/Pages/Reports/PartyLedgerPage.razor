@page "/customers/{Id:int}/ledger"
@page "/suppliers/{Id:int}/ledger"
@attribute [Authorize(Policy = AppPolicies.MakeSales)]
@attribute [StreamRendering]
@inject LedgerService Ledger
@inject NavigationManager Navigation
@inject ILogger<PartyLedgerPage> Logger

<PageTitle>@(IsSupplier ? "Supplier" : "Customer") Statement · @(Report?.PartyName ?? "Ledger") · @(Configuration["StoreName"] ?? "RetailPOS")</PageTitle>

@if (AccessDenied)
{
    <div class="rounded-xl border border-rose-200 bg-rose-50 p-6 text-rose-800">
        <h2 class="text-base font-bold">Access Restricted</h2>
        <p class="mt-1 text-sm">You do not have permission to view supplier financial statements. Contact an administrator.</p>
        <a href="/" class="btn-secondary mt-4 inline-block">Return to dashboard</a>
    </div>
}
else if (Error is not null)
{
    <p class="error-panel" role="alert">
        @Error
        <a href="@Navigation.Uri" class="underline ml-2">Retry</a>
    </p>
}
else if (Loading)
{
    <LoadingPanel Message="@($"Loading {(IsSupplier ? "supplier" : "customer")} statement…")" />
}
else if (Report is null)
{
    <p class="error-panel">Account not found.</p>
}
else
{
    <!-- Screen-only Action & Filter Bar -->
    <div class="no-print mb-6 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-4">
            <div>
                <a href="@(IsSupplier ? $"/suppliers/{Id}" : $"/customers/{Id}")" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-slate-800 transition">
                    <svg class="size-3.5 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                    Back to @(IsSupplier ? "Supplier account" : "Customer account")
                </a>
                <h1 class="text-2xl font-bold tracking-tight text-slate-900 mt-1">
                    @(IsSupplier ? "Supplier Ledger & Statement" : "Customer Ledger & Statement")
                </h1>
                <p class="text-xs text-slate-500">
                    Detailed transaction breakdown, debits, credits, and running balance for <span class="font-semibold text-slate-700">@Report.PartyName</span>.
                </p>
            </div>

            <div class="flex flex-wrap items-center gap-2">
                <a href="@(IsSupplier ? $"/suppliers/{Id}" : $"/customers/{Id}")" class="btn-secondary">
                    Account Overview
                </a>
                <button type="button" class="btn-primary" data-print="a4">
                    <Icon Name="printer" />
                    Print / Save as PDF
                </button>
            </div>
        </div>

        <!-- Filter Presets & Date Range Selector -->
        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-2xs">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <div class="flex flex-wrap items-center gap-1.5">
                    <span class="text-xs font-medium text-slate-400 mr-1">Period:</span>
                    <a href="@PeriodUrl("all")" class="@ChipClass("all")">All Time</a>
                    <a href="@PeriodUrl("month")" class="@ChipClass("month")">This Month</a>
                    <a href="@PeriodUrl("lastmonth")" class="@ChipClass("lastmonth")">Last Month</a>
                    <a href="@PeriodUrl("30days")" class="@ChipClass("30days")">Last 30 Days</a>
                </div>

                <form method="get" action="@BasePath" class="flex flex-wrap items-center gap-2" data-enhance="true">
                    <input type="hidden" name="period" value="custom" />
                    <div class="w-64 sm:w-72">
                        <DateRangePicker Id="ledger-date-range" Start="@Report.Start" End="@Report.End" AutoSubmit="false" />
                    </div>
                    <button type="submit" class="btn-secondary text-xs">Apply Range</button>
                </form>
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- A4 PRINTABLE LEDGER STATEMENT SHEET        -->
    <!-- ========================================== -->
    <article id="invoice-a4-sheet" class="invoice-sheet rounded-xl p-8 sm:p-10 border border-slate-200 bg-white relative block shadow-sm">
        <!-- Top Brand Header -->
        <div class="invoice-header flex flex-col sm:flex-row justify-between items-start gap-4">
            <div class="flex items-center gap-3.5">
                <img src="/images/jas-logo-icon.png" alt="Logo" class="h-14 w-14 object-contain shrink-0" />
                <div>
                    <h2 class="text-2xl font-black tracking-tight text-slate-900 uppercase font-sans leading-none">
                        @(Configuration["StoreName"] ?? "JAS INTERNATIONAL")
                    </h2>
                    <p class="text-[11px] font-bold text-sky-600 tracking-wider uppercase mt-1">
                        @(Configuration["StoreSubtitle"] ?? "Store Management")
                    </p>
                    <span class="inline-block mt-1.5 rounded bg-slate-900 px-2 py-0.5 text-[10px] font-bold tracking-wider text-white uppercase">
                        @(IsSupplier ? "SUPPLIER STATEMENT OF ACCOUNT" : "CUSTOMER STATEMENT OF ACCOUNT")
                    </span>
                </div>
            </div>

            <div class="text-left sm:text-right text-xs leading-snug text-slate-600">
                <strong class="text-sm font-bold text-slate-900 block">@(Configuration["StoreName"] ?? "RetailPOS")</strong>
                <p>@(Configuration["Store:Address"] ?? "Khulna Shopping Complex, 41/42, 2nd Floor")</p>
                <p>Khulna 9100, Bangladesh</p>
                <p class="font-bold text-slate-800">Phone: @(Configuration["Store:Phone"] ?? "01711465078")</p>
                <p class="text-sky-600 font-medium">@(Configuration["Store:Email"] ?? "info@jasinternational.com.bd")</p>
            </div>
        </div>

        <div class="my-4 border-b-2 border-sky-400"></div>

        <!-- Meta Grid: Party Details (Left) & Statement Period (Right) -->
        <section class="invoice-meta grid grid-cols-2 gap-4 items-start my-4">
            <div class="border-l-4 border-sky-600 pl-3">
                <h3 class="text-[10px] font-bold uppercase tracking-wider text-slate-400">
                    @(IsSupplier ? "Supplier Account" : "Customer Account")
                </h3>
                <strong class="text-base font-bold text-slate-900 block mt-0.5">@Report.PartyName</strong>
                @if (!string.IsNullOrWhiteSpace(Report.Phone))
                {
                    <p class="text-xs text-slate-600"><span class="font-medium text-slate-500">Phone:</span> @Report.Phone</p>
                }
                @if (!string.IsNullOrWhiteSpace(Report.Address))
                {
                    <p class="text-xs text-slate-600"><span class="font-medium text-slate-500">Address:</span> @Report.Address</p>
                }
                <p class="text-[11px] text-slate-400 mt-0.5">Account ID: #@Report.PartyId</p>
            </div>

            <div class="text-right text-xs leading-snug">
                <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Statement Period</p>
                <p class="text-sm font-bold text-slate-900 mt-0.5">
                    @Report.Start.ToString("dd MMM yyyy") &mdash; @Report.End.ToString("dd MMM yyyy")
                </p>
                <p class="text-[11px] text-slate-500 mt-1">
                    Issued: <span class="font-medium text-slate-800">@DateTimeOffset.UtcNow.ToBusinessTime(Configuration).ToString("dd MMM yyyy")</span>
                </p>
                <p class="text-[11px] text-slate-500">
                    Currency: <span class="font-bold text-slate-800">@CurrencyCode</span>
                </p>
            </div>
        </section>

        <!-- Compact Formal Accounting Summary Bar -->
        <div class="grid grid-cols-4 border-y-2 border-black bg-slate-50/70 divide-x divide-slate-200 my-4 text-center">
            <div class="py-2 px-2">
                <span class="block text-[9px] font-bold uppercase tracking-wider text-slate-500">Opening Balance</span>
                <strong class="text-xs sm:text-sm font-bold font-mono text-slate-900 mt-0.5 block">
                    @Money(Report.OpeningBalance)
                </strong>
            </div>

            <div class="py-2 px-2">
                <span class="block text-[9px] font-bold uppercase tracking-wider text-slate-600">
                    @(IsSupplier ? "Total In / Billed (+)" : "Total In / Invoiced (+)")
                </span>
                <strong class="text-xs sm:text-sm font-bold font-mono text-slate-900 mt-0.5 block">
                    @Money(Report.TotalDebit)
                </strong>
            </div>

            <div class="py-2 px-2">
                <span class="block text-[9px] font-bold uppercase tracking-wider text-slate-600">
                    Total Out / Paid (-)
                </span>
                <strong class="text-xs sm:text-sm font-bold font-mono text-slate-900 mt-0.5 block">
                    @Money(Report.TotalCredit)
                </strong>
            </div>

            <div class="py-2 px-2 bg-slate-900 text-white">
                <span class="block text-[9px] font-bold uppercase tracking-wider text-slate-300">
                    Closing (@(Report.ClosingBalance >= 0 ? "Due" : (IsSupplier ? "Advance" : "Credit")))
                </span>
                <strong class="text-xs sm:text-sm font-black font-mono text-white mt-0.5 block">
                    @Money(Report.ClosingBalance)
                </strong>
            </div>
        </div>

        <!-- Formal Fixed-Layout Ledger Table (No Horizontal Overflow in Print) -->
        <table class="invoice-table ledger-table w-full mt-4">
            <colgroup>
                <col style="width: 12%;" />
                <col style="width: 28%;" />
                <col style="width: 12%;" />
                <col style="width: 12%;" />
                <col style="width: 14%;" />
                <col style="width: 22%;" />
            </colgroup>
            <thead>
                <tr class="border-y-2 border-black bg-slate-100/80 font-bold text-slate-900 uppercase tracking-wider text-[10px]">
                    <th class="text-left">Date</th>
                    <th class="text-left">Subject</th>
                    <th class="text-right">In (+)</th>
                    <th class="text-right">Out (-)</th>
                    <th class="text-right">Balance</th>
                    <th class="text-left">Remarks</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
                @if (Report.Period != "all" || Report.OpeningBalance != 0m || Report.Entries.Count == 0)
                {
                    <!-- Opening Balance Brought Forward Row -->
                    <tr class="bg-slate-50/70 text-slate-800">
                        <td class="font-medium text-slate-600 whitespace-nowrap">
                            @Report.Start.ToString("dd MMM yyyy")
                        </td>
                        <td class="ledger-subject font-semibold text-slate-900">
                            Opening balance
                        </td>
                        <td class="text-right font-mono text-slate-400">&mdash;</td>
                        <td class="text-right font-mono text-slate-400">&mdash;</td>
                        <td class="text-right font-mono font-bold text-slate-900 whitespace-nowrap">
                            @Amount(Report.OpeningBalance)
                        </td>
                        <td class="ledger-remarks text-slate-500 italic">
                            Brought forward
                        </td>
                    </tr>
                }

                @if (Report.Entries.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="py-6 text-center text-slate-400 italic">
                            No transactions recorded during this period.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var entry in Report.Entries)
                    {
                        <tr class="text-slate-800">
                            <td class="font-medium text-slate-600 whitespace-nowrap">
                                @entry.Date.ToBusinessTime(Configuration).ToString("dd MMM yyyy")
                            </td>
                            <td class="ledger-subject font-semibold text-slate-900">
                                @entry.Subject
                            </td>
                            <td class="text-right font-mono font-medium text-slate-900 whitespace-nowrap">
                                @(entry.Debit.HasValue ? Amount(entry.Debit.Value) : "—")
                            </td>
                            <td class="text-right font-mono font-medium text-slate-900 whitespace-nowrap">
                                @(entry.Credit.HasValue ? Amount(entry.Credit.Value) : "—")
                            </td>
                            <td class="text-right font-mono font-bold text-slate-950 whitespace-nowrap">
                                @Amount(entry.Balance)
                            </td>
                            <td class="ledger-remarks text-slate-600">
                                @(entry.Remarks ?? "—")
                            </td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr class="border-y-2 border-black bg-slate-50 font-bold text-slate-900">
                    <td colspan="2" class="uppercase tracking-wider text-[10px] text-slate-800">
                        Total &amp; Closing Balance (@CurrencyCode)
                    </td>
                    <td class="text-right font-mono text-slate-900 whitespace-nowrap">
                        @Amount(Report.TotalDebit)
                    </td>
                    <td class="text-right font-mono text-slate-900 whitespace-nowrap">
                        @Amount(Report.TotalCredit)
                    </td>
                    <td class="text-right font-mono font-black text-slate-950 whitespace-nowrap">
                        @Amount(Report.ClosingBalance)
                    </td>
                    <td class="text-[10px] font-bold uppercase text-sky-800">
                        @(Report.ClosingBalance >= 0 ? (IsSupplier ? "Payable Due" : "Receivable Due") : (IsSupplier ? "Advance" : "Credit"))
                    </td>
                </tr>
            </tfoot>
        </table>

        <!-- Verification & Signature Section -->
        <div class="invoice-closing-section mt-10 pt-4 border-t border-slate-200 break-inside-avoid">
            <div class="grid grid-cols-3 gap-6 text-center text-xs mt-6">
                <div>
                    <div class="border-b border-slate-400 pb-6"></div>
                    <p class="font-bold text-slate-800 mt-1.5 text-[11px]">Prepared By</p>
                    <p class="text-[10px] text-slate-500">Accounts Department</p>
                </div>
                <div>
                    <div class="border-b border-slate-400 pb-6"></div>
                    <p class="font-bold text-slate-800 mt-1.5 text-[11px]">Authorized Officer</p>
                    <p class="text-[10px] text-slate-500">Store Management</p>
                </div>
                <div>
                    <div class="border-b border-slate-400 pb-6"></div>
                    <p class="font-bold text-slate-800 mt-1.5 text-[11px]">
                        @(IsSupplier ? "Supplier Acknowledgment" : "Customer Acknowledgment")
                    </p>
                    <p class="text-[10px] text-slate-500">Signature &amp; Date</p>
                </div>
            </div>

            <div class="mt-5 text-center text-[10px] text-slate-400">
                <p>Computer-generated statement of account issued by @(Configuration["StoreName"] ?? "RetailPOS"). All amounts in @CurrencyCode.</p>
            </div>
        </div>
    </article>
}

@code {
    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromQuery]
    public string? Period { get; set; }

    [SupplyParameterFromQuery]
    public string? Start { get; set; }

    [SupplyParameterFromQuery]
    public string? End { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private PartyLedgerReport? Report;
    private bool Loading = true;
    private string? Error;
    private bool AccessDenied;

    private bool IsSupplier => Navigation.Uri.Contains("/suppliers/", StringComparison.OrdinalIgnoreCase);
    private string BasePath => IsSupplier ? $"/suppliers/{Id}/ledger" : $"/customers/{Id}/ledger";
    private string CurrencyCode => Configuration["CurrencyCode"] ?? "BDT";

    protected override async Task OnParametersSetAsync()
    {
        Loading = true;
        Error = null;
        AccessDenied = false;

        if (IsSupplier)
        {
            if (!HttpContext.User.IsInRole(AppRoles.Admin) && !HttpContext.User.IsInRole(AppRoles.InventoryManager))
            {
                AccessDenied = true;
                Loading = false;
                return;
            }
        }

        try
        {
            DateOnly? startDate = DateOnly.TryParseExact(Start, "yyyy-MM-dd", out var s) ? s : null;
            DateOnly? endDate = DateOnly.TryParseExact(End, "yyyy-MM-dd", out var e) ? e : null;

            if (IsSupplier)
            {
                Report = await Ledger.ReadSupplierLedgerAsync(HttpContext.User, Id, Period, startDate, endDate, HttpContext.RequestAborted);
            }
            else
            {
                Report = await Ledger.ReadCustomerLedgerAsync(HttpContext.User, Id, Period, startDate, endDate, HttpContext.RequestAborted);
            }
        }
        catch (KeyNotFoundException)
        {
            Report = null;
        }
        catch (OperationCanceledException) when (HttpContext.RequestAborted.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load party ledger for {PartyKind} {Id}", IsSupplier ? "Supplier" : "Customer", Id);
            Error = "An error occurred while generating the statement. Please try again.";
        }
        finally
        {
            Loading = false;
        }
    }

    private string Money(decimal amount) => $"{CurrencyCode} {amount:N2}";
    private static string Amount(decimal amount) => amount.ToString("N2");

    private string PeriodUrl(string period) => $"{BasePath}?period={period}";

    private string ChipClass(string period)
    {
        var current = Report?.Period ?? Period ?? "all";
        return string.Equals(current, period, StringComparison.OrdinalIgnoreCase)
            ? "filter-chip active"
            : "filter-chip";
    }
}
