    <script type="module" src="@Assets["shortcuts.js"]"></script>
    <script type="module" src="@Assets["printing.js"]"></script>
    <script type="module" src="@Assets["date-range-picker.js"]"></script>
    <script src="@Assets["lib/chart.umd.min.js"]"></script>
    <script type="module" src="@Assets["analytics-charts.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
