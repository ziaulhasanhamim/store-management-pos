<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <BasePath />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["tailwind.css"]" />
    <link rel="stylesheet" href="@Assets["POSApp.styles.css"]" />
    <link rel="icon" type="image/svg+xml" href="/images/jas-mark.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <ImportMap />
    <script>try{var tz=Intl.DateTimeFormat().resolvedOptions().timeZone;if(tz&&document.cookie.indexOf('pos_tz='+encodeURIComponent(tz))===-1)document.cookie='pos_tz='+encodeURIComponent(tz)+';path=/;max-age=31536000;SameSite=Lax';}catch{}</script>
