@inject NavigationManager Navigation

<details class="sidebar-group" open="@IsActive">
    <summary class="nav-link sidebar-summary">
        @if (!string.IsNullOrWhiteSpace(Href))
        {
            <NavLink href="@Href" Match="NavLinkMatch.All" class="sidebar-heading-link">
                <Icon Name="@IconName" />
                <span class="truncate">@Title</span>
            </NavLink>
            <span class="sidebar-chevron-wrap" title="Toggle @Title options">
                <span class="sidebar-chevron" aria-hidden="true">›</span>
            </span>
        }
        else
        {
            <div class="sidebar-heading-text">
                <Icon Name="@IconName" />
                <span class="truncate">@Title</span>
            </div>
            <span class="sidebar-chevron pr-4" aria-hidden="true">›</span>
        }
    </summary>
    <div class="sidebar-children">
        @ChildContent
    </div>
</details>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter]
    public string IconName { get; set; } = "box";

    [Parameter]
    public string? Href { get; set; }

    [Parameter, EditorRequired]
    public string Prefix { get; set; } = "";

    [Parameter]
    public string? AlternatePrefix { get; set; }

    [Parameter]
    public string? ExcludePrefix { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool IsActive
    {
        get
        {
            if (ExcludePrefix is not null)
            {
                var exclusions = ExcludePrefix.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                foreach (var exclusion in exclusions)
                {
                    if (Matches(exclusion)) return false;
                }
            }
            return Matches(Prefix) || (AlternatePrefix is not null && Matches(AlternatePrefix)) || (Href is not null && Matches(Href));
        }
    }

    private bool Matches(string prefix)
    {
        var path = new Uri(Navigation.Uri).AbsolutePath;
        var parts = prefix.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        foreach (var p in parts)
        {
            if (path.Equals(p, StringComparison.OrdinalIgnoreCase) || path.StartsWith(p + "/", StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }
        return false;
    }
}
