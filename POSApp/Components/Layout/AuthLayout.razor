@inherits LayoutComponentBase

<main class="flex min-h-screen items-center justify-center bg-slate-50 px-4 py-12">
    <div class="w-full max-w-md">
        <a href="/" class="mb-8 flex items-center justify-center gap-3 text-xl font-semibold text-slate-900">
            <img src="/images/logo.svg" alt="@(Configuration["StoreName"] ?? "RetailPOS") logo" class="size-12 rounded-xl" />
            @(Configuration["StoreName"] ?? "RetailPOS")
        </a>
        <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
            @Body
        </div>
        <p class="mt-6 text-center text-xs text-slate-500">@(Configuration["StoreSubtitle"] ?? "Store management")</p>
    </div>
</main>
