@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="min-h-screen bg-slate-50 lg:pl-64 w-full max-w-full overflow-x-hidden">
    <!-- Mobile Drawer Peer Toggle -->
    <input type="checkbox" id="mobile-nav-toggle" class="peer hidden" aria-hidden="true" />

    <!-- Backdrop Overlay for Mobile Drawer -->
    <label for="mobile-nav-toggle" class="fixed inset-0 z-40 bg-slate-950/60 backdrop-blur-xs transition-opacity duration-200 opacity-0 pointer-events-none peer-checked:opacity-100 peer-checked:pointer-events-auto lg:hidden" aria-hidden="true"></label>

    <aside class="sidebar fixed inset-y-0 left-0 z-50 w-72 max-w-[85vw] -translate-x-full peer-checked:translate-x-0 transition-transform duration-200 ease-in-out lg:transition-none overflow-y-auto lg:translate-x-0 lg:fixed lg:inset-y-0 lg:left-0 lg:z-20 lg:w-64 lg:border-r lg:border-b-0 lg:overflow-y-auto">
        <div class="flex items-center justify-between px-6 py-6">
            <a href="/" class="flex items-center gap-3">
                <img src="/images/logo.svg" alt="@(Configuration["StoreName"] ?? "RetailPOS") logo" class="size-11 rounded-xl" />
                <span class="text-base font-bold tracking-tight text-white">
                    @(Configuration["StoreName"] ?? "RetailPOS")
                    <span class="mt-0.5 block text-[10px] font-medium tracking-[0.18em] text-slate-400 uppercase">@(Configuration["StoreSubtitle"] ?? "Store management")</span>
                </span>
            </a>
            <label for="mobile-nav-toggle" class="lg:hidden text-slate-400 hover:text-white p-2 cursor-pointer text-lg" aria-label="Close navigation">✕</label>
        </div>

        <AuthorizeView>
            <nav aria-label="Main navigation" class="flex flex-col gap-1 px-3 pb-6">
                <!-- Top Core Shortcuts -->
                <NavLink href="/" Match="NavLinkMatch.All" class="nav-link">
                    <Icon Name="dashboard" />
                    <span>Dashboard</span>
                </NavLink>

                <!-- 1. Point of Sale -->
                <AuthorizeView Policy="@AppPolicies.MakeSales" Context="salesAuth">
                    <NavLink href="/sales" Match="NavLinkMatch.All" class="nav-link">
                        <Icon Name="cart" />
                        <span>Point of Sale</span>
                    </NavLink>
                </AuthorizeView>

                <!-- 2. Cash Drawer -->
                <AuthorizeView Policy="@AppPolicies.ManageDrawer" Context="drawerAuth">
                    <NavLink href="/cash-drawer" Match="NavLinkMatch.All" class="nav-link">
                        <Icon Name="wallet" />
                        <span>Cash Drawer</span>
                    </NavLink>
                </AuthorizeView>

                <!-- OPERATIONS -->
                <div class="sidebar-section-header">Operations</div>

                <!-- Expenses -->
                <AuthorizeView Policy="@AppPolicies.ManageDrawer" Context="expAuth">
                    <NavLink href="/expenses" Match="NavLinkMatch.All" class="nav-link">
                        <Icon Name="receipt" />
                        <span>Expenses</span>
                    </NavLink>
                </AuthorizeView>

                <!-- Items & Inventory -->
                <SidebarGroup Title="Items & Inventory" IconName="box" Href="/items" Prefix="/items" AlternatePrefix="/stock,/reports/statements/stock">
                    <NavLink href="/items" Match="NavLinkMatch.All">Products & items</NavLink>
                    <AuthorizeView Policy="@AppPolicies.ManageInventory" Context="takeAuth">
                        <NavLink href="/stock/takes">Physical stock takes</NavLink>
                    </AuthorizeView>
                    <AuthorizeView Policy="@AppPolicies.ManageStockAdjustment" Context="adjAuth">
                        <NavLink href="/stock/adjustments">Stock additions & waste</NavLink>
                    </AuthorizeView>
                </SidebarGroup>

                <!-- Receiving & Purchases -->
                <AuthorizeView Policy="@AppPolicies.ManageInventory" Context="recvAuth">
                    <SidebarGroup Title="Receiving & Purchases" IconName="receive" Href="/receiving" Prefix="/receiving" AlternatePrefix="/suppliers">
                        <NavLink href="/receiving" Match="NavLinkMatch.All">Receive stock & transfers</NavLink>
                        <NavLink href="/suppliers" Match="NavLinkMatch.All">Suppliers & payables</NavLink>
                        <NavLink href="/suppliers/payments">Supplier payments</NavLink>
                    </SidebarGroup>
                </AuthorizeView>

                <!-- FINANCE & PEOPLE -->
                <div class="sidebar-section-header">Finance & People</div>

                <!-- Customers & Dues -->
                <AuthorizeView Policy="@AppPolicies.MakeSales" Context="custAuth">
                    <SidebarGroup Title="Customers & Dues" IconName="users" Href="/customers" Prefix="/customers">
                        <NavLink href="/customers" Match="NavLinkMatch.All">Customers directory</NavLink>
                        <NavLink href="/customers/payments">Collect customer dues</NavLink>
                    </SidebarGroup>
                </AuthorizeView>

                <!-- Salary & Payroll -->
                <AuthorizeView Policy="@AppPolicies.ManageUsers" Context="payrollAuth">
                    <SidebarGroup Title="Salary & Payroll" IconName="users" Href="/payroll" Prefix="/payroll" AlternatePrefix="/employees">
                        <NavLink href="/payroll" Match="NavLinkMatch.All">Staff salary & payroll</NavLink>
                        <NavLink href="/employees">Employees & balances</NavLink>
                    </SidebarGroup>
                </AuthorizeView>

                <!-- Finance & Books -->
                <AuthorizeView Policy="@AppPolicies.ManageDrawer" Context="financeAuth">
                    <SidebarGroup Title="Finance & Books" IconName="wallet" Href="/finance/day" Prefix="/finance" AlternatePrefix="/reports/statements/cash,/reports/statements/bank,/cash-drawer?view=transfer">
                        <AuthorizeView Policy="@AppPolicies.ManageInventory" Context="closeAuth">
                            <NavLink href="/finance/day">Day summary & close</NavLink>
                            <NavLink href="/finance/month">Month summary & close</NavLink>
                        </AuthorizeView>
                        <AuthorizeView Policy="@AppPolicies.ManageUsers" Context="bankAuth">
                            <NavLink href="/finance/bank">Bank & digital accounts</NavLink>
                        </AuthorizeView>
                        <NavLink href="/finance/clearing">Card & wallet clearing</NavLink>
                        <AuthorizeView Policy="@AppPolicies.ManageUsers" Context="debtAuth">
                            <NavLink href="/finance/debt">Loans & borrowings</NavLink>
                        </AuthorizeView>
                    </SidebarGroup>
                </AuthorizeView>

                <!-- INSIGHTS -->
                <div class="sidebar-section-header">Insights</div>

                <AuthorizeView Policy="@AppPolicies.MakeSales" Context="repAuth">
                    <NavLink href="/reports" Match="NavLinkMatch.All" class="nav-link">
                        <Icon Name="dashboard" />
                        <span>Reports & Analytics</span>
                    </NavLink>
                </AuthorizeView>

                <!-- SYSTEM -->
                <AuthorizeView Policy="@AppPolicies.ManageUsers" Context="adminAuth">
                    <div class="sidebar-section-header">System</div>
                    <SidebarGroup Title="Administration" IconName="settings" Href="/administration" Prefix="/administration" AlternatePrefix="/users">
                        <NavLink href="/administration" Match="NavLinkMatch.All">Store setup & settings</NavLink>
                        <NavLink href="/users">Users & permissions</NavLink>
                        <NavLink href="/administration/audit">Record change audit</NavLink>
                        <NavLink href="/finance/balance-checks">Balance integrity checks</NavLink>
                    </SidebarGroup>
                </AuthorizeView>
            </nav>
        </AuthorizeView>

        <div class="px-6 pb-6 pt-3 text-xs text-slate-400 border-t border-slate-100">
            <div class="font-medium text-slate-500">@(Configuration["StoreName"] ?? "RetailPOS") © @UserTime.Today().Year</div>
        </div>
    </aside>

    <header class="flex h-16 sm:h-18 items-center justify-between border-b border-slate-200 bg-white px-3 sm:px-6 lg:px-8 w-full max-w-full">
        <div class="flex items-center gap-2 sm:gap-3 min-w-0">
            <label for="mobile-nav-toggle" class="icon-button shrink-0 lg:hidden cursor-pointer" aria-label="Open menu" title="Open menu">
                <svg class="size-6 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </label>
            <a href="/" class="flex items-center gap-2 shrink-0 lg:hidden">
                <img src="/images/logo.svg" alt="@(Configuration["StoreName"] ?? "RetailPOS") logo" class="size-7 rounded-lg" />
                <span class="text-sm font-bold text-slate-900 truncate max-w-[120px] sm:max-w-none">@(Configuration["StoreName"] ?? "RetailPOS")</span>
            </a>
            <AuthorizeView Policy="@AppPolicies.MakeSales">
                <Authorized>
                    <POSApp.Components.Pages.Finance.WorkingDateBadge />
                </Authorized>
                <NotAuthorized>
                    <span class="text-xs font-medium tracking-wide text-slate-400 uppercase hidden sm:inline">Workspace</span>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <AuthorizeView>
            <Authorized Context="auth">
                <div class="flex items-center gap-2 sm:gap-4 shrink-0">
                    <AuthorizeView Policy="@AppPolicies.ManageUsers" Context="importsAuth">
                        <ImportIndicator @rendermode="InteractiveAuto" />
                    </AuthorizeView>
                    <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-blue-50 text-xs font-bold text-blue-700">
                        @auth.User.Identity?.Name?.FirstOrDefault().ToString().ToUpperInvariant()
                    </span>
                    <span class="hidden md:inline max-w-40 truncate text-sm font-medium text-slate-700" title="@auth.User.Identity?.Name">
                        @auth.User.Identity?.Name
                    </span>
                    <a href="/account/change-password" class="icon-button shrink-0 text-xs font-medium text-slate-600 hover:text-indigo-700 px-2" aria-label="Change password" title="Change password">
                        Key
                    </a>
                    <a href="/account/logout" class="icon-button shrink-0" aria-label="Sign out" title="Sign out">
                        <Icon Name="logout" />
                    </a>
                </div>
            </Authorized>
            <NotAuthorized>
                <a href="/account/login" class="btn-primary">Sign in</a>
            </NotAuthorized>
        </AuthorizeView>
    </header>

    <main class="mx-auto max-w-7xl px-3 sm:px-6 lg:px-8 py-4 sm:py-8 w-full min-w-0">
        <WorkspaceNav />
        @Body

        <footer class="mt-16 border-t border-slate-200/80 pt-6 pb-8 text-xs text-slate-500 no-print">
            <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-slate-400">
                <div>
                    @(Configuration["StoreName"] ?? "RetailPOS") · System Version 2.0 · © @UserTime.Today().Year
                </div>
                <div class="flex items-center gap-1.5 text-slate-500">
                    <span>Developed by</span>
                    <a href="https://github.com/ziaulhasanhamim" target="_blank" rel="noopener noreferrer"
                       class="inline-flex items-center gap-1 font-semibold text-slate-700 hover:text-blue-600 transition-colors">
                        <svg class="size-3.5 fill-current text-slate-600" viewBox="0 0 24 24">
                            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                        </svg>
                        <span>Ziaul Hasan Hamim</span>
                    </a>
                </div>
            </div>
        </footer>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unexpected error occurred.
    <a href="." class="reload underline">Reload</a>
    <span class="dismiss">×</span>
</div>

@code {
    private string AreaClass(string area) => WorkspaceNavigation.Area(new Uri(Navigation.Uri).AbsolutePath) == area
        ? "nav-link active" : "nav-link";
}
