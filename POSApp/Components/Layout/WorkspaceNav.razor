@inject NavigationManager Navigation

@if (Links.Count > 0)
{
    <nav class="workspace-nav no-print" aria-label="Section navigation">
        @foreach (var link in Links)
        {
            <AuthorizeView Policy="@link.Policy" Context="sectionAuth">
                <a href="@link.Href" class="@(WorkspaceNavigation.Tab(Path) == link.Href ? "filter-chip active" : "filter-chip")">@link.Label</a>
            </AuthorizeView>
        }
    </nav>
}

@code {
    private string Path => new Uri(Navigation.Uri).AbsolutePath;
    private IReadOnlyList<(string Href, string Label, string? Policy)> Links => WorkspaceNavigation.Area(Path) switch
    {
        "reports" =>
        [
            ("/reports", "Reports hub", AppPolicies.MakeSales),
            ("/reports/sales", "Sales", AppPolicies.MakeSales),
            ("/reports/expenses", "Expense analysis", AppPolicies.MakeSales),
            ("/reports/servicing", "Servicing report", AppPolicies.MakeSales),
            ("/reports/statements/stock", "Stock ledger", AppPolicies.ManageInventory),
            ("/reports/statements/cash", "Cash ledger", AppPolicies.ManageUsers),
            ("/reports/statements/bank", "Bank ledger", AppPolicies.ManageUsers)
        ],
        "servicing" =>
        [
            ("/servicing", "Servicing jobs", AppPolicies.MakeSales),
            ("/servicing/technicians", "Technicians", AppPolicies.MakeSales),
            ("/reports/servicing", "Servicing report", AppPolicies.MakeSales)
        ],
        "administration" =>
        [
            ("/administration", "Setup", AppPolicies.ManageUsers),
            ("/users", "Users & roles", AppPolicies.ManageUsers),
            ("/admin/date-corrections", "Date corrections", AppPolicies.ManageUsers),
            ("/administration/audit", "Audit history", AppPolicies.ManageUsers)
        ],
        "finance" =>
        [
            ("/finance/summary", "Summary", AppPolicies.ManageUsers),
            ("/finance", "Finance hub", AppPolicies.MakeSales),
            ("/finance/clearing", "Card & wallet clearing", AppPolicies.MakeSales),
            ("/finance/payments", "Payments", AppPolicies.MakeSales),
            ("/finance/people", "People & payroll", AppPolicies.MakeSales),
            ("/finance/accounts", "Balances & accounts", AppPolicies.ManageUsers)
        ],
        "inventory" =>
        [
            ("/inventory", "Overview", null),
            ("/items", "Items", null),
            ("/stock/takes", "Stock takes", AppPolicies.ManageInventory),
            ("/stock/adjustments", "Stock additions", AppPolicies.ManageStockAdjustment),
            ("/stock/waste", "Damage & waste", AppPolicies.ManageStockAdjustment),
            ("/receiving", "Receiving & transfers", AppPolicies.ManageInventory),
            ("/suppliers", "Suppliers", AppPolicies.ManageInventory)
        ],
        _ => []
    };
}
